package codegen

import builtin from "tack/builtin"
import bytes from "std/bytes"
import diag from "tack/diag"
import fmt from "std/fmt"
import source from "tack/source"
import text from "std/text"
import typeck from "tack/typeck"

// not_ported is the error generate returns for what the port's backend
// does not do yet, which the driver reports as not implemented, exit
// status 3, as it does typeck's.
pub var not_ported = error{code: 3, msg: "not implemented in the port"}

// backend_names are the names of the backends, in sorted order, Go's
// Names: the one backend, c, whose name the driver's --backend flag
// selects it by.
pub var backend_names = [1]string{"c"}

// default_backend is the backend used when --backend is not given, Go's
// driver's defaultBackend.
pub var default_backend = "c"

// c_ext is the file extension of the C backend's output, with the dot,
// Go's Ext of codegen/c.
pub var c_ext = ".c"

// opts are the optimization levels a build runs at, as clang's -O flags
// name them, in the order the flags are listed, Go's Opts: 0 for none, 1
// to 3 for more, and s and z for smaller code.
pub var opts = [6]string{"0", "1", "2", "3", "s", "z"}

// default_opt is the level a build runs at unless asked for another, Go's
// DefaultOpt: the highest that keeps the C standard's semantics.
pub var default_opt = "3"

// append_clang_flags appends to argv the flags every clang command of the
// backend that compiles C starts with, Go's clangFlags: -w, warnings
// off, since a warning about generated C names a temporary file and code
// whoever runs tack never wrote; -fno-finite-loops, so clang never
// assumes, as C11 6.8.5p6 lets it, that a loop ends; -mllvm
// -indvars-predicate-loops=false, which turns off the loop predication
// that deletes a loop that never ends at -Oz in clang 23.1.5
// (llvm/llvm-project#183906); and -O at opt, one of opts. It fails only
// for want of memory.
pub func append_clang_flags(mut argv list[text.Text], opt []uint8) error {
    flags := [4]string{"-w", "-fno-finite-loops", "-mllvm", "-indvars-predicate-loops=false"}
    for _, f := range flags {
        append(mut argv, text.from_bytes([]uint8(f), c_allocator)?)?
    }
    mut o := text.from_bytes([]uint8("-O"), c_allocator)?
    mut o.append(opt)?
    return append(mut argv, o)
}

// build_cmd returns the clang command that compiles src, the generated
// C, and links it with objs into the binary out, Go's BuildCmd: clang,
// its flags (see append_clang_flags) at the level opt, -I include, the
// directory the generated C finds <tack/tack.h> in, -o out, src, and
// then each of objs, the objects of the program's C files and the
// runtime's, in the order given. The driver passes every path absolute,
// so none can be read as an option. It fails only for want of memory.
pub func build_cmd(src []uint8, include []uint8, objs []text.Text, out []uint8, opt []uint8) (list[text.Text], error) {
    mut argv := make(list[text.Text], c_allocator)
    append(mut argv, text.from_bytes([]uint8("clang"), c_allocator)?)?
    append_clang_flags(mut argv, opt)?
    append(mut argv, text.from_bytes([]uint8("-I"), c_allocator)?)?
    append(mut argv, text.from_bytes(include, c_allocator)?)?
    append(mut argv, text.from_bytes([]uint8("-o"), c_allocator)?)?
    append(mut argv, text.from_bytes(out, c_allocator)?)?
    append(mut argv, text.from_bytes(src, c_allocator)?)?
    for _, o := range objs {
        append(mut argv, text.from_bytes(o.bytes(), c_allocator)?)?
    }
    return argv, noerror
}

// compile_cmd returns the clang command that compiles src, a C file of
// one of the program's packages, to the object obj, Go's CompileCmd:
// clang, its flags at the level opt, -c, -I the directory of header,
// tack.h, which the C file may include by name, -I include, the
// runtime's include directory, -include header, so tack.h's
// declarations are in force whether the file includes it or not, -o obj
// and src. It fails only for want of memory.
pub func compile_cmd(src []uint8, header []uint8, header_dir []uint8, include []uint8, obj []uint8, opt []uint8) (list[text.Text], error) {
    mut argv := make(list[text.Text], c_allocator)
    append(mut argv, text.from_bytes([]uint8("clang"), c_allocator)?)?
    append_clang_flags(mut argv, opt)?
    append(mut argv, text.from_bytes([]uint8("-c"), c_allocator)?)?
    append(mut argv, text.from_bytes([]uint8("-I"), c_allocator)?)?
    append(mut argv, text.from_bytes(header_dir, c_allocator)?)?
    append(mut argv, text.from_bytes([]uint8("-I"), c_allocator)?)?
    append(mut argv, text.from_bytes(include, c_allocator)?)?
    append(mut argv, text.from_bytes([]uint8("-include"), c_allocator)?)?
    append(mut argv, text.from_bytes(header, c_allocator)?)?
    append(mut argv, text.from_bytes([]uint8("-o"), c_allocator)?)?
    append(mut argv, text.from_bytes(obj, c_allocator)?)?
    append(mut argv, text.from_bytes(src, c_allocator)?)?
    return argv, noerror
}

// compile_std_cmd returns the clang command that compiles src, a C file
// of the runtime, to the object obj, Go's CompileStdCmd: clang, its
// flags at the level opt, -c, -I include, the runtime's include
// directory, -o obj and src. It fails only for want of memory.
pub func compile_std_cmd(src []uint8, include []uint8, obj []uint8, opt []uint8) (list[text.Text], error) {
    mut argv := make(list[text.Text], c_allocator)
    append(mut argv, text.from_bytes([]uint8("clang"), c_allocator)?)?
    append_clang_flags(mut argv, opt)?
    append(mut argv, text.from_bytes([]uint8("-c"), c_allocator)?)?
    append(mut argv, text.from_bytes([]uint8("-I"), c_allocator)?)?
    append(mut argv, text.from_bytes(include, c_allocator)?)?
    append(mut argv, text.from_bytes([]uint8("-o"), c_allocator)?)?
    append(mut argv, text.from_bytes(obj, c_allocator)?)?
    append(mut argv, text.from_bytes(src, c_allocator)?)?
    return argv, noerror
}

// version_cmd returns the command that identifies the toolchain, Go's
// VersionCmd: clang --version, whose output names clang's version, its
// default target and where it is installed. It fails only for want of
// memory.
pub func version_cmd() (list[text.Text], error) {
    mut argv := make(list[text.Text], c_allocator)
    append(mut argv, text.from_bytes([]uint8("clang"), c_allocator)?)?
    append(mut argv, text.from_bytes([]uint8("--version"), c_allocator)?)?
    return argv, noerror
}

// has_backend reports whether name is the name of a backend, Go's Get
// finding one.
pub func has_backend(name []uint8) bool {
    for _, b := range backend_names {
        if bytes.equal(name, []uint8(b)) {
            return true
        }
    }
    return false
}

// append_names appends the backends' names to out, in Go's order, joined
// by sep, as Go's strings.Join(codegen.Names(), sep) writes them.
pub func append_names(mut out list[uint8], sep []uint8) error {
    for i, b := range backend_names {
        if i > 0 {
            append(mut out, sep...)?
        }
        append(mut out, []uint8(b)...)?
    }
    return noerror
}

// refuse appends to out the error a backend reports, before lowering
// anything, for a program that must never have code generated from it,
// and reports whether it did, Go's Refuse: one any stage reported an
// error about, counted in prog_errors, the program's Errors, and in
// table_errors, its type table's. A program the front end accepted is
// not refused. Reaching it with errors is a bug in the caller, never the
// program's fault. The error has no place in any file, Go's zero Span,
// here a span of no file.
pub func refuse(prog_errors int64, table_errors int64, mut out list[diag.Diagnostic]) (bool, error) {
    if prog_errors <= 0 && table_errors <= 0 {
        return false, noerror
    }
    mut n := prog_errors
    if table_errors > n {
        n = table_errors
    }
    mut m := make(list[uint8], c_allocator)
    fmt.appendf(mut m, "internal error: code generation was given a program with %d errors", n)?
    msg := text.from_bytes(m, c_allocator)?
    sp := source.Span{file: source.FileID{n: -1}, start: 0, end: 0}
    append(mut out, diag.new_error(own msg, sp, c_allocator))?
    return true, noerror
}

// generate turns t, a checked program, with set, the builtins it was
// resolved and checked with, into its C, Go's Generate of codegen/c: a
// program refuse refuses gives its diagnostics and no C; one whose types
// tack.h could not name, header_diags', which Go's generate checks
// before it lowers anything, gives those; and any other, for now,
// not_ported, since the lowering is not ported yet. t is taken as mut,
// so the driver still has its files to render the diagnostics with, and
// its program to write tack.h from.
pub func generate(mut t typeck.Typed, set builtin.Set) (list[uint8], list[diag.Diagnostic], error) {
    out := make(list[uint8], c_allocator)
    mut diags := make(list[diag.Diagnostic], c_allocator)
    refused := refuse(t.prog.errors, mut t.table.errors(), mut diags)?
    if refused {
        return out, diags, noerror
    }
    // tack.h is written only for a build with C files, but a name it
    // cannot give is a problem with the program whatever is built.
    hd := header_diags(mut t)?
    if len(hd) > 0 {
        return out, hd, noerror
    }
    c, ld, le := lower(mut t, set)
    return c, ld, le
}
