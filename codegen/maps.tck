package codegen

import ast from "tack/ast"
import fmt from "std/fmt"
import typeck from "tack/typeck"
import types from "tack/types"

// Maps, Go's maps.go: a map's C structs, its key type's hash helper,
// after those of the types the key is made of, and its own helpers, find,
// has, at, grow, put and take, and its free helper; make, put, has, a
// value read or written under a key proven there, delete, the checked
// lookup and a range over a map. Go's emitHashOf recurses a frame a
// level of the key type's parts, so the walk keeps a stack of its own.

// r_put is the routine of Go's putValue.
var r_put uint8 = 52

// r_has is the routine of Go's hasValue and poolHasValue.
var r_has uint8 = 53

// r_map_index is the routine of Go's mapElementExpr.
var r_map_index uint8 = 54

// r_arena_index is the routine of Go's arenaIndexExpr.
var r_arena_index uint8 = 55

// r_pool_index is the routine of Go's poolElementExpr.
var r_pool_index uint8 = 56

// map_step runs the next step of f, a frame of one of the map, arena or
// pool routines, and reports whether it was one.
func (mut g Gen) map_step(mut t typeck.Typed, f MFrame, mut m Machine) (bool, error) {
    if f.r == r_put {
        mut g.step_put(mut t, f, mut m)?
        return true, noerror
    }
    if f.r == r_has || f.r == r_map_index || f.r == r_arena_index || f.r == r_pool_index {
        mut g.step_lookup(mut t, f, mut m)?
        return true, noerror
    }
    return false, noerror
}

// wb appends s to the file being written.
func (mut g Gen) wb(s string) error {
    append(mut g.buf, []uint8(s)...)?
    return noerror
}

// append_map_name appends the name of the C struct of the map type typ
// stands for, Go's mapName.
func append_map_name(mut t typeck.Typed, typ types.Type, mut out list[uint8]) error {
    b := mut t.table.bound(typ)?
    fmt.appendf(mut out, "tack_map_%d", b.number())?
    return noerror
}

// append_entry_name appends the name of the C struct of one entry of the
// map type typ stands for, Go's entryName.
func append_entry_name(mut t typeck.Typed, typ types.Type, mut out list[uint8]) error {
    b := mut t.table.bound(typ)?
    fmt.appendf(mut out, "tack_ment_%d", b.number())?
    return noerror
}

// append_hash_name appends the name of the hash helper of the key type
// typ stands for, Go's hashName.
func append_hash_name(mut t typeck.Typed, typ types.Type, mut out list[uint8]) error {
    b := mut t.table.bound(typ)?
    fmt.appendf(mut out, "tack_hash_%d", b.number())?
    return noerror
}

// append_map_helper appends the name of the helper what of the map type
// typ stands for, Go's mapHelper.
func append_map_helper(mut t typeck.Typed, what string, typ types.Type, mut out list[uint8]) error {
    b := mut t.table.bound(typ)?
    fmt.appendf(mut out, "tack_m%s_%d", what, b.number())?
    return noerror
}

// c_type_of returns the C type of typ, as bytes.
func c_type_of(mut t typeck.Typed, typ types.Type) (list[uint8], error) {
    mut out := make(list[uint8], c_allocator)
    append_c_type(mut t, typ, mut out)?
    return out, noerror
}

// emit_map_def defines the C structs a map type lowers to, Go's
// emitMapDef: its entry's and its own.
func (mut g Gen) emit_map_def(mut t typeck.Typed, typ types.Type) error {
    key := c_type_of(mut t, mut t.table.key_of(typ)?)?
    val := c_type_of(mut t, mut t.table.elem_of(typ)?)?
    mut e := make(list[uint8], c_allocator)
    append_entry_name(mut t, typ, mut e)?
    fmt.appendf(mut g.buf, "typedef struct {\n    %s key;\n    %s val;\n    uint64_t hash;\n    bool live;\n} %s;\n\n", key[:], val[:], e[:])?
    mut mn := make(list[uint8], c_allocator)
    append_map_name(mut t, typ, mut mn)?
    fmt.appendf(mut g.buf, "typedef struct {\n    %s *entries;\n    int64_t len;\n    int64_t used;\n    int64_t cap;\n", e[:])?
    fmt.appendf(mut g.buf, "    int64_t *slots;\n    int64_t nslots;\n    tack_allocator alloc;\n} %s;\n\n", mn[:])?
    return noerror
}

// map_types returns every map type the program has, in the order the
// table added them, Go's mapTypes.
func (mut g Gen) map_types(mut t typeck.Typed) (list[types.Type], error) {
    mut out := make(list[types.Type], c_allocator)
    count := mut t.table.count()
    for i := range count {
        typ := types.added(i)
        param := mut t.table.has_type_param(typ)?
        if param {
            continue
        }
        if mut t.table.is_map(typ)? {
            append(mut out, typ)?
        }
    }
    return out, noerror
}

// emit_maps writes, for every map type, the hash helper of its key type,
// after those of the types the key is made of, and its own helpers, Go's
// emitMaps, with the mixing step every hash ends with first.
func (mut g Gen) emit_maps(mut t typeck.Typed) error {
    maps := mut g.map_types(mut t)?
    if len(maps) == 0 {
        return noerror
    }
    mut g.wb("static uint64_t tack_mix_(uint64_t x) {\n    x ^= x >> 30;\n    x *= 0xbf58476d1ce4e5b9u;\n    x ^= x >> 27;\n    x *= 0x94d049bb133111ebu;\n    x ^= x >> 31;\n    return x;\n}\n\n")?
    mut hashed := make(map[types.Type]bool, c_allocator)
    for _, typ := range maps {
        mut g.emit_hash_of(mut t, mut t.table.key_of(typ)?, mut hashed)?
    }
    for _, typ := range maps {
        mut g.emit_map_helpers(mut t, typ)?
    }
    return noerror
}

// hashes_parts reports whether the hash of a key of type typ is made of
// its parts' hashes, Go's test before emitHashOf recurses: anything but
// a string, an integer, a bool, an id, a span or a handle.
func hashes_parts(mut t typeck.Typed, typ types.Type) (bool, error) {
    if typ == types.string_type || types.is_integer(typ) || typ == types.bool_type {
        return false, noerror
    }
    if mut t.table.is_ref(typ)? {
        return false, noerror
    }
    h := mut t.table.is_handle(typ)?
    return !h, noerror
}

// append_hashed_parts appends the types a key of type typ is made of,
// Go's hashedParts: an array's or a list's element type, a union's
// payloads' types, or a struct's field types.
func append_hashed_parts(mut t typeck.Typed, typ types.Type, mut out list[types.Type]) error {
    arr := mut t.table.is_array(typ)?
    lst := mut t.table.is_list(typ)?
    if arr || lst {
        append(mut out, mut t.table.elem_of(typ)?)?
        return noerror
    }
    if mut t.table.is_union(typ)? {
        n := mut t.table.case_count(typ)?
        for i := range n {
            c, ok := mut t.table.case_at(typ, i)?
            if ok && c.payload {
                append(mut out, c.typ)?
            }
        }
        return noerror
    }
    n := mut t.table.field_count(typ)?
    for i := range n {
        ft, ok := mut t.table.field_type(typ, i)?
        if ok {
            append(mut out, ft)?
        }
    }
    return noerror
}

// emit_hash_of writes the hash helper of root, after those of the types
// it is made of, unless hashed says it is written already, Go's
// emitHashOf: a type is marked before its parts are visited.
func (mut g Gen) emit_hash_of(mut t typeck.Typed, root types.Type, mut hashed map[types.Type]bool) error {
    mut frames := make(list[TypeFrame], c_allocator)
    mut parts := make(list[types.Type], c_allocator)
    entered := mut g.enter_hash(mut t, root, mut hashed, mut frames, mut parts)?
    if !entered {
        return noerror
    }
    for len(frames) > 0 {
        p, has, f := next_part(mut frames, mut parts)
        if has {
            mut g.enter_hash(mut t, p, mut hashed, mut frames, mut parts)?
            continue
        }
        mut g.write_hash(mut t, f.typ)?
    }
    return noerror
}

// enter_hash starts the visit of typ, unless hashed says it is done:
// marked, then, when its hash is made of its parts', a frame pushed for
// them, or else its helper written at once. It reports whether it was
// not done.
func (mut g Gen) enter_hash(mut t typeck.Typed, typ types.Type, mut hashed map[types.Type]bool, mut frames list[TypeFrame], mut parts list[types.Type]) (bool, error) {
    _, done := hashed[typ]
    if done {
        return false, noerror
    }
    put(mut hashed, typ, true)?
    hp := hashes_parts(mut t, typ)?
    if !hp {
        mut g.write_hash(mut t, typ)?
        return true, noerror
    }
    start := len(parts)
    append_hashed_parts(mut t, typ, mut parts)?
    append(mut frames, TypeFrame{typ: typ, start: start, next: start, end: len(parts)})?
    return true, noerror
}

// write_hash writes the hash helper of typ, whose parts' are written, Go's
// emitHashOf past its recursion.
func (mut g Gen) write_hash(mut t typeck.Typed, typ types.Type) error {
    mut name := make(list[uint8], c_allocator)
    append_hash_name(mut t, typ, mut name)?
    ct := c_type_of(mut t, typ)?
    fmt.appendf(mut g.buf, "static uint64_t %s(const %s *k) {\n", name[:], ct[:])?
    if typ == types.bool_type || types.is_integer(typ) || typ == types.string_type {
        mut g.wb(basic_hash(typ))?
    } else if mut t.table.is_id(typ)? {
        mut g.wb(basic_hash(types.uint32_type))?
    } else if mut t.table.is_span(typ)? {
        mut g.wb(basic_hash(types.uint64_type))?
    } else if mut t.table.is_handle(typ)? {
        mut g.wb("    return tack_mix_(((uint64_t)k->index | (uint64_t)k->gen << 32) ^ tack_mix_((uint64_t)k->tag));\n")?
    } else {
        arr := mut t.table.is_array(typ)?
        lst := mut t.table.is_list(typ)?
        if arr || lst {
            mut field := "e"
            mut n := make(list[uint8], c_allocator)
            if lst {
                field = "ptr"
                append(mut n, []uint8("k->len")...)?
            } else {
                fmt.appendf(mut n, "%d", mut t.table.len_of(typ)?)?
            }
            fmt.appendf(mut g.buf, "    uint64_t h = tack_mix_((uint64_t)%s);\n", n[:])?
            mut eh := make(list[uint8], c_allocator)
            append_hash_name(mut t, mut t.table.elem_of(typ)?, mut eh)?
            fmt.appendf(mut g.buf, "    for (int64_t i = 0; i < %s; i++) {\n        h = tack_mix_(h ^ %s(&k->%s[i]));\n    }\n", n[:], eh[:], field)?
            mut g.wb("    return h;\n")?
        } else if mut t.table.is_union(typ)? {
            mut g.wb("    uint64_t h = tack_mix_((uint64_t)k->tag);\n    switch (k->tag) {\n")?
            nc := mut t.table.case_count(typ)?
            for i := range nc {
                uc, ok := mut t.table.case_at(typ, i)?
                if !ok || !uc.payload {
                    continue
                }
                mut ph := make(list[uint8], c_allocator)
                append_hash_name(mut t, uc.typ, mut ph)?
                fmt.appendf(mut g.buf, "    case %d:\n        return tack_mix_(h ^ %s(&k->u.c_", i, ph[:])?
                mut t.table.case_name(uc, mut g.buf)?
                mut g.wb("));\n")?
            }
            mut g.wb("    default:\n        return h;\n    }\n")?
        } else {
            mut g.wb("    uint64_t h = 0;\n")?
            nf := mut t.table.field_count(typ)?
            for i := range nf {
                ft, _ := mut t.table.field_type(typ, i)?
                mut fh := make(list[uint8], c_allocator)
                append_hash_name(mut t, ft, mut fh)?
                fmt.appendf(mut g.buf, "    h = tack_mix_(h ^ %s(&k->", fh[:])?
                append_field_member(mut t, typ, i, mut g.buf)?
                mut g.wb("));\n")?
            }
            mut g.wb("    (void)k;\n    return h;\n")?
        }
    }
    mut g.wb("}\n\n")?
    return noerror
}

// basic_hash returns the body of the hash helper of typ, a bool, an
// integer or a string, Go's basicHash.
func basic_hash(typ types.Type) string {
    if typ == types.bool_type {
        return "    return tack_mix_(*k ? 1u : 0u);\n"
    }
    if types.is_integer(typ) && types.is_unsigned(typ) {
        return "    return tack_mix_((uint64_t)*k);\n"
    }
    if types.is_integer(typ) {
        return "    return tack_mix_((uint64_t)(int64_t)*k);\n"
    }
    return "    uint64_t h = 14695981039346656037u;\n    for (int64_t i = 0; i < k->len; i++) {\n        h ^= k->ptr[i];\n        h *= 1099511628211u;\n    }\n    return tack_mix_(h ^ (uint64_t)k->len);\n"
}

// emit_map_helpers writes the map type typ's helpers, Go's
// emitMapHelpers: find, has and at, grow, put and take.
func (mut g Gen) emit_map_helpers(mut t typeck.Typed, typ types.Type) error {
    key := mut t.table.key_of(typ)?
    value := mut t.table.elem_of(typ)?
    mut m := make(list[uint8], c_allocator)
    append_map_name(mut t, typ, mut m)?
    mut e := make(list[uint8], c_allocator)
    append_entry_name(mut t, typ, mut e)?
    k := c_type_of(mut t, key)?
    v := c_type_of(mut t, value)?
    mut find := make(list[uint8], c_allocator)
    append_map_helper(mut t, "find", typ, mut find)?
    fmt.appendf(mut g.buf, "static int64_t %s(const %s *m, const %s *k, uint64_t h) {\n", find[:], m[:], k[:])?
    mut g.wb("    if (m->nslots == 0) {\n        return -1;\n    }\n    uint64_t mask = (uint64_t)m->nslots - 1;\n    for (uint64_t i = h & mask;; i = (i + 1) & mask) {\n        int64_t s = m->slots[i];\n        if (s == 0) {\n            return -1;\n        }\n")?
    mut eq := make(list[uint8], c_allocator)
    mut g.append_equal_expr(mut t, key, []uint8("m->entries[s - 1].key"), []uint8("(*k)"), mut eq)?
    fmt.appendf(mut g.buf, "        if (s > 0 && m->entries[s - 1].hash == h && %s) {\n            return (int64_t)i;\n        }\n    }\n}\n\n", eq[:])?
    mut g.emit_map_lookups(mut t, typ)?
    mut g.emit_map_grow(mut t, typ)?
    mut put_name := make(list[uint8], c_allocator)
    append_map_helper(mut t, "put", typ, mut put_name)?
    unused := mut g.maybe_unused(put_name[:])?
    fmt.appendf(mut g.buf, "%sstatic bool %s(%s *m, %s key, %s val) {\n", unused, put_name[:], m[:], k[:], v[:])?
    mut hn := make(list[uint8], c_allocator)
    append_hash_name(mut t, key, mut hn)?
    fmt.appendf(mut g.buf, "    uint64_t h = %s(&key);\n    int64_t s = %s(m, &key, h);\n", hn[:], find[:])?
    mut g.wb("    if (s >= 0) {\n")?
    fmt.appendf(mut g.buf, "        %s *e = &m->entries[m->slots[s] - 1];\n", e[:])?
    mut g.write_frees(mut t, "        ", value, []uint8("e->val"))?
    mut g.wb("        e->val = val;\n")?
    mut g.write_frees(mut t, "        ", key, []uint8("key"))?
    mut g.wb("        return true;\n    }\n")?
    mut grow := make(list[uint8], c_allocator)
    append_map_helper(mut t, "grow", typ, mut grow)?
    fmt.appendf(mut g.buf, "    if (!%s(m)) {\n", grow[:])?
    mut g.write_frees(mut t, "        ", key, []uint8("key"))?
    mut g.write_frees(mut t, "        ", value, []uint8("val"))?
    mut g.wb("        return false;\n    }\n    uint64_t mask = (uint64_t)m->nslots - 1;\n    uint64_t i = h & mask;\n    while (m->slots[i] > 0) {\n        i = (i + 1) & mask;\n    }\n    m->slots[i] = m->used + 1;\n")?
    fmt.appendf(mut g.buf, "    m->entries[m->used] = (%s){.key = key, .val = val, .hash = h, .live = true};\n", e[:])?
    mut g.wb("    m->used++;\n    m->len++;\n    return true;\n}\n\n")?
    mut g.emit_map_take(mut t, typ)?
    return noerror
}

// emit_map_take writes the map type typ's take helper, Go's emitMapTake.
func (mut g Gen) emit_map_take(mut t typeck.Typed, typ types.Type) error {
    key := mut t.table.key_of(typ)?
    mut m := make(list[uint8], c_allocator)
    append_map_name(mut t, typ, mut m)?
    mut e := make(list[uint8], c_allocator)
    append_entry_name(mut t, typ, mut e)?
    v := c_type_of(mut t, mut t.table.elem_of(typ)?)?
    mut take := make(list[uint8], c_allocator)
    append_map_helper(mut t, "take", typ, mut take)?
    unused := mut g.maybe_unused(take[:])?
    fmt.appendf(mut g.buf, "%sstatic %s %s(%s *m, int64_t s) {\n", unused, v[:], take[:], m[:])?
    fmt.appendf(mut g.buf, "    %s *e = &m->entries[m->slots[s] - 1];\n    %s val = e->val;\n", e[:], v[:])?
    mut g.write_frees(mut t, "    ", key, []uint8("e->key"))?
    mut g.wb("    e->live = false;\n    m->slots[s] = -1;\n    m->len--;\n    if (m->len == 0) {\n        m->used = 0;\n        for (int64_t i = 0; i < m->nslots; i++) {\n            m->slots[i] = 0;\n        }\n    }\n    return val;\n}\n\n")?
    return noerror
}

// emit_map_lookups writes the map type typ's has and at helpers, Go's
// emitMapLookups.
func (mut g Gen) emit_map_lookups(mut t typeck.Typed, typ types.Type) error {
    key := mut t.table.key_of(typ)?
    mut m := make(list[uint8], c_allocator)
    append_map_name(mut t, typ, mut m)?
    k := c_type_of(mut t, key)?
    v := c_type_of(mut t, mut t.table.elem_of(typ)?)?
    mut find := make(list[uint8], c_allocator)
    append_map_helper(mut t, "find", typ, mut find)?
    mut hn := make(list[uint8], c_allocator)
    append_hash_name(mut t, key, mut hn)?
    mut call := make(list[uint8], c_allocator)
    fmt.appendf(mut call, "%s(m, &key, %s(&key))", find[:], hn[:])?
    mut has := make(list[uint8], c_allocator)
    append_map_helper(mut t, "has", typ, mut has)?
    mut at_name := make(list[uint8], c_allocator)
    append_map_helper(mut t, "at", typ, mut at_name)?
    uh := mut g.maybe_unused(has[:])?
    fmt.appendf(mut g.buf, "%sstatic bool %s(const %s *m, %s key) {\n    return %s >= 0;\n}\n\n", uh, has[:], m[:], k[:], call[:])?
    ua := mut g.maybe_unused(at_name[:])?
    fmt.appendf(mut g.buf, "%sstatic %s *%s(const %s *m, %s key) {\n    return (%s *)&m->entries[m->slots[%s] - 1].val;\n}\n\n", ua, v[:], at_name[:], m[:], k[:], v[:], call[:])?
    return noerror
}

// emit_map_grow writes the map type typ's grow helper, Go's emitMapGrow.
func (mut g Gen) emit_map_grow(mut t typeck.Typed, typ types.Type) error {
    mut m := make(list[uint8], c_allocator)
    append_map_name(mut t, typ, mut m)?
    mut e := make(list[uint8], c_allocator)
    append_entry_name(mut t, typ, mut e)?
    mut grow := make(list[uint8], c_allocator)
    append_map_helper(mut t, "grow", typ, mut grow)?
    fmt.appendf(mut g.buf, "static bool %s(%s *m) {\n", grow[:], m[:])?
    mut g.wb("    if (m->used < m->cap && (m->used + 1) * 4 <= m->nslots * 3) {\n        return true;\n    }\n")?
    mut g.wb("    int64_t ns = 8;\n    while (ns * 3 < (m->len + 1) * 8) {\n")?
    mut g.wb("        if (ns > INT64_MAX / 8) {\n            return false;\n        }\n        ns *= 2;\n    }\n")?
    mut g.wb("    int64_t got = 0;\n")?
    mut g.wb("    int64_t *slots = tack_list_grow_(0, 0, ns, sizeof (int64_t), _Alignof (int64_t), m->alloc, &got);\n")?
    mut g.wb("    if (slots == 0) {\n        return false;\n    }\n")?
    mut g.wb("    ns = got;\n")?
    fmt.appendf(mut g.buf, "    %s *entries = m->entries;\n    int64_t cap = m->cap;\n", e[:])?
    mut g.wb("    if (m->len + 1 > cap) {\n")?
    fmt.appendf(mut g.buf, "        entries = tack_list_grow_(m->entries, m->cap, m->len + 1, sizeof (%s), _Alignof (%s), m->alloc, &cap);\n", e[:], e[:])?
    mut g.wb("        if (entries == 0) {\n")?
    mut g.wb("            tack_list_free_(slots, ns, sizeof (int64_t), _Alignof (int64_t), m->alloc);\n")?
    mut g.wb("            return false;\n        }\n    }\n")?
    mut g.wb("    int64_t used = 0;\n    for (int64_t i = 0; i < m->used; i++) {\n")?
    mut g.wb("        if (entries[i].live) {\n            entries[used++] = entries[i];\n        }\n    }\n")?
    mut g.wb("    for (int64_t i = 0; i < ns; i++) {\n        slots[i] = 0;\n    }\n")?
    mut g.wb("    uint64_t mask = (uint64_t)ns - 1;\n")?
    mut g.wb("    for (int64_t i = 0; i < used; i++) {\n        uint64_t j = entries[i].hash & mask;\n")?
    mut g.wb("        while (slots[j] != 0) {\n            j = (j + 1) & mask;\n        }\n        slots[j] = i + 1;\n    }\n")?
    mut g.wb("    tack_list_free_(m->slots, m->nslots, sizeof (int64_t), _Alignof (int64_t), m->alloc);\n")?
    mut g.wb("    m->entries = entries;\n    m->cap = cap;\n    m->used = used;\n    m->slots = slots;\n    m->nslots = ns;\n")?
    mut g.wb("    return true;\n}\n\n")?
    return noerror
}

// write_frees writes, each line after indent, the statements that free
// the value of type typ at the place ref, Go's writeFrees.
func (mut g Gen) write_frees(mut t typeck.Typed, indent string, typ types.Type, ref []uint8) error {
    lines := mut g.frees(mut t, typ, ref)?
    for _, l := range lines {
        mut g.wb(indent)?
        append(mut g.buf, l[:]...)?
        append(mut g.buf, '\n')?
    }
    return noerror
}

// emit_map_free writes the free helper of the map type typ, Go's
// emitMapFree: every live entry's key and value, first to last, when they
// own, then both buffers.
func (mut g Gen) emit_map_free(mut t typeck.Typed, typ types.Type) error {
    key := mut t.table.key_of(typ)?
    value := mut t.table.elem_of(typ)?
    mut free := make(list[uint8], c_allocator)
    append_free_name(mut t, typ, mut free)?
    unused := mut g.maybe_unused(free[:])?
    mut m := make(list[uint8], c_allocator)
    append_map_name(mut t, typ, mut m)?
    fmt.appendf(mut g.buf, "%sstatic void %s(const %s *m) {\n", unused, free[:], m[:])?
    ko := mut g.owned(mut t, key)?
    vo := mut g.owned(mut t, value)?
    if ko || vo {
        mut g.wb("    for (int64_t i = 0; i < m->used; i++) {\n        if (m->entries[i].live) {\n")?
        mut g.write_frees(mut t, "            ", key, []uint8("m->entries[i].key"))?
        mut g.write_frees(mut t, "            ", value, []uint8("m->entries[i].val"))?
        mut g.wb("        }\n    }\n")?
    }
    mut e := make(list[uint8], c_allocator)
    append_entry_name(mut t, typ, mut e)?
    fmt.appendf(mut g.buf, "    tack_list_free_(m->entries, m->cap, sizeof (%s), _Alignof (%s), m->alloc);\n", e[:], e[:])?
    mut g.wb("    tack_list_free_(m->slots, m->nslots, sizeof (int64_t), _Alignof (int64_t), m->alloc);\n}\n\n")?
    return noerror
}

// step_put is Go's putValue: the map's address, then the key, guarded,
// then the value, then the comma expression that holds the three in
// temporaries and calls the map type's put helper.
func (mut g Gen) step_put(mut t typeck.Typed, f MFrame, mut m Machine) error {
    cl := call_of(t.prog.trees[:], f.e)
    a0, mx, is_mut := first_arg(t, f.e)
    if !is_mut {
        // Go dereferences put's first argument as a mut argument; the
        // checker makes it one.
        return not_ported
    }
    typ := mut t.type_of(mx)
    if f.step == 0 {
        mut s := f
        s.pend = len(g.pending)
        mut m.again(s, 1)?
        mut m.push(r_mut_arg, a0, types.invalid, false)?
        return noerror
    }
    if f.step == 1 {
        mut m.again(f, 2)?
        mut m.push(r_expr, node_at(t.prog.trees[:], f.e.unit, cl.args, 1), mut t.table.key_of(typ)?, false)?
        return noerror
    }
    if f.step == 2 {
        key := mut m.take()
        args := call_args_of(t, f.e)?
        last := mut g.guard_last(mut t, args[:])?
        held := mut g.guard_hold(mut t, node_at(t.prog.trees[:], f.e.unit, cl.args, 1), 1, last, own key)?
        mut m.give(own held)?
        mut m.again(f, 3)?
        mut m.push(r_expr, node_at(t.prog.trees[:], f.e.unit, cl.args, 2), mut t.table.elem_of(typ)?, false)?
        return noerror
    }
    val := mut m.take()
    key := mut m.take()
    addr := mut m.take()
    p := mut g.temp("o")?
    k := mut g.temp("o")?
    v := mut g.temp("o")?
    mut mn := make(list[uint8], c_allocator)
    append_map_name(mut t, typ, mut mn)?
    mut g.add_temp_ptr_decl(mn[:], p[:])?
    kt := c_type_of(mut t, mut t.table.key_of(typ)?)?
    mut g.add_temp_decl(kt[:], k[:])?
    vt := c_type_of(mut t, mut t.table.elem_of(typ)?)?
    mut g.add_temp_decl(vt[:], v[:])?
    mut put_name := make(list[uint8], c_allocator)
    append_map_helper(mut t, "put", typ, mut put_name)?
    mut oom := make(list[uint8], c_allocator)
    g.append_list_error(1, out_of_memory, mut oom)?
    mut out := make(list[uint8], c_allocator)
    fmt.appendf(mut out, "(%s = %s, %s = %s, %s = %s, %s(%s, %s, %s) ? (tack_error){} : %s)", p[:], addr[:], k[:], key[:], v[:], val[:], put_name[:], p[:], k[:], v[:], oom[:])?
    mut g.guard_done(f.pend)
    mut m.give(own out)?
    return noerror
}

// call_args_of returns the arguments of the call k.
func call_args_of(t typeck.Typed, k typeck.Key) (list[typeck.Key], error) {
    cl := call_of(t.prog.trees[:], k)
    mut out := make(list[typeck.Key], c_allocator)
    n := node_count(t.prog.trees[:], k.unit, cl.args)
    for i := range n {
        append(mut out, node_at(t.prog.trees[:], k.unit, cl.args, i))?
    }
    return out, noerror
}

// step_lookup is Go's hasValue and poolHasValue, a call, and
// mapElementExpr, arenaIndexExpr and poolElementExpr, an index: the
// container, then the key, the handle or the index, then the helper
// called on the container's address, the two held in order when it
// shows.
func (mut g Gen) step_lookup(mut t typeck.Typed, f MFrame, mut m Machine) error {
    mut x := no_key()
    mut y := no_key()
    if f.r == r_has {
        args := call_args_of(t, f.e)?
        if len(args) == 2 {
            x = args[0]
            y = args[1]
        }
    } else {
        ix := index_of(t.prog.trees[:], f.e)
        x = at(f.e, ix.x)
        y = at(f.e, ix.index)
    }
    xt := mut t.type_of(x)
    mut on_pool := f.r == r_pool_index
    if f.r == r_has {
        on_pool = mut t.table.is_pool(xt)?
    }
    keyed := (f.r == r_has || f.r == r_map_index) && !on_pool
    if f.step == 0 {
        mut m.again(f, 1)?
        mut m.push(r_expr, x, types.invalid, false)?
        return noerror
    }
    if f.step == 1 {
        mut m.again(f, 2)?
        mut want := types.invalid
        if keyed {
            want = mut t.table.key_of(xt)?
        }
        mut m.push(r_expr, y, want, false)?
        return noerror
    }
    k := mut m.take()
    base := mut m.take()
    mut pb := make(list[uint8], c_allocator)
    fmt.appendf(mut pb, "(%s)", base[:])?
    mut rendered := make(list[list[uint8]], c_allocator)
    append(mut rendered, pb)?
    append(mut rendered, k)?
    mut helper := make(list[uint8], c_allocator)
    if f.r == r_has && !on_pool {
        append_map_helper(mut t, "has", xt, mut helper)?
    } else if f.r == r_map_index {
        append_map_helper(mut t, "at", xt, mut helper)?
    } else if on_pool && f.r == r_has {
        append_pool_helper(mut t, "find", xt, mut helper)?
    } else if on_pool {
        append_pool_helper(mut t, "at", xt, mut helper)?
    }
    operands := [2]typeck.Key{x, y}
    ctypes := operand_types(mut t, operands[:])?
    steps := mut g.sequence(mut t, operands[:], mut rendered, ctypes[:], false)?
    mut built := make(list[uint8], c_allocator)
    if len(rendered) == 2 {
        if f.r == r_has && !on_pool {
            fmt.appendf(mut built, "%s(&%s, %s)", helper[:], rendered[0][:], rendered[1][:])?
        } else if f.r == r_has {
            fmt.appendf(mut built, "(%s(&%s, %s) != 0)", helper[:], rendered[0][:], rendered[1][:])?
        } else if f.r == r_arena_index {
            is_sp := mut t.table.is_span(mut t.type_of(y))?
            if is_sp {
                append_arena_helper(mut t, "span", xt, mut helper)?
                fmt.appendf(mut built, "%s(&%s, %s)", helper[:], rendered[0][:], rendered[1][:])?
            } else {
                append_arena_helper(mut t, "at", xt, mut helper)?
                fmt.appendf(mut built, "(*%s(&%s, %s))", helper[:], rendered[0][:], rendered[1][:])?
            }
        } else {
            fmt.appendf(mut built, "(*%s(&%s, %s))", helper[:], rendered[0][:], rendered[1][:])?
        }
    }
    v := wrap_steps(steps[:], own built)?
    mut m.give(own v)?
    return noerror
}

// map_key_source returns the temporaries a lookup of key in the map mk
// holds, Go's mapKeySource: the map's address, a pointer to it, to a
// mutable map when is_mut; the key; and the slot it is in, or -1, found
// once.
func (mut g Gen) map_key_source(mut t typeck.Typed, mk typeck.Key, key typeck.Key, is_mut bool, kind uint8, k0 typeck.Key) (MultiSource, error) {
    steps, place := mut g.expr_steps(mut t, mk)?
    typ := mut t.type_of(mk)
    kt := mut t.table.key_of(typ)?
    kx := mut g.expr(mut t, key, kt)?
    mut find := make(list[uint8], c_allocator)
    append_map_helper(mut t, "find", typ, mut find)?
    mut hash := make(list[uint8], c_allocator)
    append_hash_name(mut t, kt, mut hash)?
    mut src := new_source(kind, k0)
    mut amp := make(list[uint8], c_allocator)
    append(mut amp, '&')?
    append(mut amp, place[:]...)?
    init := with_steps(steps[:], own amp)?
    mut mn := make(list[uint8], c_allocator)
    append_map_name(mut t, typ, mut mn)?
    mut mt := plain_temp(own mn, own init)
    mt.is_ref = !is_mut
    mt.is_mut = is_mut
    append(mut src.temps, mt)?
    kc := c_type_of(mut t, kt)?
    append(mut src.temps, plain_temp(own kc, own kx))?
    mut ft := from_temp([]uint8("int64_t"), from_map_find, find[:], []uint8(""))?
    ft.aux = hash
    append(mut src.temps, ft)?
    return src, noerror
}

// delete_values lowers v, ok := delete(mut m, k), the call k0, Go's
// deleteValues: map_key_source's temporaries, then the value, taken out
// only when the key is there, the value type's zero value otherwise.
func (mut g Gen) delete_values(mut t typeck.Typed, k0 typeck.Key) (MultiSource, error) {
    args := call_args_of(t, k0)?
    if len(args) != 2 {
        return new_source(0, k0), not_ported
    }
    _, mx, is_mut := first_arg(t, k0)
    if !is_mut {
        return new_source(0, k0), not_ported
    }
    mut src := mut g.map_key_source(mut t, mx, args[1], true, ms_delete, k0)?
    typ := mut t.type_of(mx)
    ct := mut t.call_type(k0)
    mut zero := make(list[uint8], c_allocator)
    mut g.append_zero_value(mut t, ct, mut zero)?
    mut take := make(list[uint8], c_allocator)
    append_map_helper(mut t, "take", typ, mut take)?
    c := c_type_of(mut t, ct)?
    append(mut src.temps, from_temp(c[:], from_map_take, take[:], zero[:])?)?
    return src, noerror
}

// drop_delete lowers delete(mut m, k) written as a statement, the call
// k0, Go's dropDelete: map_key_source's temporaries, then, only when the
// key is there, the value taken out and dropped.
func (mut g Gen) drop_delete(mut t typeck.Typed, k0 typeck.Key) (list[Line], error) {
    args := call_args_of(t, k0)?
    _, mx, is_mut := first_arg(t, k0)
    if !is_mut || len(args) != 2 {
        return make(list[Line], c_allocator), not_ported
    }
    src := mut g.map_key_source(mut t, mx, args[1], true, 0, k0)?
    mut lines := make(list[Line], c_allocator)
    names := mut g.hold_temps(src, mut lines)?
    typ := mut t.type_of(mx)
    mut n0 := make(list[uint8], c_allocator)
    copy_name(names[:], 0, mut n0)?
    mut n2 := make(list[uint8], c_allocator)
    copy_name(names[:], 2, mut n2)?
    mut take := make(list[uint8], c_allocator)
    append_map_helper(mut t, "take", typ, mut take)?
    fmt.appendf(mut take, "(%s, %s)", n0[:], n2[:])?
    body := mut g.drop_body(mut t, mut t.call_type(k0), take[:])?
    mut head := make(list[uint8], c_allocator)
    fmt.appendf(mut head, "if (%s >= 0) {", n2[:])?
    mut g.add_line(mut lines, head[:])?
    append_indented(mut lines, body[:])?
    mut g.add_line(mut lines, []uint8("}"))?
    return lines, noerror
}

// lookup_values lowers v, ok := m[k], the index k0, Go's lookupValues:
// map_key_source's temporaries, and the value read only when the key is
// there, the value type's zero value given otherwise.
func (mut g Gen) lookup_values(mut t typeck.Typed, k0 typeck.Key) (MultiSource, error) {
    ix := index_of(t.prog.trees[:], k0)
    mut src := mut g.map_key_source(mut t, at(k0, ix.x), at(k0, ix.index), false, ms_lookup, k0)?
    mut g.append_zero_value(mut t, mut t.type_of(k0), mut src.zero)?
    return src, noerror
}

// map_range lowers a range loop over a map, s, whose value is x and
// lowered body body, Go's mapRange: the map copied into a const
// temporary, its used entries walked in order, those not live skipped,
// its key and value bound, in place when they own.
func (mut g Gen) map_range(mut t typeck.Typed, s typeck.Key, x []uint8, body []Line) (list[Line], error) {
    lp := range_of(t.prog.trees[:], s)
    xt := mut t.type_of(at(s, lp.x))
    r := mut g.temp("r")?
    k := mut g.temp("k")?
    mut entry := make(list[uint8], c_allocator)
    fmt.appendf(mut entry, "%s.entries[%s]", r[:], k[:])?
    mut vars := make(list[Line], c_allocator)
    mut skip := make(list[uint8], c_allocator)
    fmt.appendf(mut skip, "if (!%s.live) {", entry[:])?
    mut g.add_line(mut vars, skip[:])?
    mut g.add_line(mut vars, []uint8("    continue;"))?
    mut g.add_line(mut vars, []uint8("}"))?
    if !ast.is_none(lp.var_node) {
        mut g.bind_entry(mut t, at(s, lp.var_node), entry[:], "key", mut vars)?
    }
    if !ast.is_none(lp.elem) {
        mut g.bind_entry(mut t, at(s, lp.elem), entry[:], "val", mut vars)?
    }
    append(mut vars, body...)?
    mut eval := make(list[uint8], c_allocator)
    append(mut eval, []uint8("const ")...)?
    append_map_name(mut t, xt, mut eval)?
    fmt.appendf(mut eval, " %s = %s;", r[:], x)?
    mut n := make(list[uint8], c_allocator)
    fmt.appendf(mut n, "%s.used", r[:])?
    lines := mut g.range_block(eval[:], []uint8("int64_t"), k[:], n[:], vars[:])?
    return lines, noerror
}

// bind_entry declares the variable v of a range over a map, bound to the
// member of entry, unless it is _: a pointer to it when it owns, a copy
// otherwise.
func (mut g Gen) bind_entry(mut t typeck.Typed, v typeck.Key, entry []uint8, member string, mut vars list[Line]) error {
    vr := var_at(t.prog.trees[:], v)
    if is_blank(t.prog.trees[:], v.unit, vr.name) {
        return noerror
    }
    typ := mut t.decl_type(v)
    owned := mut g.owned(mut t, typ)?
    mut l := make(list[uint8], c_allocator)
    append(mut l, []uint8("const ")...)?
    append_c_type(mut t, typ, mut l)?
    if owned {
        append(mut l, []uint8(" *const ")...)?
        append_decl_name(mut t, v, mut l)?
        fmt.appendf(mut l, " = &%s.%s;", entry, member)?
    } else {
        append(mut l, ' ')?
        append_decl_name(mut t, v, mut l)?
        fmt.appendf(mut l, " = %s.%s;", entry, member)?
    }
    mut g.add_line(mut vars, l[:])?
    return noerror
}
