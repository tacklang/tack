package codegen

import bytes from "std/bytes"
import text from "std/text"
import typeck from "tack/typeck"

// What no other function names, Go's unused.go, and gen.go's
// unusedParams, namesIdent and isIdentByte: a function, a global or a
// pooled string whose name no other function's lowered body holds is
// declared __attribute__((unused)), and a parameter a body never names is
// cast to void. Go records every identifier of every body; only names
// that start tack_ are ever asked about, the names of functions, globals,
// pooled strings and helpers, never a local's or a parameter's, so here
// only those are recorded, which answers every question the same.

// is_ident_byte reports whether b can be part of a C identifier, Go's
// isIdentByte.
func is_ident_byte(b uint8) bool {
    return b == '_' || b >= '0' && b <= '9' || b >= 'a' && b <= 'z' || b >= 'A' && b <= 'Z'
}

// names_ident reports whether line, a line of C, holds the identifier
// name whole, not as part of a longer one, Go's namesIdent.
func names_ident(line []uint8, name []uint8) bool {
    if len(name) == 0 {
        return false
    }
    mut i int64 = 0
    for i >= 0 && i <= len(line) {
        k := bytes.index(line[i:], name)
        if k < 0 {
            return false
        }
        start := i +% k
        end := start +% len(name)
        mut before_ok := start == 0
        if !before_ok {
            b, ok := line[start -% 1]
            before_ok = ok && !is_ident_byte(b)
        }
        mut after_ok := end == len(line)
        if !after_ok {
            b, ok := line[end]
            after_ok = ok && !is_ident_byte(b)
        }
        if before_ok && after_ok {
            return true
        }
        i = start +% 1
    }
    return false
}

// note_names records every identifier starting tack_ the lowered body of
// the function named owner holds as named by owner, Go's noteNames.
func (mut g Gen) note_names(owner []uint8, body []Line) error {
    ot := text.from_bytes(owner, c_allocator)?
    mut oi, known := g.owner_at[ot]
    if !known {
        oi = len(g.owners)
        o2 := text.from_bytes(owner, c_allocator)?
        put(mut g.owner_at, ot, oi)?
        append(mut g.owners, o2)?
    }
    for _, l := range body {
        mut i := l.start
        for i >= 0 && i < l.end {
            j := ident_end(g.text[:], i, l.end)
            if j == i {
                i +%= 1
                continue
            }
            id_text, interesting := tack_ident(g.text[:], i, j)?
            if interesting {
                n, seen := g.named[id_text]
                if !seen {
                    put(mut g.named, id_text, Named{first: oi, multi: false})?
                } else if !n.multi && n.first != oi {
                    put(mut g.named, id_text, Named{first: n.first, multi: true})?
                }
            }
            i = j
        }
    }
    return noerror
}

// ident_end returns where the identifier starting at i of held ends,
// before end, or i when no identifier starts there.
func ident_end(held []uint8, i int64, end int64) int64 {
    mut j := i
    for j >= 0 && j < end && j < len(held) {
        if !is_ident_byte(held[j]) {
            break
        }
        j +%= 1
    }
    return j
}

// tack_ident returns the identifier held[i:j] as a Text, and whether it
// is one that starts tack_, which note_names records.
func tack_ident(held []uint8, i int64, j int64) (text.Text, bool, error) {
    if i < 0 || i > j || j > len(held) || j -% i <= 5 || !bytes.has_prefix(held[i:j], []uint8("tack_")) {
        return text.new(c_allocator), false, noerror
    }
    s := text.from_bytes(held[i:j], c_allocator)?
    return s, true, noerror
}

// owner_is reports whether the i'th of owners is name.
func owner_is(owners []text.Text, i int64, name []uint8) bool {
    if i < 0 || i >= len(owners) {
        return false
    }
    return owners[i].equal(name)
}

// maybe_unused returns __attribute__((unused)) and a space for a function
// named name no other function's lowered body names, and empty for any
// other, Go's maybeUnused.
func (mut g Gen) maybe_unused(name []uint8) (string, error) {
    key := text.from_bytes(name, c_allocator)?
    n, seen := g.named[key]
    if !seen {
        return "__attribute__((unused)) ", noerror
    }
    if n.multi {
        return "", noerror
    }
    if owner_is(g.owners[:], n.first, name) {
        return "__attribute__((unused)) ", noerror
    }
    return "", noerror
}

// unused_params appends to out a statement casting each parameter of fn
// to void, in order, for each one body, fn's lowered body, never names,
// Go's unusedParams.
func (mut g Gen) unused_params(t typeck.Typed, fn typeck.Key, body []Line, mut out list[Line]) error {
    f := func_at(t.prog.trees[:], fn)
    n := node_count(t.prog.trees[:], fn.unit, f.params)
    for i := range n {
        p := node_at(t.prog.trees[:], fn.unit, f.params, i)
        mut name := make(list[uint8], c_allocator)
        append_param_decl_name(t, p, i, mut name)?
        mut used := false
        for _, l := range body {
            if names_ident(g.line_text(l), name[:]) {
                used = true
                break
            }
        }
        if !used {
            mut cast := make(list[uint8], c_allocator)
            append(mut cast, []uint8("(void)")...)?
            append(mut cast, name[:]...)?
            append(mut cast, ';')?
            mut g.add_line(mut out, cast[:])?
        }
    }
    return noerror
}
