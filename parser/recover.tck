package parser

import ast from "tack/ast"
import lexer from "tack/lexer"
import source from "tack/source"

// Error recovery, a port of Go's recover.go, whose comment at the top
// says how it works: a construct that hits a syntax error returns its
// error and stops where it is, and the package clause, each import, each
// top-level declaration, each statement of a block and each clause's
// header in a switch catch it, record it (see record), skip the damaged
// text (sync_decl, sync_stmt) and put a bad node in the tree where it
// was.

// record records f, the error of a construct that failed, unless it
// starts where one already recorded does (see recorded), or the parse
// has halted.
func (mut p Parser) record(f Fail) error {
    if !f.failed() || p.halted() || p.recorded(f) {
        return noerror
    }
    append(mut p.errs, f.n -% 1)?
    return put(mut p.err_at, p.fail_span(f).start, true)
}

// recorded reports whether an error starting where f starts has been
// recorded: a second one there follows from the first.
func (p Parser) recorded(f Fail) bool {
    _, ok := p.err_at[p.fail_span(f).start]
    return ok
}

// halted reports whether the parse stops: it has recorded more errors
// than its limit, or the program nests too deeply.
func (p Parser) halted() bool {
    return p.too_deep.failed() || p.max_errors > 0 && len(p.errs) > p.max_errors
}

// bad_decl records f, the error of the declaration that started at the
// token start, skips to the start of the next one (see sync_decl), and
// returns the bad declaration standing for the text skipped.
func (mut p Parser) bad_decl(start int64, f Fail) (id[ast.Node], error) {
    mut p.record(f)?
    mut p.unconsume_eof()
    mut p.rewind_to(start, f, true)
    mut p.sync_decl(start)
    mut p.import_names_in(start)?
    sp := p.skipped(start)
    name, method := mut p.decl_name(start)?
    n := mut p.add(ast.Kind.bad_decl(ast.BadDecl{name: name, method: method}), sp)?
    return n, noerror
}

// decl_name returns the name the declaration skipped from the token
// start to the parser's was declaring, when it got that far, and whether
// it is a method's: the name after func, after a method's receiver,
// after type, var or mut, or after import, past any pub, lib or extern
// before them and an extern's C name. It returns an empty name when the
// tokens skipped hold no such name.
func (mut p Parser) decl_name(start int64) (span[uint8], bool, error) {
    mut i := p.past_modifiers(start)
    if i >= p.index || p.tok(i).kind() != lexer.kind_keyword {
        return empty_str(), false, noerror
    }
    mut method := false
    kw := p.tok(i).keyword()
    if kw == lexer.keyword_func {
        i +%= 1
        if i < p.index && p.tok(i).kind() == lexer.kind_l_paren {
            i = p.past_parens(i)
            method = true
        }
    } else if kw == lexer.keyword_type || kw == lexer.keyword_var || kw == lexer.keyword_mut ||
        kw == lexer.keyword_import {
        i +%= 1
    } else {
        return empty_str(), false, noerror
    }
    if i >= p.index || p.tok(i).kind() != lexer.kind_ident {
        return empty_str(), false, noerror
    }
    name := mut p.tok_str(p.tok(i))?
    return name, method, noerror
}

// past_modifiers returns the index of the first token from start, below
// the parser's index, that is none of the words a declaration may start
// with before its keyword: pub, lib, and extern with its C name.
func (p Parser) past_modifiers(start int64) int64 {
    mut i := start
    for i < p.index && (is_keyword(p.tok(i), lexer.keyword_pub) || is_keyword(p.tok(i), lexer.keyword_lib)) {
        i +%= 1
    }
    if i < p.index && is_keyword(p.tok(i), lexer.keyword_extern) {
        i +%= 1
        if i < p.index && p.tok(i).kind() == lexer.kind_l_paren {
            i = p.past_parens(i)
        }
    }
    return i
}

// past_parens returns the index of the token after the parenthesis that
// closes the one at the token open, or the parser's index when it is not
// closed before it.
func (p Parser) past_parens(open int64) int64 {
    mut depth int64 = 0
    for mut i := open; i < p.index; i = i +% 1 {
        k := p.tok(i).kind()
        if k == lexer.kind_l_paren {
            depth +%= 1
        } else if k == lexer.kind_r_paren {
            depth -%= 1
            if depth == 0 {
                return i +% 1
            }
        }
    }
    return p.index
}

// bad_stmt records f, the error of the statement that started at the
// token start, skips to its end (see sync_stmt), and returns the bad
// statement standing for the text skipped, and whether the block holding
// it is broken. in_clause says the statement is in a case clause's body,
// which a case or a default also ends.
func (mut p Parser) bad_stmt(start int64, f Fail, in_clause bool) (id[ast.Node], bool, error) {
    mut p.record(f)?
    mut p.unconsume_eof()
    mut p.rewind_to(start, f, false)
    broken := mut p.sync_stmt(start, in_clause)
    n := mut p.add(ast.Kind.bad_stmt, p.skipped(start))?
    return n, broken, noerror
}

// import_names_in records as an import's name each name followed by from
// and a string among the tokens from the token start to the parser's:
// the damaged declaration skipped was an import, its keyword mistyped.
func (mut p Parser) import_names_in(start int64) error {
    for mut i := start; i +% 2 < p.index; i = i +% 1 {
        if p.tok(i).kind() == lexer.kind_ident && is_keyword(p.tok(i +% 1), lexer.keyword_from) &&
            p.tok(i +% 2).kind() == lexer.kind_str {
            mut p.add_import_token(p.tok(i))?
        }
    }
    return noerror
}

// rewind_to moves the parser back to the first token after the token
// start that starts the next construct, given the depth of braces opened
// since start, when the construct that failed with f consumed it and its
// error is at it: the start of the line of the next declaration, as
// decl_starts says when for_decl is set, for a declaration, and as
// at_decl_line(true) says otherwise, for a statement.
func (mut p Parser) rewind_to(start int64, f Fail, for_decl bool) {
    if !f.failed() {
        return
    }
    end := p.index
    mut depth int64 = 0
    first := p.fail_span(f).start
    for mut k := start +% 1; k < end && p.tok(k).offset_start() <= first; k = k +% 1 {
        depth = max0(depth +% brace_step(p.tok(k -% 1).kind()))
        p.index = k
        if p.tok(k).offset_start() == first && p.at_line_start() {
            mut starts := false
            if for_decl {
                starts = mut p.decl_starts(start, depth)
            } else {
                starts = mut p.at_decl_line(true)
            }
            if starts {
                return
            }
        }
    }
    p.index = end
}

// max0 returns v, or 0 when v is negative.
func max0(v int64) int64 {
    if v < 0 {
        return 0
    }
    return v
}

// brace_step returns how a token of kind k changes the depth of braces:
// up one for {, down one for }, and not at all for anything else.
func brace_step(k lexer.TokenKind) int64 {
    if k == lexer.kind_l_curl {
        return 1
    }
    if k == lexer.kind_r_curl {
        return -1
    }
    return 0
}

// unconsume_eof moves the parser back to the EOF token when the
// construct that failed consumed it, so every loop still finds the end of
// the file.
func (mut p Parser) unconsume_eof() {
    last := len(p.tokens) -% 1
    if p.index > last {
        p.index = last
    }
}

// skipped returns the span from the token start through the last token
// consumed since, or the empty span at start's token when none was.
func (p Parser) skipped(start int64) source.Span {
    first := p.tok(min_index(start, len(p.tokens) -% 1))
    if p.index <= start {
        return span_in(p.file, first.offset_start(), first.offset_start())
    }
    return span_in(p.file, first.offset_start(), p.last_end())
}

// min_index returns the smaller of a and b.
func min_index(a int64, b int64) int64 {
    if a < b {
        return a
    }
    return b
}

// brace_depth returns the depth of braces from the token start to the
// token before the parser's, counting each { in and each } out, and moves
// the parser back to a } that closes the block start is in, should the
// failed construct have consumed one (see closes_block).
func (mut p Parser) brace_depth(start int64) int64 {
    mut depth int64 = 0
    for mut i := start; i < p.index; i = i +% 1 {
        k := p.tok(i).kind()
        if k == lexer.kind_l_curl {
            depth +%= 1
        } else if k == lexer.kind_r_curl {
            if depth > 0 {
                depth -%= 1
            } else if mut p.closes_block(i) {
                p.index = i
                return 0
            }
        }
    }
    return depth
}

// closes_block reports whether the } at token i can close the block a
// damaged construct is in: the rest of its line is nothing, a semicolon,
// another }, or else, and it starts its line or closes a { opened earlier
// on it.
func (mut p Parser) closes_block(i int64) bool {
    if !p.ends_its_line(i) {
        return false
    }
    return p.tok(i).starts_line() || mut p.opens_on_line_before(i)
}

// ends_its_line reports whether what comes after the } at token i on its
// line is nothing, a semicolon, another }, or else.
func (p Parser) ends_its_line(i int64) bool {
    if i +% 1 >= len(p.tokens) {
        return true
    }
    next := p.tok(i +% 1)
    k := next.kind()
    return k == lexer.kind_eof || next.starts_line() || k == lexer.kind_r_curl || k == lexer.kind_semi ||
        is_keyword(next, lexer.keyword_else)
}

// opens_on_line_before reports whether a { that no } closes comes before
// the token i on its line. The last } found to have none before it is
// remembered, which keeps a line of thousands of them linear.
func (mut p Parser) opens_on_line_before(i int64) bool {
    mut depth int64 = 0
    for mut j := i -% 1; j >= 0; j = j -% 1 {
        if j == p.no_open_before -% 1 && p.no_open_before > 0 {
            break // none before the remembered one, and none since
        }
        k := p.tok(j).kind()
        if k == lexer.kind_r_curl {
            depth +%= 1
        } else if k == lexer.kind_l_curl {
            if depth == 0 {
                return true
            }
            depth -%= 1
        }
        if p.tok(j).starts_line() {
            break
        }
    }
    p.no_open_before = i
    return false
}

// inserted reports whether tk, a semicolon, was inserted at a line's end
// rather than written: an inserted one covers no bytes.
func inserted(tk lexer.Token) bool {
    return tk.offset_end() == tk.offset_start()
}

// sync_stmt skips the rest of the statement that started at the token
// start: through the semicolon that ends it at its own depth, or up to
// the closing brace of the block holding it, the start of a line that
// starts a declaration, a case or a default, for a statement of a case
// clause, or the end of the file. It returns whether the block holding
// the statement is broken (see Go's syncStmt).
func (mut p Parser) sync_stmt(start int64, in_clause bool) bool {
    if mut p.semi_in_parens(start) {
        return false
    }
    mut depth := mut p.brace_depth(start)
    for {
        stop, broken := mut p.stmt_ends(start, depth, in_clause)
        if stop {
            return broken
        }
        tk := mut p.next()
        depth = max0(depth +% brace_step(tk.kind()))
        if tk.kind() == lexer.kind_semi && depth == 0 && !mut p.stmt_goes_on(tk) {
            return false
        }
    }
}

// semi_in_parens reports whether the statement that started at the token
// start ends at a semicolon the failed construct consumed with a
// parenthesis or a bracket it opened still open, outside any brace, and
// then moves the parser to the token after it.
func (mut p Parser) semi_in_parens(start int64) bool {
    mut parens int64 = 0
    mut braces int64 = 0
    for mut i := start; i < p.index; i = i +% 1 {
        k := p.tok(i).kind()
        if k == lexer.kind_l_paren || k == lexer.kind_l_brack {
            parens +%= 1
        } else if k == lexer.kind_r_paren || k == lexer.kind_r_brack {
            parens = max0(parens -% 1)
        } else if k == lexer.kind_l_curl {
            braces +%= 1
        } else if k == lexer.kind_r_curl {
            if braces == 0 {
                return false
            }
            braces -%= 1
        } else if k == lexer.kind_semi {
            if parens > 0 && braces == 0 {
                p.index = i +% 1
                return true
            }
        }
    }
    return false
}

// stmt_goes_on reports whether the damaged statement being skipped goes
// on past semi, a semicolon at its own depth: an inserted one before a
// line that carries on the one before (see continues_line), or a written
// one before the rest of a line ending in an opening brace.
func (mut p Parser) stmt_goes_on(semi lexer.Token) bool {
    if inserted(semi) {
        return continues_line(p.peek().kind())
    }
    return mut p.last_on_line(p.index) == lexer.kind_l_curl
}

// continues_line reports whether a line that starts with a token of kind
// k carries on the line before it: k is an operator other than ! or an
// assignment's, the postfix ?, ) or ], or a comma, a period, a colon or
// an ellipsis.
func continues_line(k lexer.TokenKind) bool {
    n := k.number()
    if n >= lexer.kind_add.number() && n <= lexer.kind_shift_right_assign.number() ||
        n >= lexer.kind_equal.number() && n <= lexer.kind_greater_equal.number() {
        return true
    }
    return k == lexer.kind_logical_and || k == lexer.kind_logical_or || k == lexer.kind_inc ||
        k == lexer.kind_dec || k == lexer.kind_question || k == lexer.kind_r_paren ||
        k == lexer.kind_r_brack || k == lexer.kind_comma || k == lexer.kind_period ||
        k == lexer.kind_colon || k == lexer.kind_ellipsis
}

// stmt_ends reports whether the statement that started at the token
// start, being skipped with depth braces open, ends before the next
// token, and whether that leaves the block holding it broken.
func (mut p Parser) stmt_ends(start int64, depth int64, in_clause bool) (bool, bool) {
    tk := p.peek()
    if tk.kind() == lexer.kind_eof {
        return true, false
    }
    if depth > 0 {
        return p.index > start && mut p.at_block_break(), true
    }
    if tk.kind() == lexer.kind_r_curl {
        return mut p.closes_block(p.index), false
    }
    if in_clause && (is_keyword(tk, lexer.keyword_case) || is_keyword(tk, lexer.keyword_default)) {
        return p.index > start, false
    }
    return p.index > start && mut p.at_decl_line(true), false
}

// sync_decl skips the rest of the declaration that started at the token
// start, to the start of a line that starts the next one (see
// decl_starts), or the end of the file, or, for a function's body
// spilled where declarations go, to the closing brace that starts a line
// outside the braces skipped (see stmt_like).
func (mut p Parser) sync_decl(start int64) {
    mut depth := mut p.decl_depth(start)
    if p.index < start {
        p.index = start
    }
    spill := mut p.stmt_like(start)
    for p.peek().kind() != lexer.kind_eof && (p.index <= start || !mut p.decl_starts(start, depth)) {
        if spill && p.index > start && depth == 0 && p.at_brace_line() {
            return
        }
        tk := mut p.next()
        depth = max0(depth +% brace_step(tk.kind()))
    }
}

// decl_depth returns the depth of braces from the token start, where a
// damaged declaration starts, to the parser's token, as brace_depth
// does, but for a function's header line or a type's first line, which
// opens one brace, its body's or its struct's, when it ends in one, and
// none when it does not.
func (mut p Parser) decl_depth(start int64) int64 {
    if !mut p.func_header_at(start) && !p.type_at(start) {
        d := mut p.brace_depth(start)
        return d
    }
    next := p.next_line(start)
    mut depth := mut p.header_depth(start)
    if p.index <= next {
        // The failed header did not get past its own line, the rest of
        // which is skipped here, as its braces are counted.
        p.index = next
        return depth
    }
    for mut i := next; i < p.index; i = i +% 1 {
        depth = max0(depth +% brace_step(p.tok(i).kind()))
    }
    return depth
}

// func_header_at reports whether the damaged declaration that starts at
// the token start is a function's: it starts with func, or its line is
// shaped like a function's header and it may hold statements.
func (mut p Parser) func_header_at(start int64) bool {
    return p.has_body(start) || mut p.header_line_at(start) && !mut p.holds_no_stmts(start)
}

// header_depth returns how many braces the first line of the function or
// the type whose declaration starts at the token start opens: one, its
// body's, when it is shaped like a header or, for one that starts with
// func or type, ends in a brace, and none otherwise.
func (mut p Parser) header_depth(start int64) int64 {
    if mut p.header_line_at(start) ||
        (p.has_body(start) || p.type_at(start)) && mut p.last_on_line(start) == lexer.kind_l_curl {
        return 1
    }
    return 0
}

// type_at reports whether the declaration that starts at the token
// start, pub or lib aside, starts with type.
func (p Parser) type_at(start int64) bool {
    return is_keyword(p.decl_tok(start), lexer.keyword_type)
}

// decl_starts reports whether the next token starts the line a
// declaration does, with depth braces open since the damaged declaration
// that started at the token start.
func (mut p Parser) decl_starts(start int64, depth int64) bool {
    if !p.at_line_start() {
        return false
    }
    tk := p.peek()
    if is_keyword(tk, lexer.keyword_var) {
        return depth == 0 || mut p.holds_no_stmts(start)
    }
    if is_keyword(tk, lexer.keyword_mut) {
        return depth == 0 || mut p.holds_no_stmts(start) && !is_keyword(p.decl_tok(start), lexer.keyword_type)
    }
    return mut p.at_decl_line(depth > 0)
}

// at_block_break reports whether a block's statements stop before the
// next token without its closing brace: it starts a line with func, pub,
// lib, extern or import, which no statement starts with, or with type,
// when no brace closes the block before the next declaration's line.
func (mut p Parser) at_block_break() bool {
    if !mut p.at_decl_line(true) {
        return false
    }
    return !is_keyword(p.peek(), lexer.keyword_type) || p.unclosed_before()
}

// unclosed_before reports whether, from the next token, the start of a
// declaration's line, no closing brace that would close the block holding
// it comes before the next line that starts with a keyword only a
// declaration starts with, or the end of the file.
func (p Parser) unclosed_before() bool {
    mut depth int64 = 0
    for mut k int64 = 1; ; k = k +% 1 {
        tk := p.peek_at(k)
        if tk.kind() == lexer.kind_eof {
            return true
        }
        if tk.kind() == lexer.kind_l_curl {
            depth +%= 1
        } else if tk.kind() == lexer.kind_r_curl {
            if depth == 0 {
                return false
            }
            depth -%= 1
        } else if depth == 0 && tk.starts_line() && is_decl_keyword(tk) {
            return true
        }
    }
}

// parse_stmts parses the statements of a block into body, up to its
// closing brace, or the end of the file, or a line that starts a
// declaration (see at_block_break), or, when in_clause, a case or a
// default, recovering from each that fails (see bad_stmt), up to one
// that leaves the block broken. It stops when the parse halts.
func (mut p Parser) parse_stmts(mut body list[id[ast.Node]], in_clause bool) error {
    for !p.halted() && !mut p.at_block_break() && !p.at_stmts_end(in_clause) {
        if !in_clause && mut p.skip_stray_clause() {
            continue
        }
        start := p.index
        stmt, f := mut p.parse_stmt()?
        if !f.failed() {
            if is_nil(stmt) {
                break
            }
            append(mut body, stmt)?
            continue
        }
        bad, broken := mut p.bad_stmt(start, f, in_clause)?
        append(mut body, bad)?
        if broken {
            break
        }
    }
    return noerror
}

// at_stmts_end reports whether the next token ends a block's statements:
// its closing brace or the end of the file, or, in a case clause's body,
// the next case or default too, or a line that can only be a damaged
// clause header (see at_damaged_header).
func (p Parser) at_stmts_end(in_clause bool) bool {
    if in_clause {
        return p.at_clause_end() || p.at_damaged_header()
    }
    k := p.peek().kind()
    return k == lexer.kind_r_curl || k == lexer.kind_eof
}

// skip_stray_clause skips a case or a default clause's header, through
// its colon or the end of its line, that starts a line where a statement
// is expected, outside any switch, after an error in the same top-level
// declaration, and reports whether it did.
func (mut p Parser) skip_stray_clause() bool {
    tk := p.peek()
    if !p.stray_after_error() || !is_keyword(tk, lexer.keyword_case) && !is_keyword(tk, lexer.keyword_default) {
        return false
    }
    mut p.next()
    for {
        t := p.peek()
        if t.kind() == lexer.kind_eof || t.kind() == lexer.kind_r_curl || t.starts_line() {
            return true
        }
        if t.kind() == lexer.kind_colon {
            mut p.next()
            return true
        }
        mut p.next()
    }
}

// stray_after_error reports whether the next token starts a line and an
// error has been recorded since the top-level declaration being parsed,
// or the one just parsed, began.
func (p Parser) stray_after_error() bool {
    return p.at_line_start() && len(p.errs) > p.decl_errs
}
