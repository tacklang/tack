package main

import builtin from "tack/builtin"
import codegen from "tack/codegen"
import conv from "std/conv"
import fmt from "std/fmt"
import loader from "tack/loader"
import os from "std/os"
import path from "std/path"
import text from "std/text"
import typeck from "tack/typeck"

// The build: tack --out <path> <target>, Go's execute past the dump
// flags and its builder (tack/build.go). The --out path is checked
// before anything is compiled (check_out_path), the target compiled as
// --emit compiles it (see emit_target), and then, in a temporary
// directory, the C files of the program's packages compiled, the
// runtime's C files compiled and the objects among them the program
// needs picked, the definitions of its extern funcs checked (see
// link.tck), and the generated C linked with all those objects into
// the binary by clang (build).
//
// Every message is Go's, its os errors in Go's words (see
// loader.go_errno, and go_errno_text and append_go_signal for how clang
// ended); what the port cannot word as Go does is declined: an errno
// Go's words for are not known, a temporary directory or file that
// cannot be made or written, a clang that fails in a way Go's exec does
// not, an object the ELF reader does not take (see elf.tck), a
// temporary directory that cannot be removed, but after diagnostics
// (see report_removal), and a relative --out from a current directory
// that cannot be found, where Go's message is wrong (see build_in).
// clang writes to the driver's own outputs as it runs, as Go's does, so
// the warnings are written just before the first such clang starts (see
// run_tool): a decline decided before then writes nothing but its one
// line, and one after, its line after what Go writes before its own
// error, the warnings and clang's output; a file the build made at the
// --out path is removed either way.
//
// What differs from Go and cannot be seen in what a build writes: the
// temporary directory is std/os's make_temp_dir's, $TMPDIR/tk- and six
// letters and digits, where Go's os.MkdirTemp makes tk- and decimal
// digits; no message the port words names it, and porttest hides the
// characters after tk- of both in clang's notes, which name tack.h
// there when a C file of the program's does not compile. Every failure
// Go words with a path below it, a directory of the runtime that cannot
// be made, mkdir and its path, or a file that cannot be written, is
// declined. Its directories are made with mode 0755 and its files with
// 0644, std/os's, where Go's are 0750 and 0600, inside the directory
// make_temp_dir makes 0700, as Go's is. Ctrl-C does not stop clang and
// leaves the temporary directory behind, where Go cancels the build and
// removes it.

// build_target builds the target, the input at index k of a, the
// command line whose flags set fl, into the binary --out names, with the
// error limit max_errors, as Go's execute does: the --out path checked
// first (see check_out_path), then the target compiled and linked (see
// emit_target and build). It returns the exit status.
func build_target(a []text.Text, k int64, fl Flags, max_errors int64) (int32, error) {
    if k < 0 || k >= len(a) || fl.out_at < 0 || fl.out_at >= len(a) {
        // command found the input at k, and the --out flag set out_at,
        // so this does not happen.
        return unimplemented([]uint8("--out")), noerror
    }
    code, e := build_out(part_of(a[fl.out_at].bytes(), fl.out_from, a[fl.out_at].len()), a[k].bytes(), opt_of(fl), max_errors)
    return code, e
}

// build_out is build_target for out, the --out path, and target, the
// input, at the level opt.
func build_out(out []uint8, target []uint8, opt string, max_errors int64) (int32, error) {
    code := check_out_path(out, target)?
    if code != exit_ok {
        return code, noerror
    }
    code2, e := emit_target(target, Dump{n: 0}, max_errors, out, opt)
    return code2, e
}

// opt_of returns the optimization level the -O flags of fl ask for, one
// of codegen.opts, or codegen.default_opt when none is given, Go's optOf
// for a build; two of them are a usage error opt_usage has reported.
func opt_of(fl Flags) string {
    for k, on := range fl.opt {
        o, has := codegen.opts[k]
        if on && has {
            return o
        }
    }
    return codegen.default_opt
}

// part_of returns the view of b from i up to j, or an empty view when
// those are not bounds of b.
func part_of(b []uint8, i int64, j int64) []uint8 {
    if i < 0 || j < i || j > len(b) {
        return b[:0]
    }
    return b[i:j]
}

// check_out_path checks out, the --out path, against input, the target,
// before anything is compiled, as Go's checkOutPath does: a directory of
// out that cannot be looked at, cannot write --out, out and Go's stat
// error, or is not a directory, and an out that is a directory, are
// errors, exit status 1; an out that is the input file is a usage error,
// exit status 2, since linking would overwrite it. Any other failure to
// look at out or at input is left for the build to meet, as Go leaves
// it. It returns exit_ok when the build may go on, and otherwise the
// exit status of what it wrote, not implemented for an errno whose Go
// words are not known.
func check_out_path(out []uint8, input []uint8) (int32, error) {
    dir := path.dir(out, c_allocator)?
    info, err := os.stat(dir.bytes())
    if err.code != 0 {
        errno := loader.go_errno(err)
        if len(errno) == 0 {
            return unimplemented([]uint8("--out of a directory that cannot be looked at")), noerror
        }
        fmt.eprintf("tack: cannot write --out %s: stat %s: %s\n", out, dir.bytes(), errno)
        return exit_failure, noerror
    }
    if !info.is_dir() {
        fmt.eprintf("tack: cannot write --out %s: %s is not a directory\n", out, dir.bytes())
        return exit_failure, noerror
    }
    out_info, out_err := os.stat(out)
    if out_err.code != 0 {
        return exit_ok, noerror
    }
    if out_info.is_dir() {
        fmt.eprintf("tack: cannot write --out %s: it is a directory\n", out)
        return exit_failure, noerror
    }
    in_info, in_err := os.stat(input)
    if in_err.code == 0 && os.same_file(in_info, out_info) {
        mut msg := make(list[uint8], c_allocator)
        fmt.appendf(mut msg, "--out %s is the input file; linking would overwrite it", out)?
        return usage(msg), noerror
    }
    return exit_ok, noerror
}

// build builds t's program, whose generated C is c, into the binary out,
// at the level opt, as Go's builder.build does, warnings being what the
// stages before warned of, rendered, and max_errors the error limit of
// the diagnostics its definitions check gives: in a fresh temporary
// directory, which is removed on every path, it writes the runtime (see
// write_runtime) and c, as program.c, compiles the program's C files
// (see compile_c) and the runtime's it needs (see link_std), checks
// they define every extern func (see check_definitions) and runs
// clang's link of them all (see codegen.build_cmd), clang writing to
// the driver's own standard output and standard error as it runs. The
// warnings are written just before the first such clang starts, or,
// when none does, once the build has ended in one of Go's errors; Go
// writes them before its build begins, and nothing the port writes
// comes between. It returns the exit status: exit_ok or exit_failure,
// with the warnings, clang's output and, for a failure, Go's error,
// tack: and its text, or the diagnostics of the definitions check,
// written as Go writes them; or not implemented, with the line saying
// so written last, and the file clang's link made at out, if it started
// and nothing was at out before, removed. A decline decided before
// clang starts writes nothing else; one after comes after the warnings
// and clang's output, which are what Go writes before its own error.
// What was at out before the build is not restored: a decline after
// clang ran can leave a file clang overwrote, overwritten, and a
// symbolic link, dangling or not, with the file clang wrote through it
// at its target. A temporary directory that cannot be made or removed
// is declined: Go's messages for them name a path the port's does not
// make; but for one that cannot be removed after the definitions check
// gave diagnostics, where Go drops the removal's error, which the port
// reports (see report_removal). It fails only for want of memory,
// writing nothing, having tried to remove the directory first; the
// removal itself allocates, so a directory it could not remove for want
// of memory is left behind, and a binary clang wrote at out before
// memory ran out is left there, with exit status 1.
func build(mut t typeck.Typed, c []uint8, warnings []uint8, out []uint8, opt string, max_errors int64) (int32, error) {
    tmp, terr := os.make_temp_dir([]uint8("tk-"), c_allocator)
    if terr.code == 1 {
        return exit_failure, terr
    }
    if terr.code != 0 {
        return unimplemented([]uint8("--out with a temp directory that cannot be made")), noerror
    }
    mut st := Steps{warnings: make(list[uint8], c_allocator), msg: make(list[uint8], c_allocator), shown: false}
    append(mut st.warnings, warnings...)?
    mut made := text.new(c_allocator)
    mut rendered := make(list[uint8], c_allocator)
    code, e := build_in(mut t, tmp.bytes(), c, out, opt, max_errors, mut st, mut made, mut rendered)
    // Go's build makes its directory absolute before its deferred
    // RemoveAll runs, so its error names the absolute path; one that
    // cannot be made so is the build's decline already.
    mut root := text.from_bytes(tmp.bytes(), c_allocator)?
    abs_tmp, af := abs_path(tmp.bytes())?
    if !af.failed {
        root = abs_tmp
    }
    rm, re := remove_tree(root.bytes())
    if e.code != 0 {
        return exit_failure, e
    }
    if re.code != 0 {
        return exit_failure, re
    }
    mut outcome := code
    if rm.failed {
        if code == exit_failure && len(rendered) > 0 {
            reported := report_removal(mut st, rendered[:], rm)?
            if reported {
                return exit_failure, noerror
            }
        }
        outcome = not_implemented
        st.msg = make(list[uint8], c_allocator)
        append(mut st.msg, []uint8(" with a temp directory that cannot be removed")...)?
    }
    if outcome == not_implemented {
        if made.len() > 0 {
            remove_made(made.bytes())
        }
        if len(rendered) > 0 {
            // The diagnostics are what Go writes, its removal's error
            // dropped, so they come before the decline, after the
            // warnings.
            if !st.shown {
                fmt.ewrite(st.warnings[:])
            }
            fmt.ewrite(rendered[:])
        }
        mut what := make(list[uint8], c_allocator)
        append(mut what, []uint8("--out")...)?
        append(mut what, st.msg...)?
        return unimplemented(what), noerror
    }
    if !st.shown {
        fmt.ewrite(st.warnings[:])
    }
    if outcome != exit_ok {
        if len(rendered) > 0 {
            fmt.ewrite(rendered[:])
        } else {
            fmt.eprintf("tack: %s\n", st.msg[:])
        }
    }
    return outcome, noerror
}

// report_removal writes, for a build that ended in rendered, the
// diagnostics of its definitions check, and whose temporary directory
// rm says could not be removed, the warnings when they are not written
// yet, rendered, and then tack: failed to delete temp directory: and
// rm's error, as Go's RemoveAll would word it (see remove_tree), and
// reports whether it did; it writes nothing when rm is not worded (see
// Removal), which the caller declines. Go's build joins the
// removal's error to the diagnostics' and then reports only the
// diagnostics, dropping it, a bug the port does not copy (decided
// 2026-11-18, a known divergence). Where several entries could not be
// removed, the one named is the first in list_dir's sorted order, where
// Go's would be the first readdir gives. It fails only for want of
// memory.
func report_removal(mut st Steps, rendered []uint8, rm Removal) (bool, error) {
    words := os_errno_words(rm.err)
    if !rm.worded || len(words) == 0 {
        return false, noerror
    }
    if !st.shown {
        fmt.ewrite(st.warnings[:])
        st.shown = true
    }
    fmt.ewrite(rendered)
    mut line := make(list[uint8], c_allocator)
    fmt.appendf(mut line, "tack: failed to delete temp directory: %s %s: %s\n", rm.op, rm.path.bytes(), words)?
    fmt.ewrite(line[:])
    return true, noerror
}

// remove_made removes p, the --out path, absolute, which a build that is
// declined made, or a temporary file cache_write wrote: a file, or a
// symbolic link, never a directory, which clang does not make. One that
// cannot be removed is left; the decline is all that is said, so
// remove_made reports nothing.
func remove_made(p []uint8) {
    info, err := os.lstat(p)
    if err.code != 0 || info.is_dir() {
        return
    }
    rerr := os.remove_path(p)
    if rerr.code != 0 {
        return
    }
}

// build_in is build's work for t in dir, the temporary directory, as
// make_temp_dir gave it: it returns exit_ok; or exit_failure with Go's
// error in st's msg, or with the rendered diagnostics of the
// definitions check in rendered; or not_implemented with what the port
// cannot do in st's msg, after a space, for the not implemented line;
// with st's shown set once the warnings are written, just before the
// first clang that writes to the driver's outputs starts (see run_tool),
// and, in made, the absolute --out path when nothing was there before
// clang's link ran and it started, so that a build that is declined can
// remove what clang made. Go's build makes the directory and out
// absolute first, each as filepath.Abs does, failing with cannot find
// the temp directory or cannot find --out and the error. Go's
// filepath.Abs returns "" with its error, and build assigns it to dir
// and outBin before it words the message: its RemoveAll("") then
// removes nothing, leaving the directory, which the port removes, and
// its cannot find --out names an empty path, cannot find --out :, which
// the port declines rather than copy. Then, as Go's build does, it
// writes the runtime and program.c, compiles the program's C files and
// the runtime's it needs, checks the definitions, and links.
func build_in(mut t typeck.Typed, dir []uint8, c []uint8, out []uint8, opt string, max_errors int64, mut st Steps, mut made text.Text, mut rendered list[uint8]) (int32, error) {
    abs_dir, df := abs_path(dir)?
    if df.failed {
        if df.unworded {
            append(mut st.msg, []uint8(" in a current directory that cannot be found")...)?
            return not_implemented, noerror
        }
        fmt.appendf(mut st.msg, "cannot find the temp directory: %s", df.msg[:])?
        return exit_failure, noerror
    }
    abs_out, of := abs_path(out)?
    if of.failed {
        // Go's message names the empty path filepath.Abs returned, not
        // out: a bug the port does not copy.
        append(mut st.msg, []uint8(" in a current directory that cannot be found")...)?
        return not_implemented, noerror
    }
    include, rcode := write_runtime(abs_dir.bytes(), mut st.msg)?
    if rcode != exit_ok {
        return rcode, noerror
    }
    mut name := text.from_bytes([]uint8("program"), c_allocator)?
    mut name.append([]uint8(codegen.c_ext))?
    src := path.join(abs_dir.bytes(), name.bytes(), c_allocator)?
    wcode := write_temp(src.bytes(), c, mut st.msg)?
    if wcode != exit_ok {
        return wcode, noerror
    }
    mut objs := make(list[CObject], c_allocator)
    ccode := compile_c(mut t, abs_dir.bytes(), include.bytes(), opt, mut st, mut objs)?
    if ccode != exit_ok {
        return ccode, noerror
    }
    runtime := path.join(abs_dir.bytes(), []uint8("runtime"), c_allocator)?
    builtin_dir := path.join(runtime.bytes(), []uint8("builtin"), c_allocator)?
    mut std_objs := make(list[CObject], c_allocator)
    scode := link_std(mut t, abs_dir.bytes(), builtin_dir.bytes(), include.bytes(), opt, mut objs, mut st, mut std_objs)?
    if scode != exit_ok {
        return scode, noerror
    }
    for i := range len(std_objs) {
        append(mut objs, replace(mut std_objs[i], empty_object()))?
    }
    dcode := check_definitions(t, objs[:], max_errors, mut st, mut rendered)?
    if dcode != exit_ok {
        return dcode, noerror
    }
    mut paths := make(list[text.Text], c_allocator)
    for _, o := range objs {
        append(mut paths, text.from_bytes(o.obj.bytes(), c_allocator)?)?
    }
    argv := codegen.build_cmd(src.bytes(), include.bytes(), paths[:], abs_out.bytes(), []uint8(opt))?
    _, before := os.lstat(abs_out.bytes())
    // Made before clang runs, so that nothing after it needs memory to
    // say what to remove.
    candidate := text.from_bytes(abs_out.bytes(), c_allocator)?
    mut started := false
    code := run_tool(argv, []uint8(""), mut st, mut started)?
    if started && loader.is_enoent(before) {
        made = candidate
    }
    return code, noerror
}

// write_runtime writes the runtime built into the compiler below dir,
// the build's temporary directory, as Go's writeRuntime does: its
// header at runtime/include/tack/tack.h and its C files in
// runtime/builtin, each directory made as Go's os.MkdirAll makes it,
// and returns runtime/include, the directory every C file of the build
// is compiled against, with exit_ok; or, with an empty Text, exit_failure
// with Go's error in msg, cannot write the runtime and Go's mkdir error,
// or not_implemented, with what in msg, for a directory or file that
// cannot be made or written as Go words it.
func write_runtime(dir []uint8, mut msg list[uint8]) (text.Text, int32, error) {
    root := path.join(dir, []uint8("runtime"), c_allocator)?
    include := path.join(root.bytes(), []uint8("include"), c_allocator)?
    header := path.join(include.bytes(), []uint8(builtin.header_path), c_allocator)?
    mut rel := text.from_bytes([]uint8("runtime/include/"), c_allocator)?
    header_dir := path.dir([]uint8(builtin.header_path), c_allocator)?
    mut rel.append(header_dir.bytes())?
    code := make_below(dir, rel.bytes(), mut msg)?
    if code != exit_ok {
        return text.new(c_allocator), code, noerror
    }
    wcode := write_temp(header.bytes(), []uint8(builtin.runtime_header()), mut msg)?
    if wcode != exit_ok {
        return text.new(c_allocator), wcode, noerror
    }
    code2 := make_below(dir, []uint8("runtime/builtin"), mut msg)?
    if code2 != exit_ok {
        return text.new(c_allocator), code2, noerror
    }
    builtin_dir := path.join(root.bytes(), []uint8("builtin"), c_allocator)?
    for i := range builtin.runtime_count() {
        f, has := builtin.runtime_file(i)
        if !has {
            continue
        }
        p := path.join(builtin_dir.bytes(), []uint8(f.name), c_allocator)?
        fcode := write_temp(p.bytes(), []uint8(f.data), mut msg)?
        if fcode != exit_ok {
            return text.new(c_allocator), fcode, noerror
        }
    }
    return include, exit_ok, noerror
}

// make_below makes the directories of rel, a slash-separated path below
// dir, that are not there yet, each after the one above it, as Go's
// os.MkdirAll makes the directories of dir joined with rel when dir
// exists. A directory that cannot be made is not_implemented, with what
// in msg: Go's error names its path, below the temporary directory,
// whose name the port's does not share.
func make_below(dir []uint8, rel []uint8, mut msg list[uint8]) (int32, error) {
    mut at := text.from_bytes(dir, c_allocator)?
    mut start int64 = 0
    mut j int64 = 0
    for j <= len(rel) {
        c, has := rel[j]
        if has && c != '/' {
            j +%= 1
            continue
        }
        lo := start
        hi := j
        j +%= 1
        start = j
        if hi <= lo {
            continue
        }
        next := path.join(at.bytes(), part_of(rel, lo, hi), c_allocator)?
        at = next
        info, serr := os.stat(at.bytes())
        if serr.code == 0 && info.is_dir() {
            continue
        }
        err := os.make_dir(at.bytes())
        if err.code == 1 {
            return exit_failure, err
        }
        if err.code != 0 {
            // Go's error, cannot write the runtime: mkdir, the path and
            // the errno, names the temporary directory, whose name is
            // not Go's.
            append(mut msg, []uint8(" with a runtime directory that cannot be made")...)?
            return not_implemented, noerror
        }
    }
    return exit_ok, noerror
}

// write_temp writes data to the file at p, in the build's temporary
// directory, as Go's writeFile does, and returns exit_ok, or
// not_implemented, with what in msg, when it cannot: std/os's write_file
// opens, writes and closes in one call and does not say which failed,
// so the port cannot tell Go's open, write or close error apart.
func write_temp(p []uint8, data []uint8, mut msg list[uint8]) (int32, error) {
    err := os.write_file(p, data)
    if err.code == 1 {
        return exit_failure, err
    }
    if err.code != 0 {
        append(mut msg, []uint8(" with a temp file that cannot be written")...)?
        return not_implemented, noerror
    }
    return exit_ok, noerror
}

// run_tool runs argv, a toolchain command whose program is clang, as
// Go's runTool does: the program found on PATH as Go's exec.LookPath
// finds it (see find_clang), and then that path run, with std/os's
// run_inherit, given argv as it is, its argv[0] clang, as Go's exec.Cmd
// runs its Path with its Args, so that nothing looks clang up again.
// clang writes to the driver's own standard output and standard error,
// as Go's does, given os.Stdout and os.Stderr, so a terminal shows its
// colour and both streams arrive as it writes them; st's warnings, what
// the stages before warned of, are written just before it starts,
// unless they were already, and st's shown set. It returns exit_ok when
// clang exits 0, and otherwise exit_failure, with Go's error in st's
// msg: for file, a C file of the program's or the runtime's as messages
// name it, cannot compile, file and a colon first, then clang failed:
// and Go's words for how it ended (see append_status), or fork/exec,
// the path and Go's text for the errno when it could not be started; or
// Go's exec error for a clang not found or found relative to the
// current directory, before anything is written. A run that fails
// another way, /dev/null that cannot be opened or a wait that fails, is
// not_implemented, with what in st's msg: Go's exec does neither as the
// port does. started is set when clang was started, whatever it then
// did.
func run_tool(argv []text.Text, file []uint8, mut st Steps, mut started bool) (int32, error) {
    mut fail := make(list[uint8], c_allocator)
    if len(file) > 0 {
        fmt.appendf(mut fail, "cannot compile %s: ", file)?
    }
    append(mut fail, []uint8("clang failed: ")...)?
    mut found := text.new(c_allocator)
    mut why := make(list[uint8], c_allocator)
    fcode := find_clang(mut found, mut why)?
    if fcode != exit_ok {
        append(mut st.msg, fail[:]...)?
        append(mut st.msg, why[:]...)?
        return exit_failure, noerror
    }
    if !st.shown {
        fmt.ewrite(st.warnings[:])
        st.shown = true
    }
    status, err := os.run_inherit(found.bytes(), argv, c_allocator)
    // Only a child that ran and was waited for started: run_inherit's
    // other errors come before the child or instead of it, but for a
    // wait that failed once it had started, which it does not tell
    // apart, and is taken as not started.
    started = err.code == 0
    if err.code == 1 {
        return exit_failure, err
    }
    if err.code == 13 {
        errno := go_errno_text(err.msg)
        if len(errno) == 0 {
            append(mut st.msg, []uint8(" with a clang that cannot be started")...)?
            return not_implemented, noerror
        }
        append(mut st.msg, fail[:]...)?
        fmt.appendf(mut st.msg, "fork/exec %s: %s", found.bytes(), errno)?
        return exit_failure, noerror
    }
    if err.code != 0 {
        append(mut st.msg, []uint8(" with a clang that cannot be run")...)?
        return not_implemented, noerror
    }
    if status.exited() && status.exit_status() == 0 {
        return exit_ok, noerror
    }
    append(mut st.msg, fail[:]...)?
    append_status(mut st.msg, status)?
    return exit_failure, noerror
}

// find_clang looks for clang on $PATH as Go's exec.LookPath looks for
// it: each element of PATH in order, split at colons, an empty one
// meaning ., joined with clang and cleaned, a path that is not a file
// this process may run, as std/os's can_execute decides it as Go's
// findExecutable does, skipped. The first that is one is the clang
// found: it returns exit_ok, with its path in found, when that path is
// absolute, and otherwise exit_failure with Go's exec.ErrDot error,
// exec: "clang": cannot run executable found relative to current
// directory, in msg. When there is none, the error is Go's exec:
// "clang": executable file not found in $PATH, in msg, with
// exit_failure.
func find_clang(mut found text.Text, mut msg list[uint8]) (int32, error) {
    p, set := os.env([]uint8("PATH"), c_allocator)?
    if set && p.len() > 0 {
        mut start int64 = 0
        mut j int64 = 0
        for j <= p.len() {
            c, has := p.bytes()[j]
            if has && c != ':' {
                j +%= 1
                continue
            }
            lo := start
            hi := j
            j +%= 1
            start = j
            mut cand := text.new(c_allocator)
            if hi <= lo {
                cand = path.join([]uint8("."), []uint8("clang"), c_allocator)?
            } else {
                cand = path.join(part_of(p.bytes(), lo, hi), []uint8("clang"), c_allocator)?
            }
            if !os.can_execute(cand.bytes()) {
                continue
            }
            if !path.is_abs(cand.bytes()) {
                append(mut msg, []uint8("exec: ")...)?
                conv.append_quote(mut msg, []uint8("clang"))?
                append(mut msg, []uint8(": cannot run executable found relative to current directory")...)?
                return exit_failure, noerror
            }
            found = cand
            return exit_ok, noerror
        }
    }
    append(mut msg, []uint8("exec: ")...)?
    conv.append_quote(mut msg, []uint8("clang"))?
    append(mut msg, []uint8(": executable file not found in $PATH")...)?
    return exit_failure, noerror
}

// Removal is how remove_tree ended: failed when it could not remove
// everything, and then the first failure: worded when its errno is
// EACCES or EPERM, the failures the port words as Go's os.RemoveAll
// would, as a PathError: op, unlinkat or openfdat, the op Go's
// removeAllFrom names for that failure (see remove_tree); path, the
// entry's full path, as RemoveAll's error names it; and err, std/os's
// error for it. A failure of any other errno is not worded, which the
// caller declines: Go's RemoveAll, working relative to a descriptor of
// each directory, fails otherwise than the port's, by path, for one, or
// not at all, ENAMETOOLONG for a path past PATH_MAX among them.
type Removal struct {
    failed bool
    worded bool
    op string
    path text.Text
    err error
}

// removal_failed returns the Removal of a failure of op at p with err,
// worded when err is EACCES or EPERM. It fails only for want of memory.
func removal_failed(op string, p []uint8, err error) (Removal, error) {
    t := text.from_bytes(p, c_allocator)?
    return Removal{failed: true, worded: is_denied(err), op: op, path: t, err: err}, noerror
}

// no_removal returns the Removal of nothing that failed.
func no_removal() Removal {
    return Removal{failed: false, worded: false, op: "", path: text.new(c_allocator), err: noerror}
}

// is_denied reports whether err is std/os's error for EACCES or EPERM.
func is_denied(err error) bool {
    return is_errno(err, "Permission denied") || is_errno(err, "Operation not permitted")
}

// is_errno reports whether err is std/os's error for the errno whose
// message is msg.
func is_errno(err error, msg string) bool {
    return err.code == 3 && err.msg == msg
}

// RemoveFrame is one entry remove_tree is removing: its path, the index
// among the frames of the directory holding it, -1 for the root, and,
// for a directory, the first failure among what is below it, Go's
// recurseErr.
type RemoveFrame struct {
    path text.Text
    parent int64
    below Removal
}

// remove_tree removes root, absolute, and everything below it as Go's
// os.RemoveAll does on Linux, removeall_at.go's removeAllFrom, but with
// lists of its own where Go recurses, so a tree however deep needs no
// more stack, though every path it meets is kept until it ends, and
// with std/os's calls, by path, where Go's are relative to a descriptor
// of each directory. What it reports is worded only for EACCES and EPERM
// (see Removal), the failures below; each entry, looked at with lstat,
// so that a link is removed itself, never what it points to:
//
//   - that is not there, ENOENT, is no failure, as Go's IsNotExist is
//     none;
//   - that lstat cannot look at, the directory above it not searchable,
//     with EACCES or EPERM, fails as openfdat and the errno, as Go's
//     unlinkat and then its openDirAt fail;
//   - that is not a directory is removed, a failure, but for ENOENT,
//     unlinkat and the errno: Go's openDirAt of a file gives ENOTDIR,
//     which Go answers with its unlinkat's error; but for a symbolic
//     link, whose unlinkat fails with EACCES or EPERM, openfdat and the
//     errno, since Go's openDirAt of a link gives errSymlink, which Go
//     answers with openfdat and its unlinkat's error;
//   - that is a directory is listed, and each entry below it removed,
//     in list_dir's sorted order, the first failure among them kept,
//     Go's recurseErr; one that cannot be listed, but for ENOENT, which
//     is no failure, keeps openfdat and the errno, as Go's openDirAt
//     failing; then the directory itself is removed, which succeeds, or
//     fails with ENOENT, as no failure whatever was kept, and otherwise
//     fails as what was kept, or, with nothing kept, unlinkat and the
//     errno.
//
// A failure goes up to the directory above it, the first one kept
// there, and the root's is what remove_tree returns (see Removal). It is
// not Go's RemoveAll in four ways no build shows: between the lstat of
// a path and its listing or its removal, another process could put a
// link in its place, which a listing would then follow, where Go opens
// each directory with O_NOFOLLOW; root is the directory make_temp_dir
// made, mode 0700, so only a process of the same user can. Where several
// entries cannot be removed, the first kept is the first in list_dir's
// sorted order, where Go's is the first readdir gives. A directory that
// can be opened but not read fails as openfdat, where Go's readdirnames
// would fail as readdirnames, since list_dir does both. And Go first
// tries to remove root whole, and opens the directory above it, whose
// failure it reports as open: the port starts at root itself, which
// make_temp_dir made below a directory it could write to. It fails only
// for want of memory.
func remove_tree(root []uint8) (Removal, error) {
    mut frames := make(list[RemoveFrame], c_allocator)
    append(mut frames, RemoveFrame{path: text.from_bytes(root, c_allocator)?, parent: -1, below: no_removal()})?
    // work holds the frames still to be done, the next last: each a
    // frame's index and whether its entries are already removed, so that
    // only the directory itself is left.
    mut work := make(list[int64], c_allocator)
    mut finish := make(list[bool], c_allocator)
    append(mut work, 0)?
    append(mut finish, false)?
    mut result := no_removal()
    for len(work) > 0 {
        i, has := pop(mut work)
        fin, has_fin := pop(mut finish)
        if !has || !has_fin || i < 0 || i >= len(frames) {
            break
        }
        p := text.from_bytes(frames[i].path.bytes(), c_allocator)?
        mut r := no_removal()
        if fin {
            r = remove_dir_itself(p.bytes(), frames[i].below)?
        } else {
            info, lerr := os.lstat(p.bytes())
            if lerr.code == 1 {
                return result, lerr
            }
            if is_errno(lerr, "No such file or directory") {
                continue
            }
            if lerr.code != 0 {
                r = removal_failed("openfdat", p.bytes(), lerr)?
            } else if !info.is_dir() {
                rerr := os.remove_path(p.bytes())
                if rerr.code == 1 {
                    return result, rerr
                }
                if rerr.code != 0 && !is_errno(rerr, "No such file or directory") {
                    mut op := "unlinkat"
                    if is_denied(rerr) && is_link(p.bytes()) {
                        op = "openfdat"
                    }
                    r = removal_failed(op, p.bytes(), rerr)?
                }
            } else {
                names, derr := os.list_dir(p.bytes(), c_allocator)
                if derr.code == 1 {
                    return result, derr
                }
                if is_errno(derr, "No such file or directory") {
                    continue
                }
                if derr.code != 0 {
                    kept := removal_failed("openfdat", p.bytes(), derr)?
                    r = remove_dir_itself(p.bytes(), kept)?
                } else {
                    append(mut work, i)?
                    append(mut finish, true)?
                    // Pushed last first, so the first in sorted order is
                    // done first.
                    mut k := len(names) -% 1
                    for k >= 0 && k < len(names) {
                        q := path.join(p.bytes(), names[k].bytes(), c_allocator)?
                        k -%= 1
                        append(mut frames, RemoveFrame{path: q, parent: i, below: no_removal()})?
                        append(mut work, len(frames) -% 1)?
                        append(mut finish, false)?
                    }
                    continue
                }
            }
        }
        if !r.failed {
            continue
        }
        up := frames[i].parent
        if up < 0 || up >= len(frames) {
            result = r
            continue
        }
        if !frames[up].below.failed {
            frames[up].below = r
        }
    }
    return result, noerror
}

// remove_dir_itself removes the directory p, whose entries remove_tree
// has removed, or tried to, kept being the first failure among them, and
// returns how that ended, as Go's removeAllFrom ends: no failure when
// the directory is gone, or was not there; kept when it is not; and,
// with nothing kept, unlinkat and the errno of its removal. It fails
// only for want of memory.
func remove_dir_itself(p []uint8, kept Removal) (Removal, error) {
    rerr := os.remove_path(p)
    if rerr.code == 1 {
        return no_removal(), rerr
    }
    if rerr.code == 0 || is_errno(rerr, "No such file or directory") {
        return no_removal(), noerror
    }
    if kept.failed {
        k := removal_failed(kept.op, kept.path.bytes(), kept.err)?
        return k, noerror
    }
    r := removal_failed("unlinkat", p, rerr)?
    return r, noerror
}
