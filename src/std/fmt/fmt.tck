package fmt

// Package fmt writes text and bytes to standard output. A program imports
// it as
//
//     import fmt from "std/fmt"
//
// and the compiler reads it from $TACK_HOME/src/std/fmt, or
// ~/.tack/src/std/fmt, as it reads the builtins from std/builtin. println
// is written in Tack on top of the print builtin; printf's formatting is
// C, in printf.c, and write's output is C, in write.c, which the driver
// compiles and links with every program that imports fmt, as it does any
// package's C files. All three write through C's stdout, as print does,
// so their output interleaves in the order of the calls.

// println writes s to standard output exactly as given, then a newline,
// "\n". println("") writes the newline alone. Like print, it reports no
// error: what standard output does with the bytes is not checked.
pub func println(s string) {
    print(s)
    print("\n")
}

// printf writes format to standard output with each verb in it replaced
// by the next of args, formatted as the verb says, and every other byte
// as it is. A verb is % and the character after it:
//
//     %d  an integer of any type, in decimal, with - before a negative one
//     %x  an integer of any type, in lowercase hexadecimal with no 0x,
//         with - before a negative one: -1 is -1, as in Go, not ff
//     %s  a string, its bytes exactly
//     %t  a bool, true or false
//     %c  a uint8, the byte itself
//     %v  a value of any type above, as its own verb writes it: %d for an
//         integer, %s for a string, %t for a bool
//     %%  a %, taking no argument
//
// There are no widths, precisions or flags. An untyped constant argument
// is an int64, and a character literal a uint8.
//
// When the compiler knows format, a literal or an immutable variable
// holding one, it checks each verb against its argument, and every
// mistake is a compile error. Otherwise each mistake is written into the
// output where it happens, as Go's fmt writes it, never undefined:
//
//     %!d(string=hi)          a verb given a value it does not take, or
//                             a verb printf does not know: the verb,
//                             then the value's type and its %v
//     %!d(MISSING)            a verb with no argument left
//     %!(EXTRA int64=5, ...)  after the output, arguments no verb took
//     %!(NOVERB)              a % that ends the format
//
// Like print, it writes through C's stdout, so the output of the two
// interleaves in the order of the calls, and it reports no error.
pub func printf(format string, args ...any) {
    cprintf(format, args...)
}

// cprintf is printf's body, in C: tack_fmt_printf in printf.c.
extern("tack_fmt_printf") func cprintf(format string, args ...any)

// write writes the bytes of b to standard output exactly, each as it is,
// 0 and 0xff included, and nothing else: no newline, no formatting. A
// view of no bytes writes nothing. b is a view, so a list[uint8], an
// array or a slice of uint8, or a string's bytes, []uint8(s), can be
// passed. Like print and printf, it writes through C's stdout, so the
// output of the three interleaves in the order of the calls, and it
// reports no error.
pub func write(b []uint8) {
    cwrite(b)
}

// cwrite is write's body, in C: tack_fmt_write in write.c.
extern("tack_fmt_write") func cwrite(b []uint8)
