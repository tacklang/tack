package os

import bytes from "std/bytes"
import text from "std/text"

// Package os reaches the operating system: the program's arguments and
// environment, files and directories, and other programs, which run
// starts and waits for. A program imports it as
//
//     import os from "std/os"
//
// and the compiler reads it from $TACK_HOME/src/std/os, or
// ~/.tack/src/std/os, as it reads std/fmt. Its C, os.c, makes one POSIX
// call at a time and decides nothing; every loop, every retry and every
// allocation is here, in Tack.
//
// Paths and names are []uint8 views, passed to the OS as they are, with
// no cleaning or joining. A path or a name holding a 0 byte, which C
// would read as its end, is refused before the OS sees it, as error{code:
// 4, msg: "path contains a NUL byte"} or "name contains a NUL byte". Text
// the OS gives back, an argument, a variable's value, a directory's
// names, is a text.Text, and a file's bytes a list[uint8]; each function
// that returns one takes the Allocator it is made through, as scope, so it
// may be a region's, and no other does. run takes its output lists as
// mut beside its allocator, so a region's allocator goes to it only with
// lists of that region's block: given one with lists declared outside the
// block, the call is rejected, since the escape rule cannot tell that run
// keeps nothing from the region in them.
//
// Every byte from the OS lands in a list Tack owns, appended by C
// through the list's own allocator, so Tack frees it. When an allocation
// fails, the error is error{code: 1, msg: "out of memory"}, as for every
// std function, and code 1 means that and nothing else. When the OS
// refuses, the error is code 3 and the message the C library's strerror
// gives on macOS, the same on every target: error{code: 3, msg: "No such
// file or directory"}, for one, and error{code: 3, msg: "Cannot allocate
// memory"} for a kernel that cannot allocate memory for the call, ENOMEM,
// which is the OS's refusal, not the program's allocation. Every errno
// Linux defines has its message, glibc's for one macOS does not define,
// so none is "unknown OS error" on Linux. A program run cannot start is
// code 13 and the OS's message, error{code: 13, msg: "No such file or
// directory"} for one not on PATH. A function
// that fails returns an empty list or Text beside its error, and frees
// what it had made; nothing it returns is partial.
//
// Every file descriptor os opens it closes before it returns, on every
// path, and opens close-on-exec, so no child process inherits it, and
// every child run starts it waits for before it returns, so none is left
// a zombie.

// read_size is how many bytes read_file makes room for before each read,
// the most os.c reads at once.
var read_size int64 = 65536

// fd_range is the error for a file descriptor the OS gives that an int32
// cannot hold, which no POSIX open gives, since C's int is 32 bits on
// every target os builds for; it is there because the conversion's ok
// is checked, and a descriptor it reports could not be closed.
var fd_range = error{code: 2, msg: "internal error"}

// nul_path is the error for a path holding a 0 byte.
var nul_path = error{code: 4, msg: "path contains a NUL byte"}

// nul_arg is the error for an argument of run holding a 0 byte.
var nul_arg = error{code: 4, msg: "argument contains a NUL byte"}

// nul_prog is the error for a program run is given whose name holds a 0
// byte.
var nul_prog = error{code: 4, msg: "program contains a NUL byte"}

// nul_name is the error for an environment variable's name holding a 0
// byte.
var nul_name = error{code: 4, msg: "name contains a NUL byte"}

// c_open opens path, for reading when mode is 0, and for writing when it
// is 1, creating the file with mode 0644 or truncating it, close-on-exec
// either way, and returns the file descriptor, or the errno negated.
extern("tack_os_open") func c_open(path []uint8, mode int32) int64

// c_close closes fd and returns 0, or the errno negated.
extern("tack_os_close") func c_close(fd int32) int64

// c_read reads up to 65536 bytes from fd and appends them to l, and
// returns how many, 0 at the end of the file, or the errno negated, or
// -no_room when l cannot grow to hold them (see c_error).
extern("tack_os_read") func c_read(fd int32, mut l list[uint8]) int64

// c_write writes some of data to fd, with one write, and returns how many
// bytes, or the errno negated.
extern("tack_os_write") func c_write(fd int32, data []uint8) int64

// c_remove removes the file or empty directory at path, with C's remove,
// and returns 0, or the errno negated.
extern("tack_os_remove") func c_remove(path []uint8) int64

// c_make_dir makes the directory path with mode 0755 and returns 0, or
// the errno negated.
extern("tack_os_make_dir") func c_make_dir(path []uint8) int64

// c_rename renames the file or directory old_path to new_path, with C's
// rename, and returns 0, or the errno negated.
extern("tack_os_rename") func c_rename(old_path []uint8, new_path []uint8) int64

// c_stat fills info with what stat(2) reports of the file at path,
// following symbolic links, and returns 0, or the errno negated; on a
// failure info is left as it was.
extern("tack_os_stat") func c_stat(path []uint8, mut info Info) int64

// c_lstat is c_stat with lstat(2), which does not follow a symbolic link
// at the end of path.
extern("tack_os_lstat") func c_lstat(path []uint8, mut info Info) int64

// c_getwd appends the absolute path of the current directory to dir,
// through getcwd, and returns 0, or the errno negated: ERANGE for a path
// longer than the buffer getcwd is given, path_max bytes with its 0; or
// -no_room when dir cannot grow (see c_error).
extern("tack_os_getwd") func c_getwd(mut dir list[uint8]) int64

// c_list_dir appends the name of every entry of the directory path,
// each followed by a 0, to names, in the order the OS gives them, "."
// and ".." included, and returns 0, or the errno negated, or -no_room
// when names cannot grow (see c_error).
extern("tack_os_list_dir") func c_list_dir(path []uint8, mut names list[uint8]) int64

// c_make_temp_dir makes a new directory named by tmpl, a path ending in
// XXXXXX and a 0, through mkdtemp, which replaces the Xs, and returns 0,
// or the errno negated.
extern("tack_os_make_temp_dir") func c_make_temp_dir(mut tmpl list[uint8]) int64

// c_env appends the value of the environment variable name to value and
// returns 1, or returns 0 when it is not set, or the errno negated, or
// -no_room when value cannot grow (see c_error).
extern("tack_os_env") func c_env(name []uint8, mut value list[uint8]) int64

// c_argc returns how many arguments the program was given, its name
// included.
extern("tack_os_argc") func c_argc() int64

// c_arg appends argument i to arg and returns 0, or the errno negated,
// or -no_room when arg cannot grow (see c_error).
extern("tack_os_arg") func c_arg(i int64, mut arg list[uint8]) int64

// c_pipe makes a pipe, both its ends close-on-exec, puts its read end in
// fds[0] and its write end in fds[1], and returns 0, or the errno
// negated.
extern("tack_os_pipe") func c_pipe(mut fds [2]int32) int64

// c_spawn starts the program prog, through posix_spawnp, which looks it
// up on PATH when it holds no /, with the arguments flat holds: argc of
// them, each followed by a 0, argv[0] first, which need not name prog.
// The child reads in as its standard input, writes its standard output
// to out and its standard error to err, and starts with the
// process's environment and SIGPIPE's default action. It returns the
// child's process id; or the errno negated when setting the start up
// fails, before any program is looked for, -no_room for the C library's
// ENOMEM there, an allocation of its own that failed, and E2BIG for more
// than 8192 arguments; or c_spawn_failed() plus the errno, negated, when
// the program cannot be started: posix_spawnp's own failure, the
// program not found, not run, or no process made for it, and
// ENAMETOOLONG for a prog too long for a path.
extern("tack_os_spawn") func c_spawn(prog []uint8, flat []uint8, argc int64, in int32, out int32, err int32) int64

// c_spawn_failed returns the number c_spawn adds to an errno for a
// program that cannot be started, 1 << 21, above every errno and above
// os.c's no_room.
extern("tack_os_spawn_failed") func c_spawn_failed() int64

// c_flush_stdio flushes C's stdout, then its stderr, which print, exit
// and std/fmt write through, handing a failure to the runtime as
// std/fmt's flushes do: a broken pipe ends the process as exit(141)
// does, and any other failure loses the bytes.
extern("tack_os_flush_stdio") func c_flush_stdio()

// c_can_execute returns 1 when the file at path may be run, as
// can_execute says, and 0 otherwise.
extern("tack_os_can_execute") func c_can_execute(path []uint8) int64

// c_poll2 waits until a or b, each a descriptor or negative for none,
// can be read without blocking, its writer has closed it, or it has
// failed, and returns 1 when a can, 2 when b can, 3 when both can, or the
// errno negated.
extern("tack_os_poll2") func c_poll2(a int32, b int32) int64

// c_wait waits for the child pid to end and returns its exit status, 0
// to 255, or 256 plus the signal that killed it, or 512 plus the signal
// when it also dumped core, or the errno negated.
extern("tack_os_wait") func c_wait(pid int64) int64

// c_eintr returns EINTR, the errno of a call a signal interrupted.
extern("tack_os_eintr") func c_eintr() int64

// c_error returns the error for e, an errno or os.c's no_room, 1 << 20,
// which no errno is: out of memory, code 1, for no_room, a list that
// could not grow, and code 3 with strerror's message for an errno,
// ENOMEM's "Cannot allocate memory" among them. The C functions here
// fail with -errno or -no_room, which -%r turns back, and a result is
// compared with c_eintr() as -%n. Both are small positive numbers, so
// the negation never wraps; it is -% rather than - because C's contract,
// not a proof, is what bounds it.
extern("tack_os_error") func c_error(e int64) error

// has_nul reports whether s holds a 0 byte.
func has_nul(s []uint8) bool {
    return bytes.index_byte(s, 0) >= 0
}

// part returns the view of s from a up to b, or an empty view when those
// are not bounds of s.
func part(s []uint8, a int64, b int64) []uint8 {
    if a < 0 || b < a || b > len(s) {
        return s[:0]
    }
    return s[a:b]
}

// args returns the program's arguments, made through alloc: its name, as
// it was run, first, then each argument, an empty one included, in
// order. It fails only for want of memory, returning an empty list and
// freeing what it had made.
pub func args(scope alloc Allocator) (list[text.Text], error) {
    empty := make(list[text.Text], alloc)
    mut out := make(list[text.Text], alloc)
    for i := range c_argc() {
        mut b := make(list[uint8], alloc)
        r := c_arg(i, mut b)
        if r < 0 {
            return empty, c_error(-%r)
        }
        t, e := text.from_bytes(b, alloc)
        if e.code != 0 {
            return empty, e
        }
        e2 := append(mut out, t)
        if e2.code != 0 {
            return empty, e2
        }
    }
    return out, noerror
}

// env returns the value of the environment variable name, made through
// alloc, and true, or an empty Text and false when it is not set, which
// an empty name never is. A variable set to nothing is an empty Text and
// true. A name holding a 0 byte is error{code: 4, msg: "name contains a
// NUL byte"}; otherwise it fails only for want of memory. On an error the
// Text is empty and the bool false.
pub func env(name []uint8, scope alloc Allocator) (text.Text, bool, error) {
    if has_nul(name) {
        return text.new(alloc), false, nul_name
    }
    mut v := make(list[uint8], alloc)
    r := c_env(name, mut v)
    if r < 0 {
        return text.new(alloc), false, c_error(-%r)
    }
    if r == 0 {
        return text.new(alloc), false, noerror
    }
    t, e := text.from_bytes(v, alloc)
    if e.code != 0 {
        return text.new(alloc), false, e
    }
    return t, true, noerror
}

// read_file returns every byte of the file at path, in a list made
// through alloc. It reads until the end of the file, retrying a read a
// signal interrupted, and closes the file on every path. On an error,
// the OS's or out of memory, the list is empty and what had been read is
// freed. A directory is error{code: 3, msg: "Is a directory"}.
pub func read_file(path []uint8, scope alloc Allocator) (list[uint8], error) {
    empty := make(list[uint8], alloc)
    if has_nul(path) {
        return empty, nul_path
    }
    r := c_open(path, 0)
    if r < 0 {
        return empty, c_error(-%r)
    }
    fd, fits := int32(r)
    if !fits {
        return empty, fd_range
    }
    // A file opened for reading has nothing to flush, so a failed close
    // loses nothing that was read; its errno is not reported.
    defer {
        c_close(fd)
    }
    mut data := make(list[uint8], alloc)
    for {
        e := reserve(mut data, read_size)
        if e.code != 0 {
            return empty, e
        }
        n := c_read(fd, mut data)
        if n == 0 {
            return data, noerror
        }
        if n < 0 && -%n != c_eintr() {
            return empty, c_error(-%n)
        }
    }
}

// write_file writes data to the file at path, creating it with mode 0644
// when it does not exist and truncating it when it does, and returns no
// error. It writes until every byte is written, retrying a write a
// signal interrupted, and closes the file on every path; a failed close,
// which can mean the bytes did not reach the file, is an error. On an
// error the file may have been created or truncated, and hold some of
// data: nothing makes the write all or nothing. A pipe with no reader is
// error{code: 3, msg: "Broken pipe"}: the program ignores SIGPIPE, so the
// write fails rather than end the process.
pub func write_file(path []uint8, data []uint8) error {
    if has_nul(path) {
        return nul_path
    }
    r := c_open(path, 1)
    if r < 0 {
        return c_error(-%r)
    }
    fd, fits := int32(r)
    if !fits {
        return fd_range
    }
    mut at int64 = 0
    for at < len(data) {
        n := c_write(fd, part(data, at, len(data)))
        if n <= 0 && -%n != c_eintr() {
            c_close(fd)
            // A write of something that writes nothing has no errno; 0
            // is none, so it is "unknown OS error".
            return c_error(-%n)
        }
        if n > 0 {
            // C's write contract bounds n by the bytes it was given, what
            // is left of data, so at stays at most len(data) and never
            // wraps; +% is there because only that contract bounds it.
            at +%= n
        }
    }
    c := c_close(fd)
    if c < 0 {
        return c_error(-%c)
    }
    return noerror
}

// remove_path removes the file, or the empty directory, at path, and returns
// no error. A directory that is not empty is error{code: 3, msg:
// "Directory not empty"}, and a missing path error{code: 3, msg: "No
// such file or directory"}.
pub func remove_path(path []uint8) error {
    if has_nul(path) {
        return nul_path
    }
    r := c_remove(path)
    if r < 0 {
        return c_error(-%r)
    }
    return noerror
}

// make_dir makes the directory path, with mode 0755 before the umask, and
// returns no error. It makes no parent: a missing one is error{code: 3,
// msg: "No such file or directory"}, and a path that exists is
// error{code: 3, msg: "File exists"}.
pub func make_dir(path []uint8) error {
    if has_nul(path) {
        return nul_path
    }
    r := c_make_dir(path)
    if r < 0 {
        return c_error(-%r)
    }
    return noerror
}

// rename renames the file or directory at old_path to new_path, with
// rename(2), and returns no error. What is at new_path, a file when
// old_path is a file or an empty directory when it is a directory, is
// replaced, at once: there is no moment with nothing at new_path.
// Renaming a path onto itself changes nothing, and a symbolic link is
// renamed itself, not the file it points to. It moves nothing between
// file systems: two paths on different ones are error{code: 3, msg:
// "Cross-device link"}. A missing old_path, or a missing directory to
// rename into, is error{code: 3, msg: "No such file or directory"}, a
// directory onto a file error{code: 3, msg: "Not a directory"}, a file
// onto a directory error{code: 3, msg: "Is a directory"}, a directory
// into itself or a directory below it error{code: 3, msg: "Invalid
// argument"}, and a directory onto one that is not empty error{code: 3,
// msg: "Directory not empty"}, or "File exists" on some file systems. A
// 0 byte in either path is error{code: 4, msg: "path contains a NUL
// byte"}, and the OS sees neither path. On an error nothing has been
// renamed.
pub func rename(old_path []uint8, new_path []uint8) error {
    if has_nul(old_path) || has_nul(new_path) {
        return nul_path
    }
    r := c_rename(old_path, new_path)
    if r < 0 {
        return c_error(-%r)
    }
    return noerror
}

// Info is what stat reports of a file, read through its methods. Its
// fields are private, so no program outside os writes an Info literal,
// and fields added to it later break none that reads one. A program may
// still have a zero Info, from a declaration or make(os.Info, alloc):
// one with size 0 that is not a directory, and is the same file as no
// Info, itself included (see same_file).
pub type Info struct {
    // length is the file's size in bytes, as size returns it.
    length int64
    // directory is whether the file is a directory.
    directory bool
    // device and inode are the file's st_dev and st_ino, which together
    // name it on the machine, as same_file compares them.
    device uint64
    inode uint64
    // found is whether stat or lstat filled the Info in, which a zero
    // Info's is not.
    found bool
}

// size returns the file's length in bytes: for a regular file, how many
// its contents hold, holes of a sparse file included; for anything
// else, what the OS reports, which POSIX leaves unspecified.
pub func (i Info) size() int64 {
    return i.length
}

// is_dir reports whether the file is a directory.
pub func (i Info) is_dir() bool {
    return i.directory
}

// same_file reports whether a and b, each from stat or lstat, describe
// the same file: the same device and the same inode, as Go's
// os.SameFile compares them. Two paths reaching one file, by a symbolic
// link that stat follows or by a hard link, are the same file. A zero
// Info, which neither filled in, is the same file as none, not even
// another zero Info. What a and b say is what was true when each was
// made: a file removed since and another made may reuse the inode.
pub func same_file(a Info, b Info) bool {
    return a.found && b.found && a.device == b.device && a.inode == b.inode
}

// stat returns what the OS reports of the file at path, with stat(2),
// and no error. It follows symbolic links, so a link reports the file it
// points to, and a link to nothing is error{code: 3, msg: "No such file
// or directory"}, as a missing path is; a chain of links too long, or a
// loop of them, is error{code: 3, msg: "Too many levels of symbolic
// links"}, and a path through a file error{code: 3, msg: "Not a
// directory"}. On an error the Info's size is 0 and is_dir false.
pub func stat(path []uint8) (Info, error) {
    mut info Info
    if has_nul(path) {
        return info, nul_path
    }
    r := c_stat(path, mut info)
    if r < 0 {
        return info, c_error(-%r)
    }
    return info, noerror
}

// lstat is stat without following a symbolic link at the end of path,
// with lstat(2): a link reports itself, a file that is not a directory,
// whether what it points to exists or not, and a link to a directory is
// not one. Links before the last element of path are followed, as stat
// follows them, so a path through a missing directory is error{code: 3,
// msg: "No such file or directory"} and one through a file error{code:
// 3, msg: "Not a directory"}. On an error the Info is a zero Info.
pub func lstat(path []uint8) (Info, error) {
    mut info Info
    if has_nul(path) {
        return info, nul_path
    }
    r := c_lstat(path, mut info)
    if r < 0 {
        return info, c_error(-%r)
    }
    return info, noerror
}

// getwd returns the absolute path of the current directory, made
// through alloc, as getcwd(3) gives it: the directory's own path, with
// every symbolic link resolved, whatever path the process was started in
// through, and whatever $PWD says. A current directory that was removed
// is error{code: 3, msg: "No such file or directory"}, one an element
// of whose path cannot be read error{code: 3, msg: "Permission
// denied"}, and a path longer than 4095 bytes error{code: 3, msg:
// "Result too large"}, ERANGE's, even where the OS could give it. On an
// error the Text is empty and what had been made is freed.
pub func getwd(scope alloc Allocator) (text.Text, error) {
    mut dir := make(list[uint8], alloc)
    r := c_getwd(mut dir)
    if r < 0 {
        return text.new(alloc), c_error(-%r)
    }
    t, e := text.from_bytes(dir, alloc)
    if e.code != 0 {
        return text.new(alloc), e
    }
    return t, noerror
}

// is_dot reports whether name is "." or "..".
func is_dot(name []uint8) bool {
    return bytes.equal(name, []uint8(".")) || bytes.equal(name, []uint8(".."))
}

// less reports whether a sorts before b bytewise: at the first byte that
// differs, a's is smaller, or a ends first, being a prefix of b.
func less(a []uint8, b []uint8) bool {
    for i, x := range a {
        y, ok := b[i]
        if !ok {
            return false
        }
        if x != y {
            return x < y
        }
    }
    return len(a) < len(b)
}

// name_at returns the bytes of name k of names, which run from starts[k]
// up to ends[k] in buf, or an empty view for a k that is no name's.
func name_at(buf []uint8, starts []int64, ends []int64, k int64) []uint8 {
    a, ok := starts[k]
    b, ok2 := ends[k]
    if !ok || !ok2 {
        return buf[:0]
    }
    return part(buf, a, b)
}

// sort_names returns the indexes of the names in buf, which run from
// starts[k] up to ends[k] for each k, ordered by their bytes, through a
// merge sort, bottom up, which is stable and takes O(n log n)
// comparisons. It fails only for want of memory.
func sort_names(buf []uint8, starts []int64, ends []int64, scope alloc Allocator) (list[int64], error) {
    n := len(starts)
    mut src := make(list[int64], alloc)
    e0 := reserve(mut src, n)
    if e0.code != 0 {
        return src, e0
    }
    for i := range n {
        e := append(mut src, i)
        if e.code != 0 {
            return src, e
        }
    }
    // lo + width and mid + width may pass an int64 for an n past half of
    // one, and so may width * 2; each is then past n, which is what the
    // code after it does with a value past n: mid and hi stop at n, and
    // the doubling ends the loop.
    mut width int64 = 1
    for width < n {
        mut dst := make(list[int64], alloc)
        e1 := reserve(mut dst, n)
        if e1.code != 0 {
            return dst, e1
        }
        mut lo int64 = 0
        for lo < n {
            mut mid, fits := lo + width
            if !fits || mid > n {
                mid = n
            }
            mut hi, fits2 := mid + width
            if !fits2 || hi > n {
                hi = n
            }
            mut i := lo
            mut j := mid
            for i < mid || j < hi {
                // i < mid and j < hi are within src, so the run a name is
                // taken from always has it: the left only while i < mid,
                // when hasA, and the right only while j < hi, when hasB.
                a, hasA := src[i]
                b, hasB := src[j]
                // The left run's name goes first unless the right's sorts
                // strictly before it, which keeps equal names in order.
                left := j >= hi || i < mid && !less(name_at(buf, starts, ends, b), name_at(buf, starts, ends, a))
                // i steps only while below mid and j only while within
                // src, so neither passes n, and +% never wraps.
                if left && hasA {
                    e := append(mut dst, a)
                    if e.code != 0 {
                        return dst, e
                    }
                    i +%= 1
                } else if hasB {
                    e := append(mut dst, b)
                    if e.code != 0 {
                        return dst, e
                    }
                    j +%= 1
                } else {
                    break
                }
            }
            lo = hi
        }
        src = dst
        twice, fits := width * 2
        if !fits {
            break
        }
        width = twice
    }
    return src, noerror
}

// list_dir returns the name of every entry of the directory path, made
// through alloc, sorted bytewise, so the order does not depend on the
// OS, without "." and "..". On an error, the OS's or out of memory, the
// list is empty and what had been made is freed. A file is error{code:
// 3, msg: "Not a directory"}.
pub func list_dir(path []uint8, scope alloc Allocator) (list[text.Text], error) {
    empty := make(list[text.Text], alloc)
    if has_nul(path) {
        return empty, nul_path
    }
    mut buf := make(list[uint8], alloc)
    r := c_list_dir(path, mut buf)
    if r < 0 {
        return empty, c_error(-%r)
    }
    mut starts := make(list[int64], alloc)
    mut ends := make(list[int64], alloc)
    mut start int64 = 0
    for i, c := range buf {
        if c == 0 {
            if !is_dot(part(buf, start, i)) {
                e0 := append(mut starts, start)
                e1 := append(mut ends, i)
                if e0.code != 0 || e1.code != 0 {
                    return empty, error{code: 1, msg: "out of memory"}
                }
            }
            start = i + 1
        }
    }
    order, e2 := sort_names(buf, starts, ends, alloc)
    if e2.code != 0 {
        return empty, e2
    }
    mut names := make(list[text.Text], alloc)
    e3 := reserve(mut names, len(order))
    if e3.code != 0 {
        return empty, e3
    }
    for _, k := range order {
        t, e4 := text.from_bytes(name_at(buf, starts, ends, k), alloc)
        if e4.code != 0 {
            return empty, e4
        }
        e5 := append(mut names, t)
        if e5.code != 0 {
            return empty, e5
        }
    }
    return names, noerror
}

// append_temp_base appends to tmpl the directory make_temp_dir makes its
// directory in, dir, or /tmp when dir is empty, without the slashes dir
// ends in, unless it is all slashes.
func append_temp_base(mut tmpl list[uint8], dir []uint8) error {
    if len(dir) == 0 {
        return append(mut tmpl, []uint8("/tmp")...)
    }
    mut n := len(dir)
    for n > 1 {
        c, ok := dir[n - 1]
        if !ok || c != '/' {
            break
        }
        n--
    }
    return append(mut tmpl, part(dir, 0, n)...)
}

// make_temp_dir makes a new directory, with mode 0700, whose name no
// other has, in $TMPDIR, or in /tmp when TMPDIR is unset or empty, and
// returns its path, made through alloc: the directory, a /, prefix, and
// six characters mkdtemp picks, letters and digits on glibc. prefix may
// be empty. The caller removes it. A prefix holding a / is error{code:
// 4, msg: "prefix contains a slash"} and one holding a 0 byte
// error{code: 4, msg: "prefix contains a NUL byte"}, refused before the
// OS sees either; one too long for a name is error{code: 3, msg: "File
// name too long"}. On an error, the OS's or out of memory, the Text is
// empty and no directory is left behind.
pub func make_temp_dir(prefix []uint8, scope alloc Allocator) (text.Text, error) {
    if bytes.index_byte(prefix, '/') >= 0 {
        return text.new(alloc), error{code: 4, msg: "prefix contains a slash"}
    }
    if has_nul(prefix) {
        return text.new(alloc), error{code: 4, msg: "prefix contains a NUL byte"}
    }
    dir, set, e0 := env([]uint8("TMPDIR"), alloc)
    if e0.code != 0 {
        return text.new(alloc), e0
    }
    mut tmpl := make(list[uint8], alloc)
    mut e1 := noerror
    if set {
        e1 = append_temp_base(mut tmpl, dir.bytes())
    } else {
        e1 = append_temp_base(mut tmpl, []uint8(""))
    }
    if e1.code != 0 {
        return text.new(alloc), e1
    }
    e2 := append(mut tmpl, '/')
    if e2.code != 0 {
        return text.new(alloc), e2
    }
    e3 := append(mut tmpl, prefix...)
    if e3.code != 0 {
        return text.new(alloc), e3
    }
    e4 := append(mut tmpl, []uint8("XXXXXX\x00")...)
    if e4.code != 0 {
        return text.new(alloc), e4
    }
    r := c_make_temp_dir(mut tmpl)
    if r < 0 {
        return text.new(alloc), c_error(-%r)
    }
    t, e5 := text.from_bytes(part(tmpl, 0, len(tmpl) - 1), alloc)
    if e5.code != 0 {
        c_remove(part(tmpl, 0, len(tmpl) - 1))
        return text.new(alloc), e5
    }
    return t, noerror
}

// drain reads what fd has into l, once: when fd is at its end, it closes
// it and sets it to -1, so the next poll ignores it. A read a signal
// interrupted reads nothing and is no error; the next poll tries again.
func drain(mut fd int32, mut l list[uint8]) error {
    n := c_read(fd, mut l)
    if n == 0 {
        c_close(fd)
        fd = -1
        return noerror
    }
    if n < 0 && -%n != c_eintr() {
        return c_error(-%n)
    }
    return noerror
}

// wait_for waits for the child pid to end, retrying a wait a signal
// interrupted, and returns what c_wait does.
func wait_for(pid int64) int64 {
    for {
        s := c_wait(pid)
        if s >= 0 || -%s != c_eintr() {
            return s
        }
    }
}

// Status is how a child that run started ended, read through its
// methods: it exited, with an exit status from 0 to 255, or a signal
// killed it, which may have made it dump core. Its fields are private, as
// Info's are, so no program outside os writes a Status literal. A
// program may still have a zero Status, from a declaration or
// make(os.Status, alloc): a child that exited with status 0.
pub type Status struct {
    // code is the exit status, 0 to 255, when signo is 0, and -1 when it
    // is not.
    code int64
    // signo is the number of the signal that killed the child, or 0 when
    // it exited.
    signo int64
    // core is whether the child dumped core as the signal killed it.
    core bool
}

// exited reports whether the child exited, rather than being killed by
// a signal.
pub func (s Status) exited() bool {
    return s.signo == 0
}

// exit_status returns the status the child exited with, 0 to 255, or -1
// when a signal killed it, as Go's ProcessState.ExitCode does.
pub func (s Status) exit_status() int64 {
    return s.code
}

// signal returns the number of the signal that killed the child, as the
// OS numbers it, 9 for SIGKILL and 15 for SIGTERM, or 0 when it exited.
pub func (s Status) signal() int64 {
    return s.signo
}

// core_dumped reports whether the child dumped core as a signal killed
// it, which the OS's limits and core pattern decide; false when it
// exited.
pub func (s Status) core_dumped() bool {
    return s.core
}

// status_of returns the Status c_wait's result w, 0 or more, says: an
// exit status below 256, a signal's number plus 256, or plus 512 for a
// child that dumped core.
func status_of(w int64) Status {
    if w >= 512 {
        return Status{code: -1, signo: w - 512, core: true}
    }
    if w >= 256 {
        return Status{code: -1, signo: w - 256, core: false}
    }
    return Status{code: w, signo: 0, core: false}
}

// spawn_error returns the error for r, a negative result of c_spawn:
// code 13 and the OS's message for a program that could not be started,
// and c_error's error for a start that could not be set up.
func spawn_error(r int64) error {
    // r is an errno, no_room or c_spawn_failed() plus an errno, negated,
    // each far from the ends of an int64, so -% never wraps.
    n := -%r
    base := c_spawn_failed()
    if n >= base {
        e := c_error(n -% base)
        return error{code: 13, msg: e.msg}
    }
    return c_error(n)
}

// run runs prog and waits for it to end, and returns how it ended, a
// Status, and no error. prog is looked up on PATH when it holds no /,
// through posix_spawnp, and started as it is otherwise. argv, argv[0]
// included, is what the child is given as its arguments; argv[0] need
// not name prog, as with Go's exec.Cmd, whose Path and Args[0] differ.
// The child starts with this process's environment and SIGPIPE's
// default action, which this process ignores, reads /dev/null as its
// standard input, and writes its standard output and its standard error
// to pipes, which run reads at once, whichever has something, until both
// reach their ends, so neither can fill and block the child; it then
// appends all the child wrote to its standard output to out, and all it
// wrote to its standard error to err_out, after what each held. A child
// that exits with a status other than 0 is no error, and neither is one
// a signal kills: the Status says which, and what it wrote before it
// ended is appended as for any other. alloc makes run's own lists, the
// arguments as C takes them and the bytes read, all freed before run
// returns.
//
// On an error the Status cannot be read, and out and err_out are left
// as they were, their lengths and their bytes: what was read is appended
// only once everything has succeeded. Errors are:
//
//   - error{code: 4, msg: "argv is empty"};
//   - error{code: 4, msg: "program contains a NUL byte"};
//   - error{code: 4, msg: "argument contains a NUL byte"};
//   - code 13 and the OS's message, when the program cannot be started:
//     error{code: 13, msg: "No such file or directory"} for a program
//     not on PATH, a path that names nothing, an empty prog, or a script
//     whose interpreter is missing, "Permission denied" for a file no
//     one may run or a directory, "Exec format error" for a file the
//     kernel cannot run, which run tries no shell for, and "Cannot
//     allocate memory" when the kernel has no memory to start it;
//   - code 3 and the OS's message, when /dev/null cannot be opened, a
//     pipe cannot be made or the start cannot be set up, before any
//     program is looked for, or a
//     read, poll or wait fails once it has started;
//   - error{code: 1, msg: "out of memory"}, an allocation that failed,
//     the C library's own while setting the start up included. Room for
//     the bytes read is made in out first, then in err_out, so when only
//     err_out cannot grow, out's capacity may have grown, though its
//     length and bytes have not.
//
// Once the child has started, run waits for it on every path. After an
// error while reading, it first closes its ends of the pipes, so a child
// still writing gets EPIPE, or dies of SIGPIPE, and ends; it does not
// kill it, and a child that never ends keeps run waiting, as it would
// without the error. A process whose parent left SIGCHLD ignored can
// still wait for its children: the runtime sets SIGCHLD back to its
// default action at the start.
pub func run(prog []uint8, argv []text.Text, mut out list[uint8], mut err_out list[uint8], scope alloc Allocator) (Status, error) {
    mut none Status
    if len(argv) == 0 {
        return none, error{code: 4, msg: "argv is empty"}
    }
    if has_nul(prog) {
        return none, nul_prog
    }
    mut flat := make(list[uint8], alloc)
    for _, a := range argv {
        if has_nul(a.bytes()) {
            return none, nul_arg
        }
        e0 := append(mut flat, a.bytes()...)
        if e0.code != 0 {
            return none, e0
        }
        e1 := append(mut flat, 0)
        if e1.code != 0 {
            return none, e1
        }
    }
    // /dev/null is opened here, as Go's exec opens it, so that a failure
    // to open it is the OS's error, not the program's that could not be
    // started.
    rn := c_open([]uint8("/dev/null"), 0)
    if rn < 0 {
        return none, c_error(-%rn)
    }
    devnull, fits := int32(rn)
    if !fits {
        return none, fd_range
    }
    mut stdout_pipe [2]int32
    r0 := c_pipe(mut stdout_pipe)
    if r0 < 0 {
        c_close(devnull)
        return none, c_error(-%r0)
    }
    mut stderr_pipe [2]int32
    r1 := c_pipe(mut stderr_pipe)
    if r1 < 0 {
        c_close(devnull)
        c_close(stdout_pipe[0])
        c_close(stdout_pipe[1])
        return none, c_error(-%r1)
    }
    pid := c_spawn(prog, flat, len(argv), devnull, stdout_pipe[1], stderr_pipe[1])
    // The child has its own copies of /dev/null and the write ends, if it
    // started; run keeps none, so each read end reaches its end when the
    // child's copies close.
    c_close(devnull)
    c_close(stdout_pipe[1])
    c_close(stderr_pipe[1])
    mut a := stdout_pipe[0]
    mut b := stderr_pipe[0]
    if pid < 0 {
        c_close(a)
        c_close(b)
        return none, spawn_error(pid)
    }
    mut got_out := make(list[uint8], alloc)
    mut got_err := make(list[uint8], alloc)
    mut failure := noerror
    for a >= 0 || b >= 0 {
        m := c_poll2(a, b)
        if m < 0 {
            if -%m == c_eintr() {
                continue
            }
            failure = c_error(-%m)
            break
        }
        if m % 2 == 1 {
            failure = drain(mut a, mut got_out)
            if failure.code != 0 {
                break
            }
        }
        if m / 2 % 2 == 1 {
            failure = drain(mut b, mut got_err)
            if failure.code != 0 {
                break
            }
        }
    }
    if a >= 0 {
        c_close(a)
    }
    if b >= 0 {
        c_close(b)
    }
    w := wait_for(pid)
    if failure.code != 0 {
        return none, failure
    }
    if w < 0 {
        return none, c_error(-%w)
    }
    e2 := reserve(mut out, len(got_out))
    if e2.code != 0 {
        return none, e2
    }
    e3 := reserve(mut err_out, len(got_err))
    if e3.code != 0 {
        return none, e3
    }
    // Neither append can fail: each list has room for what it appends.
    e4 := append(mut out, got_out...)
    e5 := append(mut err_out, got_err...)
    if e4.code != 0 || e5.code != 0 {
        return none, error{code: 1, msg: "out of memory"}
    }
    return status_of(w), noerror
}

// run_inherit runs prog and waits for it to end, as run does, but the
// child writes its standard output and its standard error to this
// process's own, descriptors 1 and 2, as Go's exec does with cmd.Stdout
// = os.Stdout and cmd.Stderr = os.Stderr: nothing is read or kept, a
// terminal stays one to the child, and where both reach one place the
// child's writes to each arrive as it makes them. Before the child
// starts, run_inherit flushes what print, exit and std/fmt have written
// and C still holds, standard output first, so it comes before
// anything the child writes; a flush that fails ends the process with a
// broken pipe as std/fmt's do, and otherwise loses the bytes. prog,
// argv, the child's environment, its standard input, /dev/null, and the
// Status are run's. Its errors are run's but those of the pipes and the
// reads, which it has none of: code 4 for an empty argv or a 0 byte in
// prog or an argument; code 13 and the OS's message for a program that
// cannot be started; code 3 for /dev/null that cannot be opened, a
// start that cannot be set up, or a wait that fails; and code 1 for an
// allocation that failed. alloc makes run_inherit's one list, the
// arguments as C takes them, freed before it returns.
pub func run_inherit(prog []uint8, argv []text.Text, scope alloc Allocator) (Status, error) {
    mut none Status
    if len(argv) == 0 {
        return none, error{code: 4, msg: "argv is empty"}
    }
    if has_nul(prog) {
        return none, nul_prog
    }
    mut flat := make(list[uint8], alloc)
    for _, a := range argv {
        if has_nul(a.bytes()) {
            return none, nul_arg
        }
        e0 := append(mut flat, a.bytes()...)
        if e0.code != 0 {
            return none, e0
        }
        e1 := append(mut flat, 0)
        if e1.code != 0 {
            return none, e1
        }
    }
    rn := c_open([]uint8("/dev/null"), 0)
    if rn < 0 {
        return none, c_error(-%rn)
    }
    devnull, fits := int32(rn)
    if !fits {
        return none, fd_range
    }
    c_flush_stdio()
    pid := c_spawn(prog, flat, len(argv), devnull, 1, 2)
    c_close(devnull)
    if pid < 0 {
        return none, spawn_error(pid)
    }
    w := wait_for(pid)
    if w < 0 {
        return none, c_error(-%w)
    }
    return status_of(w), noerror
}

// can_execute reports whether the file at path is one this process may
// run, as Go's exec.LookPath decides for each file it looks at: path,
// following symbolic links, names a file that is not a directory, and
// faccessat(2), with AT_EACCESS, so by the effective user and group,
// lets it be run; where faccessat fails with ENOSYS or EPERM, as some
// containers' seccomp filters make it, whether any of the file's mode's
// execute bits is set. A path holding a 0 byte, a missing path, a
// symbolic link to nothing and one stat(2) cannot reach are none.
pub func can_execute(path []uint8) bool {
    if has_nul(path) {
        return false
    }
    return c_can_execute(path) == 1
}
