package utf8

// Package utf8 decodes and encodes UTF-8 as Go's unicode/utf8 package
// does. A program imports it as
//
//     import utf8 from "std/utf8"
//
// and the compiler reads it from $TACK_HOME/src/std/utf8, or
// ~/.tack/src/std/utf8, as it reads std/bytes. It is written in Tack
// alone, with no C, and allocates nothing but what append_rune appends.
//
// A rune is an int32, as in Go: a Unicode code point, 0 to 0x10FFFF, but
// for the surrogates, 0xD800 to 0xDFFF, which UTF-8 cannot encode. An
// int32 outside that, negative or past 0x10FFFF, is no rune.
//
// decode takes the first rune of a []uint8 view and its width in bytes,
// valid reports whether a whole view is UTF-8, and append_rune encodes a
// rune into a list. Each follows Go's function of the same role exactly,
// DecodeRune, Valid and AppendRune:
//
//   - A valid encoding is the shortest one of a rune: 1 byte for 0 to
//     0x7F, 2 for up to 0x7FF, 3 for up to 0xFFFF and 4 for up to
//     0x10FFFF. An overlong encoding, one of a surrogate, one past
//     0x10FFFF, a byte that starts no encoding (0x80 to 0xC1 and 0xF5 to
//     0xFF), and an encoding cut short by the end of the view or by a
//     byte that is not a continuation, are all invalid.
//   - decode gives 0xFFFD, U+FFFD REPLACEMENT CHARACTER, and width 1 for
//     invalid input, so a loop that steps by the width steps over one bad
//     byte at a time, and 0xFFFD and width 0 for an empty view. 0xFFFD
//     and width 3 is the character itself, written out, which is valid.
//   - append_rune encodes a value that is no rune, and a surrogate, as
//     0xFFFD.

// rune_error is U+FFFD, the rune decode gives for invalid input and
// append_rune encodes in place of a value that is no rune.
var rune_error int32 = 0xFFFD

// max_rune is the largest rune, U+10FFFF.
var max_rune int32 = 0x10FFFF

// continues reports whether c is a continuation byte between lo and hi:
// 0x80 to 0xBF, narrowed for the second byte of an encoding whose first
// byte allows only part of that range.
func continues(c uint8, lo uint8, hi uint8) bool {
    return c >= lo && c <= hi
}

// at returns byte i of s, or 0 when s has no byte i. 0 is no
// continuation byte, so an encoding cut short by the end of s is
// invalid as one cut short by any other byte that is not a continuation
// is, which is how Go treats both: 0xFFFD and width 1.
func at(s []uint8, i int64) uint8 {
    c, ok := s[i]
    if !ok {
        return 0
    }
    return c
}

// decode returns the first rune of s and the number of bytes its
// encoding takes, as Go's utf8.DecodeRune does: 0xFFFD and 1 when s does
// not start with a valid encoding, and 0xFFFD and 0 when s is empty.
//
// The first byte decides the length and the range the second byte must
// be in, as Go's first and acceptRanges tables do: the narrower ranges
// after 0xE0, 0xED, 0xF0 and 0xF4 are what rule out overlong encodings,
// the surrogates and values past 0x10FFFF.
pub func decode(s []uint8) (int32, int64) {
    if len(s) == 0 {
        return rune_error, 0
    }
    b0 := s[0]
    if b0 < 0x80 {
        return b0, 1
    }
    // 0x80 to 0xBF continue an encoding and start none, and 0xC0 and
    // 0xC1 would start only an overlong one, of a value below 0x80.
    if b0 < 0xC2 || b0 > 0xF4 {
        return rune_error, 1
    }
    b1 := at(s, 1)
    if b0 < 0xE0 {
        if !continues(b1, 0x80, 0xBF) {
            return rune_error, 1
        }
        return int32(b0 & 0x1F) << 6 | int32(b1 & 0x3F), 2
    }
    b2 := at(s, 2)
    if b0 < 0xF0 {
        mut lo uint8 = 0x80
        mut hi uint8 = 0xBF
        if b0 == 0xE0 {
            lo = 0xA0
        } else if b0 == 0xED {
            hi = 0x9F
        }
        if !continues(b1, lo, hi) || !continues(b2, 0x80, 0xBF) {
            return rune_error, 1
        }
        return int32(b0 & 0x0F) << 12 | int32(b1 & 0x3F) << 6 | int32(b2 & 0x3F), 3
    }
    b3 := at(s, 3)
    mut lo uint8 = 0x80
    mut hi uint8 = 0xBF
    if b0 == 0xF0 {
        lo = 0x90
    } else if b0 == 0xF4 {
        hi = 0x8F
    }
    if !continues(b1, lo, hi) || !continues(b2, 0x80, 0xBF) || !continues(b3, 0x80, 0xBF) {
        return rune_error, 1
    }
    return int32(b0 & 0x07) << 18 | int32(b1 & 0x3F) << 12 | int32(b2 & 0x3F) << 6 | int32(b3 & 0x3F), 4
}

// valid reports whether s is all valid UTF-8, as Go's utf8.Valid does:
// true for an empty s, and for U+FFFD written out, and false when any
// byte of s is not part of a valid encoding.
pub func valid(s []uint8) bool {
    // i only grows, by a width from 1 to 4 that decode found within
    // s[i:], so it stays from 0 to len(s), and i +% w never wraps; the
    // checker does not follow that through the loop, so its condition
    // tests i >= 0, which always holds, to prove s[i:].
    mut i int64 = 0
    for i >= 0 && i < len(s) {
        r, w := decode(s[i:])
        if r == rune_error && w == 1 {
            return false
        }
        i +%= w
    }
    return true
}

// append_rune appends the UTF-8 encoding of r to out, as Go's
// utf8.AppendRune does: 1 to 4 bytes, or the 3 of U+FFFD when r is a
// surrogate, negative or past 0x10FFFF. It returns no error, or, when
// out cannot grow, error{code: 1, msg: "out of memory"}, the builtin
// append's, and leaves out exactly as it was: the bytes are written into
// a local array first and added with one append.
pub func append_rune(mut out list[uint8], r int32) error {
    if r >= 0 && r < 0x80 {
        return append(mut out, uint8(r))
    }
    mut c := r
    if c < 0 || c > max_rune || c >= 0xD800 && c <= 0xDFFF {
        c = rune_error
    }
    // c is 0x80 to 0x10FFFF here, so every shifted, masked part below is
    // within a byte, and its conversion holds.
    mut buf [4]uint8
    if c <= 0x7FF {
        buf[0] = byte_of(0xC0 | c >> 6)
        buf[1] = byte_of(0x80 | c & 0x3F)
        return append(mut out, buf[:2]...)
    }
    if c <= 0xFFFF {
        buf[0] = byte_of(0xE0 | c >> 12)
        buf[1] = byte_of(0x80 | c >> 6 & 0x3F)
        buf[2] = byte_of(0x80 | c & 0x3F)
        return append(mut out, buf[:3]...)
    }
    buf[0] = byte_of(0xF0 | c >> 18)
    buf[1] = byte_of(0x80 | c >> 12 & 0x3F)
    buf[2] = byte_of(0x80 | c >> 6 & 0x3F)
    buf[3] = byte_of(0x80 | c & 0x3F)
    return append(mut out, buf...)
}

// byte_of returns the low byte of v. v & 0xFF is always 0 to 0xFF, so
// the conversion always holds, but a bitwise operator gives the checker
// no bound, so it is in the checked form, whose ok is always true.
func byte_of(v int32) uint8 {
    b, ok := uint8(v & 0xFF)
    if !ok {
        return 0
    }
    return b
}
