// Package builtin documents the types, values and functions Tack provides
// without a declaration or an import. The compiler implements every one of
// them itself; this file is built into the compiler and is never compiled
// as code. It exists so editors can show each builtin's documentation and
// go to its declaration. Changing a copy of it changes nothing.
//
// Some builtins take any list, map or type, which no Tack declaration can
// say exactly. Their declarations below use stand-in types, Elem, Key,
// Sized and ListType, declared at the end of this file for documentation
// only; no program can name them.
package builtin

// Types

// int64 is a signed 64-bit integer, from -9223372036854775808 to
// 9223372036854775807. An integer constant with nothing to give it a type
// is an int64.
type int64 int64

// int32 is a signed 32-bit integer, from -2147483648 to 2147483647.
type int32 int32

// int16 is a signed 16-bit integer, from -32768 to 32767.
type int16 int16

// int8 is a signed 8-bit integer, from -128 to 127.
type int8 int8

// uint64 is an unsigned 64-bit integer, from 0 to 18446744073709551615.
type uint64 uint64

// uint32 is an unsigned 32-bit integer, from 0 to 4294967295.
type uint32 uint32

// uint16 is an unsigned 16-bit integer, from 0 to 65535.
type uint16 uint16

// uint8 is an unsigned 8-bit integer, from 0 to 255: a byte.
type uint8 uint8

// unsafe_size_t is C's size_t: an unsigned integer as wide as the target
// makes it, from 32 to 64 bits. Its rules hold whatever its width is.
type unsafe_size_t unsafe_size_t

// unsafe_uintptr_t is C's uintptr_t: an unsigned integer wide enough to
// hold an address, from 32 to 64 bits, not necessarily as wide as
// unsafe_size_t.
type unsafe_uintptr_t unsafe_uintptr_t

// float64 is an IEEE 754 binary64 float, with + - * and / and the six
// comparisons. A float constant with nothing to give it a type is a
// float64. Dividing by zero gives an infinity, or NaN for 0.0 / 0.0, and
// NaN is equal to nothing, itself included. A float carries no facts,
// cannot index, and is not converted to or from an integer implicitly.
type float64 float64

// float32 is an IEEE 754 binary32 float, as float64 is a binary64 one.
type float32 float32

// bool is true or false.
type bool bool

// string is an immutable string of bytes. Its length is len(s), and s[i]
// is its byte i, a uint8.
type string string

// any refers to a value of one of the basic types, which one known only
// at run time. It can only be the type of a parameter, or the element
// type of a variadic or view parameter.
type any any

// error is a returned error: a code and a message, code 0 meaning no
// error, whatever the message. A function that can fail returns one as its
// last result, and the results beside it cannot be read until it is
// checked.
type error struct {
    code int32
    msg  string
}

// Allocator is an opaque handle on an allocator, which a list grows and is
// freed through. It is copyable, and has no zero value, no order and no ==.
type Allocator Allocator

// Values

// true is the bool that holds.
var true bool

// false is the bool that does not hold.
var false bool

// noerror is the error with code 0 and an empty message: no error.
var noerror error

// c_allocator is the Allocator that lowers to C's malloc, realloc and
// free, the one Allocator there is.
var c_allocator Allocator

// Functions

// print writes s to standard output exactly as given, adding no newline.
func print(s string)

// exit ends the process immediately with the given status. Pending defers
// do not run, in the calling function or any other, but before the
// process ends every allocator frees every buffer it still holds, so no
// list outlives the program. Only the low bits of the status reach the
// operating system, the low 8 on Linux and macOS, so exit(70000) ends with
// status 112.
func exit(code int32)

// len returns the number of elements of the array, view or list v, or the
// number of bytes of the string v. The length of an array, and of a string
// literal, is a constant; a view's or a list's is never known.
func len(v Sized) int64

// make returns an empty list of elements of type T, written make(list[T],
// alloc), which grows through alloc and is freed through it when its
// owner's block ends. It allocates nothing, so it cannot fail.
func make(t ListType, alloc Allocator) ListType

// append appends elems to the end of l, in order, growing its buffer
// through l's allocator when it has no room for them, and returns no
// error; or, when the allocator cannot grow it, or l's length would
// overflow an int64, returns error{code: 1, msg: "out of memory"} and
// leaves l as it was, all or nothing. It takes any number of values, none
// included, append(mut l, a, b, c), or a view spread whole, append(mut l,
// v...), never a view of l itself. Its error cannot be discarded.
func append[T Elem](mut l list[T], elems ...T) error

// reserve makes room in l for n more elements, so that its capacity is at
// least its length plus n, and returns no error; its length and elements
// never change, and n of 0 does nothing. A negative n returns
// error{code: 2, msg: "negative count"}, and one the allocator cannot make
// room for error{code: 1, msg: "out of memory"}, each leaving l as it was.
// Its error cannot be discarded.
func reserve[T Elem](mut l list[T], n int64) error

// pop moves the last element of l out of it and returns it, leaving l one
// element shorter; nothing is copied, allocated or freed. Its plain form,
// x := pop(mut l), needs len(l) > 0 proven where it is written. Its
// checked form, x, ok := pop(mut l), may be written anywhere: ok is false
// for an empty list, which is left as it was. Written as a statement,
// pop(mut l) discards the last element when there is one.
func pop[T Elem](mut l list[T]) T

// remove moves element i of l out of it and returns it, moving every
// element after it down one place, so the rest keep their order. Its plain
// form needs i proven in range for l; its checked form, x, ok :=
// remove(mut l, i), may be written anywhere, ok being false for an i out of
// range. Written as a statement it discards element i only when i is in range.
func remove[T Elem](mut l list[T], i int64) T

// swap swaps elements i and j of l in place; i equal to j leaves l as it
// was. It moves, copies and frees nothing, so it reorders lists of owned
// elements. Both indexes need proofs, as l[i] does, and a proof about
// len(l) holds across it.
func swap[T Elem](mut l list[T], i int64, j int64)

// replace moves the value of place out, as its result, and moves new into
// place, in one step, so the place never holds no value: old :=
// replace(mut s.items, make(list[T], alloc)) takes a list out of a field,
// which no move can do. place is anything a mut argument can be. Written
// as a statement, replace(mut place, new) is an assignment, which frees the
// old value.
func replace[T Elem](mut place T, new T) T

// put puts v under k in m: in place of the value k has, which it frees,
// keeping k's position in m's order; or at the end of the order when k is
// new. When the allocator cannot grow m it returns error{code: 1, msg:
// "out of memory"}, leaves m exactly as it was, and frees k and v. k and v
// are moved in. Its error cannot be discarded.
func put[K Key, V Elem](mut m map[K]V, k K, v V) error

// delete takes the value under k out of m, moving it, and frees the key m
// held: v, ok := delete(mut m, k) gives the value and true, or, when k is
// not in m, V's zero value and false. Written as a statement, delete(mut
// m, k) frees the value it takes.
func delete[K Key, V Elem](mut m map[K]V, k K) (V, bool)

// has reports whether k is in m. Tested as a condition it proves k is in m
// where the condition holds, so m[k] is then a place that can be read and
// assigned in place. The proof ends at any write to m that can reach the
// use.
func has[K Key, V Elem](m map[K]V, k K) bool

// drop frees x at once, exactly as the end of its block would, and leaves
// it moved from: a later use is a use after a move, until x is assigned a
// new value, and the end of its block frees nothing more. x is a local
// variable or an own parameter whose type owns something, written own x;
// a field or an element cannot be dropped, since it cannot be moved out
// of what holds it, and a value that owns nothing is an error, since there
// is nothing to free. In a generic function, drop(own t) of a type
// parameter's value is allowed, and drops nothing for a type argument
// that owns nothing. It is only a statement; it has no value.
func drop[T Elem](own x T)

// Stand-ins, for documentation only

// Elem stands for any type: a list's element, a map's value, a place.
type Elem interface {
}

// Key stands for any type a map key can have: one with ==.
type Key interface {
}

// Sized stands for any array, view or list, of any element type, or a
// string.
type Sized interface {
}

// ListType stands for a list type written where a value goes, as
// make(list[int64], c_allocator) does.
type ListType interface {
}
