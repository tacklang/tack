02 |	
03 |	type int struct {
   |	     ^~~
04 |	    while int64

extern-keyword-names/main.tck:4:5: error: field while of type int cannot be named while in C: it is a C keyword
03 |	type int struct {
04 |	    while int64
   |	    ^~~~~
05 |	    x int64

extern-keyword-names/main.tck:6:5: error: field char of type int cannot be named char in C: it is a C keyword
05 |	    x int64
06 |	    char bool
   |	    ^~~~
07 |	}

