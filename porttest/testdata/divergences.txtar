#define TACK_H

#include <stdbool.h>
#include <stdint.h>

typedef struct {
    int64_t x;
    int64_t y;
} geo_Point;

typedef struct {
    geo_Point min;
    geo_Point max;
} geo_Rect;

// package main
int64_t area(geo_Rect /* r */); // extern func area(r Rect) int64

#endif
