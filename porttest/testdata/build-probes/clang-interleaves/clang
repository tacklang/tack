#!/bin/sh
# A clang that writes a line to each stream in turn, twice, and exits 1,
# so that with both streams one pipe the order they arrive in shows
# whether the driver passes them on as clang writes them.
echo "fake clang: out 1"
echo "fake clang: err 1" >&2
echo "fake clang: out 2"
echo "fake clang: err 2" >&2
exit 1
