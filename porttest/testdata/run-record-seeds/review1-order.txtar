Order dependence.
-- a-emit/record --
selfcheck review: writes tack.h into the shared copy of examples/hello
dir examples/hello
invoke "--emit-header"
invoke "main.tck"
exit 0
file "tack.h" "// Generated by the Tack compiler. Do not edit.\n//\n// It declares every extern func of the program, for the C files that\n// define them, and the types their signatures use.\n\n#ifndef TACK_H\n#define TACK_H\n\n#include <stdbool.h>\n#include <stdint.h>\n\n#endif\n"
-- b-emit/record --
selfcheck review: the same run, with no file line
dir examples/hello
invoke "--emit-header"
invoke "main.tck"
exit 0
