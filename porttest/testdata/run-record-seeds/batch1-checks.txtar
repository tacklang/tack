-- a/record --
selfcheck a lacks line of each stream
dir examples/hello
stream fd3 capture
stream fd4 capture
lacks stdout "FAIL"
lacks stderr "error"
lacks fd3 "x"
lacks fd4 "\x00"
exit 0
stdout "Hello, World!\n"
stderr ""
-- b/record --
selfcheck lacks with a merged standard error
dir examples/hello
stream stderr merged
lacks stdout "FAIL"
lacks stderr "FAIL"
exit 0
stdout ""
-- c/record --
selfcheck count lines of each stream
dir examples/hello
stream fd3 capture
stream fd4 capture
count stdout 1 "Hello"
count stdout 0 "FAIL"
count stderr 0 "x"
count fd3 0 "x"
count fd4 999999999 "\x00"
exit 0
stdout "Hello, World!\n"
stderr ""
