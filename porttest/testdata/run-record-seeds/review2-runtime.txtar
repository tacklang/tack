-- r3-high-fds/fds.c --
#include <fcntl.h>
#include "tack.h"

int64_t high_open_fds(void) {
    int64_t bits = 0;
    for (int fd = 10; fd <= 40; fd++) {
        if (fcntl(fd, F_GETFD) != -1) {
            bits |= (int64_t)1 << (fd - 10);
        }
    }
    return bits;
}
-- r3-high-fds/main.tck --
package main

import fmt from "std/fmt"

extern("high_open_fds") func high() int64

// main prints which of descriptors 10 to 40 are open.
func main() {
    fmt.printf("open %d\n", high())
}
-- r3-high-fds/record --
selfcheck review
exit 0
stdout "open 0\n"
-- r4-argv0/main.tck --
package main

import fmt from "std/fmt"
import os from "std/os"

// main prints its argv[0].
func main() {
    args, e := os.args(c_allocator)
    if e.code != 0 {
        exit(1)
    }
    for i, a := range args {
        if i == 0 {
            fmt.printf("argv0 %s\n", a.bytes())
        }
    }
}
