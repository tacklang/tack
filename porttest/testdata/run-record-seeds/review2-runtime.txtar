-- r1-opt-one-level/lvl.c --
#include "tack.h"

int64_t lvl_optimized(void) {
#ifdef __OPTIMIZE__
    return 1;
#else
    return 0;
#endif
}
-- r1-opt-one-level/main.tck --
package main

extern("lvl_optimized") func optimized() int64

// main exits 1 when its C was optimized.
func main() {
    if optimized() != 0 {
        exit(1)
    }
}
