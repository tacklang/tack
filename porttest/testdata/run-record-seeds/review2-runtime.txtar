-- r5-writes-src/main.tck --
package main

import os from "std/os"

// main writes x to the file its first argument names.
func main() {
    args, e := os.args(c_allocator)
    if e.code != 0 {
        exit(1)
    }
    for i, a := range args {
        if i == 1 {
            e2 := os.write_file(a.bytes(), []uint8("x"))
            if e2.code != 0 {
                exit(2)
            }
        }
    }
}
-- r5-writes-src/record --
selfcheck review
arg "$SRC/stray.txt"
exit 0
-- r7-files/main.tck --
package main

import os from "std/os"

// main writes files whose bytes test file and file+ lines.
func main() {
    if os.write_file([]uint8("nonl.txt"), []uint8("a\nb")).code != 0 {
        exit(1)
    }
    if os.write_file([]uint8("empty.txt"), []uint8("")).code != 0 {
        exit(2)
    }
    if os.write_file([]uint8("hdr.txt"), []uint8("-- x/record --\n\n\n")).code != 0 {
        exit(3)
    }
    if os.write_file([]uint8("bin.txt"), []uint8("\x00\xff\r\n\"q\"")).code != 0 {
        exit(4)
    }
}
-- r7-files/record --
selfcheck review
exit 0
