-- zz-a-tmp-sibling/main.tck --
package main

import os from "std/os"

// main writes x to the file its first argument names.
func main() {
    args, e := os.args(c_allocator)
    if e.code != 0 {
        exit(1)
    }
    for i, a := range args {
        if i == 1 && os.write_file(a.bytes(), []uint8("x")).code != 0 {
            exit(2)
        }
    }
}
-- zz-a-tmp-sibling/record --
selfcheck probe: a file beside TMPDIR, a name joined to TMPDIR with no slash
arg "$TMPleft"
exit 0
stdout ""
stderr ""
