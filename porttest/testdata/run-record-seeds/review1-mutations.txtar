-- pwd/main.tck --
package main

import fmt from "std/fmt"
import os from "std/os"

func main() {
    v, set, e := os.env([]uint8("PWD"), c_allocator)
    if e.code != 0 {
        exit(1)
    }
    if set {
        fmt.printf("PWD %s\n", v.bytes())
    } else {
        fmt.printf("PWD unset\n")
    }
    s, set2, e2 := os.env([]uint8("SHLVL"), c_allocator)
    if e2.code != 0 {
        exit(1)
    }
    if set2 {
        fmt.printf("SHLVL %s\n", s.bytes())
    }
}
-- pwd/record --
selfcheck review: what the environment holds beyond PATH and TMPDIR
