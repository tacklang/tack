package main

// The unused pass counts a method as used when a call outside it calls
// it, x.m(), mut x.m() or T.m(x), and warns of one nothing calls, and of
// a used method's parameters nothing reads.

type S struct {
    x int64
}

func (s S) read(unread int64) int64 {
    return s.x
}

func (mut s S) bump() {
    s.x +%= 1
}

func (s S) through(k int64) int64 {
    return s.x +% k
}

func (s S) never() int64 {
    return s.x
}

func (s S) again(n int64) int64 {
    if n > 0 {
        return s.again(n -% 1)
    }
    return s.x
}

func main() {
    mut s := S{x: 1}
    mut s.bump()
    a := s.read(2)
    b := S.through(s, 3)
    if a +% b == 0 {
        print("zero")
    }
}
