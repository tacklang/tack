package main

import text from "std/text"

type Grower interface {
    mut grow(by int64)
    size() int64
}

type Box struct {
    n int64
    l list[int64]
}

func (mut b Box) grow(by int64) {
    b.n +%= by
}

func (b Box) size() int64 {
    return b.n +% len(b.l)
}

type Sh union {
    sq int64
    ci int64
    none
}

func (mut s Sh) grow(by int64) {
    mut nv := 0
    mut isq := false
    switch s {
    case sq(v):
        nv = v +% by
        isq = true
    case ci(v):
        nv = v +% by
    case none:
        return
    }
    if isq {
        s = Sh.sq(nv)
    } else {
        s = Sh.ci(nv)
    }
}

func (s Sh) size() int64 {
    switch s {
    case sq(v):
        return v
    case ci(v):
        return v *% 3
    case none:
        return 0
    }
}

func bump[S Grower](mut s S, n int64) int64 {
    for range n {
        mut s.grow(1)
    }
    return s.size()
}

func emit(mut w Grower, k int64) int64 {
    mut w.grow(k)
    return w.size()
}

type R struct {
    t text.Text
    l list[int64]
    p Box
    m map[text.Text]int64
    f float64
    b bool
    u uint8
    i8 int8
    u64 uint64
    f32 float32
}

func call(scope f func()) {
    f()
}

func calln(scope f func() int64) int64 {
    return f()
}

func size[T Data](v T) int64 {
    switch T {
    case int64:
        return v
    case text.Text:
        mut n := 0
        call(func() {
            n = v.len()
        })
        return n
    case list[E]:
        mut n := 0
        for _, e := range v {
            n +%= calln(func() int64 {
                return size(e)
            })
        }
        return n
    case map[text.Text]V:
        return len(v)
    case struct:
        mut n := 0
        for f := range fields(T) {
            call(func() {
                n +%= size(v.[f]) +% f.index
                call(func() {
                    n +%= len(f.name)
                })
            })
        }
        return n
    default:
        return 1
    }
}

func reset[T Data](mut v T) error {
    mut done := false
    call(func() {
        v = make(T, c_allocator)
        done = true
    })
    if !done {
        return error{code: 1, msg: "no"}
    }
    return noerror
}

func fresh(n int64) (list[int64], error) {
    mut l := make(list[int64], c_allocator)
    for i := range n {
        append(mut l, i)?
    }
    return l, noerror
}

func consume(own l list[int64]) int64 {
    return len(l)
}

func each(v []int64, scope f func(int64)) {
    for _, x := range v {
        f(x)
    }
}

func double(x int64) int64 {
    return x *% 2
}

func q(scope f func(int64) (int64, error), x int64) (int64, error) {
    defer {
        print("qd\n")
    }
    r := f(x)?
    return r, noerror
}

func run() error {
    mut b := Box{n: 1, l: make(list[int64], c_allocator)}
    pn(bump(mut b, 3))
    mut s := Sh.sq(2)
    pn(bump(mut s, 2))
    pn(emit(mut b, 5))
    pn(emit(mut s, 5))
    t := text.from_bytes([]uint8("hey"), c_allocator)?
    mut r := R{t: t, l: make(list[int64], c_allocator), p: b, m: make(map[text.Text]int64, c_allocator), f: 1.0, b: true, u: 2, i8: -1, u64: 3, f32: 2.0}
    append(mut r.l, 4)?
    pn(size(r))
    reset(mut r)?
    pn(size(r))
    fv := fresh
    l := fv(3)?
    c := consume
    pn(c(own l))
    mut tot := 0
    f := double
    arr := [3]int64{1, 2, 3}
    each(arr, func(x int64) {
        tot +%= f(x)
    })
    pn(tot)
    v := q(func(x int64) (int64, error) {
        defer {
            print("cd\n")
        }
        l2 := fresh(x)?
        return consume(own l2), noerror
    }, 4)?
    pn(v)
    return noerror
}

func main() {
    e := run()
    pn(e.code)
}

func digit(d int64) string {
    switch d {
    case 0:
        return "0"
    case 1:
        return "1"
    case 2:
        return "2"
    case 3:
        return "3"
    case 4:
        return "4"
    case 5:
        return "5"
    case 6:
        return "6"
    case 7:
        return "7"
    case 8:
        return "8"
    default:
        return "9"
    }
}

func pdigits(n int64) {
    if n >= 10 {
        pdigits(n / 10)
    }
    r, ok := n % 10
    if ok {
        print(digit(r))
    }
}

func pn(n int64) {
    if n < 0 {
        print("-")
        if n == -9223372036854775807 - 1 {
            print("9223372036854775808\n")
            return
        }
        pdigits(-%n)
    } else {
        pdigits(n)
    }
    print("\n")
}
