package main

// Builtins that only give a value, written as statements: has of a map
// and of a pool, len, and make of a basic type and of a struct that owns
// nothing. Each is reported as not used, and its value dropped; the key
// and handle arguments are calls, which still run, in order.

type Point struct {
    x int64
    y int64
}

func key(k int64) int64 {
    print("key\n")
    return k
}

func run() error {
    mut m := make(map[int64]int64, c_allocator)
    put(mut m, 1, 2)?
    has(m, key(1));
    has(m, key(5));
    len(m);
    mut p := make(pool[int64], c_allocator)
    h := insert(mut p, 3)?
    has(p, h);
    make(int64, c_allocator);
    make(Point, c_allocator);
    if has(m, 1) && has(p, h) {
        print("both\n")
    }
    return noerror
}

func main() {
    e := run()
    if e.code != 0 {
        exit(1)
    }
}
