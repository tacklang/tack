package main

import fmt from "std/fmt"

// The runs of each class, built as the input is read, and the file
// written from them.

// internal is the error of a step no input can reach, kept so that a
// mistake in this tool stops it rather than writing wrong tables.
var internal = error{code: 2, msg: "internal error"}

// Runs collects the runs of one class, in ascending order: pairs holds
// every run closed so far, each its first rune and its last, and, while
// open is true, first to last is the run still growing, which the next
// add may extend.
type Runs struct {
    pairs list[int32]
    open bool
    first int32
    last int32
}

// Tables holds the runs of each class std/unicode answers.
type Tables struct {
    print Runs
    graphic Runs
    letter Runs
    digit Runs
    space Runs
}

// new_runs returns a Runs with no runs.
func new_runs() Runs {
    return Runs{pairs: make(list[int32], c_allocator), open: false, first: 0, last: 0}
}

// new_tables returns Tables with no runs in any class.
func new_tables() Tables {
    return Tables{print: new_runs(), graphic: new_runs(), letter: new_runs(), digit: new_runs(), space: new_runs()}
}

// add adds the runes first to last, first no greater than last, to rs,
// extending the open run when first is the rune just after it, and
// returns no error. Every rune added must be above every rune added
// before, which the readers check of their input; an add out of order,
// or of a range that is no range of runes, is an internal error, and
// out of memory is append's error.
func (mut rs Runs) add(first int32, last int32) error {
    if first < 0 || last < first || last > max_rune {
        return internal
    }
    if rs.open {
        if first <= rs.last {
            return internal
        }
        // rs.last is below first, so below max_rune, and + 1 fits.
        if first == rs.last +% 1 {
            rs.last = last
            return noerror
        }
        append(mut rs.pairs, rs.first, rs.last)?
    }
    rs.open = true
    rs.first = first
    rs.last = last
    return noerror
}

// close closes rs's open run, if it has one, so that pairs holds every
// run, and returns no error, or append's out of memory.
func (mut rs Runs) close() error {
    if rs.open {
        append(mut rs.pairs, rs.first, rs.last)?
        rs.open = false
    }
    return noerror
}

// write_tables appends to out the whole of tables.tck: its header,
// naming the Unicode version, and then each class of t, in the order
// Go's internal/unicodegen wrote them, closing each class's open run
// first.
func write_tables(mut out list[uint8], version []uint8, mut t Tables) error {
    fmt.appendf(mut out, "package unicode\n\n// Code generated by tools/unicodegen from the Character Database of Unicode\n// %s. DO NOT EDIT; run make unicode-tables instead.\n", version)?
    mut t.print.close()?
    mut t.graphic.close()?
    mut t.letter.close()?
    mut t.digit.close()?
    mut t.space.close()?
    write_class(mut out, "print_runs", "unicode.IsPrint", "letters, marks, numbers, punctuation, symbols and U+0020", t.print.pairs)?
    write_class(mut out, "graphic_runs", "unicode.IsGraphic", "letters, marks, numbers, punctuation, symbols and spaces (Zs)", t.graphic.pairs)?
    write_class(mut out, "letter_runs", "unicode.IsLetter", "letters (L)", t.letter.pairs)?
    write_class(mut out, "digit_runs", "unicode.IsDigit", "decimal digits (Nd)", t.digit.pairs)?
    write_class(mut out, "space_runs", "unicode.IsSpace", "White_Space: \\t \\n \\v \\f \\r, U+0020, U+0085, U+00A0 and others", t.space.pairs)?
    return noerror
}

// write_class appends to out one class: its doc comment, naming the Go
// predicate go_name it is defined as and what it holds, then the array
// name of pairs, four runs a line, each rune as 0x and at least four
// uppercase hex digits.
func write_class(mut out list[uint8], name string, go_name string, what string, pairs []int32) error {
    // pairs holds two runes a run, so its length is even and halving it
    // cannot wrap.
    n := len(pairs) / 2
    fmt.appendf(mut out, "\n// %s holds the runes %s holds for:\n// %s.\n// Its %d runs are each a first rune and a last, in ascending order.\n", name, go_name, what, n)?
    fmt.appendf(mut out, "var %s = [%d]int32{\n", name, len(pairs))?
    for i, r := range pairs {
        // Eight runes, four runs, a line.
        if i % 8 == 0 {
            append(mut out, []uint8("   ")...)?
        }
        append(mut out, ' ')?
        append_rune_hex(mut out, r)?
        append(mut out, ',')?
        if i % 8 == 7 || i == len(pairs) -% 1 {
            append(mut out, '\n')?
        }
    }
    append(mut out, []uint8("}\n")...)?
    return noerror
}

// append_rune_hex appends r, a rune, to out as Go's %04X after 0x
// writes it: 0x and r's uppercase hex digits, at least four, with
// leading zeros to make up four, so 0x0009, 0x3000 and 0x10FFFF. A
// negative r, which no class holds, is an internal error.
func append_rune_hex(mut out list[uint8], r int32) error {
    if r < 0 {
        return internal
    }
    mut v := int64(r)
    mut digits := make(list[uint8], c_allocator)
    for len(digits) < 4 || v > 0 {
        d, ok := uint8(v % 16)
        if !ok {
            return internal
        }
        if d < 10 {
            append(mut digits, '0' +% d)?
        } else {
            append(mut digits, 'A' +% (d -% 10))?
        }
        v = v / 16
    }
    append(mut out, '0', 'x')?
    for len(digits) > 0 {
        c := pop(mut digits)
        append(mut out, c)?
    }
    return noerror
}
