package main

import bytes from "std/bytes"
import fmt from "std/fmt"
import os from "std/os"
import text from "std/text"

// Package main is embed, the tool that writes the Tack source of files
// the compiler carries inside it: the builtins' documentation and the C
// runtime with its header, which Go's compiler embeds with go:embed, a
// directive Tack has not got. It is run as
//
//     embed <out.tck> <package> <name>=<file> ... <group>[]=<file> ...
//
// and writes to out.tck a Tack source file of package package, marked as
// generated, with, for each name=file, a global
//
//     pub var <name> = "<the bytes of file>"
//
// and, for each group named with [] after it, two arrays, in the order
// the group's files are given:
//
//     pub var <group>_names = [n]string{"<base name of each file>", ...}
//     pub var <group>_data = [n]string{"<the bytes of each file>", ...}
//
// Each string literal holds the file's bytes exactly, escaped as the
// lexer decodes them: a printable ASCII byte as itself, but for the
// quote and the backslash, which are escaped, a newline, a tab and a
// carriage return as \n, \t and \r, and every other byte as \x and two
// lowercase hex digits. A literal holds a whole file on one line, which
// the lexer takes at any length. The header comment names each file by
// its base name, so where the files are read from does not change what
// is written, and a rerun with the same files writes the same bytes,
// which tackc's porttest checks.
//
// A mistake on the command line, a file that cannot be read or the
// output that cannot be written is reported on standard error, with
// exit status 1, and 2 for a command line of the wrong shape.

// Item is one name=file argument: the global's name, whether it is a
// group's, and the file.
type Item struct {
    name text.Text
    group bool
    file text.Text
}

// main runs the tool and exits with the status run gives.
func main() {
    a, err := os.args(c_allocator)
    if err.code != 0 {
        fmt.eprintf("embed: %s\n", err.msg)
        exit(1)
    }
    code, e := run(a)
    if e.code != 0 {
        fmt.eprintf("embed: %s\n", e.msg)
        exit(1)
    }
    exit(code)
}

// run does main's work for the arguments a, the program's name first,
// and returns the exit status, or an error that stopped it.
func run(a []text.Text) (int32, error) {
    if len(a) < 4 {
        fmt.eprintf("usage: embed <out.tck> <package> <name>=<file> ... <group>[]=<file> ...\n")
        return 2, noerror
    }
    mut items := make(list[Item], c_allocator)
    for i, arg := range a {
        if i < 3 {
            continue
        }
        it, ok := parse_item(arg.bytes())?
        if !ok {
            fmt.eprintf("embed: %s is not <name>=<file> or <group>[]=<file>\n", arg.bytes())
            return 2, noerror
        }
        append(mut items, it)?
    }
    mut out := make(list[uint8], c_allocator)
    for i, arg := range a {
        if i == 2 {
            fmt.appendf(mut out, "package %s\n\n", arg.bytes())?
        }
    }
    append(mut out, []uint8("// Code generated by tools/embed; DO NOT EDIT. It holds the bytes of\n")...)?
    for _, it := range items {
        fmt.appendf(mut out, "// %s\n", base(it.file.bytes()))?
    }
    for k, it := range items {
        if it.group || defined_before(items, k) {
            continue
        }
        data, e := os.read_file(it.file.bytes(), c_allocator)
        if e.code != 0 {
            fmt.eprintf("embed: reading %s: %s\n", it.file.bytes(), e.msg)
            return 1, noerror
        }
        fmt.appendf(mut out, "\n// %s is the bytes of %s.\npub var %s = ", it.name.bytes(), base(it.file.bytes()), it.name.bytes())?
        quote(mut out, data)?
        append(mut out, '\n')?
    }
    for k, it := range items {
        if !it.group || defined_before(items, k) {
            continue
        }
        code := write_group(mut out, items, it.name.bytes())?
        if code != 0 {
            return code, noerror
        }
    }
    for i, arg := range a {
        if i == 1 {
            e := os.write_file(arg.bytes(), out)
            if e.code != 0 {
                fmt.eprintf("embed: writing %s: %s\n", arg.bytes(), e.msg)
                return 1, noerror
            }
        }
    }
    return 0, noerror
}

// parse_item splits arg, name=file or group[]=file, into an Item, and
// reports whether it has that shape: a name of letters, digits and
// underscores, not starting with a digit, and a file that is not empty.
func parse_item(arg []uint8) (Item, bool, error) {
    eq := bytes.index_byte(arg, '=')
    mut it := Item{name: text.new(c_allocator), group: false, file: text.new(c_allocator)}
    if eq <= 0 || eq >= len(arg) {
        return it, false, noerror
    }
    // eq is below len(arg), so eq + 1 does not wrap.
    file_start := eq +% 1
    if file_start <= 0 || file_start >= len(arg) {
        return it, false, noerror
    }
    mut name_end := eq
    if bytes.has_suffix(arg[:eq], []uint8("[]")) {
        it.group = true
        // The suffix's two bytes are in arg[:eq], so eq is at least 2.
        name_end = eq -% 2
    }
    if name_end < 0 || name_end > len(arg) || !is_name(arg[:name_end]) {
        return it, false, noerror
    }
    mut it.name.append(arg[:name_end])?
    mut it.file.append(arg[file_start:])?
    return it, true, noerror
}

// is_name reports whether s can name a Tack global: letters, digits and
// underscores, not empty and not starting with a digit.
func is_name(s []uint8) bool {
    if len(s) == 0 || s[0] >= '0' && s[0] <= '9' {
        return false
    }
    for _, c := range s {
        if c != '_' && !(c >= 'a' && c <= 'z') && !(c >= 'A' && c <= 'Z') && !(c >= '0' && c <= '9') {
            return false
        }
    }
    return true
}

// defined_before reports whether an item before the k-th of items has
// the k-th's name and kind, so the k-th joins it rather than defining
// the name again: every file of a group is written by its first item, and
// a name given twice is written once, from its first file.
func defined_before(items []Item, k int64) bool {
    for i, it := range items {
        if i >= k {
            return false
        }
        for j, o := range items {
            if j == k && o.group == it.group && o.name.equal(it.name.bytes()) {
                return true
            }
        }
    }
    return false
}

// write_group appends to out the two arrays of the group name, from
// every item of items in it, in order, and returns 0, or 1 when one of
// its files cannot be read, which it reports.
func write_group(mut out list[uint8], items []Item, name []uint8) (int32, error) {
    mut n int64 = 0
    for _, it := range items {
        if it.group && it.name.equal(name) {
            n +%= 1
        }
    }
    fmt.appendf(mut out, "\n// %s_names are the base names of the files of the group %s.\n", name, name)?
    fmt.appendf(mut out, "pub var %s_names = [%d]string{\n", name, n)?
    for _, it := range items {
        if it.group && it.name.equal(name) {
            append(mut out, []uint8("    ")...)?
            quote(mut out, base(it.file.bytes()))?
            append(mut out, []uint8(",\n")...)?
        }
    }
    append(mut out, []uint8("}\n")...)?
    fmt.appendf(mut out, "\n// %s_data are the bytes of the files %s_names names, in the same\n// order.\npub var %s_data = [%d]string{\n", name, name, name, n)?
    for _, it := range items {
        if it.group && it.name.equal(name) {
            data, e := os.read_file(it.file.bytes(), c_allocator)
            if e.code != 0 {
                fmt.eprintf("embed: reading %s: %s\n", it.file.bytes(), e.msg)
                return 1, noerror
            }
            append(mut out, []uint8("    ")...)?
            quote(mut out, data)?
            append(mut out, []uint8(",\n")...)?
        }
    }
    append(mut out, []uint8("}\n")...)?
    return 0, noerror
}

// base returns the last element of the slash path p, what follows its
// last slash, or p when it has none.
func base(p []uint8) []uint8 {
    mut start int64 = 0
    for i, c := range p {
        if c == '/' {
            // i is an index of p, so i + 1 does not wrap.
            start = i +% 1
        }
    }
    if start < 0 || start > len(p) {
        return p
    }
    return p[start:]
}

// hex_digit returns the lowercase hex digit of d, which is below 16.
func hex_digit(d uint8) uint8 {
    if d < 10 {
        return '0' +% d
    }
    return 'a' +% (d -% 10)
}

// quote appends data to out as a Tack string literal the lexer decodes
// to exactly data (see the package documentation).
func quote(mut out list[uint8], data []uint8) error {
    reserve(mut out, len(data) +% 2)?
    append(mut out, '"')?
    for _, c := range data {
        if c == '"' || c == '\\' {
            append(mut out, '\\', c)?
        } else if c == '\n' {
            append(mut out, '\\', 'n')?
        } else if c == '\t' {
            append(mut out, '\\', 't')?
        } else if c == '\r' {
            append(mut out, '\\', 'r')?
        } else if c >= ' ' && c <= '~' {
            append(mut out, c)?
        } else {
            append(mut out, '\\', 'x', hex_digit(c >> 4), hex_digit(c & 15))?
        }
    }
    return append(mut out, '"')
}
