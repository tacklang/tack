package typeck

import ast from "tack/ast"
import constant from "tack/constant"
import source from "tack/source"
import types from "tack/types"

// The lengths a successful append proves, Go's appended.go. append adds
// all of its values or none, and when it adds none its error's code is
// not zero, so after
//
//     err := append(mut l, a, b)
//     if err.code != 0 {
//         return
//     }
//
// len(l) is at least 2, until a write to l can reach the code asking.
// The rule applies when the error is bound to an immutable variable the
// call declares, with no type written, so its code always tells of that
// call, and the list is a variable that can have facts. The count is the
// number of values passed, or the length of an array spread whole; a
// spread of anything else proves nothing. The proof comes from no guard,
// so it has no region: a write to l ends it when it runs after the
// append and before the code asking, which the whole function's writes
// to l are searched for (see written_since).

// AppendRec is a call to append whose error was bound to err, an
// immutable variable, adding count values to the list lst, which takes
// effect at at, the end of the call, Go's appendRecord.
type AppendRec struct {
    err Key
    lst FKey
    count int64
    at int64
}

// FuncWrite is a write to a variable anywhere in the function being
// checked, Go's funcWrite: where it takes effect, and every loop that
// holds it, the count spans of fw_loops from loops.
type FuncWrite struct {
    at int64
    loops int64
    count int64
}

// WRun is a run of the FuncWrites of one declaration: count of them
// from start.
type WRun struct {
    start int64
    count int64
}

// EachWrite is a write each_write finds, Go's write: shown, the target
// or the mut argument; at, where it takes effect; and the loops holding
// it in the node walked, outermost first, the count spans of loops from
// loops_at in the list each_write is given.
type EachWrite struct {
    shown Key
    at int64
    loops_at int64
    count int64
}

// record_append records the variable k, v, just checked, when it is an
// immutable error declared with no type and bound to an append that
// adds a known number of values to a list that can have facts, Go's
// recordAppend and appendCount.
func (mut c Checker) record_append(k Key, v ast.Var) error {
    if v.mutable || ast.is_none(v.value) || !ast.is_none(v.type_expr) || decl_type_of(c.decl_types, k) != types.error_type {
        return noerror
    }
    value := sub(k, v.value)
    if !is_builtin_call(c.prog.trees, c.none, value, "append") {
        return noerror
    }
    cl := call_of(c.prog.trees, value)
    nargs := count_items(c.prog.trees, value.unit, cl.args)
    if nargs < 2 {
        return noerror
    }
    first := item_at(c.prog.trees, value.unit, cl.args, 0)
    mut x := no_key()
    switch kind_at(c.prog.trees, first) {
    case mut_arg(inner):
        x = sub(first, inner)
    default:
        return noerror
    }
    lk, ok := mut c.string_var(x)?
    mut count := nargs -% 1
    if cl.spread {
        count = 0
        st := mut c.type_of(item_at(c.prog.trees, value.unit, cl.args, 1))
        if c.table.is_array(st) {
            count = c.table.len_of(st)
        }
    }
    if ok && count > 0 {
        append(mut c.appends, AppendRec{err: k, lst: lk, count: count, at: span_at(c.prog.trees, value).end})?
    }
    return noerror
}

// appended_len returns least, what the facts say of the length of the
// list k, narrowed by every append to it whose error the facts in force
// prove is no error, and that no write to it since can have undone (see
// written_since), Go's appendedLen.
func (mut c Checker) appended_len(k FKey, least Interval) (Interval, error) {
    mut out := least
    mut i int64 = 0
    for i < len(c.appends) {
        r, ok := c.appends[i]
        i +%= 1
        if !ok || r.lst != k {
            continue
        }
        ne := mut c.no_error(r.err)?
        if !ne {
            continue
        }
        ws := mut c.written_since(r)?
        if ws {
            continue
        }
        mut f := new_fact(zero_fkey())
        f.lo = constant.from_int64(r.count)
        f.has_lo = true
        out = out.narrow(f)
    }
    return out, noerror
}

// written_since reports whether a write to r's list can run after r's
// append and before c.fx.at, the code asking, without the append running
// again, Go's writtenSince: it takes effect after the append and can
// reach c.fx.at (see reaches); or it is in a loop holding c.fx.at but
// not the append, whose next pass reaches c.fx.at with no append in
// between.
func (mut c Checker) written_since(r AppendRec) (bool, error) {
    run := mut c.func_writes(r.lst.decl)?
    mut i int64 = 0
    for i < run.count {
        w, ok := c.func_write_list[run.start +% i]
        i +%= 1
        if !ok || w.at <= r.at {
            continue
        }
        if c.reaches(Ending{drop: -1, kept: -1, loop: zero_span(), at: w.at}) {
            return true, noerror
        }
        mut j int64 = 0
        for j < w.count {
            loop := span_in(c.fw_loops[:], w.loops +% j)
            j +%= 1
            if in_span(c.fx.at, loop) && !in_span(r.at, loop) {
                return true, noerror
            }
        }
    }
    return false, noerror
}

// func_writes returns the run of every write to decl in the body of the
// function being checked (see each_write), found once per function and
// kept, Go's funcWrites.
func (mut c Checker) func_writes(decl Key) (WRun, error) {
    run, has := c.writes_by_decl[decl]
    if has {
        return run, noerror
    }
    mut nodes := make(list[Key], c_allocator)
    c.stmt_keys(c.body_unit, c.body_nodes, mut nodes)?
    mut found := make(list[EachWrite], c_allocator)
    mut loops := make(list[source.Span], c_allocator)
    mut c.each_write(nodes[:], decl, mut found, mut loops)?
    start := len(c.func_write_list)
    for _, w := range found {
        at := len(c.fw_loops)
        mut j int64 = 0
        for j < w.count {
            append(mut c.fw_loops, span_in(loops[:], w.loops_at +% j))?
            j +%= 1
        }
        append(mut c.func_write_list, FuncWrite{at: w.at, loops: at, count: w.count})?
    }
    nrun := WRun{start: start, count: len(found)}
    put(mut c.writes_by_decl, decl, nrun)?
    return nrun, noerror
}

// each_write appends to out every write to decl in nodes, however deeply
// nested, in the order a walk meets them, Go's eachWrite: an
// assignment's target, a compound assignment's, an increment's or
// decrement's, one of an assignment of several values, each when it
// writes decl itself and not through a list (see written_decl), and the
// first mut argument of a call that writes decl so, but a swap's. Each
// node is walked on its own, from a stack of its own, so a write's loops,
// appended to loops, are those inside the node that hold it.
func (mut c Checker) each_write(nodes []Key, decl Key, mut out list[EachWrite], mut loops list[source.Span]) error {
    mut open := make(list[source.Span], c_allocator)
    mut stack := make(list[id[ast.Node]], c_allocator)
    mut kids := make(list[id[ast.Node]], c_allocator)
    mut targets := make(list[Key], c_allocator)
    for _, root := range nodes {
        for len(open) > 0 {
            pop(mut open)
        }
        append(mut stack, root.node)?
        for len(stack) > 0 {
            top, ok := pop(mut stack)
            if !ok {
                break
            }
            n := Key{unit: root.unit, node: top}
            clear_nodes(mut kids)
            children_of(c.prog.trees, n.unit, top, mut kids)?
            mut j := len(kids) -% 1
            for j >= 0 {
                kid, has := kids[j]
                if has {
                    append(mut stack, kid)?
                }
                j -%= 1
            }
            switch kind_at(c.prog.trees, n) {
            case case_clause, field, union_case:
                continue
            default:
            }
            sp := span_at(c.prog.trees, n)
            for len(open) > 0 && sp.start >= span_in(open[:], len(open) -% 1).end {
                pop(mut open)
            }
            if c.is_loop_node(n) {
                append(mut open, sp)?
            }
            clear_keys(mut targets)
            mut is_call := false
            switch kind_at(c.prog.trees, n) {
            case assign(a):
                append(mut targets, sub(n, a.target))?
            case inc_dec(a):
                append(mut targets, sub(n, a.target))?
            case multi_assign(m):
                c.stmt_keys(n.unit, m.targets, mut targets)?
            case call:
                is_call = !is_builtin_call(c.prog.trees, c.none, n, "swap")
            default:
            }
            for _, t := range targets {
                d := mut c.written_decl(t)?
                if d == decl {
                    mut c.push_each_write(t, sp.end, open[:], mut out, mut loops)?
                }
            }
            if !is_call {
                continue
            }
            clear_keys(mut targets)
            mut c.call_operands(n, mut targets)?
            mut written := false
            for _, arg := range targets {
                if written {
                    break
                }
                switch kind_at(c.prog.trees, arg) {
                case mut_arg(x):
                    d := mut c.written_decl(sub(arg, x))?
                    if d == decl {
                        mut c.push_each_write(arg, sp.end, open[:], mut out, mut loops)?
                        written = true
                    }
                default:
                }
            }
        }
    }
    return noerror
}

// push_each_write appends to out the write shown at at, held by the
// loops open, which it appends to loops.
func (mut c Checker) push_each_write(shown Key, at int64, open []source.Span, mut out list[EachWrite], mut loops list[source.Span]) error {
    start := len(loops)
    append(mut loops, open...)?
    append(mut out, EachWrite{shown: shown, at: at, loops_at: start, count: len(open)})?
    return noerror
}

// empty_nodes returns a list of no nodes, the body no function's check
// has set yet.
func empty_nodes() ast.Nodes {
    mut none ast.Nodes
    return none
}
