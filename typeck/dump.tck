package typeck

import ast from "tack/ast"
import builtin from "tack/builtin"
import diag from "tack/diag"
import fmt from "std/fmt"
import source from "tack/source"
import text from "std/text"
import types from "tack/types"

// The dump --port-types writes: a flat JSON object, lists of nodes and
// never a nested tree, so a program of any size dumps, which tackc's
// porttest builds again from Go's checker and compares. phase says how
// far the checker got, "decls", the declaration phase, when the bodies
// were declined, or "bodies", everything Go's Check does; table holds every
// type the table added, with every query the Table answers about it;
// decls every declaration of the program in Go's prog.Decls() order,
// with what the checker recorded on it; instances the instances of
// generic functions, each its function's name and its type arguments,
// none before bodies; errors the errors reported, in
// order, each with its file, its span's start and end, its message and
// its notes, each a file, a span and a message; and assumed the kinds of
// judgment the port answered as holding without proving them. In the
// phase "decls" the table and the errors are as they stood before the
// first body; in "bodies" nodes holds every node of the trees (see
// nodes.tck), and used, runs_c, uses_unreachable and uses_lists what the
// program needs of the runtime (see write_runtime).
//
// A constant is null, Go's nil, or an object of one key saying its kind:
// int, its value in decimal as a string; float64 and float32, the bits of
// the float as a decimal string; bytes, a string's bytes in hexadecimal,
// so any bytes dump as themselves; bool; c_allocator, true; list, the
// values of an array or a struct; or union, its case's place, with
// payload, its payload or null.

// write_dump returns the dump of what the checker found, written from
// the handover it takes out of c (see Typed), which it leaves empty, so
// what the dump compares is what code generation reads.
pub func (mut c Checker) write_dump() (list[uint8], error) {
    mut t := mut c.take_typed()?
    out := mut t.write_dump(c.diags[:], c.assumed[:])?
    return out, noerror
}

// write_dump returns the dump of c, with diags, the checker's errors,
// and assumed, the kinds of judgment it took as holding unproven.
pub func (mut c Typed) write_dump(diags []diag.Diagnostic, assumed []text.Text) (list[uint8], error) {
    mut out := make(list[uint8], c_allocator)
    mut n := mut c.table.count()
    mut errors := len(diags)
    if c.bodies_done {
        fmt.appendf(mut out, "{\"phase\":\"bodies\",\"table\":[")?
    } else {
        fmt.appendf(mut out, "{\"phase\":\"decls\",\"table\":[")?
        n = c.decl_type_count
        errors = c.decl_error_count
    }
    for i := range n {
        if i > 0 {
            append(mut out, ',')?
        }
        mut c.write_type(mut out, types.added(i))?
    }
    fmt.appendf(mut out, "],\"decls\":[")?
    for i := range count_decls(c.prog) {
        if i > 0 {
            append(mut out, ',')?
        }
        mut c.write_decl(mut out, decl_at(c.prog, i))?
    }
    fmt.appendf(mut out, "],\"instances\":[")?
    if c.bodies_done && c.instances_recorded {
        mut c.write_instances(mut out)?
    }
    fmt.appendf(mut out, "],\"errors\":[")?
    for i, d := range diags {
        if i >= errors {
            break
        }
        if i > 0 {
            append(mut out, ',')?
        }
        write_diag(c.files, mut out, d.message.bytes(), d.span)?
        fmt.appendf(mut out, ",\"notes\":[")?
        for j, note := range d.related {
            if j > 0 {
                append(mut out, ',')?
            }
            write_diag(c.files, mut out, note.message.bytes(), note.span)?
            append(mut out, '}')?
        }
        fmt.appendf(mut out, "]}")?
    }
    if c.bodies_done {
        fmt.appendf(mut out, "],\"nodes\":")?
        mut c.write_nodes(mut out)?
        mut c.write_runtime(mut out)?
        fmt.appendf(mut out, ",\"assumed\":[")?
    } else {
        fmt.appendf(mut out, "],\"assumed\":[")?
    }
    for i, a := range assumed {
        if i > 0 {
            append(mut out, ',')?
        }
        append(mut out, '"')?
        write_escaped(mut out, a.bytes())?
        append(mut out, '"')?
    }
    fmt.appendf(mut out, "]}\n")?
    return out, noerror
}

// write_runtime appends, after a comma, what the program needs of the
// runtime, which the backend and the driver ask (see builtin's
// used.tck): used, the names of the builtins with a C body it calls, in
// Go's order; runs_c, whether it runs C beyond its generated C;
// uses_unreachable, whether it holds an unreachable; and uses_lists,
// whether its types, as checking left them, have a list, an arena, a
// pool or a map.
func (mut c Typed) write_runtime(mut out list[uint8]) error {
    set := builtin.default_set()
    used := set.used(c.prog)?
    fmt.appendf(mut out, ",\"used\":[")?
    for i, f := range used {
        if i > 0 {
            append(mut out, ',')?
        }
        write_name(mut out, []uint8(f.name))?
    }
    runs_c := set.runs_c(c.prog)?
    fmt.appendf(mut out, "],\"runs_c\":")?
    write_bool(mut out, runs_c)?
    holds_unreachable := builtin.uses_unreachable(c.prog)?
    fmt.appendf(mut out, ",\"uses_unreachable\":")?
    write_bool(mut out, holds_unreachable)?
    fmt.appendf(mut out, ",\"uses_lists\":")?
    lists := builtin.uses_lists(mut c.table)?
    write_bool(mut out, lists)?
    return noerror
}

// write_diag appends a diagnostic or a note saying message at sp, as an
// object, left open for the caller to add to and close, of its file's
// name, its span's start and end and its message.
func write_diag(files source.Set, mut out list[uint8], message []uint8, sp source.Span) error {
    fmt.appendf(mut out, "{\"file\":\"")?
    for _, f := range files.lookup(sp.file) {
        write_escaped(mut out, f.filename.bytes())?
    }
    fmt.appendf(mut out, "\",\"start\":%d,\"end\":%d,\"message\":\"", sp.start, sp.end)?
    write_escaped(mut out, message)?
    append(mut out, '"')?
    return noerror
}

// write_escaped appends s as the inside of a JSON string: a quote, a
// backslash and every byte below 32 escaped, and every other byte as it
// is.
func write_escaped(mut out list[uint8], s []uint8) error {
    for _, b := range s {
        if b == '"' || b == '\\' {
            append(mut out, '\\')?
            append(mut out, b)?
        } else if b < 32 {
            append(mut out, []uint8("\\u00")...)?
            append_hex(mut out, b)?
        } else {
            append(mut out, b)?
        }
    }
    return noerror
}

// append_hex appends b as two lowercase hexadecimal digits.
func append_hex(mut out list[uint8], b uint8) error {
    append(mut out, hex_digit(b >> 4))?
    append(mut out, hex_digit(b & 15))?
    return noerror
}

// hex_digit returns the lowercase hexadecimal digit of d, below 16.
func hex_digit(d uint8) uint8 {
    if d < 10 {
        return '0' +% d
    }
    return 'a' +% (d -% 10)
}

// write_name appends s as a JSON string.
func write_name(mut out list[uint8], s []uint8) error {
    append(mut out, '"')?
    write_escaped(mut out, s)?
    append(mut out, '"')?
    return noerror
}

// write_bool appends b as JSON.
func write_bool(mut out list[uint8], b bool) error {
    if b {
        append(mut out, []uint8("true")...)?
    } else {
        append(mut out, []uint8("false")...)?
    }
    return noerror
}

// write_type appends the table's entry for typ, every query read
// through the handover's table (see types.Bound), which with nothing
// bound answers as the Table's own queries do.
func (mut c Typed) write_type(mut out list[uint8], typ types.Type) error {
    fmt.appendf(mut out, "{\"id\":%d,\"kind\":", typ.number())?
    kind := mut c.table.kind_name(typ)?
    write_name(mut out, []uint8(kind))?
    name := mut c.table.name(typ)?
    fmt.appendf(mut out, ",\"name\":")?
    write_name(mut out, name[:])?
    elem := mut c.table.elem_of(typ)?
    n := mut c.table.len_of(typ)?
    key := mut c.table.key_of(typ)?
    fmt.appendf(mut out, ",\"elem\":%d,\"len\":%d,\"key\":%d,\"fields\":[", elem.number(), n, key.number())?
    is_struct := mut c.table.is_struct(typ)?
    if typ != types.error_type && is_struct {
        nf := mut c.table.field_count(typ)?
        for i := range nf {
            if i > 0 {
                append(mut out, ',')?
            }
            ft, _ := mut c.table.field_type(typ, i)?
            mut fname := msg()
            mut c.table.field_name(typ, i, mut fname)?
            fmt.appendf(mut out, "{\"name\":")?
            write_name(mut out, fname[:])?
            fmt.appendf(mut out, ",\"type\":%d}", ft.number())?
        }
    }
    fmt.appendf(mut out, "],\"cases\":[")?
    nc := mut c.table.case_count(typ)?
    for i := range nc {
        if i > 0 {
            append(mut out, ',')?
        }
        cs, _ := mut c.table.case_at(typ, i)?
        mut cname := msg()
        mut c.table.case_name(cs, mut cname)?
        fmt.appendf(mut out, "{\"name\":")?
        write_name(mut out, cname[:])?
        fmt.appendf(mut out, ",\"type\":%d,\"payload\":", cs.typ.number())?
        write_bool(mut out, cs.payload)?
        append(mut out, '}')?
    }
    fmt.appendf(mut out, "],\"params\":[")?
    np := mut c.table.param_count(typ)?
    for i := range np {
        if i > 0 {
            append(mut out, ',')?
        }
        p, _ := mut c.table.param(typ, i)?
        fmt.appendf(mut out, "{\"type\":%d,\"mut\":", p.typ.number())?
        write_bool(mut out, p.is_mut)?
        fmt.appendf(mut out, ",\"own\":")?
        write_bool(mut out, p.is_own)?
        fmt.appendf(mut out, ",\"scope\":")?
        write_bool(mut out, p.is_scope)?
        append(mut out, '}')?
    }
    fmt.appendf(mut out, "],\"results\":[")?
    nr := mut c.table.result_count(typ)?
    for i := range nr {
        if i > 0 {
            append(mut out, ',')?
        }
        r := mut c.table.result(typ, i)?
        fmt.appendf(mut out, "%d", r.number())?
    }
    size := mut c.table.size(typ)?
    fmt.appendf(mut out, "],\"size\":{\"bytes\":%d,\"align\":%d,\"overflow\":", size.bytes, size.align)?
    write_bool(mut out, size.overflow)?
    owned := mut c.table.owned(typ)?
    has_zero := mut c.table.has_zero(typ)?
    holds_list := mut c.table.holds_list(typ)?
    holds_arena := mut c.table.holds_arena(typ)?
    holds_pool := mut c.table.holds_pool(typ)?
    holds_union := mut c.table.holds_union(typ)?
    in_any := mut c.table.in_any_of(typ)?
    buffered := mut c.table.buffered(typ)?
    fmt.appendf(mut out, "},\"owned\":")?
    write_bool(mut out, owned)?
    fmt.appendf(mut out, ",\"has_zero\":")?
    write_bool(mut out, has_zero)?
    fmt.appendf(mut out, ",\"holds_list\":")?
    write_bool(mut out, holds_list)?
    fmt.appendf(mut out, ",\"holds_arena\":")?
    write_bool(mut out, holds_arena)?
    fmt.appendf(mut out, ",\"holds_pool\":")?
    write_bool(mut out, holds_pool)?
    fmt.appendf(mut out, ",\"holds_union\":")?
    write_bool(mut out, holds_union)?
    fmt.appendf(mut out, ",\"in_any\":")?
    write_bool(mut out, in_any)?
    fmt.appendf(mut out, ",\"buffered\":")?
    write_bool(mut out, buffered)?
    append(mut out, '}')?
    return noerror
}

// write_decl appends the dump of the declaration d.
func (mut c Typed) write_decl(mut out list[uint8], d Key) error {
    switch kind_at(c.prog.trees, d) {
    case func_decl:
        fn := func_of(c.prog.trees, d)
        fmt.appendf(mut out, "{\"decl\":\"Func\",\"name\":")?
        write_name(mut out, text_at(c.prog.trees, c.none, d.unit, fn.name))?
        // Go's Func.Value is set only where a body uses the function as
        // a value, so it is invalid in every declaration before bodies.
        mut value := types.invalid
        if c.bodies_done {
            value = mut c.func_value(d)
        }
        fmt.appendf(mut out, ",\"value\":%d,\"type_params\":[", value.number())?
        for i := range count_items(c.prog.trees, d.unit, fn.type_params) {
            if i > 0 {
                append(mut out, ',')?
            }
            mut c.write_type_param(mut out, item_at(c.prog.trees, d.unit, fn.type_params, i))?
        }
        fmt.appendf(mut out, "],\"params\":")?
        mut c.write_params(mut out, d.unit, fn.params)?
        fmt.appendf(mut out, ",\"results\":")?
        mut c.write_results(mut out, d)?
        append(mut out, '}')?
    case var_decl(v):
        fmt.appendf(mut out, "{\"decl\":\"Var\",\"name\":")?
        write_name(mut out, text_at(c.prog.trees, c.none, d.unit, v.name))?
        fmt.appendf(mut out, ",\"type\":%d,\"const\":", decl_type_of(c.decl_types, d).number())?
        cv, has := mut c.var_const(d)
        if has {
            mut c.write_const(mut out, cv)?
        } else {
            append(mut out, []uint8("null")...)?
        }
        append(mut out, '}')?
    case type_decl(td):
        fmt.appendf(mut out, "{\"decl\":\"Type\",\"name\":")?
        write_name(mut out, text_at(c.prog.trees, c.none, d.unit, td.name))?
        fmt.appendf(mut out, ",\"type\":%d,\"methods\":[", decl_type_of(c.decl_types, d).number())?
        switch kind_at(c.prog.trees, sub(d, td.type_expr)) {
        case interface_type(ms):
            for j := range count_items(c.prog.trees, d.unit, ms) {
                if j > 0 {
                    append(mut out, ',')?
                }
                mk := item_at(c.prog.trees, d.unit, ms, j)
                switch kind_at(c.prog.trees, mk) {
                case iface_method(m):
                    fmt.appendf(mut out, "{\"name\":")?
                    write_name(mut out, text_at(c.prog.trees, c.none, mk.unit, m.name))?
                    fmt.appendf(mut out, ",\"params\":")?
                    mut c.write_params(mut out, mk.unit, m.params)?
                    fmt.appendf(mut out, ",\"results\":")?
                    mut c.write_results(mut out, mk)?
                    append(mut out, '}')?
                default:
                    append(mut out, []uint8("null")...)?
                }
            }
        default:
        }
        fmt.appendf(mut out, "]}")?
    default:
        fmt.appendf(mut out, "{\"decl\":\"Bad\"}")?
    }
    return noerror
}

// write_params appends the names and types of the parameters ps of the
// tree unit.
func (mut c Typed) write_params(mut out list[uint8], unit int64, ps ast.Nodes) error {
    append(mut out, '[')?
    for i := range count_items(c.prog.trees, unit, ps) {
        if i > 0 {
            append(mut out, ',')?
        }
        p := item_at(c.prog.trees, unit, ps, i)
        fmt.appendf(mut out, "{\"name\":")?
        write_name(mut out, name_of(c.prog.trees, c.none, p))?
        fmt.appendf(mut out, ",\"type\":%d}", decl_type_of(c.decl_types, p).number())?
    }
    append(mut out, ']')?
    return noerror
}

// write_results appends the result types recorded for the function or
// interface method k.
func (mut c Typed) write_results(mut out list[uint8], k Key) error {
    append(mut out, '[')?
    n, _ := results_count(c.result_count, k)
    for i := range n {
        if i > 0 {
            append(mut out, ',')?
        }
        fmt.appendf(mut out, "%d", result_of(c.results, k, i).number())?
    }
    append(mut out, ']')?
    return noerror
}

// write_type_param appends the dump of the type parameter tk.
func (mut c Typed) write_type_param(mut out list[uint8], tk Key) error {
    fmt.appendf(mut out, "{\"name\":")?
    write_name(mut out, name_of(c.prog.trees, c.none, tk))?
    fmt.appendf(mut out, ",\"type\":%d,\"iface\":", decl_type_of(c.decl_types, tk).number())?
    iface := mut c.type_param_iface(tk)
    if !is_no_key(iface) {
        append(mut out, '"')?
        p, ok := c.unit_pkg[iface.unit]
        if ok {
            mut path := msg()
            append_pkg(c.prog.packages, p, 1, mut path)?
            write_escaped(mut out, path[:])?
        }
        append(mut out, '.')?
        write_escaped(mut out, name_of(c.prog.trees, c.none, iface))?
        append(mut out, '"')?
    } else {
        append(mut out, []uint8("null")...)?
    }
    fmt.appendf(mut out, ",\"data\":")?
    write_bool(mut out, mut c.type_param_data(tk))?
    fmt.appendf(mut out, ",\"implicit\":")?
    write_bool(mut out, mut c.type_param_implicit(tk))?
    append(mut out, '}')?
    return noerror
}

// write_const appends the constant k.
func (mut c Typed) write_const(mut out list[uint8], k Const) error {
    if k.kind == cv_none {
        append(mut out, []uint8("null")...)?
        return noerror
    }
    if k.kind == cv_int {
        fmt.appendf(mut out, "{\"int\":\"")?
        k.i.append_string(mut out)?
        fmt.appendf(mut out, "\"}")?
        return noerror
    }
    if k.kind == cv_f64 {
        fmt.appendf(mut out, "{\"float64\":\"%d\"}", k.bits)?
        return noerror
    }
    if k.kind == cv_f32 {
        fmt.appendf(mut out, "{\"float32\":\"%d\"}", k.bits)?
        return noerror
    }
    if k.kind == cv_str {
        fmt.appendf(mut out, "{\"bytes\":\"")?
        for _, b := range c.store.str_bytes(k) {
            append_hex(mut out, b)?
        }
        fmt.appendf(mut out, "\"}")?
        return noerror
    }
    if k.kind == cv_bool {
        fmt.appendf(mut out, "{\"bool\":")?
        write_bool(mut out, k.b)?
        append(mut out, '}')?
        return noerror
    }
    if k.kind == cv_alloc {
        fmt.appendf(mut out, "{\"c_allocator\":true}")?
        return noerror
    }
    if k.kind == cv_list {
        fmt.appendf(mut out, "{\"list\":[")?
        for i := range k.count {
            if i > 0 {
                append(mut out, ',')?
            }
            item, _ := c.store.item(k, i)
            mut c.write_const(mut out, item)?
        }
        fmt.appendf(mut out, "]}")?
        return noerror
    }
    if k.kind == cv_union {
        fmt.appendf(mut out, "{\"union\":%d,\"payload\":", case_of(k))?
        p, has := c.store.payload(k)
        if has {
            mut c.write_const(mut out, p)?
        } else {
            append(mut out, []uint8("null")...)?
        }
        append(mut out, '}')?
        return noerror
    }
    // An untyped float, the exact value of a constant expression of
    // floats before it is rounded to a type, is never a global's value,
    // but is an operator's; the dump writes it exactly, in lowest terms.
    if k.kind == cv_float {
        f, has := clone_float(c.store.floats, k.first)?
        if has {
            fmt.appendf(mut out, "{\"float\":\"")?
            f.append_exact(mut out, c_allocator)?
            fmt.appendf(mut out, "\"}")?
            return noerror
        }
    }
    fmt.appendf(mut out, "null")?
    return noerror
}

// write_instances appends the instances of generic functions found,
// Go's Program.Instances, each an object of its function's name and its
// type arguments.
func (mut c Typed) write_instances(mut out list[uint8]) error {
    for i := range mut c.instance_count() {
        if i > 0 {
            append(mut out, ',')?
        }
        fmt.appendf(mut out, "{\"func\":\"")?
        inst_fn := mut c.instance_func(i)
        write_escaped(mut out, name_of(c.prog.trees, c.none, inst_fn))?
        fmt.appendf(mut out, "\",\"type_args\":[")?
        for j := range mut c.instance_arg_count(i) {
            if j > 0 {
                append(mut out, ',')?
            }
            v_instance_arg := mut c.instance_arg(i, j)
            fmt.appendf(mut out, "%d", v_instance_arg.number())?
        }
        fmt.appendf(mut out, "]}")?
    }
    return noerror
}
