package typeck

import constant from "tack/constant"
import types from "tack/types"

// The relations in force, Go's relgraph.go, relindex.go's relScan and
// relnotes.go: a query of whether x - y <= w builds a graph of the
// bounds in force that hold where it is asked, each bound a - b <= v an
// edge from a to b of weight v, every length at least 0 and at most the
// largest int64, of at most relation_cap nodes found breadth first from
// x and y, and the shortest paths in it bound the differences of its
// nodes. The graph is built from a scan of the facts in force, as Go's
// tests build the graph they check Go's index against, which takes the
// same edges in the same order and so finds the same nodes, cap and
// bounds. An edge with side conditions joins the graph once the graph
// without it proves them (see admit). As Go's does, the graph leaves out
// an edge with no condition alike to one it took, without judging its
// fact, and finds its bounds exactly; where they do not settle, it is
// built again keeping every edge alike, which answers as Go's graph
// keeping them does (see find_dists).

// relation_cap is the most nodes a query's graph holds, Go's
// relationCap.
var relation_cap int64 = 64

// RelEdge is a bound in a query's graph, from - to <= w, which counts
// only where conds hold, Go's relEdge: fact is the position in active of
// the fact it comes from, or -1 for a length's or a type's range, which
// always holds.
type RelEdge struct {
    frm FKey
    to FKey
    w int64
    fact int64
    conds Conds
    group int64
}

// plain_edge returns the edge from - to <= w of the fact at fact, of no
// condition, in no group of edges alike yet (see edge_group).
func plain_edge(frm FKey, to FKey, w int64, fact int64) RelEdge {
    return RelEdge{frm: frm, to: to, w: w, fact: fact, conds: no_conds(), group: -1}
}

// RelGraph is the graph of a query, Go's relGraph: nodes in the order
// found, index their positions, the edges taken, in the order taken,
// those admitted and those left pending for their conditions (see
// admit), whether the cap left edges out, and the bounds found so far
// from a node and to one, each by the node as dist_from and dist_to give
// their positions in dists, n entries each, known the same; all_from and
// all_to are the same for the graph with every pending edge admitted
// too, Go's withPending. Unless alike says it keeps them, the graph
// keeps no edge with no condition alike to one it took before, the
// first of them standing for all, and dropped says it left one out: the
// groups of edges alike it took are those the index of the relations
// marks with its stamp (see edge_group); diverged says a search for
// its bounds did not settle while admitting its edges, and q is the
// query it was built for (see dists).
type RelGraph struct {
    nodes list[FKey]
    index map[FKey]int64
    edges list[RelEdge]
    admitted list[RelEdge]
    pending list[RelEdge]
    capped bool
    dist_from map[int64]int64
    dist_to map[int64]int64
    all_from map[int64]int64
    all_to map[int64]int64
    dists list[int64]
    known list[bool]
    alike bool
    dropped bool
    diverged bool
    admitting bool
    stamp int64
    q GraphQuery
}

// EdgeEnds is an edge's nodes and weight, Go's edgeEnds: the key of the
// set of the edges with no condition a graph has taken.
type EdgeEnds struct {
    frm FKey
    to FKey
    w int64
}

// GraphQuery is what a query's graph was built for, so that the graph
// keeping every edge alike can be built for it again (see dists): its
// two nodes, which are lengths, and whether it leaves out a stored
// value's bounds and counts each variable's type's.
type GraphQuery struct {
    x FKey
    y FKey
    x_len bool
    y_len bool
    plain bool
    typed bool
}

// new_rel_graph returns a graph of no node.
func new_rel_graph() RelGraph {
    return RelGraph{
        nodes: make(list[FKey], c_allocator),
        index: make(map[FKey]int64, c_allocator),
        edges: make(list[RelEdge], c_allocator),
        admitted: make(list[RelEdge], c_allocator),
        pending: make(list[RelEdge], c_allocator),
        capped: false,
        dist_from: make(map[int64]int64, c_allocator),
        dist_to: make(map[int64]int64, c_allocator),
        all_from: make(map[int64]int64, c_allocator),
        all_to: make(map[int64]int64, c_allocator),
        dists: make(list[int64], c_allocator),
        known: make(list[bool], c_allocator),
        alike: true,
        dropped: false,
        diverged: false,
        admitting: false,
        stamp: 0,
        q: GraphQuery{x: zero_fkey(), y: zero_fkey(), x_len: false, y_len: false, plain: false, typed: false},
    }
}

// forget drops every bound found so far, once the edges admitted change.
func (mut g RelGraph) forget() {
    a := replace(mut g.dist_from, make(map[int64]int64, c_allocator))
    drop(own a)
    b := replace(mut g.dist_to, make(map[int64]int64, c_allocator))
    drop(own b)
    d := replace(mut g.all_from, make(map[int64]int64, c_allocator))
    drop(own d)
    e := replace(mut g.all_to, make(map[int64]int64, c_allocator))
    drop(own e)
    for len(g.dists) > 0 {
        pop(mut g.dists)
    }
    for len(g.known) > 0 {
        pop(mut g.known)
    }
}

// admit takes in the edges taken between the graph's nodes, Go's
// relGraph.admit: first those that need no condition, then, again and
// again, each conditional one whose conditions the graph proves, until
// none joins; the rest are pending.
func (mut c Checker) admit(mut g RelGraph) error {
    for _, e := range g.edges {
        if e.conds.count > 0 {
            append(mut g.pending, e)?
        } else {
            append(mut g.admitted, e)?
        }
    }
    mut joined := true
    for joined {
        joined = false
        mut i int64 = 0
        for i < len(g.pending) {
            e := rel_edge_in(g.pending[:], i)
            h := mut c.holds_all(mut g, e.conds)?
            if !h {
                i +%= 1
                continue
            }
            append(mut g.admitted, e)?
            mut j := i
            for j +% 1 < len(g.pending) {
                set_at(mut g.pending, j, rel_edge_in(g.pending[:], j +% 1))
                j +%= 1
            }
            pop(mut g.pending)
            mut g.forget()
            joined = true
        }
    }
    return noerror
}

// holds_all reports whether the graph proves every one of conds, Go's
// relGraph.holdsAll: the node at most hi, a bound on it less 0, and at
// least lo, a bound on 0 less it of at most -lo.
func (mut c Checker) holds_all(mut g RelGraph, conds Conds) (bool, error) {
    zero := zero_fkey()
    mut i int64 = 0
    for i < conds.count {
        cond := c.cond_at(conds, i)
        i +%= 1
        if cond.has_hi {
            p := mut c.proves(mut g, cond.of, zero, cond.hi)?
            if !p {
                return false, noerror
            }
        }
        if !cond.has_lo {
            continue
        }
        lo, ok := cond.lo.negate()
        if !ok {
            return false, noerror
        }
        p := mut c.proves(mut g, zero, cond.of, lo)?
        if !p {
            return false, noerror
        }
    }
    return true, noerror
}

// found adds k to the graph's nodes, when it is not one already, Go's
// relGraph.found.
func (mut g RelGraph) found(k FKey) error {
    _, seen := g.index[k]
    if !seen {
        put(mut g.index, k, len(g.nodes))?
        append(mut g.nodes, k)?
    }
    return noerror
}

// ending_count returns how many endings the runs from r hold, Go's
// endings.count.
func (c Checker) ending_count(r int64) int64 {
    mut n int64 = 0
    mut run := r
    for run >= 0 {
        rec := c.run_at(run)
        n +%= rec.count
        run = rec.next
    }
    return n
}

// GraphBuild is what building a query's graph keeps, Go's graphBuilder:
// which facts hold, memoized, which edges are taken, which lengths and
// variables have their range, the lengths, the query's nodes, whether it
// leaves out a stored value's bounds, plain, and whether it counts each
// variable's type's bounds, typed.
type GraphBuild struct {
    holds map[int64]bool
    used map[int64]bool
    ranged map[FKey]bool
    lens list[FKey]
    x FKey
    y FKey
    x_len bool
    y_len bool
    plain bool
    typed bool
}

// relation_graph returns the graph for a query about the nodes x and y,
// x_len and y_len saying which are lengths, and false when no relation is
// in force, Go's relationGraph and graphOf, from the index of the
// relations in force (see relindex.tck), with every edge taken admitted
// that its conditions let in (see admit).
//
// It builds the graph that drops edges alike first, which answers as the
// graph keeping them does wherever a search for bounds settles, and that
// one where a search while admitting does not (see dists), Go's
// buildGraph.
func (mut c Checker) relation_graph(x FKey, y FKey, x_len bool, y_len bool, plain bool) (RelGraph, bool, error) {
    q := GraphQuery{x: x, y: y, x_len: x_len, y_len: y_len, plain: plain, typed: c.typed_relations}
    mut g, has := mut c.graph_of(q, false)?
    if !has || !g.diverged {
        return g, has, noerror
    }
    full, has_full := mut c.graph_of(q, true)?
    return full, has_full, noerror
}

// graph_of returns the graph for the query q, keeping every edge alike
// when alike is set, its edges admitted, Go's graphOf: a graph that
// dropped none is the graph keeping them, and answers as it does.
func (mut c Checker) graph_of(q GraphQuery, alike bool) (RelGraph, bool, error) {
    x := q.x
    y := q.y
    x_len := q.x_len
    y_len := q.y_len
    plain := q.plain
    mut g := new_rel_graph()
    g.alike = alike
    g.q = q
    c.fx.rel.stamp +%= 1
    g.stamp = c.fx.rel.stamp
    mut c.build_rel_idx()?
    if c.fx.rel.relations == 0 {
        return g, false, noerror
    }
    mut b := GraphBuild{
        holds: make(map[int64]bool, c_allocator), used: make(map[int64]bool, c_allocator),
        ranged: make(map[FKey]bool, c_allocator), lens: make(list[FKey], c_allocator),
        x: x, y: y, x_len: x_len, y_len: y_len, plain: plain, typed: q.typed,
    }
    append(mut b.lens, c.fx.rel.lens[:]...)?
    mut qi int64 = 0
    for qi < 2 {
        mut k := x
        if qi == 1 {
            k = y
        }
        qi +%= 1
        if c.graph_is_len(b, k) && !c.is_len_node(k) {
            append(mut b.lens, k)?
        }
    }
    mut g.found(x)?
    mut g.found(y)?
    mut next int64 = 0
    for next < len(g.nodes) {
        u, has_u := g.nodes[next]
        if !has_u {
            break
        }
        next +%= 1
        mut c.expand(mut g, mut b, u)?
    }
    if !g.dropped {
        g.alike = true
    }
    g.admitting = true
    e := mut c.admit(mut g)
    g.admitting = false
    if e.code != 0 {
        return g, true, e
    }
    return g, true, noerror
}

// graph_is_len reports whether k is a length: one the facts use as one,
// or a query's node that is, Go's graphBuilder.isLen.
func (c Checker) graph_is_len(b GraphBuild, k FKey) bool {
    return c.is_len_node(k) || k == b.x && b.x_len || k == b.y && b.y_len
}

// visit adds k to g, and reports whether it is in it: it is, or the cap
// leaves room for it, Go's graphBuilder.visit.
func (mut g RelGraph) visit(k FKey) (bool, error) {
    _, seen := g.index[k]
    if seen {
        return true, noerror
    }
    if len(g.nodes) == relation_cap {
        g.capped = true
        return false, noerror
    }
    mut g.found(k)?
    return true, noerror
}

// expand takes every edge that holds from u, a node found, to a node the
// graph has room for, in the order the index lists them, then the last
// stored value's bounds at u, and, for 0 and for a length, the lengths'
// ranges, or, for a graph that counts them, a variable's type's range,
// Go's graphBuilder.expand. Once the graph is full, of the edges
// left at u only those to its nodes can join, which the pair lists give,
// taken in the order of the index, as taking every edge would; and it is
// capped when any other holds (see take_rest).
func (mut c Checker) expand(mut g RelGraph, mut b GraphBuild, u FKey) error {
    ends, has := c.fx.rel.ends[u]
    mut cur := -1
    if has {
        cur = ends.head
    }
    for cur >= 0 && len(g.nodes) < relation_cap {
        en := entry_in(c.fx.rel.entries[:], cur)
        cur = en.next
        mut c.take_edge(mut g, mut b, en.edge, en.other)?
    }
    if cur >= 0 {
        mut c.take_rest(mut g, mut b, u, cur)?
    }
    top, has_top := c.fx.rel.stored_top[u]
    if has_top && !b.plain {
        f := fact_in(c.fx.active[:], top)
        if f.ends < 0 || c.ending_count(f.ends) <= reach_scan_limit {
            zero := zero_fkey()
            if f.has_hi && f.hi.fits(64, true) {
                mut c.take_stored(mut g, mut b, plain_edge(f.about, zero, f.hi.to_int64(), top), zero)?
            }
            lo, ok := f.lo.negate()
            if f.has_lo && ok && lo.fits(64, true) {
                mut c.take_stored(mut g, mut b, plain_edge(zero, f.about, lo.to_int64(), top), zero)?
            }
        }
    }
    if u.is_zero() {
        mut li int64 = 0
        for li < len(b.lens) {
            k, has_k := b.lens[li]
            li +%= 1
            if !has_k {
                break
            }
            in := mut g.visit(k)?
            if in {
                mut c.length_edges(mut g, mut b, k)?
            }
        }
    } else if c.graph_is_len(b, u) {
        in := mut g.visit(zero_fkey())?
        if in {
            mut c.length_edges(mut g, mut b, u)?
        }
    } else if b.typed {
        in := mut g.visit(zero_fkey())?
        if in {
            mut c.type_edges(mut g, mut b, u)?
        }
    }
    return noerror
}

// type_edges takes the bounds of the type of u, a variable or a
// parameter with no path below it, once, as edges to and from 0, Go's
// graphBuilder.typeRange: every value it holds lies within them, so they
// always hold. An end past what an edge's weight holds is left out.
func (mut c Checker) type_edges(mut g RelGraph, mut b GraphBuild, u FKey) error {
    _, done := b.ranged[u]
    if done || u.path != 0 {
        return noerror
    }
    put(mut b.ranged, u, true)?
    typ := decl_type_of(c.decl_types, u.decl)
    if !types.is_integer(typ) || typ == types.untyped_int {
        return noerror
    }
    lo, hi := type_bounds(typ)
    zero := zero_fkey()
    if hi.fits(64, true) {
        mut c.add_edge(mut g, plain_edge(u, zero, hi.to_int64(), -1))?
    }
    neg, ok := lo.negate()
    if ok && neg.fits(64, true) {
        mut c.add_edge(mut g, plain_edge(zero, u, neg.to_int64(), -1))?
    }
    return noerror
}

// take_edge takes the edge id of the index, from the node being expanded
// to other, when it is not taken, its fact holds and the graph has room
// for other, Go's graphBuilder.take.
func (mut c Checker) take_edge(mut g RelGraph, mut b GraphBuild, eid int64, other FKey) error {
    _, used := b.used[eid]
    if used {
        return noerror
    }
    e := rel_edge_in(c.fx.rel.edges[:], eid)
    taken := mut c.is_alike_taken(g, e)?
    if taken {
        g.dropped = true
        return noerror
    }
    h := mut c.holds_at(mut b, e.fact)?
    if !h {
        return noerror
    }
    in := mut g.visit(other)?
    if in {
        put(mut b.used, eid, true)?
        mut c.add_edge(mut g, e)?
    }
    return noerror
}

// is_alike_taken reports whether g, a graph that drops edges alike, has
// taken an edge alike to e, which has no condition: from the same node,
// to the same node, of the same weight, with no condition either. Such
// an edge's other node is in the graph already, so leaving it out changes
// no node, and no shortest path that settles (see dists).
func (mut c Checker) is_alike_taken(g RelGraph, e RelEdge) (bool, error) {
    if g.alike || e.conds.count > 0 {
        return false, noerror
    }
    grp := mut c.edge_group(e)?
    m, has := c.fx.rel.group_mark[grp]
    return has && m == g.stamp, noerror
}

// edge_group returns the group of edges alike e, which has no condition,
// is in: those of the index know theirs, given when pushed, and any other
// is looked up by its ends, a new group made for them when none has
// them, so that marking a group taken costs a step, not a lookup.
func (mut c Checker) edge_group(e RelEdge) (int64, error) {
    if e.group >= 0 {
        return e.group, noerror
    }
    ends := EdgeEnds{frm: e.frm, to: e.to, w: e.w}
    grp, has := c.fx.rel.groups[ends]
    if has {
        return grp, noerror
    }
    n := len(c.fx.rel.group_mark)
    put(mut c.fx.rel.groups, ends, n)?
    append(mut c.fx.rel.group_mark, 0)?
    return n, noerror
}

// take_stored takes e, a stored value's bound at the node being
// expanded, to other, when its fact holds and the graph has room for
// other.
func (mut c Checker) take_stored(mut g RelGraph, mut b GraphBuild, e RelEdge, other FKey) error {
    taken := mut c.is_alike_taken(g, e)?
    if taken {
        g.dropped = true
        return noerror
    }
    h := mut c.holds_at(mut b, e.fact)?
    if !h {
        return noerror
    }
    in := mut g.visit(other)?
    if in {
        mut c.add_edge(mut g, e)?
    }
    return noerror
}

// take_rest takes, once the graph is full, the edges at u from the entry
// cur on that hold and lead to a node of the graph, not taken before, in
// the order the index lists them, after marking the graph capped when
// any other holds, Go's graphBuilder.takeRest: a full graph gains no
// node, so only whether an edge outside it holds matters.
func (mut c Checker) take_rest(mut g RelGraph, mut b GraphBuild, u FKey, cur int64) error {
    first := entry_in(c.fx.rel.entries[:], cur).edge
    mut found := make(list[int64], c_allocator)
    for _, w := range g.nodes {
        pe, has := c.fx.rel.pends[PairKey{u: u, w: w}]
        if !has {
            continue
        }
        mut p := pe.tail
        for p >= 0 {
            en := entry_in(c.fx.rel.pentries[:], p)
            if en.edge < first {
                break
            }
            append(mut found, en.edge)?
            p = en.prev
        }
    }
    sorted := sort_ints(found[:])?
    mut e := cur
    for !g.capped && e >= 0 {
        en := entry_in(c.fx.rel.entries[:], e)
        e = en.next
        _, in := g.index[en.other]
        if in {
            continue
        }
        edge := rel_edge_in(c.fx.rel.edges[:], en.edge)
        h := mut c.holds_at(mut b, edge.fact)?
        if h {
            g.capped = true
        }
    }
    mut last := -1
    for _, eid := range sorted {
        if eid == last {
            continue
        }
        last = eid
        edge := rel_edge_in(c.fx.rel.edges[:], eid)
        mut other := edge.to
        if other == u {
            other = edge.frm
        }
        mut c.take_edge(mut g, mut b, eid, other)?
    }
    return noerror
}

// add_edge takes e into the graph's edges, Go's graphBuilder.add,
// unless g drops edges alike and has taken one alike to e already.
func (mut c Checker) add_edge(mut g RelGraph, e RelEdge) error {
    taken := mut c.is_alike_taken(g, e)?
    if taken {
        g.dropped = true
        return noerror
    }
    if !g.alike && e.conds.count == 0 {
        grp := mut c.edge_group(e)?
        set_int(mut c.fx.rel.group_mark, grp, g.stamp)
    }
    append(mut g.edges, e)?
    return noerror
}

// length_edges takes the range of the length k, once, Go's
// graphBuilder.lengthRange: at most the largest int64, and at least 0,
// or the least length a successful append gives it (see appended_len).
func (mut c Checker) length_edges(mut g RelGraph, mut b GraphBuild, k FKey) error {
    _, done := b.ranged[k]
    if done {
        return noerror
    }
    put(mut b.ranged, k, true)?
    mut c.add_edge(mut g, plain_edge(k, zero_fkey(), 9223372036854775807, -1))?
    least := mut c.appended_len(k, no_interval())?
    mut w int64 = 0
    v, ok := least.lo.negate()
    if least.has_lo && ok && v.fits(64, true) {
        w = v.to_int64()
    }
    mut c.add_edge(mut g, plain_edge(zero_fkey(), k, w, -1))?
    return noerror
}

// holds_at reports whether the fact at position i of active holds where
// the query is asked, remembering the answer, Go's holdsAt.
func (mut c Checker) holds_at(mut b GraphBuild, i int64) (bool, error) {
    h, seen := b.holds[i]
    if seen {
        return h, noerror
    }
    r := mut c.holds(fact_in(c.fx.active[:], i))?
    put(mut b.holds, i, r)?
    return r, noerror
}

// find_dists returns where the bounds the shortest paths give from the
// node at src, or to it when reverse is set, start in g's dists, found
// once, Go's relGraph.dists and shortest, following each edge admitted
// in order, and each pending one after them when all says so, Go's
// withPending. A graph keeping edges alike finds them by Bellman and
// Ford's rounds, Go's roundBounds: at most as many rounds as the graph
// has nodes, a sum past an int64 left out. One that drops them finds
// them exactly, Go's exactBounds, summing in 128 bits, and they settle
// only when no cycle of negative weight is reached and every bound fits
// an int64: then they are the shortest paths' weights, which the graph
// keeping edges alike finds too. Where they do not settle, such a graph
// marks itself diverged while it admits its edges, and keeps the bounds
// that fit; once admitted, it is replaced by the graph keeping edges
// alike, built for the same query from the same facts, which answers
// from then on, as Go's buildGraph does.
func (mut c Checker) find_dists(mut g RelGraph, src int64, reverse bool, all bool) (int64, error) {
    if all && reverse {
        at, ok := g.all_to[src]
        if ok {
            return at, noerror
        }
    } else if all {
        at, ok := g.all_from[src]
        if ok {
            return at, noerror
        }
    } else if reverse {
        at, ok := g.dist_to[src]
        if ok {
            return at, noerror
        }
    } else {
        at, ok := g.dist_from[src]
        if ok {
            return at, noerror
        }
    }
    n := len(g.nodes)
    // Each edge's nodes are looked up once, not once a round.
    mut ea := make(list[int64], c_allocator)
    mut eb := make(list[int64], c_allocator)
    mut ew := make(list[int64], c_allocator)
    mut part := 0
    for part < 2 {
        part +%= 1
        if part == 2 && !all {
            break
        }
        mut ei int64 = 0
        mut count := len(g.admitted)
        if part == 2 {
            count = len(g.pending)
        }
        for ei < count {
            mut e := rel_edge_in(g.admitted[:], ei)
            if part == 2 {
                e = rel_edge_in(g.pending[:], ei)
            }
            ei +%= 1
            a, has_a := g.index[e.frm]
            bn, has_b := g.index[e.to]
            if !has_a || !has_b {
                continue
            }
            if reverse {
                append(mut ea, bn)?
                append(mut eb, a)?
            } else {
                append(mut ea, a)?
                append(mut eb, bn)?
            }
            append(mut ew, e.w)?
        }
    }
    mut dist := make(list[int64], c_allocator)
    mut known := make(list[bool], c_allocator)
    push_ints(mut dist, 0, n)?
    mut zi int64 = 0
    for zi < n {
        append(mut known, false)?
        zi +%= 1
    }
    set_bool(mut known, src, true)
    if g.alike {
        round_bounds(ea[:], eb[:], ew[:], n, mut dist, mut known)
    } else {
        settled := exact_bounds(ea[:], eb[:], ew[:], n, mut dist, mut known)?
        if !settled {
            g.diverged = true
            if !g.admitting {
                full, has := mut c.full_graph(g.q)?
                if has {
                    old := replace(mut g, full)
                    drop(own old)
                    r := mut c.find_dists(mut g, src, reverse, all)?
                    return r, noerror
                }
            }
        }
    }
    base := len(g.dists)
    append(mut g.dists, dist[:]...)?
    append(mut g.known, known[:]...)?
    if all && reverse {
        put(mut g.all_to, src, base)?
    } else if all {
        put(mut g.all_from, src, base)?
    } else if reverse {
        put(mut g.dist_to, src, base)?
    } else {
        put(mut g.dist_from, src, base)?
    }
    return base, noerror
}

// full_graph returns the graph keeping every edge alike for the query q,
// built from the facts in force now, which are those the graph that
// dropped them was built from: every query asks its graph at once.
func (mut c Checker) full_graph(q GraphQuery) (RelGraph, bool, error) {
    outer := c.typed_relations
    c.typed_relations = q.typed
    g, has, e := mut c.graph_of(q, true)
    c.typed_relations = outer
    return g, has, e
}

// round_bounds finds in dist and known the bounds from the node they
// mark known, Go's roundBounds: for at most n rounds, each edge, from
// ea[i] to eb[i] of weight ew[i], followed in order, a sum past an int64
// left out, until a round changes none.
func round_bounds(ea []int64, eb []int64, ew []int64, n int64, mut dist list[int64], mut known list[bool]) {
    mut round int64 = 0
    for round < n {
        round +%= 1
        mut changed := false
        mut i int64 = 0
        for i < len(ea) {
            a := int_in(ea, i)
            bn := int_in(eb, i)
            w := int_in(ew, i)
            i +%= 1
            if !bool_at(known[:], a) {
                continue
            }
            s, ok := sum_int64(int_in(dist[:], a), w)
            if ok && (!bool_at(known[:], bn) || s < int_in(dist[:], bn)) {
                set_int(mut dist, bn, s)
                set_bool(mut known, bn, true)
                changed = true
            }
        }
        if !changed {
            break
        }
    }
}

// exact_bounds finds in dist and known the bounds from the node they
// mark known,
// Go's exactBounds: summed in 128 bits, a high and a low half, for at most
// n rounds, and reports whether they settled, a round changing none and
// every bound fitting an int64. The bounds kept are those that fit.
func exact_bounds(ea []int64, eb []int64, ew []int64, n int64, mut dist list[int64], mut known list[bool]) (bool, error) {
    mut his := make(list[int64], c_allocator)
    mut los := make(list[uint64], c_allocator)
    push_ints(mut his, 0, n)?
    mut zi int64 = 0
    for zi < n {
        append(mut los, 0)?
        zi +%= 1
    }
    mut settled := false
    mut round int64 = 0
    for round < n {
        round +%= 1
        mut changed := false
        mut i int64 = 0
        for i < len(ea) {
            a := int_in(ea, i)
            bn := int_in(eb, i)
            w := int_in(ew, i)
            i +%= 1
            if !bool_at(known[:], a) {
                continue
            }
            hi, lo := wide_add(int_in(his[:], a), u64_in(los[:], a), w)
            if !bool_at(known[:], bn) || wide_less(hi, lo, int_in(his[:], bn), u64_in(los[:], bn)) {
                set_int(mut his, bn, hi)
                set_at(mut los, bn, lo)
                set_bool(mut known, bn, true)
                changed = true
            }
        }
        if !changed {
            settled = true
            break
        }
    }
    mut i int64 = 0
    for i < n {
        if bool_at(known[:], i) {
            v, fits := wide_int64(int_in(his[:], i), u64_in(los[:], i))
            if fits {
                set_int(mut dist, i, v)
            } else {
                set_bool(mut known, i, false)
                settled = false
            }
        }
        i +%= 1
    }
    return settled, noerror
}

// u64_in returns l[i], or 0.
func u64_in(l []uint64, i int64) uint64 {
    v, ok := l[i]
    if !ok {
        return 0
    }
    return v
}

// wide_add returns the 128-bit sum of hi:lo, in two's complement, and w,
// Go's wide.add.
func wide_add(hi int64, lo uint64, w int64) (int64, uint64) {
    mut uw uint64 = 0
    mut sign int64 = 0
    if w >= 0 {
        v, ok := uint64(w)
        if ok {
            uw = v
        }
    } else {
        // -(w + 1) is an int64 for every negative w; its complement is w's
        // low 64 bits.
        v, ok := uint64(-(w + 1))
        if ok {
            uw = ^v
        }
        sign = -1
    }
    sum := lo +% uw
    mut carry int64 = 0
    if sum < lo {
        carry = 1
    }
    return hi +% sign +% carry, sum
}

// wide_less reports whether ah:al is less than bh:bl, Go's wide.less.
func wide_less(ah int64, al uint64, bh int64, bl uint64) bool {
    return ah < bh || ah == bh && al < bl
}

// wide_int64 returns hi:lo as an int64, when it fits one, Go's
// wide.int64.
func wide_int64(hi int64, lo uint64) (int64, bool) {
    if hi == 0 && lo < 9223372036854775808 {
        v, ok := int64(lo)
        return v, ok
    }
    if hi == -1 && lo >= 9223372036854775808 {
        v, ok := int64(^lo)
        if ok {
            return (-%v) -% 1, true
        }
    }
    return 0, false
}

// set_bool sets l[i] to v, when l has an i'th.
func set_bool(mut l list[bool], i int64, v bool) {
    set_at(mut l, i, v)
}

// sum_int64 returns a + b, and false when it is past what an int64
// holds, Go's sum.
func sum_int64(a int64, b int64) (int64, bool) {
    s := a +% b
    if b > 0 && s < a || b < 0 && s > a {
        return 0, false
    }
    return s, true
}

// bound returns what the graph knows of node x less node y, when it
// knows something, Go's relGraph.bound.
func (mut c Checker) bound(mut g RelGraph, x FKey, y FKey) (int64, bool, error) {
    i, ok_x := g.index[x]
    j, ok_y := g.index[y]
    if !ok_x || !ok_y {
        return 0, false, noerror
    }
    base := mut c.find_dists(mut g, i, false, false)?
    return int_in(g.dists[:], base +% j), bool_at(g.known[:], base +% j), noerror
}

// bound_to is bound, found from y backwards, Go's relGraph.boundTo.
func (mut c Checker) bound_to(mut g RelGraph, x FKey, y FKey) (int64, bool, error) {
    i, ok_x := g.index[x]
    j, ok_y := g.index[y]
    if !ok_x || !ok_y {
        return 0, false, noerror
    }
    base := mut c.find_dists(mut g, j, true, false)?
    return int_in(g.dists[:], base +% i), bool_at(g.known[:], base +% i), noerror
}

// proves reports whether the graph proves x - y <= w, Go's
// relGraph.proves.
func (mut c Checker) proves(mut g RelGraph, x FKey, y FKey, w constant.Int) (bool, error) {
    d, ok := mut c.bound(mut g, x, y)?
    return ok && constant.from_int64(d).cmp(w) <= 0, noerror
}

// proves_all reports whether the graph with every pending edge admitted
// too proves x - y <= w, Go's withPending().proves.
func (mut c Checker) proves_all(mut g RelGraph, x FKey, y FKey, w constant.Int) (bool, error) {
    i, ok_x := g.index[x]
    j, ok_y := g.index[y]
    if !ok_x || !ok_y {
        return false, noerror
    }
    base := mut c.find_dists(mut g, i, false, true)?
    d := int_in(g.dists[:], base +% j)
    return bool_at(g.known[:], base +% j) && constant.from_int64(d).cmp(w) <= 0, noerror
}

// QueryW is the bound a query's graph must prove on x's node less y's,
// and whether any can prove it.
type QueryW struct {
    w constant.Int
    ok bool
}

// query_w returns the bound the graph must prove for x - y <= w, Go's
// query: w less x's offset plus y's.
func query_w(x LinTerm, y LinTerm, w constant.Int) QueryW {
    v, ok := w.sub(x.off)
    if !ok {
        return QueryW{w: v, ok: false}
    }
    r, ok2 := v.add(y.off)
    return QueryW{w: r, ok: ok2}
}

// relates reports whether the relations in force prove x - y <= w, Go's
// relates: whether the graph proves each term's conditions, that it is
// its node plus its offset, unwrapped (see arith_term), and x.node -
// y.node <= w - x.off + y.off. Two terms of the same node with no
// conditions need no facts.
func (mut c Checker) relates(x LinTerm, y LinTerm, w constant.Int) (bool, error) {
    q := query_w(x, y, w)
    if !q.ok {
        return false, noerror
    }
    if x.node == y.node && x.conds.count == 0 && y.conds.count == 0 {
        return constant.from_int64(0).cmp(q.w) <= 0, noerror
    }
    mut g, has := mut c.relation_graph(x.node, y.node, x.is_len, y.is_len, false)?
    if !has {
        return false, noerror
    }
    hx := mut c.holds_all(mut g, x.conds)?
    if !hx {
        return false, noerror
    }
    hy := mut c.holds_all(mut g, y.conds)?
    if !hy {
        return false, noerror
    }
    r := mut c.proves(mut g, x.node, y.node, q.w)?
    return r, noerror
}
