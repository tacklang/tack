package typeck

import ast from "tack/ast"
import fmt from "std/fmt"
import source from "tack/source"
import types from "tack/types"

// The generic builtins a body calls, Go's genericCall and the checks of
// list.go and arena.go's make: len, make, append, reserve, pop and
// remove, each checking its own arguments. What needs a proof, a plain
// pop's or remove's, is S3's and declined, as are the builtins of maps,
// arenas and pools that change them, put, delete, add, add_all and
// insert, and replace, swap and drop, which are S6's.

// is_generic_builtin reports whether name is a generic builtin's, one
// Go's genericCall checks.
func is_generic_builtin(name []uint8) bool {
    return bytes_equal(name, []uint8("len")) || bytes_equal(name, []uint8("make")) || bytes_equal(name, []uint8("append")) || bytes_equal(name, []uint8("reserve")) || bytes_equal(name, []uint8("pop")) || bytes_equal(name, []uint8("remove")) || bytes_equal(name, []uint8("swap")) || bytes_equal(name, []uint8("replace")) || bytes_equal(name, []uint8("put")) || bytes_equal(name, []uint8("delete")) || bytes_equal(name, []uint8("has")) || bytes_equal(name, []uint8("drop")) || bytes_equal(name, []uint8("add")) || bytes_equal(name, []uint8("add_all")) || bytes_equal(name, []uint8("insert"))
}

// generic_call checks the call k when it calls a generic builtin, Go's
// genericCall and the checker it returns, and returns the call's type
// and whether it was one.
func (mut c Checker) generic_call(k Key) (types.Type, bool, error) {
    name, is_builtin := builtin_name(c.prog.trees, c.none, k)?
    if !is_builtin || !is_generic_builtin(name) {
        return types.invalid, false, noerror
    }
    if bytes_equal(name, []uint8("len")) {
        t := mut c.len_call(k)?
        return t, true, noerror
    }
    if bytes_equal(name, []uint8("make")) {
        t := mut c.make_call(k)?
        return t, true, noerror
    }
    if bytes_equal(name, []uint8("has")) {
        t := mut c.has_call(k)?
        mut c.set_node_type(k, t)?
        return t, true, noerror
    }
    if bytes_equal(name, []uint8("append")) {
        t := mut c.append_call(k)?
        return t, true, noerror
    }
    if bytes_equal(name, []uint8("reserve")) {
        t := mut c.reserve_call(k)?
        return t, true, noerror
    }
    if bytes_equal(name, []uint8("pop")) {
        t := mut c.pop_call(k)?
        return t, true, noerror
    }
    if bytes_equal(name, []uint8("remove")) {
        t := mut c.remove_call(k)?
        return t, true, noerror
    }
    return types.invalid, true, not_ported
}

// made_name reports whether the name x, nm, written as make's first
// argument, names a type, Go's madeName.
func (mut c Checker) made_name(x Key, nm ast.Ident) bool {
    if nm.def.kind == ast.def_type || nm.def.kind == ast.def_type_param {
        return true
    }
    if !nm.def.is_none() || len(text_at(c.prog.trees, c.none, x.unit, nm.pkg)) > 0 {
        return false
    }
    _, basic := types.lookup(text_at(c.prog.trees, c.none, x.unit, nm.name))
    return basic || bytes_equal(text_at(c.prog.trees, c.none, x.unit, nm.name), []uint8("Data"))
}

// made_type reports whether e is a type make can make as written, Go's
// madeType: a list, map, arena or pool type, or a name of a type.
func (mut c Checker) made_type(e Key) bool {
    switch kind_at(c.prog.trees, e) {
    case list_type, map_type, arena_type, pool_type:
        return true
    case ident(nm):
        return mut c.made_name(e, nm)
    default:
        return false
    }
}

// make_call checks a call to make, k, and records the type it makes on
// the call, Go's makeCall: a list, map, arena or pool type or a Data
// type's name, then an Allocator.
func (mut c Checker) make_call(k Key) (types.Type, error) {
    cl := call_of(c.prog.trees, k)
    n := count_items(c.prog.trees, k.unit, cl.args)
    if n > 0 {
        first := item_at(c.prog.trees, k.unit, cl.args, 0)
        switch kind_at(c.prog.trees, first) {
        case arena_type:
            at := mut c.declared_type(first)?
            t := mut c.make_arena(k, at)?
            return t, noerror
        default:
        }
    }
    mut name := msg()
    append(mut name, []uint8("make")...)?
    ok := mut c.check_arity(k, name, 2)?
    if !ok {
        for i := range n {
            arg := item_at(c.prog.trees, k.unit, cl.args, i)
            if mut c.made_type(arg) {
                mut c.declared_type(arg)?
                continue
            }
            mut c.arg_expr(arg)?
        }
        return types.invalid, noerror
    }
    first := item_at(c.prog.trees, k.unit, cl.args, 0)
    alloc := item_at(c.prog.trees, k.unit, cl.args, 1)
    nm, is_id := ident_at(c.prog.trees, first)
    if is_id && nm.def.kind == ast.def_unbound {
        mut c.arg_expr(alloc)?
        return types.invalid, noerror
    }
    if !mut c.made_type(first) {
        mut c.arg_expr(first)?
        mut m := msg()
        fmt.appendf(mut m, "make takes a list, a map, an arena, a pool or a Data type, as in make(list[int64], c_allocator)")?
        mut c.errorf(span_at(c.prog.trees, first), own m)?
        mut c.arg_expr(alloc)?
        return types.invalid, noerror
    }
    mut typ := mut c.declared_type(first)?
    if is_id && typ != types.invalid {
        typ = mut c.made_data(first, typ)?
    }
    at := mut c.expr(alloc)?
    mut ctx := msg()
    append(mut ctx, []uint8("in argument to make")...)?
    used := mut c.use(alloc, at, types.allocator, ctx)?
    if !used || typ == types.invalid {
        return types.invalid, noerror
    }
    mut c.set_node_type(k, typ)?
    return typ, noerror
}

// make_arena checks a call to make of an arena type, k, whose type is
// typ, Go's makeArena: the sentinel, then an Allocator.
func (mut c Checker) make_arena(k Key, typ types.Type) (types.Type, error) {
    cl := call_of(c.prog.trees, k)
    mut name := msg()
    append(mut name, []uint8("make")...)?
    ok := mut c.check_arity(k, name, 3)?
    n := count_items(c.prog.trees, k.unit, cl.args)
    if !ok {
        mut i int64 = 1
        for i < n {
            mut c.arg_expr(item_at(c.prog.trees, k.unit, cl.args, i))?
            i +%= 1
        }
        return types.invalid, noerror
    }
    before := len(c.diags)
    sentinel := item_at(c.prog.trees, k.unit, cl.args, 1)
    if typ != types.invalid {
        mut c.check_arg(sentinel, arg_param("sentinel", c.table.elem_of(typ)), name)?
    } else {
        mut c.arg_expr(sentinel)?
    }
    alloc := item_at(c.prog.trees, k.unit, cl.args, 2)
    at := mut c.expr(alloc)?
    mut ctx := msg()
    append(mut ctx, []uint8("in argument to make")...)?
    mut c.use(alloc, at, types.allocator, ctx)?
    if len(c.diags) > before || typ == types.invalid {
        return types.invalid, noerror
    }
    mut c.set_node_type(k, typ)?
    return typ, noerror
}

// made_data returns typ, the type the name x names as make's first
// argument, when make can make it by name, Go's madeData: a Data type. A
// type parameter, a struct, a list and a map, whose Data rules are
// generics', S7's, are declined; any other type is reported, as Go's
// notData names it.
func (mut c Checker) made_data(x Key, typ types.Type) (types.Type, error) {
    if typ == types.bool_type || types.is_integer(typ) || types.is_float(typ) {
        return typ, noerror
    }
    if c.table.is_type_param(typ) || c.table.is_struct(typ) || c.table.is_list(typ) || c.table.is_map(typ) {
        return types.invalid, not_ported
    }
    n := mut c.type_name(typ)?
    mut m := msg()
    fmt.appendf(mut m, "cannot make %s: ", n[:])?
    mut c.kind_name(typ, mut m)?
    append(mut m, []uint8(" is not Data")...)?
    mut c.errorf(span_at(c.prog.trees, x), own m)?
    return types.invalid, noerror
}

// kind_name appends the kind of typ, a type that is not Data and is
// made of no Data parts, Go's kindName.
func (mut c Checker) kind_name(typ types.Type, mut out list[uint8]) error {
    mut s := ""
    if typ == types.string_type {
        s = "a string"
    } else if typ == types.allocator {
        s = "an Allocator"
    } else if typ == types.any_type {
        s = "an any"
    } else if c.table.is_array(typ) {
        s = "an array"
    } else if c.table.is_view(typ) {
        s = "a view"
    } else if c.table.is_union(typ) {
        s = "a union"
    } else if c.table.is_func(typ) {
        s = "a function value"
    } else if c.table.is_arena(typ) {
        s = "an arena"
    } else if c.table.is_pool(typ) {
        s = "a pool"
    } else if c.table.is_id(typ) {
        s = "an id"
    } else if c.table.is_span(typ) {
        s = "a span"
    } else if c.table.is_handle(typ) {
        s = "a handle"
    } else {
        n := mut c.type_name(typ)?
        append(mut out, n[:]...)?
        return noerror
    }
    append(mut out, []uint8(s)...)?
    return noerror
}

// list_target checks arg, the list a call to builtin grows or takes
// from, which must be passed as mut and be a place of a list type, or,
// for reserve, of an arena type, or, for remove, of a pool type, Go's
// listTarget, and returns its element type, invalid when anything was
// reported.
func (mut c Checker) list_target(arg Key, builtin string) (types.Type, error) {
    mut x := no_key()
    switch kind_at(c.prog.trees, arg) {
    case mut_arg(inner):
        x = sub(arg, inner)
    default:
    }
    if is_no_key(x) {
        t := mut c.expr(arg)?
        mut name := "l"
        if c.table.is_pool(t) && bytes_equal([]uint8(builtin), []uint8("remove")) {
            name = "p"
        }
        mut callee := msg()
        append(mut callee, []uint8(builtin)...)?
        mut c.missing_mut(arg, arg_param(name, types.invalid), callee)?
        return types.invalid, noerror
    }
    got := mut c.place(x, arg)?
    if got == types.invalid {
        return types.invalid, noerror
    }
    is_reserve := bytes_equal([]uint8(builtin), []uint8("reserve"))
    is_remove := bytes_equal([]uint8(builtin), []uint8("remove"))
    if is_reserve && c.table.is_arena(got) {
        return c.table.elem_of(got), noerror
    }
    n := mut c.type_name(got)?
    mut m := msg()
    if is_reserve && !c.table.is_list(got) {
        fmt.appendf(mut m, "reserve expects a list or an arena, got %s", n[:])?
        mut c.errorf(span_at(c.prog.trees, x), own m)?
        return types.invalid, noerror
    }
    if is_remove && c.table.is_pool(got) {
        return c.table.elem_of(got), noerror
    }
    if is_remove && !c.table.is_list(got) {
        fmt.appendf(mut m, "remove expects a list or a pool, got %s", n[:])?
        mut c.errorf(span_at(c.prog.trees, x), own m)?
        return types.invalid, noerror
    }
    if !c.table.is_list(got) {
        fmt.appendf(mut m, "%s expects a list, got %s", builtin, n[:])?
        mut c.errorf(span_at(c.prog.trees, x), own m)?
        return types.invalid, noerror
    }
    return c.table.elem_of(got), noerror
}

// append_call checks a call to append, k, records its type, error, on
// the call and returns it, Go's appendCall.
func (mut c Checker) append_call(k Key) (types.Type, error) {
    cl := call_of(c.prog.trees, k)
    mut name := msg()
    append(mut name, []uint8("append")...)?
    ok := mut c.check_variadic_arity(k, name, 1, arg_param("elems", types.invalid))?
    if !ok {
        mut c.arg_exprs(k)?
        return types.invalid, noerror
    }
    before := len(c.diags)
    elem := mut c.list_target(item_at(c.prog.trees, k.unit, cl.args, 0), "append")?
    if cl.spread {
        spread := item_at(c.prog.trees, k.unit, cl.args, 1)
        mut c.append_spread(spread, elem, name)?
        owned := c.table.owned(elem)?
        if len(c.diags) == before && owned {
            t := mut c.source_text(span_at(c.prog.trees, spread))?
            mut what := msg()
            mut c.owned_phrase(elem, mut what)?
            mut m := msg()
            fmt.appendf(mut m, "cannot spread %s into append: its elements would be copied, and %s cannot be", t[:], what[:])?
            mut c.errorf(span_at(c.prog.trees, spread), own m)?
        }
    } else {
        value := arg_param("elems", elem)
        mut i int64 = 1
        for i < count_items(c.prog.trees, k.unit, cl.args) {
            mut c.check_arg(item_at(c.prog.trees, k.unit, cl.args, i), value, name)?
            i +%= 1
        }
    }
    mut c.check_list_borrows(k)?
    if len(c.diags) > before {
        return types.invalid, noerror
    }
    mut c.set_node_type(k, types.error_type)?
    return types.error_type, noerror
}

// append_spread checks arg, the view a call to builtin spreads into its
// variadic parameter of type []T for the element type elem, Go's
// appendSpread.
func (mut c Checker) append_spread(arg Key, elem types.Type, builtin list[uint8]) error {
    if elem != types.invalid {
        vt := mut c.table.view_of(elem)?
        mut p := arg_param("elems", vt)
        p.variadic = true
        mut c.check_arg(arg, p, builtin)?
        return noerror
    }
    switch kind_at(c.prog.trees, arg) {
    case call(acl):
        switch kind_at(c.prog.trees, sub(arg, acl.fn)) {
        case view_type:
            mut c.view_conversion(arg)?
            return noerror
        default:
        }
    default:
    }
    return mut c.arg_expr(arg)
}

// reserve_call checks a call to reserve, k, records its type, error, on
// the call and returns it, Go's reserveCall.
func (mut c Checker) reserve_call(k Key) (types.Type, error) {
    cl := call_of(c.prog.trees, k)
    mut name := msg()
    append(mut name, []uint8("reserve")...)?
    ok := mut c.check_arity(k, name, 2)?
    if !ok {
        mut c.arg_exprs(k)?
        return types.invalid, noerror
    }
    before := len(c.diags)
    mut c.list_target(item_at(c.prog.trees, k.unit, cl.args, 0), "reserve")?
    n := item_at(c.prog.trees, k.unit, cl.args, 1)
    mut c.check_arg(n, arg_param("n", types.int64_type), name)?
    if len(c.diags) > before {
        return types.invalid, noerror
    }
    v, known := mut c.known_value(n)?
    if known && v.is_negative() {
        mut m := msg()
        fmt.appendf(mut m, "reserve count must not be negative, got ")?
        v.append_string(mut m)?
        mut c.errorf(span_at(c.prog.trees, n), own m)?
        return types.invalid, noerror
    }
    mut c.set_node_type(k, types.error_type)?
    return types.error_type, noerror
}

// pop_call checks a call to pop, k, records the type of the element it
// gives on the call and returns it, Go's popCall: the plain form needs
// the list proven not empty, S3's, and is declined.
func (mut c Checker) pop_call(k Key) (types.Type, error) {
    cl := call_of(c.prog.trees, k)
    mut name := msg()
    append(mut name, []uint8("pop")...)?
    ok := mut c.check_arity(k, name, 1)?
    if !ok {
        mut c.arg_exprs(k)?
        return types.invalid, noerror
    }
    elem := mut c.list_target(item_at(c.prog.trees, k.unit, cl.args, 0), "pop")?
    if elem == types.invalid {
        return types.invalid, noerror
    }
    mut c.set_node_type(k, elem)?
    if c.checked_take != k && c.dropped_call != k {
        return types.invalid, not_ported
    }
    return elem, noerror
}

// remove_call checks a call to remove, k, records the type of the
// element it gives on the call and returns it, Go's removeCall: a pool's
// remove, and the plain form, which needs its index proven in range,
// are declined.
func (mut c Checker) remove_call(k Key) (types.Type, error) {
    cl := call_of(c.prog.trees, k)
    mut name := msg()
    append(mut name, []uint8("remove")...)?
    ok := mut c.check_arity(k, name, 2)?
    if !ok {
        mut c.arg_exprs(k)?
        return types.invalid, noerror
    }
    before := len(c.diags)
    first := item_at(c.prog.trees, k.unit, cl.args, 0)
    elem := mut c.list_target(first, "remove")?
    switch kind_at(c.prog.trees, first) {
    case mut_arg(x):
        ft := mut c.type_of(sub(first, x))
        if c.table.is_pool(ft) {
            return types.invalid, not_ported
        }
    default:
    }
    i := item_at(c.prog.trees, k.unit, cl.args, 1)
    first_type := mut c.type_of(first)
    if c.table.is_pool(first_type) {
        mut c.arg_expr(i)?
        return types.invalid, noerror
    }
    mut c.check_arg(i, arg_param("i", types.int64_type), name)?
    if len(c.diags) > before || elem == types.invalid {
        return types.invalid, noerror
    }
    mut c.set_node_type(k, elem)?
    v, known := mut c.known_value(i)?
    if known && v.is_negative() {
        return types.invalid, not_ported
    }
    if c.checked_take != k && c.dropped_call != k {
        return types.invalid, not_ported
    }
    return elem, noerror
}

// take_results checks a call to pop or remove, k, bound to want names
// covering sp, the checked form, Go's takeResults, and appends its two
// values' types to out.
func (mut c Checker) take_results(k Key, want int64, sp source.Span, mut out list[types.Type]) (bool, error) {
    outer := c.checked_take
    c.checked_take = k
    elem := mut c.expr(k)?
    c.checked_take = outer
    if elem == types.invalid {
        return false, noerror
    }
    if want != 2 {
        name, _ := builtin_name(c.prog.trees, c.none, k)?
        mut m := msg()
        fmt.appendf(mut m, "assignment mismatch: %d variables but %s gives 2 values", want, name[:])?
        mut c.errorf(sp, own m)?
        return false, noerror
    }
    append(mut out, elem)?
    append(mut out, types.bool_type)?
    return true, noerror
}
