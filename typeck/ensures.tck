package typeck

import ast from "tack/ast"
import constant from "tack/constant"
import diag from "tack/diag"
import fmt from "std/fmt"
import source from "tack/source"
import types from "tack/types"

// A function's contract, Go's ensures.go: func f(d int64) ensures d != 0
// states facts about its parameters that hold whenever it returns,
// which the checker proves in its body and gives to its callers.
//
// The clause is checked with the signature, before any body, as Go's
// checkContract checks it: its shape, that it is a bool, and that each
// operand of its top-level && gives a fact, the facts facts_from gives
// for it being true, each about a parameter or a path below one, which
// are recorded as the function's contract (see ClauseFact). In the
// body, every path that returns must prove each of them (see
// prove_contract): each return, each ?, and the end of the body when it
// can be reached, with the facts in force there; code after a statement
// that leaves never runs and proves anything, and a defer written
// before a return whose code writes a variable a fact names fails the
// proof. At a call, the facts are put in force after the statement the
// call is, or is the whole value of, for the rest of the block, each
// parameter replaced by the variable of the caller passed for it (see
// call_contract_facts).
//
// The clause is type-checked as a body's expression is, where it ends,
// with what the left side of each && says in force for its right side,
// so its arithmetic is proven, or reported, as in a body (see
// clause_type).

// ClauseFact is one fact a contract gives, Go's clauseFact: the fact,
// leaf, the operand of the clause's top-level && that gives it, base,
// what the fact's subject's type, or a length's range, says of it
// without any fact, and is_len, whether that subject is a string, view
// or list, whose length the fact is about. A difference bound's record,
// which the facts of a body keep only for that body, is kept here,
// diff, with its conditions, cond_count of contract_conds from conds.
type ClauseFact struct {
    leaf Key
    f Fact
    base Interval
    is_len bool
    diff DiffBound
    conds int64
    cond_count int64
}

// CRun is a function's contract: the count ClauseFacts of contract_facts
// from start.
type CRun struct {
    start int64
    count int64
}

// check_contract checks the ensures clause of the function at d, Go's
// checkContract: an extern func's is reported; any other's shape, then
// its type, then, when neither was reported, the facts each operand of
// its top-level && gives.
func (mut c Checker) check_contract(d Key) error {
    fn := func_of(c.prog.trees, d)
    if ast.is_none(fn.contract) {
        return noerror
    }
    clause := sub(d, fn.contract)
    if fn.is_extern {
        mut sp := fn.ensures_span
        sp.end = span_at(c.prog.trees, clause).end
        mut m := msg()
        fmt.appendf(mut m, "extern func %s cannot have an ensures clause; its body is written in C, where nothing proves it", text_at(c.prog.trees, c.none, d.unit, fn.name)[:])?
        return mut c.errorf(sp, own m)
    }
    before := len(c.diags)
    mut c.clause_shape(d, clause)?
    if len(c.diags) == before {
        v := mut c.clause_type(d, clause)?
        if v != types.invalid && v != types.bool_type {
            n := mut c.type_name(v)?
            mut m := msg()
            fmt.appendf(mut m, "ensures clause must be a bool, got %s", n[:])?
            mut c.errorf(span_at(c.prog.trees, clause), own m)?
        }
    }
    if len(c.diags) > before {
        return noerror
    }
    // The operands of the top-level &&, in source order, Go's
    // conjuncts: an && on either side is walked through, from a stack of
    // its own.
    mut stack := make(list[Key], c_allocator)
    append(mut stack, clause)?
    start := len(c.contract_facts)
    for len(stack) > 0 {
        x, ok := pop(mut stack)
        if !ok {
            break
        }
        switch kind_at(c.prog.trees, x) {
        case binary(b):
            if b.op == ast.op_and {
                append(mut stack, sub(x, b.y))?
                append(mut stack, sub(x, b.x))?
                continue
            }
        default:
        }
        mut c.leaf_facts(x)?
    }
    if len(c.diags) == before {
        put(mut c.contracts, d, CRun{start: start, count: len(c.contract_facts) -% start})?
    }
    return noerror
}

// clause_type checks clause, the ensures clause of the function at d, of
// the right shape, as an expression, Go's checkClauseType, and returns
// its type: as a body's, with what the left side of an && says in force
// for its right side and the provers judging its arithmetic, where it
// ends.
func (mut c Checker) clause_type(d Key, clause Key) (types.Type, error) {
    outer := replace(mut c.body, BodyState{fn: d, loops: 0, deferred: 0, defer_loops: 0, field_loop: 0, in_rejected_defer: false, clauses: make(list[ClauseAt], c_allocator)})
    was := c.in_body
    c.in_body = true
    at := c.fx.at
    c.fx.at = span_at(c.prog.trees, clause).end
    v, e := mut c.clause_value(clause)
    c.fx.at = at
    c.in_body = was
    mine := replace(mut c.body, outer)
    drop(own mine)
    return v, e
}

// clause_value checks clause as an expression and returns its value's
// type, for clause_type.
func (mut c Checker) clause_value(clause Key) (types.Type, error) {
    got := mut c.expr(clause)?
    v := mut c.value_of(clause, got)?
    return v, noerror
}

// clause_shape reports each part of e, the clause of the function at d,
// that a clause cannot hold, Go's clauseShape, in Go's order, by a walk
// with a stack of its own, since an operator's chain nests without end.
func (mut c Checker) clause_shape(d Key, e Key) error {
    mut stack := make(list[id[ast.Node]], c_allocator)
    append(mut stack, e.node)?
    for len(stack) > 0 {
        n := pop(mut stack)
        k := sub(e, n)
        switch kind_at(c.prog.trees, k) {
        case ident(nm):
            mut c.clause_name(d, k, nm)?
        case int_lit, float_lit, char_lit, str_lit, bool_lit:
        case selector(s):
            append(mut stack, s.x)?
        case index(ix):
            append(mut stack, ix.index)?
            append(mut stack, ix.x)?
        case unary(u):
            if u.op == ast.unary_not || u.op == ast.unary_neg {
                append(mut stack, u.x)?
            } else {
                mut c.clause_cannot_hold(k)?
            }
        case binary(b):
            if b.op == ast.op_and || b.op == ast.op_or || b.op == ast.op_add || b.op == ast.op_sub || is_comparison_op(b.op) {
                append(mut stack, b.y)?
                append(mut stack, b.x)?
            } else {
                mut c.clause_cannot_hold(k)?
            }
        case call(cl):
            nm, is_id := ident_at(c.prog.trees, sub(k, cl.fn))
            if !is_id || nm.def.kind != ast.def_builtin || !bytes_equal(text_at(c.prog.trees, c.none, k.unit, nm.name), []uint8("len")) && !bytes_equal(text_at(c.prog.trees, c.none, k.unit, nm.name), []uint8("has")) {
                t := mut c.source_text(span_at(c.prog.trees, sub(k, cl.fn)))?
                mut m := msg()
                fmt.appendf(mut m, "an ensures clause can call only len and has, not %s", t[:])?
                mut c.errorf(span_at(c.prog.trees, sub(k, cl.fn)), own m)?
                continue
            }
            mut i := count_items(c.prog.trees, k.unit, cl.args)
            for i > 0 {
                i -%= 1
                append(mut stack, item_at(c.prog.trees, k.unit, cl.args, i).node)?
            }
        default:
            mut c.clause_cannot_hold(k)?
        }
    }
    return noerror
}

// clause_name reports the name nm at k, in the clause of the function at
// d, unless it names one of its parameters that is not own, or nothing
// because of an error already reported, Go's clauseName.
func (mut c Checker) clause_name(d Key, k Key, nm ast.Ident) error {
    if nm.def.kind == ast.def_unbound {
        return noerror
    }
    p := key_of_def(nm.def)
    if nm.def.kind == ast.def_param && is_param_of(c.prog.trees, d, p) {
        param := param_of(c.prog.trees, p)
        if !param.is_own {
            return noerror
        }
        mut name := msg()
        append(mut name, name_of(c.prog.trees, c.none, p)...)?
        mut m := msg()
        fmt.appendf(mut m, "an ensures clause cannot name own parameter %s: its argument moves into the call, so nothing it ensures about %s reaches the caller", name[:], name[:])?
        return mut c.errorf(span_at(c.prog.trees, k), own m)
    }
    mut m := msg()
    fmt.appendf(mut m, "an ensures clause can name only the parameters of ")?
    mut c.display_name(d, mut m)?
    fmt.appendf(mut m, ", and ")?
    qualified(c.prog.trees, c.none, k.unit, nm, mut m)?
    fmt.appendf(mut m, " is not one")?
    return mut c.errorf(span_at(c.prog.trees, k), own m)
}

// is_param_of reports whether p is one of the parameters of the function
// at d.
func is_param_of(trees []ast.File, d Key, p Key) bool {
    fn := func_of(trees, d)
    for i := range count_items(trees, d.unit, fn.params) {
        if item_at(trees, d.unit, fn.params, i) == p {
            return true
        }
    }
    return false
}

// clause_cannot_hold reports e, a part of an ensures clause no fact can
// be learned through, Go's clauseCannotHold.
func (mut c Checker) clause_cannot_hold(e Key) error {
    t := mut c.source_text(span_at(c.prog.trees, e))?
    mut m := msg()
    fmt.appendf(mut m, "an ensures clause cannot hold %s; it compares parameters, their fields and elements, constants, len and has, with !, &&, ||, + and -", t[:])?
    return mut c.errorf(span_at(c.prog.trees, e), own m)
}

// leaf_facts records the facts leaf, an operand of an ensures clause's
// top-level &&, gives when true, Go's leafFacts,
// and reports a leaf that gives none: naming the part of a mut
// parameter it is about, when it is, and the facts a clause can state
// otherwise. A value ruled out, r != -1, is a fact no clause gives: only
// a division's proof asks about one.
func (mut c Checker) leaf_facts(leaf Key) error {
    mut facts := make(list[Fact], c_allocator)
    mut c.facts_from(node_cond(leaf), true, mut facts)?
    n := len(c.contract_facts)
    for _, f0 := range facts {
        if !(!f0.is_empty() && !f0.has_ne || !f0.in_map.is_zero()) {
            continue
        }
        mut f := f0
        f.src = no_cond()
        f.guard = -1
        f.ends = -1
        base, is_len := mut c.base_of(leaf, f.about)?
        mut cf := ClauseFact{leaf: leaf, f: f, base: base, is_len: is_len, diff: c.diff_at(-1), conds: 0, cond_count: 0}
        if f.diff >= 0 {
            cf.diff = c.diff_at(f.diff)
            cf.conds = len(c.contract_conds)
            cf.cond_count = cf.diff.conds.count
            mut j int64 = 0
            for j < cf.diff.conds.count {
                append(mut c.contract_conds, c.cond_at(cf.diff.conds, j))?
                j +%= 1
            }
        }
        append(mut c.contract_facts, cf)?
    }
    if len(c.contract_facts) > n {
        return noerror
    }
    t := mut c.source_text(span_at(c.prog.trees, leaf))?
    part, root, found := mut c.mut_part(leaf)?
    mut m := msg()
    if found {
        pt := mut c.source_text(span_at(c.prog.trees, part))?
        fmt.appendf(mut m, "%s gives no fact; %s is part of the mut parameter %s, and a field or an element of a mut parameter carries no facts", t[:], pt[:], name_of(c.prog.trees, c.none, root)[:])?
    } else {
        fmt.appendf(mut m, "%s gives no fact; an ensures clause states facts an if's condition proves, such as d != 0, 0 <= i && i < len(a), err.code == 0 or has(m, k)", t[:])?
    }
    return mut c.errorf(span_at(c.prog.trees, leaf), own m)
}

// base_of returns what is known of the subject k, named in leaf,
// without any fact, Go's baseOf: the range of a length, of an error's
// code, or of the subject's integer type, or nothing for any other, and
// whether k is a length. The first node of leaf, in Go's walk order,
// whose subject is k decides.
func (mut c Checker) base_of(leaf Key, k FKey) (Interval, bool, error) {
    mut stack := make(list[id[ast.Node]], c_allocator)
    append(mut stack, leaf.node)?
    for len(stack) > 0 {
        n, ok := pop(mut stack)
        if !ok {
            break
        }
        e := sub(leaf, n)
        got, is := mut c.subject(e)?
        if !is || got != k {
            push_children(c.prog.trees, e, mut stack)?
            continue
        }
        _, is_len := mut c.string_var(e)?
        _, is_len_call := mut c.string_len(e)?
        _, is_code := mut c.error_code_key(e)?
        if is_len || is_len_call {
            return length_range(), true, noerror
        }
        if is_code {
            return code_interval(), false, noerror
        }
        return type_interval(mut c.type_of(e)), false, noerror
    }
    return no_interval(), false, noerror
}

// mut_root returns the mut parameter e, a field or an element, is part
// of, Go's mutRoot: none for anything else, an error's code included.
func (mut c Checker) mut_root(e Key) (Key, bool) {
    switch kind_at(c.prog.trees, e) {
    case selector(s):
        if bytes_equal(text_at(c.prog.trees, c.none, e.unit, s.name), []uint8("code")) && mut c.type_of(sub(e, s.x)) == types.error_type {
            return no_key(), false
        }
    case index:
    default:
        return no_key(), false
    }
    mut x := e
    for {
        switch kind_at(c.prog.trees, x) {
        case selector(s):
            x = sub(x, s.x)
        case index(ix):
            x = sub(x, ix.x)
        case ident(nm):
            if nm.def.kind == ast.def_param && param_of(c.prog.trees, key_of_def(nm.def)).is_mut {
                return key_of_def(nm.def), true
            }
            return no_key(), false
        default:
            return no_key(), false
        }
    }
}

// mut_part returns the first field or element in leaf, in Go's Walk
// order, below a mut parameter, with that parameter, Go's mutPart.
func (mut c Checker) mut_part(leaf Key) (Key, Key, bool, error) {
    mut stack := make(list[id[ast.Node]], c_allocator)
    append(mut stack, leaf.node)?
    for len(stack) > 0 {
        n := pop(mut stack)
        k := sub(leaf, n)
        root, found := mut c.mut_root(k)
        if found {
            return k, root, true, noerror
        }
        push_children(c.prog.trees, k, mut stack)?
    }
    return no_key(), no_key(), false, noerror
}

// DRun is the defers of a function's body: the count keys of defer_list
// from start.
type DRun struct {
    start int64
    count int64
}

// ContractArg is what a call passes for one parameter, as a contract's
// facts are carried over, Go's contractArg: the caller's variable decl,
// and the argument naming it, arg.
type ContractArg struct {
    decl Key
    arg Key
}

// clause_fact returns the fact of the clause fact cf, its difference
// bound, if any, recorded again among the facts of the body being
// checked, which name it by position.
func (mut c Checker) clause_fact(cf ClauseFact) (Fact, error) {
    mut f := cf.f
    if f.diff < 0 {
        return f, noerror
    }
    mut d := cf.diff
    d.conds = no_conds()
    mut j int64 = 0
    for j < cf.cond_count {
        w, ok := c.contract_conds[cf.conds +% j]
        j +%= 1
        if ok {
            d.conds = mut c.conds_push(d.conds, w)?
        }
    }
    f.diff = len(c.fx.diffs)
    append(mut c.fx.diffs, d)?
    return f, noerror
}

// prove_contract reports each fact the contract of the function fnk
// gives that the facts in force do not prove where it returns, Go's
// proveContractWhere: at the return ret, whose keyword is sp, at the end
// of its body, its closing brace, or at a ?, for no ret, where naming
// which. Only one error is reported for each operand of the clause's
// &&. Code that never runs, after a statement that leaves, and deferred
// code are not asked about.
func (mut c Checker) prove_contract(fnk Key, sp source.Span, ret Key, where string) error {
    run, has := c.contracts[fnk]
    if !has || c.dead > 0 || c.body.deferred > 0 {
        return noerror
    }
    m := c.mark()
    mut e := mut c.assume_return_call(ret)
    mut reported := make(list[Key], c_allocator)
    mut i int64 = 0
    for e.code == 0 && i < run.count {
        cf, ok := c.contract_facts[run.start +% i]
        i +%= 1
        if !ok {
            continue
        }
        mut was := false
        for _, r := range reported {
            was = was || r == cf.leaf
        }
        if was {
            continue
        }
        mut notes := make(list[diag.Related], c_allocator)
        held, e2 := mut c.contract_holds(fnk, cf, sp, mut notes)
        if e2.code != 0 {
            e = e2
            break
        }
        if held {
            continue
        }
        append(mut reported, cf.leaf)?
        lsp := span_at(c.prog.trees, cf.leaf)
        mut ensured := msg()
        append(mut ensured, []uint8("ensured here")...)?
        push_note(mut notes, lsp, own ensured)?
        mut text := msg()
        mut c.display_name(fnk, mut text)?
        append(mut text, []uint8(" ensures ")...)?
        t := mut c.source_text(lsp)?
        append(mut text, t[:]...)?
        append(mut text, []uint8(", which may not hold ")...)?
        append(mut text, []uint8(where)...)?
        e = mut c.error_notes(sp, own text, own notes)
    }
    r := mut c.release(m)
    if e.code != 0 {
        return e
    }
    return r
}

// prove_return_contract proves the contract of the function being
// checked at the return k, once every value is computed, so that a write
// that takes effect at the return's end, return f(mut d), counts, Go's
// end of checkReturn.
func (mut c Checker) prove_return_contract(k Key) error {
    mut kw := span_at(c.prog.trees, k)
    kw.end = kw.start +% 6
    outer := c.fx.at
    c.fx.at = span_at(c.prog.trees, k).end +% 1
    e := mut c.prove_contract(c.body.fn, kw, k, "at this return")
    c.fx.at = outer
    return e
}

// prove_end_contract proves the contract of the function d, whose body
// was just checked, at the end of its body, its closing brace, Go's
// checkBody's proveContract.
func (mut c Checker) prove_end_contract(d Key) error {
    mut end := span_at(c.prog.trees, d)
    end.start = end.end -% 1
    outer := c.fx.at
    c.fx.at = end.end
    e := mut c.prove_contract(d, end, no_key(), "at the end of its body")
    c.fx.at = outer
    return e
}

// prove_question_contract proves the contract of the function holding
// the ? k at it, which returns when its call's error is set, Go's
// proveQuestionContract: the call is done by then, so a write it makes
// through a mut argument counts.
func (mut c Checker) prove_question_contract(k Key) error {
    outer := c.fx.at
    c.fx.at = span_at(c.prog.trees, k).end +% 1
    e := mut c.prove_contract(c.body.fn, mut c.question_mark(k), no_key(), "at this ?")
    c.fx.at = outer
    return e
}

// assume_return_call puts in force the facts the one value of the
// return ret gives, when it is a call to a function with a contract,
// return fix(mut d), Go's assumeReturnCall: they hold once the call is
// done, and nothing runs between it and the return but the defers,
// whose writes prove_contract judges.
func (mut c Checker) assume_return_call(ret Key) error {
    if is_no_key(ret) {
        return noerror
    }
    mut values := empty_nodes()
    switch kind_at(c.prog.trees, ret) {
    case return_stmt(s):
        values = s.values
    default:
        return noerror
    }
    if count_items(c.prog.trees, ret.unit, values) != 1 {
        return noerror
    }
    v := item_at(c.prog.trees, ret.unit, values, 0)
    switch kind_at(c.prog.trees, v) {
    case call:
    default:
        return noerror
    }
    mut facts := make(list[Fact], c_allocator)
    none := make(list[Key], c_allocator)
    g, has := mut c.call_contract_facts(v, none[:], mut facts)?
    if !has {
        return noerror
    }
    return mut c.assume(g, facts[:], none[:])
}

// contract_holds reports whether cf holds where the function fnk returns
// at sp, Go's contractHolds, appending to notes the note on the deferred
// code that ends it when that is why it does not.
func (mut c Checker) contract_holds(fnk Key, cf ClauseFact, sp source.Span, mut notes list[diag.Related]) (bool, error) {
    f := mut c.clause_fact(cf)?
    d := mut c.defer_write(fnk, f, sp)?
    if d >= 0 {
        mut c.defer_note(d, fnk, mut notes)?
        return false, noerror
    }
    r := mut c.contract_proves(cf, f)?
    return r, noerror
}

// defer_write returns the first write to a variable f names in deferred
// code of the function fnk written before sp, which runs after a return
// at sp, or -1 when there is none, Go's deferWrite.
func (mut c Checker) defer_write(fnk Key, f Fact, sp source.Span) (int64, error) {
    run := mut c.defers_of(fnk)?
    mut i int64 = 0
    for i < run.count {
        d := key_in(c.defer_list[:], run.start +% i)
        i +%= 1
        if span_at(c.prog.trees, d).end > sp.start {
            continue
        }
        mut nodes := make(list[Key], c_allocator)
        switch kind_at(c.prog.trees, d) {
        case defer_stmt(ds):
            c.stmt_keys(d.unit, ds.body, mut nodes)?
        default:
        }
        idx := mut c.index_writes(nodes[:])?
        why := c.first_write_drop(idx, f)
        if why >= 0 {
            return why, noerror
        }
    }
    return -1, noerror
}

// defers_of returns every defer in the body of the function fnk, at any
// depth, in Go's walk order, found once and kept, Go's defersOf.
func (mut c Checker) defers_of(fnk Key) (DRun, error) {
    run, has := c.defers[fnk]
    if has {
        return run, noerror
    }
    start := len(c.defer_list)
    fn := func_of(c.prog.trees, fnk)
    mut stack := make(list[id[ast.Node]], c_allocator)
    mut i := count_items(c.prog.trees, fnk.unit, fn.body)
    for i > 0 {
        i -%= 1
        append(mut stack, item_at(c.prog.trees, fnk.unit, fn.body, i).node)?
    }
    for len(stack) > 0 {
        n, ok := pop(mut stack)
        if !ok {
            break
        }
        k := Key{unit: fnk.unit, node: n}
        switch kind_at(c.prog.trees, k) {
        case defer_stmt:
            append(mut c.defer_list, k)?
        default:
        }
        push_children(c.prog.trees, k, mut stack)?
    }
    nrun := DRun{start: start, count: len(c.defer_list) -% start}
    put(mut c.defers, fnk, nrun)?
    return nrun, noerror
}

// defer_note appends to notes the note on the drop d, a write in
// deferred code, that ends a fact the function fnk ensures, since the
// code runs after it returns, Go's drop.deferNote.
func (mut c Checker) defer_note(d int64, fnk Key, mut notes list[diag.Related]) error {
    dr := c.drop_at(d)
    mut m := msg()
    append(mut m, []uint8("but ")...)?
    append(mut m, name_of(c.prog.trees, c.none, dr.decl)...)?
    if dr.kind == drop_mut {
        append(mut m, []uint8(" is passed as mut to ")...)?
        mut i int64 = 0
        for i < dr.text_len {
            append(mut m, byte_at(c.fx.drop_text[:], dr.text_start +% i))?
            i +%= 1
        }
        append(mut m, []uint8(" here, in deferred code, which runs after ")...)?
    } else {
        append(mut m, []uint8(" is assigned here, in deferred code, which runs after ")...)?
    }
    mut c.display_name(fnk, mut m)?
    append(mut m, []uint8(" returns")...)?
    return push_note(mut notes, dr.at, own m)
}

// contract_proves reports whether the facts in force prove f, the fact of the
// clause fact cf, Go's proves: a key in a map by a fact that says so, a
// relation by the relations in force, or a bound by what is known of its
// subject, or else by the relations.
func (mut c Checker) contract_proves(cf ClauseFact, f Fact) (bool, error) {
    about := lin_term(f.about, constant.from_int64(0), false)
    minus_one := constant.from_int64(-1)
    if !f.in_map.is_zero() {
        r := mut c.proves_member(f)?
        return r, noerror
    }
    if !f.len_of.is_zero() {
        r := mut c.relates(about, lin_term(f.len_of, constant.from_int64(0), true), minus_one)?
        return r, noerror
    }
    if !f.at_most_len.is_zero() {
        r := mut c.relates(about, lin_term(f.at_most_len, constant.from_int64(0), true), constant.from_int64(0))?
        return r, noerror
    }
    if !f.at_most.is_zero() {
        mut w := constant.from_int64(0)
        if f.strict {
            w = minus_one
        }
        r := mut c.relates(about, lin_term(f.at_most, constant.from_int64(0), false), w)?
        return r, noerror
    }
    if f.diff >= 0 {
        r := mut c.proves_diff(c.diff_at(f.diff))?
        return r, noerror
    }
    r := mut c.proves_bounds(cf, f)?
    return r, noerror
}

// proves_diff reports whether the facts in force prove the difference
// bound d, Go's provesDiff: the relations in force do, or a fact in force
// is the same bound, or a tighter one, holding under no more conditions,
// as the clause's own comparison tested in an early exit gives.
func (mut c Checker) proves_diff(d DiffBound) (bool, error) {
    x := lin_term(d.x, constant.from_int64(0), d.x_len)
    y := lin_term(d.y, constant.from_int64(0), d.y_len)
    r := mut c.relates(x, y, d.w)?
    if r {
        return true, noerror
    }
    mut i int64 = 0
    for i < len(c.fx.active) {
        g := fact_in(c.fx.active[:], i)
        in_force := c.fact_in_force(i)
        i +%= 1
        if !in_force || g.diff < 0 {
            continue
        }
        o := c.diff_at(g.diff)
        if o.x != d.x || o.y != d.y || o.x_len != d.x_len || o.y_len != d.y_len || o.w.cmp(d.w) > 0 || !c.every_cond(o.conds, d.conds) {
            continue
        }
        h := mut c.holds(g)?
        if h {
            return true, noerror
        }
    }
    return false, noerror
}

// every_cond reports whether each of conds is one of within, Go's
// everyCond.
func (c Checker) every_cond(conds Conds, within Conds) bool {
    mut i int64 = 0
    for i < conds.count {
        a := c.cond_at(conds, i)
        i +%= 1
        mut found := false
        mut j int64 = 0
        for j < within.count && !found {
            found = same_cond(a, c.cond_at(within, j))
            j +%= 1
        }
        if !found {
            return false
        }
    }
    return true
}

// same_cond reports whether a and b are the same condition, Go's
// sameCond.
func same_cond(a NoWrap, b NoWrap) bool {
    return a.of == b.of && a.is_len == b.is_len && a.has_lo == b.has_lo && a.has_hi == b.has_hi && (!a.has_lo || a.lo.cmp(b.lo) == 0) && (!a.has_hi || a.hi.cmp(b.hi) == 0)
}

// proves_bounds reports whether the facts in force keep the subject of f,
// the fact of cf, of which cf.base is known without any, within the
// bounds f puts on it, and away from zero when it does, Go's
// provesBounds.
func (mut c Checker) proves_bounds(cf ClauseFact, f Fact) (bool, error) {
    known := mut c.known_of(cf, f)?
    about := lin_term(f.about, constant.from_int64(0), cf.is_len)
    if f.nonzero && !known.excludes_zero() {
        return false, noerror
    }
    if f.has_lo {
        lo := mut c.at_least_by(known, about, f.lo)?
        if !lo {
            return false, noerror
        }
    }
    if f.has_hi {
        hi := mut c.at_most_of(known, about, f.hi)?
        if !hi {
            return false, noerror
        }
    }
    return true, noerror
}

// proves_member reports whether a fact in force says what f, a key's
// being in a map, does: the same key in the same map, Go's provesMember.
func (mut c Checker) proves_member(f Fact) (bool, error) {
    mut facts := make(list[Fact], c_allocator)
    mut c.held_facts_about(f.about, mut facts)?
    for _, g := range facts {
        if g.in_map == f.in_map && g.known == f.known {
            h := mut c.holds(g)?
            if h {
                return true, noerror
            }
        }
    }
    return false, noerror
}

// known_of returns what the facts in force say of the subject of f, the
// fact of cf, starting from what cf.base knows of it, and, for a length,
// what a successful append proves, with a bound at zero moved past it
// where zero is ruled out, Go's knownOf.
func (mut c Checker) known_of(cf ClauseFact, f Fact) (Interval, error) {
    mut known := cf.base
    mut facts := make(list[Fact], c_allocator)
    mut c.held_facts_about(f.about, mut facts)?
    for _, g := range facts {
        if !g.in_map.is_zero() {
            continue
        }
        h := mut c.holds(g)?
        if h {
            known = known.narrow(g)
        }
    }
    if cf.is_len {
        known = mut c.appended_len(f.about, known)?
    }
    return known.tightened(), noerror
}

// contract_call returns the call stmt is, or is the whole value of, a
// declaration or an assignment, of one value or several, appending to
// targets every target the statement assigns once the call is done, or
// no key, Go's contractCall.
func (mut c Checker) contract_call(stmt Key, mut targets list[Key]) (Key, error) {
    mut value := no_key()
    switch kind_at(c.prog.trees, stmt) {
    case expr_stmt(s):
        value = sub(stmt, s.x)
    case var_decl(v):
        if !ast.is_none(v.value) {
            value = sub(stmt, v.value)
        }
    case multi_var(m):
        value = sub(stmt, m.value)
    case assign(a):
        value = sub(stmt, a.value)
        append(mut targets, sub(stmt, a.target))?
    case multi_assign(m):
        value = sub(stmt, m.value)
        c.stmt_keys(stmt.unit, m.targets, mut targets)?
    default:
        return no_key(), noerror
    }
    switch kind_at(c.prog.trees, value) {
    case call:
        return value, noerror
    default:
        return no_key(), noerror
    }
}

// stmt_contract_facts appends to facts what the call stmt is, or is the whole
// value of, gives the statements after it in its block by its callee's
// contract, and returns the guard they come from, Go's contractFacts.
func (mut c Checker) stmt_contract_facts(stmt Key, mut facts list[Fact]) (Guard, bool, error) {
    mut targets := make(list[Key], c_allocator)
    call := mut c.contract_call(stmt, mut targets)?
    if is_no_key(call) {
        return no_guard(), false, noerror
    }
    g, has, e := mut c.call_contract_facts(call, targets[:], mut facts)
    return g, has, e
}

// call_contract_facts appends to facts what call gives by its callee's
// contract once it is done, and returns the guard they come from, or
// false when it gives none, Go's callContractFacts: targets are what
// the statement holding the call assigns after it, whose variables carry
// nothing.
func (mut c Checker) call_contract_facts(call Key, targets []Key, mut facts list[Fact]) (Guard, bool, error) {
    fnk := mut c.callee_of(call)
    if is_no_key(fnk) {
        return no_guard(), false, noerror
    }
    run, has := c.contracts[fnk]
    if !has {
        return no_guard(), false, noerror
    }
    mut ops := make(list[Key], c_allocator)
    mut c.call_operands(call, mut ops)?
    fn := func_of(c.prog.trees, fnk)
    if len(ops) != count_items(c.prog.trees, fnk.unit, fn.params) {
        return no_guard(), false, noerror
    }
    args := mut c.contract_args(fnk, call, ops[:], targets)?
    before := len(facts)
    mut i int64 = 0
    for i < run.count {
        cf, ok := c.contract_facts[run.start +% i]
        i +%= 1
        if !ok {
            continue
        }
        f := mut c.clause_fact(cf)?
        out, carried := mut c.carry_contract_fact(f, args)?
        if carried {
            append(mut facts, out)?
        }
    }
    if len(facts) == before {
        return no_guard(), false, noerror
    }
    return Guard{cond: no_cond(), span: span_at(c.prog.trees, call), kind: guard_ensures}, true, noerror
}

// contract_args returns, for each parameter of the function fnk, what
// call, whose operands are ops, passes for it, Go's contractArgs: a
// local variable or a parameter of the caller by name, passed as mut, or
// as a plain argument nothing else in the call writes, that the
// statement holding the call does not assign once it is done, in
// targets, nor write anywhere in them.
func (mut c Checker) contract_args(fnk Key, call Key, ops []Key, targets []Key) (map[Key]ContractArg, error) {
    mut assigned := make(map[Key]bool, c_allocator)
    for _, t := range targets {
        d := mut c.written_decl(t)?
        if !is_no_key(d) {
            put(mut assigned, d, true)?
        }
    }
    mut args := make(map[Key]ContractArg, c_allocator)
    fn := func_of(c.prog.trees, fnk)
    for i, op := range ops {
        p := item_at(c.prog.trees, fnk.unit, fn.params, i)
        name, ok := mut c.carrier(p, op, call)?
        if !ok {
            continue
        }
        nm, _ := ident_at(c.prog.trees, name)
        decl := key_of_def(nm.def)
        _, was := assigned[decl]
        if was {
            continue
        }
        w := mut c.written_in(targets, decl)?
        if !w {
            put(mut args, p, ContractArg{decl: decl, arg: name})?
        }
    }
    return args, noerror
}

// carrier returns the name arg, an argument of call passed for the
// parameter p, is when facts about p can be about it, Go's carrier: a
// local variable or a parameter of the caller by name, passed as mut, or
// as a plain argument nothing else in the call writes; a view parameter
// passed an array carries nothing, nor does a variadic one.
func (mut c Checker) carrier(p Key, arg Key, call Key) (Key, bool, error) {
    mut x := arg
    mut is_mut := false
    switch kind_at(c.prog.trees, arg) {
    case mut_arg(inner):
        x = sub(arg, inner)
        is_mut = true
    default:
    }
    nm, is_id := ident_at(c.prog.trees, x)
    if !is_id || !nm.def.is_decl() || param_of(c.prog.trees, p).variadic {
        return no_key(), false, noerror
    }
    decl := key_of_def(nm.def)
    if !c.caller_var(decl) {
        return no_key(), false, noerror
    }
    xt := mut c.type_of(x)
    if c.table.is_view(decl_type_of(c.decl_types, p)) && c.table.is_array(xt) {
        return no_key(), false, noerror
    }
    if is_mut {
        return x, true, noerror
    }
    // The call itself is walked, so that its own mut arguments count:
    // f(mut i, i) changes i after the callee was given its value.
    mut nodes := make(list[Key], c_allocator)
    append(mut nodes, call)?
    w := mut c.written_in(nodes[:], decl)?
    return x, !w, noerror
}

// caller_var reports whether decl is a local variable or a parameter, of
// the function being checked, Go's callerVar.
func (c Checker) caller_var(decl Key) bool {
    switch kind_at(c.prog.trees, decl) {
    case param_decl:
        return true
    case var_decl:
        _, global := c.globals[decl]
        return !global
    default:
        return false
    }
}

// written_in reports whether anything in nodes writes decl, as
// each_write finds writes, a call passing it as mut included, Go's
// writtenIn.
func (mut c Checker) written_in(nodes []Key, decl Key) (bool, error) {
    mut found := make(list[EachWrite], c_allocator)
    mut loops := make(list[source.Span], c_allocator)
    mut c.each_write(nodes, decl, mut found, mut loops)?
    return len(found) > 0, noerror
}

// carry_contract_fact returns f, a fact about a callee's parameters,
// with each replaced by the caller's variable args holds for it, and
// whether every one it names has one that can carry it, Go's carryFact
// (see carriable); a key in a map is known as member_of knows the
// argument.
func (mut c Checker) carry_contract_fact(f Fact, args map[Key]ContractArg) (Fact, bool, error) {
    mut ok := true
    mut out := f
    if f.in_map.is_zero() {
        out.about, ok = mut c.carry_key_of(f.about, args, ok)?
    } else {
        k := f.about
        if !k.is_zero() {
            if k.path != 0 {
                out.about, ok = mut c.carry_key_of(k, args, ok)?
                ok = ok && mut c.immutable_decl(out.about.decl)
            } else {
                a, found := args[k.decl]
                if !found {
                    return f, false, noerror
                }
                about, known, member := mut c.member_of(a.arg)?
                out.about = about
                out.known = known
                if !member {
                    return f, false, noerror
                }
            }
        }
    }
    out.len_of, ok = mut c.carry_key_of(f.len_of, args, ok)?
    out.at_most_len, ok = mut c.carry_key_of(f.at_most_len, args, ok)?
    out.at_most, ok = mut c.carry_key_of(f.at_most, args, ok)?
    out.in_map, ok = mut c.carry_key_of(f.in_map, args, ok)?
    if f.diff >= 0 {
        mut d := c.diff_at(f.diff)
        d.x, ok = mut c.carry_key_of(d.x, args, ok)?
        d.y, ok = mut c.carry_key_of(d.y, args, ok)?
        mut conds := no_conds()
        mut j int64 = 0
        for j < d.conds.count {
            mut w := c.cond_at(d.conds, j)
            j +%= 1
            w.of, ok = mut c.carry_key_of(w.of, args, ok)?
            conds = mut c.conds_push(conds, w)?
        }
        d.conds = conds
        out.diff = len(c.fx.diffs)
        append(mut c.fx.diffs, d)?
    }
    out.ends = -1
    out.drop = -1
    out.guard = -1
    out.src = no_cond()
    return out, ok, noerror
}

// carry_key_of returns k, a subject below a callee's parameter, carried
// to the caller's variable args holds for that parameter, Go's sub in
// carryFact, and ok still set when it can be; k itself and false when it
// cannot, or once ok is not set.
func (mut c Checker) carry_key_of(k FKey, args map[Key]ContractArg, ok bool) (FKey, bool, error) {
    if k.is_zero() || !ok {
        return k, ok, noerror
    }
    a, found := args[k.decl]
    if !found {
        return k, false, noerror
    }
    can := mut c.carriable(k, a.decl)?
    if !can {
        return k, false, noerror
    }
    return FKey{decl: a.decl, path: k.path}, true, noerror
}

// carriable reports whether a fact about k, a subject below a callee's
// parameter, can be about the same path below decl, the caller's
// variable passed for it, Go's carriable: the parameter itself always
// can; a path only below an immutable variable or parameter, or as an
// error's code, and only when every index in it is a known value.
func (mut c Checker) carriable(k FKey, decl Key) (bool, error) {
    if k.path == 0 {
        return true, noerror
    }
    mut p := msg()
    c.path_text(k.path, mut p)?
    if named_index(p[:]) {
        return false, noerror
    }
    if mut c.immutable_decl(decl) {
        return true, noerror
    }
    return bytes_equal(p[:], []uint8(".code")) && decl_type_of(c.decl_types, decl) == types.error_type, noerror
}

// named_index reports whether path, a subject's path below its
// variable, has an element whose index is written as a name rather than
// a value, Go's namedIndex.
func named_index(path []uint8) bool {
    mut i int64 = 0
    for i < len(path) {
        b := byte_at(path, i)
        i +%= 1
        if b != '[' {
            continue
        }
        if i >= len(path) {
            return true
        }
        n := byte_at(path, i)
        if n != '-' && (n < '0' || n > '9') {
            return true
        }
    }
    return false
}
