package typeck

import types from "tack/types"

// supported_type reports whether a value of typ is one whose checks the
// port's body check covers: any type but a function type or a type
// parameter, or anything holding one, whose values are S7's. The answer
// for each type is remembered, and the types it is made of are walked
// with a stack of their own, so a chain of structs each holding the next
// is walked in a bounded stack.
func (mut c Checker) supported_type(typ types.Type) (bool, error) {
    known, seen := c.plain_types[typ.number()]
    if seen {
        return known, noerror
    }
    mut stack := make(list[types.Type], c_allocator)
    mut visited := make(map[int64]bool, c_allocator)
    append(mut stack, typ)?
    mut ok := true
    for ok && len(stack) > 0 {
        t, has := pop(mut stack)
        if !has {
            break
        }
        _, been := visited[t.number()]
        if been {
            continue
        }
        put(mut visited, t.number(), true)?
        prior, has_prior := c.plain_types[t.number()]
        if has_prior {
            ok = prior
            continue
        }
        if c.table.is_func(t) || c.table.is_type_param(t) {
            ok = false
            continue
        }
        if c.table.is_array(t) || c.table.is_view(t) || c.table.is_list(t) || c.table.is_arena(t) || c.table.is_pool(t) || c.table.is_ref(t) {
            append(mut stack, c.table.elem_of(t))?
            continue
        }
        if c.table.is_map(t) {
            append(mut stack, c.table.key_of(t))?
            append(mut stack, c.table.elem_of(t))?
            continue
        }
        if c.table.is_union(t) {
            for _, uc := range c.table.cases(t) {
                if uc.payload {
                    append(mut stack, uc.typ)?
                }
            }
            continue
        }
        if c.table.is_struct(t) {
            for i := range c.table.field_count(t) {
                ft, has_ft := c.table.field_type(t, i)
                if has_ft {
                    append(mut stack, ft)?
                }
            }
            continue
        }
    }
    put(mut c.plain_types, typ.number(), ok)?
    return ok, noerror
}
