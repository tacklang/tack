package typeck

import ast from "tack/ast"
import fmt from "std/fmt"
import types from "tack/types"

// The nodes of the --port-types dump, written once bodies are checked:
// every node of every tree, each tree's declarations in order and each
// node before the nodes it holds, in the order Go's ast.Walk visits them
// (see ast.children), with what the checker recorded on it. A case
// clause, a field and a union's case, nodes here but parts of their
// node in Go, are left out, as Go's walk visits no node for them.
//
// Each node is an object of its kind, Go's type name; its type, Go's
// ast.TypeOf of an expression and the Type of a variable or a
// parameter, 0 for anything else; its constant, the Const of a binary, a
// unary, a call or a variable, as the dump writes a constant (see
// write_const), null for anything else; the type a call converts to,
// conv; the type a name was narrowed to, narrowed; whether a switch on a
// union names every case, exhaustive; whether a variable is one a
// fields loop unrolled, unrolled; and whether a name moves the value of
// the variable it names, Go's Ident.Move (see mv_move). A call to a
// generic function has its type arguments, parameters' and results'
// types too (see write_call_types), a fields loop's fields(T) what it
// ranges over and lists (see write_fields_of), a switch on a type
// parameter how its cases match (see write_type_cases) and a closure
// its captures (see write_captures).

// write_nodes appends the nodes of every tree to out, as a list.
func (mut c Checker) write_nodes(mut out list[uint8]) error {
    append(mut out, '[')?
    mut first := true
    mut stack := make(list[DumpItem], c_allocator)
    mut kids := make(list[id[ast.Node]], c_allocator)
    for u := range len(c.prog.trees) {
        clear_items(mut stack)
        mut i := tree_decl_count(c.prog.trees, u) -% 1
        for i >= 0 {
            append(mut stack, DumpItem{node: tree_decl(c.prog.trees, u, i), site: false})?
            i -%= 1
        }
        for len(stack) > 0 {
            top, ok := pop(mut stack)
            if !ok {
                break
            }
            k := Key{unit: u, node: top.node}
            if top.site {
                mut c.write_site_arg(mut out, k)?
                continue
            }
            name := node_kind_name(c.prog.trees, k)
            if len(name) > 0 {
                if !first {
                    append(mut out, ',')?
                }
                first = false
                mut c.write_node(mut out, k, name)?
            }
            clear_nodes(mut kids)
            mut c.dump_children(k, mut kids)?
            mut at int64 = -1
            sa, has_site := c.site_args[k]
            if has_site {
                switch kind_at(c.prog.trees, k) {
                case call(cl):
                    at = 1 +% count_items(c.prog.trees, u, cl.type_args) +% sa.index
                default:
                }
            }
            mut j := len(kids)
            for j >= 0 {
                if j < len(kids) {
                    kid, has := kids[j]
                    if has {
                        append(mut stack, DumpItem{node: kid, site: false})?
                    }
                }
                if j == at {
                    // Pushed after the argument it goes before, so that
                    // it is written first.
                    append(mut stack, DumpItem{node: top.node, site: true})?
                }
                j -%= 1
            }
        }
    }
    append(mut out, ']')?
    return noerror
}

// dump_children appends to kids the nodes Go's ast.Walk visits under k:
// a node's children, but for a closure, whose function Go's walk
// passes over to visit its parameters, results and body, and a function
// type, whose parameters' types Go's walk visits in place of them.
func (mut c Checker) dump_children(k Key, mut kids list[id[ast.Node]]) error {
    switch kind_at(c.prog.trees, k) {
    case func_lit(fn):
        children_of(c.prog.trees, k.unit, fn, mut kids)?
        return noerror
    case func_type:
        mut all := make(list[id[ast.Node]], c_allocator)
        children_of(c.prog.trees, k.unit, k.node, mut all)?
        for _, n := range all {
            switch kind_at(c.prog.trees, sub(k, n)) {
            case param_decl:
                append(mut kids, param_of(c.prog.trees, sub(k, n)).type_expr)?
            default:
                append(mut kids, n)?
            }
        }
        return noerror
    default:
        children_of(c.prog.trees, k.unit, k.node, mut kids)?
        return noerror
    }
}

// DumpItem is a node the dump has yet to write, or, site set, the
// testing.Site argument Go put among the arguments of the call node (see
// SiteArg).
type DumpItem struct {
    node id[ast.Node]
    site bool
}

// clear_items empties l, keeping what it holds allocated.
func clear_items(mut l list[DumpItem]) {
    for len(l) > 0 {
        pop(mut l)
    }
}

// write_site_arg appends the nodes of the testing.Site argument Go put
// among the arguments of the call k, Go's passSite: the Site parameter
// of the function the call is in, a name, or a literal of the Site type
// whose four fields hold the call's place, as siteLit builds it.
func (mut c Checker) write_site_arg(mut out list[uint8], k Key) error {
    sa, has := c.site_args[k]
    if !has {
        return noerror
    }
    if !is_no_key(sa.param) {
        fmt.appendf(mut out, ",{\"kind\":\"Ident\",\"type\":%d,\"const\":null,\"conv\":0,\"narrowed\":0,\"exhaustive\":false,\"unrolled\":false,\"move\":false}", decl_type_of(c.decl_types, sa.param).number())?
        return noerror
    }
    write_plain_node(mut out, "CompositeLit", sa.typ.number())?
    for i := range 4 {
        write_plain_node(mut out, "KeyValue", 0)?
        write_plain_node(mut out, "Ident", 0)?
        if i == 0 || i == 3 {
            write_plain_node(mut out, "StrLit", types.string_type.number())?
        } else {
            write_plain_node(mut out, "IntLit", types.int64_type.number())?
        }
    }
    return noerror
}

// write_plain_node appends, after a comma, the dump's object of a node of
// the kind name and type typ, with nothing else recorded on it.
func write_plain_node(mut out list[uint8], name string, typ int64) error {
    fmt.appendf(mut out, ",{\"kind\":\"%s\",\"type\":%d,\"const\":null,\"conv\":0,\"narrowed\":0,\"exhaustive\":false,\"unrolled\":false,\"move\":false}", name, typ)?
    return noerror
}

// tree_decl_count returns how many declarations the tree unit has.
func tree_decl_count(trees []ast.File, unit int64) int64 {
    if unit < 0 || unit >= len(trees) {
        return 0
    }
    return len(trees[unit].decls)
}

// tree_decl returns the i'th declaration of the tree unit, or the
// sentinel.
func tree_decl(trees []ast.File, unit int64, i int64) id[ast.Node] {
    mut z id[ast.Node]
    if unit < 0 || unit >= len(trees) {
        return z
    }
    d, ok := trees[unit].decls[i]
    if !ok {
        return z
    }
    return d
}

// write_node appends the object of the node k, of the kind name.
func (mut c Checker) write_node(mut out list[uint8], k Key, name string) error {
    mut typ := types.invalid
    mut conv := types.invalid
    mut has_const := false
    mut cv := no_const()
    mut exhaustive := false
    switch kind_at(c.prog.trees, k) {
    case var_decl:
        typ = decl_type_of(c.decl_types, k)
        v, ok := c.var_consts[k]
        has_const = ok
        cv = v
    case param_decl:
        typ = decl_type_of(c.decl_types, k)
    case call(cl):
        _, cleared := c.conv_cleared[k]
        if !cleared {
            conv = cl.conv
        }
        vc, viewed := c.view_convs[k]
        if viewed {
            conv = vc
        }
        typ = mut c.node_type(k)
        v, ok := c.consts[k]
        has_const = ok
        cv = v
    case binary, unary:
        typ = mut c.node_type(k)
        v, ok := c.consts[k]
        has_const = ok
        cv = v
    case switch_stmt:
        _, ex := c.exhaustive[k]
        exhaustive = ex
    default:
        if is_expr_kind(c.prog.trees, k) {
            typ = mut c.node_type(k)
        }
    }
    fmt.appendf(mut out, "{\"kind\":\"%s\",\"type\":%d,\"const\":", name, typ.number())?
    if has_const {
        mut c.write_const(mut out, cv)?
    } else {
        append(mut out, []uint8("null")...)?
    }
    mut narrowed := types.invalid
    nt, has_narrowed := c.narrowed_names[k]
    if has_narrowed {
        narrowed = nt
    }
    fmt.appendf(mut out, ",\"conv\":%d,\"narrowed\":%d,\"exhaustive\":", conv.number(), narrowed.number())?
    write_bool(mut out, exhaustive)?
    _, moved := c.moves[k]
    _, unrolled := c.unrolled[k]
    fmt.appendf(mut out, ",\"unrolled\":")?
    write_bool(mut out, unrolled)?
    fmt.appendf(mut out, ",\"move\":")?
    write_bool(mut out, moved)?
    mut c.write_call_types(mut out, k)?
    mut c.write_fields_of(mut out, k)?
    mut c.write_type_cases(mut out, k)?
    mut c.write_captures(mut out, k)?
    append(mut out, '}')?
    return noerror
}

// write_call_types appends, for a call k to a generic function whose
// type arguments every type parameter has, its type arguments, its
// parameters' types and its results' types, Go's Call.TypeArgs,
// ParamTypes and ResultTypes (see record_signature).
func (mut c Checker) write_call_types(mut out list[uint8], k Key) error {
    n, has := c.call_targ_count[k]
    if !has {
        return noerror
    }
    fmt.appendf(mut out, ",\"type_args\":")?
    write_rtypes(mut out, c.call_targs, k, n)?
    mut np int64 = 0
    pc, has_p := c.call_pcount[k]
    if has_p {
        np = pc
    }
    fmt.appendf(mut out, ",\"param_types\":")?
    write_rtypes(mut out, c.call_ptypes, k, np)?
    mut nr int64 = 0
    rc, has_r := c.call_rcount[k]
    if has_r {
        nr = rc
    }
    fmt.appendf(mut out, ",\"result_types\":")?
    write_rtypes(mut out, c.call_rtypes, k, nr)?
    return noerror
}

// write_fields_of appends, for k a fields loop's fields(T), the type it
// ranges over the fields of and the type parameter v.[f] has, Go's
// FieldsOf.Type and Field, whether its body reads f.name, Go's Names, and
// the fields it lists for each type it is lowered for, Go's Unrolled.
func (mut c Checker) write_fields_of(mut out list[uint8], k Key) error {
    switch kind_at(c.prog.trees, k) {
    case fields_of:
    default:
        return noerror
    }
    mut ft := types.invalid
    t, has_t := c.fo_types[k]
    if has_t {
        ft = t
    }
    mut ff := types.invalid
    f, has_f := c.fo_fields[k]
    if has_f {
        ff = f
    }
    _, names := c.fo_names[k]
    fmt.appendf(mut out, ",\"fo_type\":%d,\"fo_field\":%d,\"names\":", ft.number(), ff.number())?
    write_bool(mut out, names)?
    fmt.appendf(mut out, ",\"fields_for\":[")?
    mut first := true
    for _, r := range c.unrolled_recs {
        if r.fo != k {
            continue
        }
        if !first {
            append(mut out, ',')?
        }
        first = false
        fmt.appendf(mut out, "{\"type\":%d,\"fields\":[", r.typ.number())?
        for i := range r.count {
            if i > 0 {
                append(mut out, ',')?
            }
            fi, ok := c.unrolled_fields[r.first +% i]
            if ok {
                fmt.appendf(mut out, "%d", fi)?
            }
        }
        fmt.appendf(mut out, "]}")?
    }
    append(mut out, ']')?
    return noerror
}

// write_type_cases appends, for k a switch on a type parameter, how
// each value of each of its cases matches, Go's CaseClause.TypeCases,
// a list for each case, in order.
func (mut c Checker) write_type_cases(mut out list[uint8], k Key) error {
    mut cases := make(list[Key], c_allocator)
    switch kind_at(c.prog.trees, k) {
    case switch_stmt(s):
        if !s.on_type {
            return noerror
        }
        for i := range count_items(c.prog.trees, k.unit, s.cases) {
            append(mut cases, item_at(c.prog.trees, k.unit, s.cases, i))?
        }
    default:
        return noerror
    }
    fmt.appendf(mut out, ",\"type_cases\":[")?
    for i, cl := range cases {
        if i > 0 {
            append(mut out, ',')?
        }
        append(mut out, '[')?
        first, count := mut c.type_cases_of(cl)
        for j := range count {
            if j > 0 {
                append(mut out, ',')?
            }
            tc, ok := c.tc_recs[first +% j]
            if ok {
                fmt.appendf(mut out, "{\"kind\":%d,\"type\":%d,\"key\":%d}", tc.kind, tc.typ.number(), tc.key.number())?
            }
        }
        append(mut out, ']')?
    }
    append(mut out, ']')?
    return noerror
}

// write_captures appends, for k a closure, its captures, Go's
// FuncLit.Captures: each the name of its variable, where it is first
// named, whether the closure may write it and where it first does.
func (mut c Checker) write_captures(mut out list[uint8], k Key) error {
    switch kind_at(c.prog.trees, k) {
    case func_lit:
    default:
        return noerror
    }
    first, count := mut c.lit_captures(k)
    fmt.appendf(mut out, ",\"captures\":[")?
    for i := range count {
        cp, ok := c.caps[first +% i]
        if !ok {
            continue
        }
        if i > 0 {
            append(mut out, ',')?
        }
        fmt.appendf(mut out, "{\"decl\":\"")?
        write_escaped(mut out, name_of(c.prog.trees, c.none, cp.decl))?
        fmt.appendf(mut out, "\",\"at\":%d,\"write\":", cp.at.start)?
        write_bool(mut out, cp.write)?
        mut wa int64 = 0
        if cp.write {
            wa = cp.write_at.start
        }
        fmt.appendf(mut out, ",\"write_at\":%d}", wa)?
    }
    append(mut out, ']')?
    return noerror
}

// write_rtypes appends the n types m holds for k, as a list of IDs.
func write_rtypes(mut out list[uint8], m map[RKey]types.Type, k Key, n int64) error {
    append(mut out, '[')?
    for i := range n {
        if i > 0 {
            append(mut out, ',')?
        }
        t, has := m[RKey{unit: k.unit, node: k.node, i: i}]
        if has {
            fmt.appendf(mut out, "%d", t.number())?
        } else {
            fmt.appendf(mut out, "0")?
        }
    }
    append(mut out, ']')?
    return noerror
}

// node_type returns the type of the expression k as Go's ast.TypeOf
// gives it once checking is done: as type_of does, but for a name a
// switch on a union took as a pattern, which Go unbinds, and a call it
// took as one, whose conversion Go forgets.
func (mut c Checker) node_type(k Key) types.Type {
    _, cleared := c.pattern_cleared[k]
    if cleared {
        return types.invalid
    }
    switch kind_at(c.prog.trees, k) {
    case call(cl):
        _, conv_gone := c.conv_cleared[k]
        if conv_gone && cl.conv != types.invalid {
            return node_type_of(c.node_types, k)
        }
    default:
    }
    return mut c.type_of(k)
}

// is_expr_kind reports whether the node k is an expression, a type as
// written among them, Go's ast.Expr.
func is_expr_kind(trees []ast.File, k Key) bool {
    switch kind_at(trees, k) {
    case call, ident, str_lit, float_lit, int_lit, char_lit, bool_lit, noerror_lit, c_allocator_lit, binary, unary, type_assert, array_type, view_type, list_type, arena_type, pool_type, ref_type, map_type, func_type, composite_lit, index, slice, struct_type, selector, question, key_value, mut_arg, own_arg, func_lit, fields_of, interface_type, struct_case, union_type:
        return true
    default:
        return false
    }
}

// node_kind_name returns the name of the Go type of the node k, or ""
// for a node of the port's that is none of Go's (see the comment at the
// top of the file).
func node_kind_name(trees []ast.File, k Key) string {
    switch kind_at(trees, k) {
    case func_decl:
        return "Func"
    case param_decl:
        return "Param"
    case var_decl:
        return "Var"
    case import_decl:
        return "Import"
    case type_decl:
        return "TypeDecl"
    case bad_decl:
        return "BadDecl"
    case type_param:
        return "TypeParam"
    case iface_method:
        return "IfaceMethod"
    case expr_stmt:
        return "ExprStmt"
    case return_stmt:
        return "Return"
    case if_stmt:
        return "If"
    case assign:
        return "Assign"
    case for_stmt:
        return "For"
    case break_stmt:
        return "Break"
    case continue_stmt:
        return "Continue"
    case unreachable_stmt:
        return "Unreachable"
    case fallthrough_stmt:
        return "Fallthrough"
    case inc_dec:
        return "IncDec"
    case multi_var:
        return "MultiVar"
    case multi_assign:
        return "MultiAssign"
    case for_range:
        return "ForRange"
    case switch_stmt:
        return "Switch"
    case defer_stmt:
        return "Defer"
    case region_stmt:
        return "Region"
    case bad_stmt:
        return "BadStmt"
    case call:
        return "Call"
    case ident:
        return "Ident"
    case str_lit:
        return "StrLit"
    case float_lit:
        return "FloatLit"
    case int_lit:
        return "IntLit"
    case char_lit:
        return "CharLit"
    case bool_lit:
        return "BoolLit"
    case noerror_lit:
        return "NoErrorLit"
    case c_allocator_lit:
        return "CAllocatorLit"
    case binary:
        return "Binary"
    case unary:
        return "Unary"
    case type_assert:
        return "TypeAssert"
    case array_type:
        return "ArrayType"
    case view_type:
        return "ViewType"
    case list_type:
        return "ListType"
    case arena_type:
        return "ArenaType"
    case pool_type:
        return "PoolType"
    case ref_type:
        return "RefType"
    case map_type:
        return "MapType"
    case func_type:
        return "FuncType"
    case composite_lit:
        return "CompositeLit"
    case index:
        return "Index"
    case slice:
        return "Slice"
    case struct_type:
        return "StructType"
    case selector:
        return "Selector"
    case question:
        return "Question"
    case key_value:
        return "KeyValue"
    case mut_arg:
        return "MutArg"
    case own_arg:
        return "OwnArg"
    case func_lit:
        return "FuncLit"
    case fields_of:
        return "FieldsOf"
    case interface_type:
        return "InterfaceType"
    case struct_case:
        return "StructCase"
    case union_type:
        return "UnionType"
    default:
        return ""
    }
}
