package typeck

import ast from "tack/ast"
import fmt from "std/fmt"
import types from "tack/types"

// The nodes of the --port-types dump, written once bodies are checked:
// every node of every tree, each tree's declarations in order and each
// node before the nodes it holds, in the order Go's ast.Walk visits them
// (see ast.children), with what the checker recorded on it. A case
// clause, a field and a union's case, nodes here but parts of their
// node in Go, are left out, as Go's walk visits no node for them.
//
// Each node is an object of its kind, Go's type name; its type, Go's
// ast.TypeOf of an expression and the Type of a variable or a
// parameter, 0 for anything else; its constant, the Const of a binary, a
// unary, a call or a variable, as the dump writes a constant (see
// write_const), null for anything else; the type a call converts to,
// conv; the type a name was narrowed to, narrowed; whether a switch on a
// union names every case, exhaustive; whether a variable is one a
// fields loop unrolled, unrolled; and whether a name moves the value of
// the variable it names, Go's Ident.Move (see mv_move). A call to a
// generic function has its type arguments, parameters' and results'
// types too, and a call to add, add_all or insert its results' types
// (see write_call_types), a fields loop's fields(T) what it
// ranges over and lists (see write_fields_of), a switch on a type
// parameter how its cases match (see write_type_cases), a closure its
// captures (see write_captures), and the nodes whatever else the backend
// reads of them (see write_handover). Every field is read through the
// handover's methods (see Typed), so the dump shows what code generation
// will read.

// write_nodes appends the nodes of every tree to out, as a list.
func (mut c Typed) write_nodes(mut out list[uint8]) error {
    mut c.place_decls()?
    append(mut out, '[')?
    mut first := true
    mut stack := make(list[DumpItem], c_allocator)
    mut kids := make(list[id[ast.Node]], c_allocator)
    mut order := make(list[DumpItem], c_allocator)
    for u := range len(c.prog.trees) {
        clear_items(mut stack)
        mut i := tree_decl_count(c.prog.trees, u) -% 1
        for i >= 0 {
            append(mut stack, DumpItem{node: tree_decl(c.prog.trees, u, i), site: false, nth: 0})?
            i -%= 1
        }
        for len(stack) > 0 {
            top, ok := pop(mut stack)
            if !ok {
                break
            }
            k := Key{unit: u, node: top.node}
            if top.site {
                mut c.write_site_arg(mut out, k, top.nth)?
                continue
            }
            name := node_kind_name(c.prog.trees, k)
            if len(name) > 0 {
                if !first {
                    append(mut out, ',')?
                }
                first = false
                mut c.write_node(mut out, k, name)?
            }
            clear_nodes(mut kids)
            mut c.dump_children(k, mut kids)?
            mut c.dump_order(k, kids[:], mut order)?
            // Pushed last first, so that they are written in order.
            mut j := len(order) -% 1
            for j >= 0 {
                item, has := order[j]
                if has {
                    append(mut stack, item)?
                }
                j -%= 1
            }
        }
    }
    append(mut out, ']')?
    return noerror
}

// dump_children appends to kids the nodes Go's ast.Walk visits under k:
// a node's children, but for a closure, whose function Go's walk
// passes over to visit its parameters, results and body, and a function
// type, whose parameters' types Go's walk visits in place of them.
func (mut c Typed) dump_children(k Key, mut kids list[id[ast.Node]]) error {
    switch kind_at(c.prog.trees, k) {
    case func_lit(fn):
        children_of(c.prog.trees, k.unit, fn, mut kids)?
        return noerror
    case func_type:
        mut all := make(list[id[ast.Node]], c_allocator)
        children_of(c.prog.trees, k.unit, k.node, mut all)?
        for _, n := range all {
            switch kind_at(c.prog.trees, sub(k, n)) {
            case param_decl:
                append(mut kids, param_of(c.prog.trees, sub(k, n)).type_expr)?
            default:
                append(mut kids, n)?
            }
        }
        return noerror
    default:
        children_of(c.prog.trees, k.unit, k.node, mut kids)?
        return noerror
    }
}

// DumpItem is a node the dump has yet to write, or, site set, the nth
// testing.Site argument Go put among the arguments of the call node (see
// SiteArg).
type DumpItem struct {
    node id[ast.Node]
    site bool
    nth int64
}

// dump_order sets order to the nodes Go's walk visits under k, kids, in
// order, with the testing.Site arguments Go put among a call's arguments
// each at its index among them (see Typed.site_index).
func (mut c Typed) dump_order(k Key, kids []id[ast.Node], mut order list[DumpItem]) error {
    clear_items(mut order)
    n := mut c.site_len(k)
    mut base := len(kids)
    if n > 0 {
        switch kind_at(c.prog.trees, k) {
        case call(cl):
            base = 1 +% count_items(c.prog.trees, k.unit, cl.type_args)
        default:
        }
    }
    mut a int64 = 0
    for a < base && a < len(kids) {
        kid, has := kids[a]
        if has {
            append(mut order, DumpItem{node: kid, site: false, nth: 0})?
        }
        a +%= 1
    }
    if n == 0 {
        return noerror
    }
    mut s int64 = 0
    mut at int64 = 0
    for a < len(kids) || s < n {
        if s < n && mut c.site_index(k, s) == at {
            append(mut order, DumpItem{node: k.node, site: true, nth: s})?
            s +%= 1
        } else if a < len(kids) {
            kid, has := kids[a]
            if has {
                append(mut order, DumpItem{node: kid, site: false, nth: 0})?
            }
            a +%= 1
        } else {
            break
        }
        at +%= 1
    }
    return noerror
}

// clear_items empties l, keeping what it holds allocated.
func clear_items(mut l list[DumpItem]) {
    for len(l) > 0 {
        pop(mut l)
    }
}

// write_site_arg appends the nodes of the nth testing.Site argument Go
// put among the arguments of the call k, Go's passSite: the Site
// parameter of the function the call is in, a name, with the name of
// the parameter it is bound to, site_param, or a literal of the Site
// type whose four fields hold the call's place, as siteLit builds it,
// with what they hold, site: the file, the line, the column and the
// excerpt (see Typed.site_text).
func (mut c Typed) write_site_arg(mut out list[uint8], k Key, nth int64) error {
    if mut c.site_index(k, nth) < 0 {
        return noerror
    }
    param := mut c.site_param(k, nth)
    if !is_no_key(param) {
        pt := mut c.decl_type(param)
        fmt.appendf(mut out, ",{\"kind\":\"Ident\",\"type\":%d,\"const\":null,\"conv\":0,\"narrowed\":0,\"exhaustive\":false,\"unrolled\":false,\"move\":false,\"site_param\":", pt.number())?
        write_name(mut out, name_of(c.prog.trees, c.none, param))?
        fmt.appendf(mut out, ",\"def\":")?
        mut c.write_def(mut out, ast.decl_def(ast.def_param, param.unit, param.node))?
        append(mut out, '}')?
        return noerror
    }
    mut file := msg()
    mut excerpt := msg()
    line, col, _ := mut c.site_text(k, nth, mut file, mut excerpt)?
    st := mut c.site_type(k, nth)
    fmt.appendf(mut out, ",{\"kind\":\"CompositeLit\",\"type\":%d,\"const\":null,\"conv\":0,\"narrowed\":0,\"exhaustive\":false,\"unrolled\":false,\"move\":false,\"site\":{\"file\":", st.number())?
    write_name(mut out, file[:])?
    fmt.appendf(mut out, ",\"line\":%d,\"col\":%d,\"excerpt\":", line, col)?
    write_name(mut out, excerpt[:])?
    fmt.appendf(mut out, "}}")?
    for i := range 4 {
        write_plain_node(mut out, "KeyValue", 0)?
        // Go's field name in the literal is a name bound to nothing.
        fmt.appendf(mut out, ",{\"kind\":\"Ident\",\"type\":0,\"const\":null,\"conv\":0,\"narrowed\":0,\"exhaustive\":false,\"unrolled\":false,\"move\":false,\"def\":null}")?
        if i == 0 || i == 3 {
            write_plain_node(mut out, "StrLit", types.string_type.number())?
        } else {
            write_plain_node(mut out, "IntLit", types.int64_type.number())?
        }
    }
    return noerror
}

// write_plain_node appends, after a comma, the dump's object of a node of
// the kind name and type typ, with nothing else recorded on it.
func write_plain_node(mut out list[uint8], name string, typ int64) error {
    fmt.appendf(mut out, ",{\"kind\":\"%s\",\"type\":%d,\"const\":null,\"conv\":0,\"narrowed\":0,\"exhaustive\":false,\"unrolled\":false,\"move\":false}", name, typ)?
    return noerror
}

// tree_decl_count returns how many declarations the tree unit has.
func tree_decl_count(trees []ast.File, unit int64) int64 {
    if unit < 0 || unit >= len(trees) {
        return 0
    }
    return len(trees[unit].decls)
}

// tree_decl returns the i'th declaration of the tree unit, or the
// sentinel.
func tree_decl(trees []ast.File, unit int64, i int64) id[ast.Node] {
    mut z id[ast.Node]
    if unit < 0 || unit >= len(trees) {
        return z
    }
    d, ok := trees[unit].decls[i]
    if !ok {
        return z
    }
    return d
}

// write_node appends the object of the node k, of the kind name.
func (mut c Typed) write_node(mut out list[uint8], k Key, name string) error {
    mut typ := types.invalid
    mut conv := types.invalid
    mut cv := no_const()
    mut exhaustive := false
    switch kind_at(c.prog.trees, k) {
    case var_decl:
        typ = mut c.decl_type(k)
        v, ok := mut c.var_const(k)
        if ok {
            cv = v
        }
    case param_decl:
        typ = mut c.decl_type(k)
    case call:
        conv = mut c.conv(k)
        typ = mut c.type_of(k)
        cv = mut c.const_of(k)
    case binary, unary:
        typ = mut c.type_of(k)
        cv = mut c.const_of(k)
    case switch_stmt:
        exhaustive = mut c.is_exhaustive(k)
    default:
        if is_expr_kind(c.prog.trees, k) {
            typ = mut c.type_of(k)
        }
    }
    fmt.appendf(mut out, "{\"kind\":\"%s\",\"type\":%d,\"const\":", name, typ.number())?
    mut c.write_const(mut out, cv)?
    narrowed := mut c.narrowed(k)
    fmt.appendf(mut out, ",\"conv\":%d,\"narrowed\":%d,\"exhaustive\":", conv.number(), narrowed.number())?
    write_bool(mut out, exhaustive)?
    moved := mut c.is_move(k)
    unrolled := mut c.is_unrolled(k)
    fmt.appendf(mut out, ",\"unrolled\":")?
    write_bool(mut out, unrolled)?
    fmt.appendf(mut out, ",\"move\":")?
    write_bool(mut out, moved)?
    mut c.write_call_types(mut out, k)?
    mut c.write_fields_of(mut out, k)?
    mut c.write_type_cases(mut out, k)?
    mut c.write_captures(mut out, k)?
    mut c.write_handover(mut out, k)?
    append(mut out, '}')?
    return noerror
}

// write_def appends what a name is bound to, Go's Ident.Def as the
// --port-types dump writes it: null for nothing, unbound or builtin for
// those bindings, and for a declaration a string of its kind, Go's type
// name of it, the place among the program's trees, Go's prog.Files(),
// of the file it is in, where in that file its name starts and its
// name, a space between each,
// a string rather than an object, which keeps the dump of a large
// program small enough for porttest to decode.
func (mut c Typed) write_def(mut out list[uint8], d ast.Def) error {
    if d.kind == ast.def_none {
        append(mut out, []uint8("null")...)?
        return noerror
    }
    if d.kind == ast.def_unbound {
        append(mut out, []uint8("\"unbound\"")...)?
        return noerror
    }
    if d.kind == ast.def_builtin {
        append(mut out, []uint8("\"builtin\"")...)?
        return noerror
    }
    mut kind := "Import"
    if d.kind == ast.def_func {
        kind = "Func"
    } else if d.kind == ast.def_param {
        kind = "Param"
    } else if d.kind == ast.def_var {
        kind = "Var"
    } else if d.kind == ast.def_type {
        kind = "Type"
    } else if d.kind == ast.def_type_param {
        kind = "TypeParam"
    }
    dk := key_of_def(d)
    sp := name_span_of(c.prog.trees, dk)
    fmt.appendf(mut out, "\"%s %d %d ", kind, dk.unit, sp.start)?
    write_escaped(mut out, name_of(c.prog.trees, c.none, dk))?
    append(mut out, '"')?
    return noerror
}

// write_handover appends what of k the backend reads that the fields
// before do not show (see Typed): for a call, its type as recorded, Go's
// Call.Type, the method it calls, Go's Call.Method, and the stand-in a
// call through a value calls, Go's Call.Dynamic (see write_func_ref);
// for a method expression, the method, Go's Selector.Method; for a ?,
// the values it gives, Go's Question.Results; for an unreachable, the
// place its abort reports, Go's Where; for a variable, whether it is
// unused, Go's Var.Unused; for a name, what it is bound to, Go's
// Ident.Def (see write_def); for a type switch, the types each case
// names, Go's CaseClause.Types; for a fallthrough, where the clause it
// enters starts, Go's Fallthrough.Next, or -1; and for a closure, its
// function's value and results, Go's Func.Value and ResultTypes.
func (mut c Typed) write_handover(mut out list[uint8], k Key) error {
    switch kind_at(c.prog.trees, k) {
    case call:
        v_call_type := mut c.call_type(k)
        fmt.appendf(mut out, ",\"call_type\":%d,\"method\":", v_call_type.number())?
        mut c.write_func_ref(mut out, mut c.method(k))?
        fmt.appendf(mut out, ",\"dynamic\":")?
        mut c.write_func_ref(mut out, mut c.dynamic(k))?
    case selector:
        fmt.appendf(mut out, ",\"method\":")?
        mut c.write_func_ref(mut out, mut c.method(k))?
    case question:
        fmt.appendf(mut out, ",\"results\":[")?
        for i := range mut c.question_result_count(k) {
            if i > 0 {
                append(mut out, ',')?
            }
            v_question_result := mut c.question_result(k, i)
            fmt.appendf(mut out, "%d", v_question_result.number())?
        }
        append(mut out, ']')?
    case unreachable_stmt:
        mut w := msg()
        mut c.where(k, mut w)?
        fmt.appendf(mut out, ",\"where\":\"")?
        write_escaped(mut out, w[:])?
        append(mut out, '"')?
    case var_decl:
        fmt.appendf(mut out, ",\"unused\":")?
        write_bool(mut out, mut c.is_unused(k))?
    case ident:
        fmt.appendf(mut out, ",\"def\":")?
        mut c.write_def(mut out, mut c.def_of(k))?
    case switch_stmt(s):
        if is_type_switch_tag(c.prog.trees, sub(k, s.tag)) {
            fmt.appendf(mut out, ",\"case_types\":[")?
            for i := range count_items(c.prog.trees, k.unit, s.cases) {
                if i > 0 {
                    append(mut out, ',')?
                }
                cl := item_at(c.prog.trees, k.unit, s.cases, i)
                n, _ := mut c.case_type_count(cl)
                append(mut out, '[')?
                for j := range n {
                    if j > 0 {
                        append(mut out, ',')?
                    }
                    v_case_type := mut c.case_type(cl, j)
                    fmt.appendf(mut out, "%d", v_case_type.number())?
                }
                append(mut out, ']')?
            }
            append(mut out, ']')?
        }
    case fallthrough_stmt:
        next := mut c.falls_into(k)
        mut at int64 = -1
        if !is_no_key(next) {
            at = span_at(c.prog.trees, next).start
        }
        fmt.appendf(mut out, ",\"next\":%d", at)?
    case func_lit(fn):
        fk := sub(k, fn)
        v_func_value := mut c.func_value(fk)
        fmt.appendf(mut out, ",\"value\":%d,\"lit_results\":[", v_func_value.number())?
        for i := range mut c.result_len(fk) {
            if i > 0 {
                append(mut out, ',')?
            }
            v_result := mut c.result(fk, i)
            fmt.appendf(mut out, "%d", v_result.number())?
        }
        append(mut out, ']')?
    default:
    }
    return noerror
}

// write_func_ref appends the dump of fn, a function a call or a method
// expression names, or null for no key: its place among the program's
// declarations, Go's prog.Decls(), or -1 for a stand-in, which none
// declares; its name; its value; its parameters' and results' types;
// and, for a stand-in for a method of an interface, that method's name,
// Go's Func.Interface, or null.
func (mut c Typed) write_func_ref(mut out list[uint8], fn Key) error {
    if is_no_key(fn) {
        append(mut out, []uint8("null")...)?
        return noerror
    }
    f := func_of(c.prog.trees, fn)
    mut at int64 = -1
    place, declared := c.decl_places[fn]
    if declared {
        at = place
    }
    fmt.appendf(mut out, "{\"decl\":%d,\"name\":", at)?
    write_name(mut out, text_at(c.prog.trees, c.none, fn.unit, f.name))?
    v_func_value := mut c.func_value(fn)
    fmt.appendf(mut out, ",\"value\":%d,\"params\":[", v_func_value.number())?
    for i := range count_items(c.prog.trees, fn.unit, f.params) {
        if i > 0 {
            append(mut out, ',')?
        }
        pk := item_at(c.prog.trees, fn.unit, f.params, i)
        pt := mut c.decl_type(pk)
        fmt.appendf(mut out, "%d", pt.number())?
    }
    fmt.appendf(mut out, "],\"results\":[")?
    for i := range mut c.result_len(fn) {
        if i > 0 {
            append(mut out, ',')?
        }
        v_result := mut c.result(fn, i)
        fmt.appendf(mut out, "%d", v_result.number())?
    }
    fmt.appendf(mut out, "],\"iface\":")?
    m := mut c.interface_of(fn)
    if is_no_key(m) {
        append(mut out, []uint8("null")...)?
    } else {
        write_name(mut out, text_at(c.prog.trees, c.none, m.unit, iface_method_of(c.prog.trees, m).name))?
    }
    append(mut out, '}')?
    return noerror
}

// place_decls records in c.decl_places the place of each declaration
// of the program among them all, in Go's prog.Decls() order, which the
// dump writes a function a call names by (see write_func_ref).
func (mut c Typed) place_decls() error {
    for i := range count_decls(c.prog) {
        put(mut c.decl_places, decl_at(c.prog, i), i)?
    }
    return noerror
}

// is_type_switch_tag reports whether tag, a switch's, is x.(type), which
// makes the switch a type switch, Go's IsTypeSwitch.
func is_type_switch_tag(trees []ast.File, tag Key) bool {
    switch kind_at(trees, tag) {
    case type_assert(a):
        return ast.is_none(a.type_expr)
    default:
        return false
    }
}

// write_call_types appends, for a call k to a generic function whose
// type arguments every type parameter has, its type arguments and its
// parameters' types, Go's Call.TypeArgs and ParamTypes (see
// record_signature), and, for that call and for one to add, add_all or
// insert, its results' types, Go's ResultTypes (see record_added).
func (mut c Typed) write_call_types(mut out list[uint8], k Key) error {
    n, has := mut c.type_arg_count(k)
    if has {
        mut c.write_type_args(mut out, k, n)?
    }
    nr, has_r := mut c.result_type_count(k)
    if !has_r {
        return noerror
    }
    fmt.appendf(mut out, ",\"result_types\":[")?
    for i := range nr {
        if i > 0 {
            append(mut out, ',')?
        }
        v_result_type := mut c.result_type(k, i)
        fmt.appendf(mut out, "%d", v_result_type.number())?
    }
    append(mut out, ']')?
    return noerror
}

// write_type_args appends the n type arguments recorded on the call k
// and its parameters' types, Go's Call.TypeArgs and ParamTypes.
func (mut c Typed) write_type_args(mut out list[uint8], k Key, n int64) error {
    fmt.appendf(mut out, ",\"type_args\":[")?
    for i := range n {
        if i > 0 {
            append(mut out, ',')?
        }
        v_type_arg := mut c.type_arg(k, i)
        fmt.appendf(mut out, "%d", v_type_arg.number())?
    }
    fmt.appendf(mut out, "],\"param_types\":[")?
    for i := range mut c.param_type_count(k) {
        if i > 0 {
            append(mut out, ',')?
        }
        v_param_type := mut c.param_type(k, i)
        fmt.appendf(mut out, "%d", v_param_type.number())?
    }
    append(mut out, ']')?
    return noerror
}

// write_fields_of appends, for k a fields loop's fields(T), the type it
// ranges over the fields of and the type parameter v.[f] has, Go's
// FieldsOf.Type and Field, whether its body reads f.name, Go's Names, and
// the fields it lists for each type it is lowered for, Go's Unrolled.
func (mut c Typed) write_fields_of(mut out list[uint8], k Key) error {
    switch kind_at(c.prog.trees, k) {
    case fields_of:
    default:
        return noerror
    }
    ft := mut c.fo_type(k)
    ff := mut c.fo_field(k)
    fmt.appendf(mut out, ",\"fo_type\":%d,\"fo_field\":%d,\"names\":", ft.number(), ff.number())?
    write_bool(mut out, mut c.reads_names(k))?
    fmt.appendf(mut out, ",\"fields_for\":[")?
    for j := range mut c.unrolled_count(k) {
        if j > 0 {
            append(mut out, ',')?
        }
        at := mut c.unrolled_at(k, j)
        typ, n := mut c.unrolled_type(at)
        fmt.appendf(mut out, "{\"type\":%d,\"fields\":[", typ.number())?
        for i := range n {
            if i > 0 {
                append(mut out, ',')?
            }
            fmt.appendf(mut out, "%d", mut c.unrolled_field(at, i))?
        }
        fmt.appendf(mut out, "]}")?
    }
    append(mut out, ']')?
    return noerror
}

// write_type_cases appends, for k a switch on a type parameter, how
// each value of each of its cases matches, Go's CaseClause.TypeCases,
// a list for each case, in order.
func (mut c Typed) write_type_cases(mut out list[uint8], k Key) error {
    mut cases := make(list[Key], c_allocator)
    switch kind_at(c.prog.trees, k) {
    case switch_stmt(s):
        if !s.on_type {
            return noerror
        }
        for i := range count_items(c.prog.trees, k.unit, s.cases) {
            append(mut cases, item_at(c.prog.trees, k.unit, s.cases, i))?
        }
    default:
        return noerror
    }
    fmt.appendf(mut out, ",\"type_cases\":[")?
    for i, cl := range cases {
        if i > 0 {
            append(mut out, ',')?
        }
        append(mut out, '[')?
        for j := range mut c.type_case_count(cl) {
            if j > 0 {
                append(mut out, ',')?
            }
            kind, typ, key := mut c.type_case(cl, j)
            fmt.appendf(mut out, "{\"kind\":%d,\"type\":%d,\"key\":%d}", kind, typ.number(), key.number())?
        }
        append(mut out, ']')?
    }
    append(mut out, ']')?
    return noerror
}

// write_captures appends, for k a closure, its captures, Go's
// FuncLit.Captures: each the name of its variable, where it is first
// named, whether the closure may write it and where it first does.
func (mut c Typed) write_captures(mut out list[uint8], k Key) error {
    switch kind_at(c.prog.trees, k) {
    case func_lit:
    default:
        return noerror
    }
    fmt.appendf(mut out, ",\"captures\":[")?
    for i := range mut c.capture_count(k) {
        if i > 0 {
            append(mut out, ',')?
        }
        decl, at, write, write_at := mut c.capture(k, i)
        fmt.appendf(mut out, "{\"decl\":\"")?
        write_escaped(mut out, name_of(c.prog.trees, c.none, decl))?
        fmt.appendf(mut out, "\",\"at\":%d,\"write\":", at.start)?
        write_bool(mut out, write)?
        mut wa int64 = 0
        if write {
            wa = write_at.start
        }
        fmt.appendf(mut out, ",\"write_at\":%d}", wa)?
    }
    append(mut out, ']')?
    return noerror
}

// is_expr_kind reports whether the node k is an expression, a type as
// written among them, Go's ast.Expr.
func is_expr_kind(trees []ast.File, k Key) bool {
    switch kind_at(trees, k) {
    case call, ident, str_lit, float_lit, int_lit, char_lit, bool_lit, noerror_lit, c_allocator_lit, binary, unary, type_assert, array_type, view_type, list_type, arena_type, pool_type, ref_type, map_type, func_type, composite_lit, index, slice, struct_type, selector, question, key_value, mut_arg, own_arg, func_lit, fields_of, interface_type, struct_case, union_type:
        return true
    default:
        return false
    }
}

// node_kind_name returns the name of the Go type of the node k, or ""
// for a node of the port's that is none of Go's (see the comment at the
// top of the file).
func node_kind_name(trees []ast.File, k Key) string {
    switch kind_at(trees, k) {
    case func_decl:
        return "Func"
    case param_decl:
        return "Param"
    case var_decl:
        return "Var"
    case import_decl:
        return "Import"
    case type_decl:
        return "TypeDecl"
    case bad_decl:
        return "BadDecl"
    case type_param:
        return "TypeParam"
    case iface_method:
        return "IfaceMethod"
    case expr_stmt:
        return "ExprStmt"
    case return_stmt:
        return "Return"
    case if_stmt:
        return "If"
    case assign:
        return "Assign"
    case for_stmt:
        return "For"
    case break_stmt:
        return "Break"
    case continue_stmt:
        return "Continue"
    case unreachable_stmt:
        return "Unreachable"
    case fallthrough_stmt:
        return "Fallthrough"
    case inc_dec:
        return "IncDec"
    case multi_var:
        return "MultiVar"
    case multi_assign:
        return "MultiAssign"
    case for_range:
        return "ForRange"
    case switch_stmt:
        return "Switch"
    case defer_stmt:
        return "Defer"
    case region_stmt:
        return "Region"
    case bad_stmt:
        return "BadStmt"
    case call:
        return "Call"
    case ident:
        return "Ident"
    case str_lit:
        return "StrLit"
    case float_lit:
        return "FloatLit"
    case int_lit:
        return "IntLit"
    case char_lit:
        return "CharLit"
    case bool_lit:
        return "BoolLit"
    case noerror_lit:
        return "NoErrorLit"
    case c_allocator_lit:
        return "CAllocatorLit"
    case binary:
        return "Binary"
    case unary:
        return "Unary"
    case type_assert:
        return "TypeAssert"
    case array_type:
        return "ArrayType"
    case view_type:
        return "ViewType"
    case list_type:
        return "ListType"
    case arena_type:
        return "ArenaType"
    case pool_type:
        return "PoolType"
    case ref_type:
        return "RefType"
    case map_type:
        return "MapType"
    case func_type:
        return "FuncType"
    case composite_lit:
        return "CompositeLit"
    case index:
        return "Index"
    case slice:
        return "Slice"
    case struct_type:
        return "StructType"
    case selector:
        return "Selector"
    case question:
        return "Question"
    case key_value:
        return "KeyValue"
    case mut_arg:
        return "MutArg"
    case own_arg:
        return "OwnArg"
    case func_lit:
        return "FuncLit"
    case fields_of:
        return "FieldsOf"
    case interface_type:
        return "InterfaceType"
    case struct_case:
        return "StructCase"
    case union_type:
        return "UnionType"
    default:
        return ""
    }
}
