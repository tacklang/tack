package typeck

import ast from "tack/ast"
import constant from "tack/constant"
import types from "tack/types"

// fold_number computes k when it is a float literal or operator
// expression, rounded to its float type, or an integer constant
// expression or known value, Go's foldNumber, and reports whether it has
// a value and whether it is one.
func (mut c Checker) fold_number(k Key) (Const, bool, bool, error) {
    typ := mut c.type_of(k)
    if types.is_float(typ) {
        switch kind_at(c.prog.trees, k) {
        case float_lit, int_lit, binary, unary:
            f, ok := mut c.float_value(k)?
            if !ok {
                return no_const(), false, true, noerror
            }
            if typ == types.float32_type {
                bits, _ := f.float32_bits(c_allocator)?
                return float_bits_const(uint64(bits), true), true, true, noerror
            }
            bits, _ := f.float64_bits(c_allocator)?
            return float_bits_const(bits, false), true, true, noerror
        default:
            return no_const(), false, false, noerror
        }
    }
    v, ok := mut c.const_value(k)
    if ok {
        return int_const(v), true, true, noerror
    }
    if !types.is_integer(typ) || typ == types.untyped_int {
        return no_const(), false, false, noerror
    }
    known, is_known := mut c.known_value(k)?
    return int_const(known), is_known, true, noerror
}




// is_bool_link reports whether k is a binary whose fold is Go's
// foldBoolBinary: one that is no number and has no bool recorded.
func (mut c Checker) is_bool_link(k Key) (bool, error) {
    switch kind_at(c.prog.trees, k) {
    case binary:
        _, _, is_number := mut c.fold_number(k)?
        return !is_number && const_of(c.consts, k).kind != cv_bool, noerror
    default:
        return false, noerror
    }
}


// fold_bool_step applies op, an operator giving a bool, to two folded
// constants, Go's foldBoolBinary after its operands.
func (mut c Checker) fold_bool_step(op ast.BinaryOp, left Const, right Const) (Const, bool, error) {
    if op == ast.op_eq || op == ast.op_ne {
        equal, ok := mut c.equal_consts(left, right)?
        return bool_const(equal == (op == ast.op_eq)), ok, noerror
    }
    if is_comparison_op(op) {
        cmp, ok := mut c.compare_consts(left, right)
        return bool_const(compare(op, cmp)), ok, noerror
    }
    if left.kind != cv_bool || right.kind != cv_bool {
        return no_const(), false, noerror
    }
    if op == ast.op_and {
        return bool_const(left.b && right.b), true, noerror
    }
    if op == ast.op_or {
        return bool_const(left.b || right.b), true, noerror
    }
    return no_const(), false, noerror
}

// compare_consts compares two integer or two string constants, giving -1,
// 0 or 1, and whether it could, Go's compareConsts: strings by their
// bytes, unsigned, and only in a global's initializer.
func (mut c Checker) compare_consts(left Const, right Const) (int64, bool) {
    if left.kind == cv_int {
        return left.i.cmp(right.i), true
    }
    if left.kind == cv_str && len(c.init_stack) > 0 {
        return compare_bytes(c.store.str_bytes(left), c.store.str_bytes(right)), true
    }
    return 0, false
}

// compare_bytes compares a and b bytewise, as Go's strings.Compare does.
func compare_bytes(a []uint8, b []uint8) int64 {
    for i, x := range a {
        y, ok := b[i]
        if !ok {
            return 1
        }
        if x < y {
            return -1
        }
        if x > y {
            return 1
        }
    }
    if len(a) < len(b) {
        return -1
    }
    return 0
}

// equal_consts reports whether two constants of one type are equal, and
// whether it could tell, Go's equalConsts. Constants nest only as deeply
// as the literals they come from, so it recurses.
func (mut c Checker) equal_consts(left Const, right Const) (bool, bool, error) {
    if left.kind == cv_union {
        if right.kind != cv_union {
            return false, false, noerror
        }
        if case_of(left) != case_of(right) {
            return false, true, noerror
        }
        pa, has_a := c.store.payload(left)
        pb, has_b := c.store.payload(right)
        if !has_a || !has_b {
            return !has_a && !has_b, true, noerror
        }
        r, ok := mut c.equal_consts(pa, pb)?
        return r, ok, noerror
    }
    if left.kind == cv_bool {
        return left.b == right.b, right.kind == cv_bool, noerror
    }
    if left.kind == cv_list {
        if right.kind != cv_list || left.count != right.count {
            return false, false, noerror
        }
        mut equal := true
        for i := range left.count {
            a, _ := c.store.item(left, i)
            b, _ := c.store.item(right, i)
            same, known := mut c.equal_consts(a, b)?
            if !known {
                return false, false, noerror
            }
            equal = equal && same
        }
        return equal, true, noerror
    }
    cmp, ok := mut c.compare_consts(left, right)
    return cmp == 0, ok, noerror
}

// fold returns the value of a checked constant expression, Go's fold: an
// integer, computed exactly as it was checked, a float rounded to its
// type, a string, a bool, c_allocator, an array's elements, a struct's
// fields in declaration order, or a union's case and payload. A bool
// expression is evaluated in full, both sides of && and || included.
//
// Go's fold recurses into each part of the value; here each part is
// folded from a stack of the fold's own (see fold_run), so a value
// nested as deeply as the parser allows, literals in literals or
// payloads in payloads, and a chain of operators, fields or elements of
// any length, folds in a bounded stack.
func (mut c Checker) fold(k Key) (Const, bool, error) {
    r, ok := mut c.fold_run(k, false)?
    return r, ok, noerror
}

// fold_part returns the value of k, a field or an element of a value the
// checker knows, Go's foldPart: what the chain of fields and elements is
// taken from, folded, and then each link taken from it in turn.
func (mut c Checker) fold_part(k Key) (Const, bool, error) {
    r, ok := mut c.fold_run(k, true)?
    return r, ok, noerror
}

// FoldFrame is a part of a value fold_run has yet to finish: the node,
// whether it is folded as a chain of fields and elements, part, how far
// it got, step, where the values of its elements start in the run's
// list of them, slots, where its links start in the run's list of them
// and how many there are, and, for a chain of bool operators, the value
// folded so far, acc and acc_ok.
type FoldFrame struct {
    k Key
    part bool
    step int64
    slots int64
    links int64
    n int64
    acc Const
    acc_ok bool
}

// fold_frame returns a frame that folds k from its start, as a chain of
// fields and elements when part says so.
func fold_frame(k Key, part bool) FoldFrame {
    return FoldFrame{k: k, part: part, step: 0, slots: 0, links: 0, n: 0, acc: no_const(), acc_ok: false}
}

// fold_run folds k, as fold_part does when part says so and as fold does
// otherwise. Each node is folded as Go's fold and its helpers fold it, a
// node with parts pushing the part it needs next, its frame under it, and
// taking up again from where it got once the part's value is known, in
// rv and rok.
func (mut c Checker) fold_run(k Key, part bool) (Const, bool, error) {
    mut st := make(list[FoldFrame], c_allocator)
    mut slots := make(list[Const], c_allocator)
    mut links := make(list[Key], c_allocator)
    mut rv := no_const()
    mut rok := false
    append(mut st, fold_frame(k, part))?
    for len(st) > 0 {
        mut f, has := pop(mut st)
        if !has {
            break
        }
        e := f.k
        if f.part {
            if f.step == 0 {
                sv, sok, is_byte := mut c.string_element(e)?
                if is_byte {
                    rv = sv
                    rok = sok
                    continue
                }
                f.links = len(links)
                x := chain_base(c.prog.trees, c.none, e, mut links)?
                f.n = len(links) -% f.links
                if f.n == 0 {
                    rv = no_const()
                    rok = false
                    continue
                }
                f.step = 1
                append(mut st, f)?
                append(mut st, fold_frame(x, false))?
                continue
            }
            rv, rok = mut c.fold_links(links, f.links, f.n, rv, rok)?
            for len(links) > f.links {
                pop(mut links)
            }
            continue
        }
        if f.step == 0 {
            v, ok, is_number := mut c.fold_number(e)?
            if is_number {
                rv = v
                rok = ok
                continue
            }
        }
        _, _, built := construction(c.prog.trees, c.none, e)
        if built {
            td, sel, _ := construction(c.prog.trees, c.none, e)
            s := selector_of(c.prog.trees, sel)
            _, at, found := c.table.find_case(decl_type_of(c.decl_types, td), text_at(c.prog.trees, c.none, sel.unit, s.name))
            payload := construction_payload(c.prog.trees, e)
            if !found {
                rv = no_const()
                rok = false
            } else if is_no_key(payload) {
                rv = mut c.store.union_const(at, no_const(), false)?
                rok = true
            } else if f.step == 0 {
                f.step = 1
                append(mut st, f)?
                append(mut st, fold_frame(payload, false))?
            } else if rok {
                rv = mut c.store.union_const(at, rv, true)?
            } else {
                rv = no_const()
            }
            continue
        }
        switch kind_at(c.prog.trees, e) {
        case str_lit(sl):
            rv = mut c.store.str_const(text_at(c.prog.trees, c.none, e.unit, sl))?
            rok = true
        case bool_lit(b):
            rv = bool_const(b)
            rok = true
        case noerror_lit:
            empty := mut c.store.str_const([]uint8(""))?
            values := [2]Const{int_const(constant.from_int64(0)), empty}
            rv = mut c.store.list_const(values[:])?
            rok = true
        case c_allocator_lit:
            rv = alloc_const()
            rok = true
        case ident(nm):
            rv = no_const()
            rok = false
            g := mut c.constant_global(nm)
            if !is_no_key(g) {
                cv, has_cv := c.var_consts[g]
                if has_cv && cv.kind != cv_none {
                    rv = cv
                    rok = true
                }
            }
        case composite_lit(lit):
            child := mut c.literal_step(e, lit, mut f, mut slots, rv, rok)?
            if !is_no_key(child) {
                append(mut st, f)?
                append(mut st, fold_frame(child, false))?
                continue
            }
            rv = f.acc
            rok = f.acc_ok
        case binary:
            child := mut c.bools_step(mut f, mut links, rv, rok)?
            if !is_no_key(child) {
                append(mut st, f)?
                append(mut st, fold_frame(child, false))?
                continue
            }
            rv = f.acc
            rok = f.acc_ok
        case unary(u):
            if f.step == 0 {
                f.step = 1
                append(mut st, f)?
                append(mut st, fold_frame(sub(e, u.x), false))?
                continue
            }
            if rok && rv.kind == cv_bool && u.op == ast.unary_not {
                rv = bool_const(!rv.b)
            } else {
                rv = no_const()
                rok = false
            }
        case selector, index:
            f.part = true
            f.step = 0
            append(mut st, f)?
        case slice:
            rv, rok = mut c.known_slice(e)?
        default:
            rv = no_const()
            rok = false
        }
    }
    return rv, rok, noerror
}

// construction_payload returns the payload the union built by e is given,
// Go's fold of a construction's one argument, or no key for none.
func construction_payload(trees []ast.File, e Key) Key {
    switch kind_at(trees, e) {
    case call(cl):
        if count_items(trees, e.unit, cl.args) == 1 {
            return item_at(trees, e.unit, cl.args, 0)
        }
        return no_key()
    default:
        return no_key()
    }
}

// chain_base appends to out the fields and elements of the chain e is
// the top of, e first, Go's foldPart's loop, and returns what the chain
// is taken from: a union built ends it.
func chain_base(trees []ast.File, none []uint8, e Key, mut out list[Key]) (Key, error) {
    mut x := e
    for {
        _, _, built := construction(trees, none, x)
        if built {
            return x, noerror
        }
        switch kind_at(trees, x) {
        case selector(s):
            append(mut out, x)?
            x = sub(x, s.x)
        case index(ix):
            append(mut out, x)?
            x = sub(x, ix.x)
        default:
            return x, noerror
        }
    }
    return x, noerror
}

// literal_step takes the fold of the composite literal e, lit, a step on,
// Go's foldLiteral, the value of its last element folded in rv and rok:
// it returns the element whose value is to be folded next, or no key
// once the literal's value, or that it has none, is in f's acc and
// acc_ok. A struct's values go to its fields' places.
func (mut c Checker) literal_step(e Key, lit ast.CompositeLit, mut f FoldFrame, mut slots list[Const], rv Const, rok bool) (Key, error) {
    typ := node_type_of(c.node_types, e)
    is_struct := c.table.is_struct(typ)
    n := count_items(c.prog.trees, e.unit, lit.elems)
    if f.step == 0 {
        f.slots = len(slots)
        if is_struct {
            for range c.table.field_count(typ) {
                append(mut slots, no_const())?
            }
        }
    } else {
        // The value of element f.step-1 is folded.
        el := item_at(c.prog.trees, e.unit, lit.elems, f.step -% 1)
        mut at int64 = -1
        mut found := !is_struct
        if is_struct {
            switch kind_at(c.prog.trees, el) {
            case key_value(kv):
                nm, _ := ident_at(c.prog.trees, sub(el, kv.key))
                _, fat, ffound := c.table.find_field(typ, text_at(c.prog.trees, c.none, el.unit, nm.name))
                at = f.slots +% fat
                found = ffound
            default:
            }
        }
        if !found || !rok {
            return no_key(), mut c.literal_fail(mut f, mut slots)
        }
        if is_struct {
            if at >= 0 && at < len(slots) {
                slots[at] = rv
            }
        } else {
            append(mut slots, rv)?
        }
    }
    if f.step < n {
        el := item_at(c.prog.trees, e.unit, lit.elems, f.step)
        f.step +%= 1
        if !is_struct {
            return el, noerror
        }
        switch kind_at(c.prog.trees, el) {
        case key_value(kv):
            _, is_id := ident_at(c.prog.trees, sub(el, kv.key))
            if is_id {
                return sub(el, kv.value), noerror
            }
        default:
        }
        return no_key(), mut c.literal_fail(mut f, mut slots)
    }
    mut values := make(list[Const], c_allocator)
    mut j := f.slots
    for j >= 0 && j < len(slots) {
        v, has := slots[j]
        if has {
            append(mut values, v)?
        }
        j +%= 1
    }
    f.acc = mut c.store.list_const(values)?
    f.acc_ok = true
    for len(slots) > f.slots {
        pop(mut slots)
    }
    return no_key(), noerror
}

// literal_fail ends the fold of a literal whose value is not known.
func (mut c Checker) literal_fail(mut f FoldFrame, mut slots list[Const]) error {
    f.acc = no_const()
    f.acc_ok = false
    for len(slots) > f.slots {
        pop(mut slots)
    }
    return noerror
}

// bools_step takes the fold of f's node, a binary, a step on, Go's
// fold_bools: a bool constant recorded on it is its value; otherwise the
// chain of bool links below it is folded, its bottom first and then each
// link's right operand, from the innermost link out, the last value
// folded in rv and rok. It returns the operand to fold next, or no key
// once the value is in f's acc and acc_ok.
func (mut c Checker) bools_step(mut f FoldFrame, mut links list[Key], rv Const, rok bool) (Key, error) {
    if f.step == 0 {
        rec := const_of(c.consts, f.k)
        if rec.kind == cv_bool {
            f.acc = rec
            f.acc_ok = true
            return no_key(), noerror
        }
        f.links = len(links)
        mut x := f.k
        for {
            link := mut c.is_bool_link(x)?
            if !link {
                break
            }
            append(mut links, x)?
            x = sub(x, binary_at(c.prog.trees, x).x)
        }
        f.n = len(links) -% f.links
        f.step = 1
        return x, noerror
    }
    if f.step == 1 {
        f.acc = rv
        f.acc_ok = rok
    } else {
        l := key_in(links, f.links +% f.n -% (f.step -% 1))
        b := binary_at(c.prog.trees, l)
        if !f.acc_ok || !rok {
            f.acc = no_const()
            f.acc_ok = false
        } else {
            f.acc, f.acc_ok = mut c.fold_bool_step(b.op, f.acc, rv)?
        }
    }
    if f.step <= f.n {
        l := key_in(links, f.links +% f.n -% f.step)
        f.step +%= 1
        return sub(l, binary_at(c.prog.trees, l).y), noerror
    }
    for len(links) > f.links {
        pop(mut links)
    }
    return no_key(), noerror
}

// string_element folds e when it is an element of a string, Go's
// foldElement for a string: the byte at a known index, not negative and
// below the length, of a string the checker knows (see known_string), an
// immutable local or a slice of one as much as a global, and reports
// whether e is one.
func (mut c Checker) string_element(e Key) (Const, bool, bool, error) {
    switch kind_at(c.prog.trees, e) {
    case index(ix):
        x := sub(e, ix.x)
        if mut c.type_of(x) != types.string_type {
            return no_const(), false, false, noerror
        }
        v, known := mut c.known_value(sub(e, ix.index))?
        if !known || v.is_negative() || !v.fits(64, true) {
            return no_const(), false, true, noerror
        }
        str, ok := mut c.known_string(x)?
        at := v.to_int64()
        if !ok || at >= str.count {
            return no_const(), false, true, noerror
        }
        b, has_b := c.store.str_bytes(str)[at]
        if !has_b {
            return no_const(), false, true, noerror
        }
        return int_const(constant.from_int64(int64(b))), true, true, noerror
    default:
        return no_const(), false, false, noerror
    }
}

// fold_links takes the n links of a chain of fields and elements from
// links, starting at first, the outermost first, from base, the value
// the chain is taken from, and ok, whether it is known, the innermost
// link first, Go's foldPart's second loop.
func (mut c Checker) fold_links(links []Key, first int64, n int64, base_in Const, ok_in bool) (Const, bool, error) {
    mut base := base_in
    mut ok := ok_in
    mut i := first +% n
    for i > first && ok {
        i -%= 1
        l := key_in(links, i)
        switch kind_at(c.prog.trees, l) {
        case selector(s):
            stype := mut c.type_of(sub(l, s.x))
            _, at, found := c.table.find_field(stype, text_at(c.prog.trees, c.none, l.unit, s.name))
            if !found || base.kind != cv_list || at >= base.count {
                ok = false
                continue
            }
            base, ok = c.store.item(base, at)
        case index(ix):
            v, known := mut c.known_value(sub(l, ix.index))?
            if !known || v.is_negative() || !v.fits(64, true) {
                ok = false
                continue
            }
            at := v.to_int64()
            xt := mut c.type_of(sub(l, ix.x))
            if xt == types.string_type {
                if base.kind != cv_str || at >= base.count {
                    ok = false
                    continue
                }
                b, has_b := c.store.str_bytes(base)[at]
                if !has_b {
                    ok = false
                    continue
                }
                base = int_const(constant.from_int64(int64(b)))
                continue
            }
            if base.kind != cv_list || at >= base.count {
                ok = false
                continue
            }
            base, ok = c.store.item(base, at)
        default:
            ok = false
        }
    }
    if !ok {
        return no_const(), false, noerror
    }
    return base, true, noerror
}
