package typeck

import ast from "tack/ast"
import fmt from "std/fmt"
import source from "tack/source"
import types from "tack/types"

// resolve_interfaces records the types of every interface's methods'
// parameters and results, as a function's are resolved, and reports an
// error result that is not last, and a testing.Site parameter, Go's
// resolveInterfaces.
func (mut c Checker) resolve_interfaces() error {
    for i := range count_decls(c.prog) {
        d := decl_at(c.prog, i)
        if !is_interface_decl(c.prog.trees, d) {
            continue
        }
        old := mut c.enter(d)
        td := type_decl_of(c.prog.trees, d)
        switch kind_at(c.prog.trees, sub(d, td.type_expr)) {
        case interface_type(ms):
            for j := range count_items(c.prog.trees, d.unit, ms) {
                mk := item_at(c.prog.trees, d.unit, ms, j)
                switch kind_at(c.prog.trees, mk) {
                case iface_method(m):
                    mut c.resolve_iface_method(d, td, mk, m)?
                default:
                }
            }
        default:
        }
        c.pkg = old
    }
    return noerror
}

// resolve_iface_method resolves the method m, at mk, of the interface td
// declared at d.
func (mut c Checker) resolve_iface_method(d Key, td ast.TypeDecl, mk Key, m ast.IfaceMethod) error {
    for i := range count_items(c.prog.trees, mk.unit, m.params) {
        p := item_at(c.prog.trees, mk.unit, m.params, i)
        typ := mut c.param_type(p, Sig{unit: mk.unit, params: m.params, i: i, recv: false})?
        mut c.set_decl_type(p, typ)?
        _, site := c.site_params[p]
        if site {
            param := param_of(c.prog.trees, p)
            mut msg1 := msg()
            fmt.appendf(mut msg1, "an interface method's parameter cannot be a testing.Site")?
            mut c.errorf(span_at(c.prog.trees, sub(p, param.type_expr)), own msg1)?
        }
    }
    n := count_items(c.prog.trees, mk.unit, m.results)
    put(mut c.result_count, mk, n)?
    for i := range n {
        r := item_at(c.prog.trees, mk.unit, m.results, i)
        typ := mut c.result_type(r, n, no_key())?
        put(mut c.results, RKey{unit: mk.unit, node: mk.node, i: i}, typ)?
    }
    for i := range n {
        if i +% 1 < n && result_of(c.results, mk, i) == types.error_type {
            mut msg2 := msg()
            fmt.appendf(mut msg2, "error must be the last result of %s.%s", text_at(c.prog.trees, c.none, d.unit, td.name)[:], text_at(c.prog.trees, c.none, mk.unit, m.name)[:])?
            mut c.errorf(span_at(c.prog.trees, item_at(c.prog.trees, mk.unit, m.results, i)), own msg2)?
        }
    }
    return noerror
}

// implicit_type_params turns each parameter of the function at d whose
// whole type is an interface, s Shape, into one of a type parameter of
// its own constrained by it, appended to the function's type parameters,
// Go's implicitTypeParams: func area(s Shape) is shorthand for func
// area[S Shape](s S). A method, an extern func and a variadic parameter
// are left as written. Go makes a TypeParam and an Ident of its own; here
// they are nodes added to the function's tree, the TypeParam marked
// implicit in tp_implicit.
func (mut c Checker) implicit_type_params(d Key, fid id[ast.Func]) error {
    fn := func_of(c.prog.trees, d)
    if fn.method || fn.is_extern {
        return noerror
    }
    for i := range count_items(c.prog.trees, d.unit, fn.params) {
        p := item_at(c.prog.trees, d.unit, fn.params, i)
        param := param_of(c.prog.trees, p)
        texpr := sub(p, param.type_expr)
        nm, is_id := ident_at(c.prog.trees, texpr)
        if !is_id || param.variadic || nm.def.kind != ast.def_type || !is_interface_decl(c.prog.trees, key_of_def(nm.def)) {
            continue
        }
        mut name := msg()
        qualified(c.prog.trees, c.none, d.unit, nm, mut name)?
        sp := span_at(c.prog.trees, texpr)
        mut c.add_implicit(d, fid, p, texpr, sp, name)?
    }
    return noerror
}

// add_implicit adds the type parameter named name, constrained by the
// interface name at texpr, written at sp, to the function fid at d, and
// makes the type of its parameter p a name of it.
func (mut c Checker) add_implicit(d Key, fid id[ast.Func], p Key, texpr Key, sp source.Span, name list[uint8]) error {
    u := d.unit
    s := add_str(mut c.prog.trees, u, name)?
    tp := ast.TypeParam{constraint: texpr.node, name: s, name_span: sp}
    tn := add_node(mut c.prog.trees, u, ast.Kind.type_param(tp), sp)?
    put(mut c.tp_implicit, Key{unit: u, node: tn}, true)?
    fn := func_of(c.prog.trees, d)
    mut items := make(list[id[ast.Node]], c_allocator)
    for i := range count_items(c.prog.trees, u, fn.type_params) {
        k := item_at(c.prog.trees, u, fn.type_params, i)
        append(mut items, k.node)?
    }
    append(mut items, tn)?
    l := add_list(mut c.prog.trees, u, items)?
    mut nf := fn
    nf.type_params = l
    set_func(mut c.prog.trees, u, fid, nf)
    mut z span[uint8]
    nid := ast.Ident{pkg: z, name: s, pkg_span: ast.unset_span(), def: ast.decl_def(ast.def_type_param, u, tn), hidden: ast.no_def()}
    nn := add_node(mut c.prog.trees, u, ast.Kind.ident(nid), sp)?
    switch kind_at(c.prog.trees, p) {
    case param_decl(pid):
        mut np := param_of(c.prog.trees, p)
        np.type_expr = nn
        set_param(mut c.prog.trees, u, pid, np)
    default:
    }
    return noerror
}

// add_str copies s into the bytes of the tree u and returns where it is.
func add_str(mut trees list[ast.File], u int64, s list[uint8]) (span[uint8], error) {
    if u < 0 || u >= len(trees) {
        mut z span[uint8]
        return z, noerror
    }
    r := mut trees[u].str(s[:])?
    return r, noerror
}

// add_node adds a node of kind k over sp to the tree u.
func add_node(mut trees list[ast.File], u int64, k ast.Kind, sp source.Span) (id[ast.Node], error) {
    if u < 0 || u >= len(trees) {
        mut z id[ast.Node]
        return z, noerror
    }
    n := mut trees[u].add(k, sp)?
    return n, noerror
}

// add_list adds items to the lists of the tree u, as a made Nodes.
func add_list(mut trees list[ast.File], u int64, items list[id[ast.Node]]) (ast.Nodes, error) {
    if u < 0 || u >= len(trees) {
        mut z ast.Nodes
        return z, noerror
    }
    l := mut trees[u].add_list(items[:])?
    return l, noerror
}

// set_func replaces the Func fid of the tree u with fn.
func set_func(mut trees list[ast.File], u int64, fid id[ast.Func], fn ast.Func) {
    if u >= 0 && u < len(trees) {
        trees[u].funcs[fid] = fn
    }
}

// set_param replaces the Param pid of the tree u with p.
func set_param(mut trees list[ast.File], u int64, pid id[ast.Param], p ast.Param) {
    if u >= 0 && u < len(trees) {
        trees[u].params[pid] = p
    }
}

// resolve_type_params gives each type parameter of the function at d a
// type of its own and finds the interface its constraint names, or
// marks it constrained by Data, reporting a constraint that names
// anything else, Go's resolveTypeParams.
func (mut c Checker) resolve_type_params(d Key) error {
    fn := func_of(c.prog.trees, d)
    for i := range count_items(c.prog.trees, d.unit, fn.type_params) {
        tk := item_at(c.prog.trees, d.unit, fn.type_params, i)
        switch kind_at(c.prog.trees, tk) {
        case type_param(tp):
            typ := mut c.table.type_param(text_at(c.prog.trees, c.none, tk.unit, tp.name))?
            mut c.set_decl_type(tk, typ)?
            put(mut c.type_params, typ.number(), tk)?
            ck := sub(tk, tp.constraint)
            data := is_data_name(c.prog.trees, c.none, ck)
            put(mut c.tp_data, tk, data)?
            if !data {
                iface := mut c.constraint(tk, tp)?
                if !is_no_key(iface) {
                    put(mut c.tp_iface, tk, iface)?
                }
            }
        default:
        }
    }
    return noerror
}

// constraint returns the interface the constraint of tp, at tk, names,
// reporting anything else written there, and no key when it reported,
// Go's constraint.
func (mut c Checker) constraint(tk Key, tp ast.TypeParam) (Key, error) {
    ck := sub(tk, tp.constraint)
    nm, is_id := ident_at(c.prog.trees, ck)
    if is_id {
        if nm.def.kind == ast.def_type && is_interface_decl(c.prog.trees, key_of_def(nm.def)) {
            return key_of_def(nm.def), noerror
        }
        unbound := mut c.unbound(ck, nm)?
        if unbound {
            return no_key(), noerror
        }
        _, basic := types.lookup(text_at(c.prog.trees, c.none, ck.unit, nm.name))
        if !basic && nm.def.is_none() {
            mut m := msg()
            fmt.appendf(mut m, "unknown type: ")?
            qualified(c.prog.trees, c.none, ck.unit, nm, mut m)?
            mut c.errorf(span_at(c.prog.trees, ck), own m)?
            return no_key(), noerror
        }
    }
    t := mut c.source_text(span_at(c.prog.trees, ck))?
    mut m := msg()
    fmt.appendf(mut m, "%s is not an interface; the constraint of type parameter %s must be one", t[:], text_at(c.prog.trees, c.none, tk.unit, tp.name)[:])?
    mut c.errorf(span_at(c.prog.trees, ck), own m)?
    return no_key(), noerror
}

// StandInKey is what the stand-in for one interface method called on
// values of one type parameter is found by, Go's standInKey: the
// interface method's node and the type parameter's type.
type StandInKey struct {
    method Key
    typ int64
}

// iface_method_named returns the method called name of the interface
// declared at d, Go's Interface().Method, or no key.
func iface_method_named(trees []ast.File, none []uint8, d Key, name []uint8) Key {
    switch kind_at(trees, d) {
    case type_decl(td):
        switch kind_at(trees, sub(d, td.type_expr)) {
        case interface_type(ms):
            for i := range count_items(trees, d.unit, ms) {
                mk := item_at(trees, d.unit, ms, i)
                switch kind_at(trees, mk) {
                case iface_method(m):
                    if bytes_equal(text_at(trees, none, mk.unit, m.name), name) {
                        return mk
                    }
                default:
                }
            }
        default:
        }
    default:
    }
    return no_key()
}

// iface_method_of returns the IfaceMethod the node mk holds, a copy.
func iface_method_of(trees []ast.File, mk Key) ast.IfaceMethod {
    switch kind_at(trees, mk) {
    case iface_method(m):
        return m
    default:
        mut z ast.IfaceMethod
        return z
    }
}

// type_param_name appends the name of the type parameter declared at
// tk, Go's TypeParam.Name.
func (mut c Checker) type_param_name(tk Key, mut out list[uint8]) error {
    switch kind_at(c.prog.trees, tk) {
    case type_param(tp):
        append(mut out, text_at(c.prog.trees, c.none, tk.unit, tp.name)...)?
    default:
    }
    return noerror
}

// type_param_method returns the method the selector f, s, names of a
// value of typ, a type parameter, Go's typeParamMethod: a stand-in for
// its constraint's method of that name, a function with no body added
// to the interface's tree whose receiver has type typ and whose other
// parameters and results are the interface method's, so a call is
// checked against it as against a struct's method. A name the
// constraint has no method of is reported; a constraint that was
// reported has none, and nothing more is reported.
func (mut c Checker) type_param_method(typ types.Type, f Key, s ast.Selector) (Key, error) {
    tk, has := c.type_params[typ.number()]
    mut name := msg()
    append(mut name, text_at(c.prog.trees, c.none, f.unit, s.name)...)?
    if !has {
        return no_key(), noerror
    }
    data, has_data := c.tp_data[tk]
    if has_data && data {
        mut m := msg()
        mut c.type_param_name(tk, mut m)?
        fmt.appendf(mut m, " has no method %s: its constraint Data has none", name[:])?
        mut c.errorf(s.name_span, own m)?
        return no_key(), noerror
    }
    iface, has_iface := c.tp_iface[tk]
    if !has_iface {
        return no_key(), noerror
    }
    mk := iface_method_named(c.prog.trees, c.none, iface, name[:])
    if is_no_key(mk) {
        mut m := msg()
        mut c.type_param_name(tk, mut m)?
        fmt.appendf(mut m, " has no method %s", name[:])?
        mut c.errorf(s.name_span, own m)?
        return no_key(), noerror
    }
    sk := StandInKey{method: mk, typ: typ.number()}
    known, made := c.stand_ins[sk]
    if made {
        return known, noerror
    }
    fn := mut c.make_stand_in(mk, tk, typ)?
    put(mut c.stand_ins, sk, fn)?
    return fn, noerror
}

// make_stand_in adds to the tree of the interface method mk the stand-in
// Go's typeParamMethod makes for it, called on values of typ, the type
// parameter declared at tk: a method with no body whose receiver,
// named as the type parameter, has type typ and is mut when mk's is,
// followed by mk's parameters, with mk's results, and returns it.
func (mut c Checker) make_stand_in(mk Key, tk Key, typ types.Type) (Key, error) {
    u := mk.unit
    m := iface_method_of(c.prog.trees, mk)
    mut tname := msg()
    mut c.type_param_name(tk, mut tname)?
    tsp := span_at(c.prog.trees, tk)
    mut tname_span := tsp
    switch kind_at(c.prog.trees, tk) {
    case type_param(tp):
        tname_span = tp.name_span
    default:
    }
    s := add_str(mut c.prog.trees, u, tname)?
    mut none_node id[ast.Node]
    recv := ast.Param{type_expr: none_node, name: s, name_span: tname_span, mut_span: ast.unset_span(), own_span: ast.unset_span(), scope_span: ast.unset_span(), ellipsis_span: ast.unset_span(), is_mut: m.is_mut, is_own: false, is_scope: false, variadic: false}
    pid := add_param_to(mut c.prog.trees, u, recv)?
    pn := add_node(mut c.prog.trees, u, ast.Kind.param_decl(pid), tsp)?
    put(mut c.decl_types, Key{unit: u, node: pn}, typ)?
    mut items := make(list[id[ast.Node]], c_allocator)
    append(mut items, pn)?
    for i := range count_items(c.prog.trees, u, m.params) {
        append(mut items, item_at(c.prog.trees, u, m.params, i).node)?
    }
    params := add_list(mut c.prog.trees, u, items)?
    mut z ast.Func
    mut fn := z
    fn.name = m.name
    fn.params = params
    fn.results = m.results
    fn.name_span = m.name_span
    fn.no_body = true
    fn.method = true
    fid := add_func_to(mut c.prog.trees, u, fn)?
    fnode := add_node(mut c.prog.trees, u, ast.Kind.func_decl(fid), span_at(c.prog.trees, mk))?
    fk := Key{unit: u, node: fnode}
    n, _ := results_count(c.result_count, mk)
    put(mut c.result_count, fk, n)?
    for i := range n {
        put(mut c.results, RKey{unit: u, node: fnode, i: i}, result_of(c.results, mk, i))?
    }
    put(mut c.stand_in_of, fk, mk)?
    return fk, noerror
}

// add_param_to adds p to the params of the tree u.
func add_param_to(mut trees list[ast.File], u int64, p ast.Param) (id[ast.Param], error) {
    if u < 0 || u >= len(trees) {
        mut z id[ast.Param]
        return z, noerror
    }
    r := mut trees[u].add_param(p)?
    return r, noerror
}

// add_func_to adds fn to the funcs of the tree u.
func add_func_to(mut trees list[ast.File], u int64, fn ast.Func) (id[ast.Func], error) {
    if u < 0 || u >= len(trees) {
        mut z id[ast.Func]
        return z, noerror
    }
    r := mut trees[u].add_func(fn)?
    return r, noerror
}

// type_param_field reports the field s of a value of typ, a type
// parameter, which has no fields, Go's typeParamField: a method of its
// constraint named without a call is reported as such.
func (mut c Checker) type_param_field(s ast.Selector, f Key, typ types.Type) error {
    mut name := msg()
    append(mut name, text_at(c.prog.trees, c.none, f.unit, s.name)...)?
    n := mut c.type_name(typ)?
    tk, has := c.type_params[typ.number()]
    if has {
        iface, has_iface := c.tp_iface[tk]
        if has_iface && !is_no_key(iface_method_named(c.prog.trees, c.none, iface, name[:])) {
            mut m := msg()
            fmt.appendf(mut m, "%s is a method of %s, not a field; a method can only be called", name[:], n[:])?
            return mut c.errorf(s.name_span, own m)
        }
    }
    mut m := msg()
    fmt.appendf(mut m, "%s has no field %s: a type parameter has only its constraint's methods", n[:], name[:])?
    return mut c.errorf(s.name_span, own m)
}
