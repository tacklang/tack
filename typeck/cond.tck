package typeck

import ast from "tack/ast"
import constant from "tack/constant"
import conv from "std/conv"
import types from "tack/types"

// The facts a condition gives, Go's factsFrom and the functions it
// calls (facts.go, maps.go's memberFact, unreachable.go's eitherFact
// and relations.go's linearFacts). A condition nests && || and ! as
// deeply as the source writes them, and a chain of && or || as long as
// it likes, so its facts are worked out from a stack of frames, not
// recursion: each frame is a part of the condition and whether it is
// asked true or false, and the facts of each part are a run of one list,
// the left side's facts then the right side's, which an && that holds
// joins by leaving them where they are.

// CondFrame is a part of a condition whose facts facts_from is working
// out: cond, asked as holds; state, how far it got, 0 before its parts,
// 1 once its left side's facts are in, 2 once its right side's are;
// start, where its facts begin in the list, and mid, where its right
// side's do.
type CondFrame struct {
    cond Cond
    holds bool
    state uint8
    start int64
    mid int64
}

// cond_binary returns the binary cond is, its operator, its left and its
// right operand, and whether it is one: a node's, or tag == value for a
// case's comparison.
func (c Checker) cond_binary(cond Cond) (ast.BinaryOp, Key, Key, bool) {
    if !is_no_key(cond.tag) {
        return ast.op_eq, cond.tag, cond.node, true
    }
    switch kind_at(c.prog.trees, cond.node) {
    case binary(b):
        return b.op, sub(cond.node, b.x), sub(cond.node, b.y), true
    default:
        return ast.op_invalid, no_key(), no_key(), false
    }
}

// facts_from appends to out the facts cond gives where it evaluated to
// holds, Go's factsFrom: && gives both sides' facts when true, the left
// side's dropped where the right side assigns their variables, and ||
// both sides' facts of being false when false; && false and || true give
// what both sides agree on (see union) and a fact carrying each side's
// own (see either_fact); ! swaps; a comparison gives what
// comparison_fact gives, a bool variable what bool_fact gives, and has
// what member_fact gives. The facts of the last && or || checked are
// copied rather than worked out again (see chain_facts_of).
func (mut c Checker) facts_from(cond Cond, holds bool, mut out list[Fact]) error {
    am := c.arena_mark()
    start := len(out)
    mut c.facts_from_at(cond, holds, mut out)?
    return mut c.keep_only(am, mut out, start)
}

// facts_from_at is facts_from without giving back the records its
// parts made that its facts do not name.
func (mut c Checker) facts_from_at(cond Cond, holds bool, mut out list[Fact]) error {
    mut frames := make(list[CondFrame], c_allocator)
    append(mut frames, CondFrame{cond: cond, holds: holds, state: 0, start: 0, mid: 0})?
    for len(frames) > 0 {
        top := len(frames) -% 1
        fr, ok := frames[top]
        if !ok {
            break
        }
        if fr.state == 0 {
            copied := mut c.chain_facts_of(fr.cond, fr.holds, mut out)?
            if copied {
                pop(mut frames)
                continue
            }
            op, x, _, is_bin := c.cond_binary(fr.cond)
            if is_bin && (op == ast.op_and || op == ast.op_or) && is_no_key(fr.cond.tag) {
                mut f2 := fr
                f2.state = 1
                f2.start = len(out)
                set_frame(mut frames, top, f2)
                append(mut frames, CondFrame{cond: node_cond(x), holds: fr.holds, state: 0, start: 0, mid: 0})?
                continue
            }
            if !is_bin {
                switch kind_at(c.prog.trees, fr.cond.node) {
                case unary(u):
                    if u.op == ast.unary_not {
                        set_frame(mut frames, top, CondFrame{cond: node_cond(sub(fr.cond.node, u.x)), holds: !fr.holds, state: 0, start: 0, mid: 0})
                        continue
                    }
                default:
                }
            }
            mut c.cond_leaf_facts(fr.cond, fr.holds, mut out)?
            pop(mut frames)
            continue
        }
        op, _, y, _ := c.cond_binary(fr.cond)
        joins := op == ast.op_and && fr.holds || op == ast.op_or && !fr.holds
        if fr.state == 1 {
            if joins {
                mut rgn := make(list[Key], c_allocator)
                append(mut rgn, y)?
                mut c.drop_assigned(mut out, fr.start, rgn[:])?
            }
            mut f2 := fr
            f2.state = 2
            f2.mid = len(out)
            set_frame(mut frames, top, f2)
            append(mut frames, CondFrame{cond: node_cond(y), holds: fr.holds, state: 0, start: 0, mid: 0})?
            continue
        }
        if !joins {
            mut c.unite_sides(fr.cond, mut out, fr.start, fr.mid)?
        }
        pop(mut frames)
    }
    return noerror
}

// leaf_facts appends to out the facts cond, no && or ||, gives where it
// evaluated to holds: a bool variable's, a has that holds, or a
// comparison's.
func (mut c Checker) cond_leaf_facts(cond Cond, holds bool, mut out list[Fact]) error {
    if !is_no_key(cond.tag) {
        return mut c.comparison_fact(cond, holds, mut out)
    }
    switch kind_at(c.prog.trees, cond.node) {
    case ident:
        return mut c.bool_fact(cond.node, holds, mut out)
    case call:
        if holds && is_builtin_call(c.prog.trees, c.none, cond.node, "has") {
            return mut c.member_fact(cond.node, mut out)
        }
        return noerror
    case binary(b):
        if is_comparison_op(b.op) {
            return mut c.comparison_fact(cond, holds, mut out)
        }
        return noerror
    default:
        return noerror
    }
}

// unite_sides replaces the facts of out from start on, a left side's up
// to mid and a right side's after, of cond, an && that does not hold or
// an || that does, with what both sides agree on, each from cond (see
// union), then the fact carrying the sides (see either_fact).
func (mut c Checker) unite_sides(cond Cond, mut out list[Fact], start int64, mid int64) error {
    mut left := make(list[Fact], c_allocator)
    mut right := make(list[Fact], c_allocator)
    mut i := start
    for i < len(out) {
        f := fact_in(out[:], i)
        if i < mid {
            append(mut left, f)?
        } else {
            append(mut right, f)?
        }
        i +%= 1
    }
    for len(out) > start {
        pop(mut out)
    }
    frm := len(out)
    mut c.unite_facts(left[:], right[:], mut out)?
    mut j := frm
    for j < len(out) {
        mut f := fact_in(out[:], j)
        f.src = cond
        set_fact(mut out, j, f)
        j +%= 1
    }
    e := mut c.either_fact(left[:], right[:])?
    append(mut out, e)?
    return noerror
}

// chain_facts_of appends to out a copy of the facts of the last && or ||
// binary checked, when they are cond's when its value is holds, Go's
// chainFacts.of, and reports whether they were.
func (mut c Checker) chain_facts_of(cond Cond, holds bool, mut out list[Fact]) (bool, error) {
    if is_no_key(c.fx.chain_bin) || !is_no_key(cond.tag) || cond.node != c.fx.chain_bin {
        return false, noerror
    }
    op, _, _, _ := c.cond_binary(cond)
    if (op == ast.op_and) != holds {
        return false, noerror
    }
    for _, f := range c.fx.chain {
        append(mut out, f)?
    }
    return true, noerror
}

// take_chain returns the facts facts_from gives for cond when its value
// is holds, Go's takeChain: the facts of the last && or || checked, when
// cond is that binary, handed over and forgotten, rather than copied.
func (mut c Checker) take_chain(cond Key, holds bool) (list[Fact], error) {
    nc := node_cond(cond)
    if !is_no_key(c.fx.chain_bin) && cond == c.fx.chain_bin {
        op, _, _, _ := c.cond_binary(nc)
        if (op == ast.op_and) == holds {
            facts := replace(mut c.fx.chain, make(list[Fact], c_allocator))
            c.fx.chain_bin = no_key()
            return facts, noerror
        }
    }
    mut out := make(list[Fact], c_allocator)
    mut c.facts_from(nc, holds, mut out)?
    return out, noerror
}

// join_chain records the facts of bin, a checked && or || binary, whose
// left side gives left, taken over, as the chain holds them, Go's
// joinFacts: left, each dropped where bin's right side assigns its
// variable, then the right side's facts.
func (mut c Checker) join_chain(bin Key, own left list[Fact]) error {
    op, _, y, _ := c.cond_binary(node_cond(bin))
    holds := op == ast.op_and
    mut joined := left
    mut rgn := make(list[Key], c_allocator)
    append(mut rgn, y)?
    mut c.drop_assigned(mut joined, 0, rgn[:])?
    mut c.facts_from(node_cond(y), holds, mut joined)?
    old := replace(mut c.fx.chain, joined)
    drop(own old)
    c.fx.chain_bin = bin
    return noerror
}

// bool_fact appends to out the fact a bool variable, the name k, tested
// on its own as a condition gives when its value is holds, Go's
// boolFact: that it is true, held as 1, or false, held as 0.
func (mut c Checker) bool_fact(k Key, holds bool, mut out list[Fact]) error {
    if mut c.type_of(k) != types.bool_type {
        return noerror
    }
    about, ok := mut c.key_of(k)?
    if !ok {
        return noerror
    }
    mut v := constant.from_int64(0)
    if holds {
        v = constant.from_int64(1)
    }
    mut f := bound(about, ast.op_eq, v)
    f.src = node_cond(k)
    append(mut out, f)?
    return noerror
}

// member_fact appends to out the fact has(m, k), the call k, gives when
// it holds, Go's memberFact: that the key is in m, for a map that is a
// subject and a key that is a known value or a name nothing assigns, or
// a path below one.
func (mut c Checker) member_fact(k Key, mut out list[Fact]) error {
    cl := call_of(c.prog.trees, k)
    if node_type_of(c.node_types, k) != types.bool_type || count_items(c.prog.trees, k.unit, cl.args) != 2 {
        return noerror
    }
    m, ok := mut c.key_of(item_at(c.prog.trees, k.unit, cl.args, 0))?
    if !ok {
        return noerror
    }
    about, known, is_member := mut c.member_of(item_at(c.prog.trees, k.unit, cl.args, 1))?
    if !is_member {
        return noerror
    }
    mut f := new_fact(about)
    f.known = known
    f.in_map = m
    f.src = node_cond(k)
    append(mut out, f)?
    return noerror
}

// member_of returns how a fact that the key k is in a map knows k, Go's
// memberOf: by its value, interned as its text, when k is a known
// integer or string, or as the subject about, when k is a name nothing
// can assign or a path below one.
func (mut c Checker) member_of(k Key) (FKey, int64, bool, error) {
    v, known := mut c.known_value(k)?
    if known {
        mut t := msg()
        append(mut t, []uint8("int ")...)?
        v.append_string(mut t)?
        n := mut c.intern_path(t[:])?
        return zero_fkey(), n, true, noerror
    }
    s, is_str := mut c.known_string(k)?
    if is_str {
        mut t := msg()
        append(mut t, []uint8("string ")...)?
        conv.append_quote(mut t, c.store.str_bytes(s))?
        n := mut c.intern_path(t[:])?
        return zero_fkey(), n, true, noerror
    }
    nm, is_id := ident_at(c.prog.trees, k)
    if is_id {
        if !nm.def.is_decl() {
            return FKey{decl: no_decl_key(), path: 0}, 0, mut c.immutable_name(nm), noerror
        }
        return decl_fkey(key_of_def(nm.def)), 0, mut c.immutable_name(nm), noerror
    }
    about, ok := mut c.path_key(k)?
    return about, 0, ok, noerror
}

// comparison_fact appends to out the facts cond, a comparison, gives
// when its value is holds, Go's comparisonFact: a bool subject ruled
// out, a subject or a length compared with a known value, a subject
// below a length, a relation a slice needs, either side being the one
// the fact is about, or else the difference bounds it gives.
func (mut c Checker) comparison_fact(cond Cond, holds bool, mut out list[Fact]) error {
    op0, x, y, _ := c.cond_binary(cond)
    mut op := op0
    if !holds {
        op = negate(op)
    }
    f, ruled := mut c.bool_ruled_out(x, op, y)?
    if ruled {
        mut g := f
        g.src = cond
        append(mut out, g)?
        return noerror
    }
    f1, ok1 := mut c.oriented_fact(x, op, y)?
    if ok1 {
        mut g := f1
        g.src = cond
        append(mut out, g)?
        return noerror
    }
    f2, ok2 := mut c.oriented_fact(y, flip(op), x)?
    if ok2 {
        mut g := f2
        g.src = cond
        append(mut out, g)?
        return noerror
    }
    frm := len(out)
    mut c.linear_facts(x, op, y, mut out)?
    mut j := frm
    for j < len(out) {
        mut g := fact_in(out[:], j)
        g.src = cond
        set_fact(mut out, j, g)
        j +%= 1
    }
    return noerror
}

// bool_ruled_out returns the fact a comparison of a bool subject with
// true or false gives, either side the literal, when it holds with op
// !=, Go's boolRuledOut: that the subject is not the literal's value.
func (mut c Checker) bool_ruled_out(x Key, op ast.BinaryOp, y Key) (Fact, bool, error) {
    mut subj := x
    mut lit := false
    mut is_lit := false
    switch kind_at(c.prog.trees, y) {
    case bool_lit(b):
        lit = b
        is_lit = true
    default:
        switch kind_at(c.prog.trees, x) {
        case bool_lit(b):
            lit = b
            is_lit = true
            subj = y
        default:
        }
    }
    if !is_lit || op != ast.op_ne || mut c.type_of(subj) != types.bool_type {
        return new_fact(zero_fkey()), false, noerror
    }
    about, ok := mut c.key_of(subj)?
    if !ok {
        return new_fact(zero_fkey()), false, noerror
    }
    mut f := new_fact(about)
    if lit {
        f.ne = constant.from_int64(1)
    }
    f.out = true
    return f, true, noerror
}

// oriented_fact returns the fact left op right gives about left, Go's
// orientedFact: a subject, or len of a string subject, compared with a
// known value, a subject below the length of a string subject, or a
// relation a slice needs.
func (mut c Checker) oriented_fact(left Key, op ast.BinaryOp, right Key) (Fact, bool, error) {
    about, ok := mut c.subject(left)?
    if !ok {
        return new_fact(zero_fkey()), false, noerror
    }
    k, known := mut c.known_value(right)?
    if known {
        return bound(about, op, k), true, noerror
    }
    s, is_len := mut c.string_len(right)?
    if is_len && !is_len_call(c.prog.trees, c.none, left) && op == ast.op_lt {
        mut f := new_fact(about)
        f.len_of = s
        return f, true, noerror
    }
    f, rel := mut c.relation(left, about, op, right)?
    return f, rel, noerror
}

// relation returns the relation left op right gives about left, an
// integer subject whose key is about, other than a length, Go's
// relation: at or below len(s), or at or below another integer subject,
// below it when strict.
func (mut c Checker) relation(left Key, about FKey, op ast.BinaryOp, right Key) (Fact, bool, error) {
    if op != ast.op_le && op != ast.op_lt || is_len_call(c.prog.trees, c.none, left) || !types.is_integer(mut c.type_of(left)) {
        return new_fact(zero_fkey()), false, noerror
    }
    s, is_len := mut c.string_len(right)?
    if is_len {
        mut f := new_fact(about)
        f.at_most_len = s
        return f, op == ast.op_le, noerror
    }
    other, ok := mut c.key_of(right)?
    if ok && types.is_integer(mut c.type_of(right)) {
        mut f := new_fact(about)
        f.at_most = other
        f.strict = op == ast.op_lt
        return f, true, noerror
    }
    return new_fact(zero_fkey()), false, noerror
}

// union appends to out the facts that hold when the facts a hold or the
// facts b do, not knowing which, Go's union: for each subject both say
// something about, the smallest interval holding what each side allows,
// leaving out relations, dropped facts and the sides of a condition.
func (mut c Checker) unite_facts(a []Fact, b []Fact, mut out list[Fact]) error {
    mut seen := make(map[FKey]bool, c_allocator)
    for _, f := range a {
        _, was := seen[f.about]
        if was || f.relational() || f.drop >= 0 || f.either >= 0 {
            continue
        }
        put(mut seen, f.about, true)?
        other, ok := side_interval(b, f.about)
        if !ok {
            continue
        }
        mine, _ := side_interval(a, f.about)
        append(mut out, mine.hull(other).as_fact(f.about))?
    }
    return noerror
}

// side_interval returns what the facts of one side say about the subject
// k, and whether any of them is about it, Go's sideInterval.
func side_interval(facts []Fact, k FKey) (Interval, bool) {
    mut known := no_interval()
    mut found := false
    for _, f := range facts {
        if f.about == k && !f.relational() && f.drop < 0 && f.either < 0 {
            known = known.narrow(f)
            found = true
        }
    }
    return known, found
}

// either_fact returns the fact carrying left and right, the facts of each
// side of a true || or a false &&, leaving out any fact carrying sides
// of its own, Go's eitherFact.
func (mut c Checker) either_fact(left []Fact, right []Fact) (Fact, error) {
    first := len(c.fx.sides)
    mut c.add_side(left)?
    mut c.add_side(right)?
    nid := len(c.fx.eithers)
    append(mut c.fx.eithers, Either{first: first, count: 2})?
    mut f := new_fact(zero_fkey())
    f.either = nid
    return f, noerror
}

// add_side records the facts of side that carry no sides of their own
// as a side.
func (mut c Checker) add_side(side []Fact) error {
    start := len(c.fx.side_facts)
    for _, f := range side {
        if f.either < 0 {
            append(mut c.fx.side_facts, f)?
        }
    }
    append(mut c.fx.sides, Side{start: start, count: len(c.fx.side_facts) -% start})?
    return noerror
}

// drop_assigned marks each fact of facts from from on that region
// assigns the variable of as writes_assigned says, Go's dropAssigned: a
// value ruled out included, and each side's facts of one carrying the
// sides of a condition (see drop_sides). A fact already dropped keeps
// its drop. The region is walked once for all the facts.
func (mut c Checker) drop_assigned(mut facts list[Fact], frm int64, rgn []Key) error {
    mut idx := new_write_index()
    mut built := false
    drops := len(c.fx.drops)
    text := len(c.fx.drop_text)
    keeps := len(c.fx.keeps)
    side_facts := len(c.fx.side_facts)
    mut named := false
    mut i := frm
    for i < len(facts) {
        mut f := fact_in(facts[:], i)
        if f.either >= 0 {
            f.either = mut c.drop_sides(f.either, rgn)?
            set_fact(mut facts, i, f)
            named = true
        } else if f.drop < 0 && (!f.is_empty() || f.out) {
            if !built {
                fresh := mut c.index_writes(rgn)?
                old := replace(mut idx, fresh)
                drop(own old)
                built = true
            }
            f.drop = c.first_write_drop(idx, f)
            set_fact(mut facts, i, f)
            named = named || f.drop >= 0
        }
        i +%= 1
    }
    if !named {
        // The walk's drops and keeps are named by no fact, and by nothing
        // else once its index goes: give them back, as Go's collector
        // frees them, so a nest of loops, each walking the loops inside
        // it, keeps records growing with what is put in force, not with
        // what is walked.
        for len(c.fx.drops) > drops {
            pop(mut c.fx.drops)
        }
        for len(c.fx.drop_text) > text {
            pop(mut c.fx.drop_text)
        }
        for len(c.fx.keeps) > keeps {
            pop(mut c.fx.keeps)
        }
        return noerror
    }
    return mut c.keep_named_drops(mut facts, frm, drops, text, side_facts)
}

// keep_named_drops gives back every drop drop_assigned's walk made, from
// drops on, with its name from text on, that no fact names: the facts
// of facts from frm on and the side facts made since side_facts, which
// are all that can name them. The walk makes a drop for every write of
// its region, and a fact names only the first write of its variable, so
// a nest of ifs, each walking the region inside it, would otherwise keep
// drops growing with the square of its depth, where Go's collector frees
// those its index alone held. The drops kept move down, in order, and
// are renamed in the facts; drops are compared by what they hold (see
// same_drop), never by their place, so nothing else changes.
func (mut c Checker) keep_named_drops(mut facts list[Fact], frm int64, drops int64, text int64, side_facts int64) error {
    if len(c.fx.drops) == drops {
        return noerror
    }
    mut moved := make(map[int64]int64, c_allocator)
    mut kept := make(list[Drop], c_allocator)
    mut names := make(list[uint8], c_allocator)
    mut i := frm
    for i < len(facts) {
        mut f := fact_in(facts[:], i)
        f.drop = mut c.keep_drop(f.drop, drops, text, mut moved, mut kept, mut names)?
        set_fact(mut facts, i, f)
        i +%= 1
    }
    mut j := side_facts
    for j < len(c.fx.side_facts) {
        mut f := fact_in(c.fx.side_facts[:], j)
        f.drop = mut c.keep_drop(f.drop, drops, text, mut moved, mut kept, mut names)?
        set_fact(mut c.fx.side_facts, j, f)
        j +%= 1
    }
    for len(c.fx.drops) > drops {
        pop(mut c.fx.drops)
    }
    for len(c.fx.drop_text) > text {
        pop(mut c.fx.drop_text)
    }
    append(mut c.fx.drops, kept[:]...)?
    append(mut c.fx.drop_text, names[:]...)?
    return noerror
}

// keep_ending_drops gives back every drop made from drops on, with its
// name from text on, that no ending made from endings on names: an index
// of a region makes a drop for every write it walks, judged as it walks
// them, and a fact keeps only the endings of the writes to what it is
// about, so a nest of ifs, each indexing the region inside it, would
// otherwise keep drops growing with the square of its depth, where Go's
// collector frees those its index alone held. assume_in and
// index_proven call it once their indexes are gone, when only those
// endings can name what they made. The drops kept move down, in order,
// renamed in the endings, as keep_named_drops moves its.
func (mut c Checker) keep_ending_drops(drops int64, text int64, endings int64) error {
    if len(c.fx.drops) == drops {
        return noerror
    }
    mut moved := make(map[int64]int64, c_allocator)
    mut kept := make(list[Drop], c_allocator)
    mut names := make(list[uint8], c_allocator)
    mut e := endings
    for e < len(c.fx.endings) {
        mut en := c.ending_at(e)
        en.drop = mut c.keep_drop(en.drop, drops, text, mut moved, mut kept, mut names)?
        set_at(mut c.fx.endings, e, en)
        e +%= 1
    }
    for len(c.fx.drops) > drops {
        pop(mut c.fx.drops)
    }
    for len(c.fx.drop_text) > text {
        pop(mut c.fx.drop_text)
    }
    append(mut c.fx.drops, kept[:]...)?
    append(mut c.fx.drop_text, names[:]...)?
    return noerror
}

// keep_drop returns where the drop d will be once keep_named_drops is
// done: d itself when it was made before drops, or none, and otherwise
// its place among the kept, which it takes, with its name, the first
// time it is asked about.
func (mut c Checker) keep_drop(d int64, drops int64, text int64, mut moved map[int64]int64, mut kept list[Drop], mut names list[uint8]) (int64, error) {
    if d < drops {
        return d, noerror
    }
    at, seen := moved[d]
    if seen {
        return at, noerror
    }
    nd := drops +% len(kept)
    mut dr := c.drop_at(d)
    if dr.text_len > 0 {
        nstart := text +% len(names)
        append_run(c.fx.drop_text[:], dr.text_start, dr.text_len, mut names)?
        dr.text_start = nstart
    }
    append(mut kept, dr)?
    put(mut moved, d, nd)?
    return nd, noerror
}

// append_run appends the n bytes of held from start to out, or nothing
// when they are not all there.
func append_run(held []uint8, start int64, n int64, mut out list[uint8]) error {
    end := start +% n
    if start >= 0 && start <= end && end <= len(held) {
        append(mut out, held[start:end]...)?
    }
    return noerror
}

// drop_sides returns a copy of the sides e with each side's facts that
// region assigns the variable of marked dropped, Go's dropSides.
func (mut c Checker) drop_sides(e int64, rgn []Key) (int64, error) {
    src := c.either_at(e)
    first := len(c.fx.sides)
    mut j int64 = 0
    for j < src.count {
        side := c.side_at(src.first +% j)
        j +%= 1
        mut copy := make(list[Fact], c_allocator)
        mut k int64 = 0
        for k < side.count {
            append(mut copy, fact_in(c.fx.side_facts[:], side.start +% k))?
            k +%= 1
        }
        mut c.drop_assigned(mut copy, 0, rgn)?
        start := len(c.fx.side_facts)
        append(mut c.fx.side_facts, copy[:]...)?
        append(mut c.fx.sides, Side{start: start, count: len(copy)})?
    }
    nid := len(c.fx.eithers)
    append(mut c.fx.eithers, Either{first: first, count: src.count})?
    return nid, noerror
}

// set_frame sets l[i] to fr, when l has an i'th frame.
func set_frame(mut l list[CondFrame], i int64, fr CondFrame) {
    set_at(mut l, i, fr)
}

// ArenaMark is how many records the arenas a condition's facts make
// records in hold: the sides of conditions, the drops and their names,
// the difference bounds and the keeps.
type ArenaMark struct {
    eithers int64
    sides int64
    side_facts int64
    drops int64
    drop_text int64
    diffs int64
    keeps int64
}

// arena_mark returns how many records those arenas hold now.
func (c Checker) arena_mark() ArenaMark {
    return ArenaMark{
        eithers: len(c.fx.eithers), sides: len(c.fx.sides), side_facts: len(c.fx.side_facts),
        drops: len(c.fx.drops), drop_text: len(c.fx.drop_text), diffs: len(c.fx.diffs),
        keeps: len(c.fx.keeps),
    }
}

// Kept is the records keep_only carries over: each kind's, in the order
// first named, and the new position of each old one.
type Kept struct {
    eithers list[Either]
    sides list[Side]
    side_facts list[Fact]
    drops list[Drop]
    drop_text list[uint8]
    diffs list[DiffBound]
    drop_at map[int64]int64
    diff_at map[int64]int64
}

// keep_only gives back every record made since am that the facts of out
// from start on do not name, the parts of a condition whose facts were
// worked out and thrown away, as Go's collector would, and moves those
// they name down to follow the records before am, renaming them in the
// facts. A condition nested as deeply as the parser allows, whose facts
// are worked out again at every level, so holds no more records than
// the facts it gives. Keeps are named only by the endings of facts put
// in force, which working out a condition's facts makes none of.
func (mut c Checker) keep_only(am ArenaMark, mut out list[Fact], start int64) error {
    if len(c.fx.eithers) == am.eithers && len(c.fx.drops) == am.drops && len(c.fx.diffs) == am.diffs && len(c.fx.keeps) == am.keeps {
        return noerror
    }
    mut k := Kept{
        eithers: make(list[Either], c_allocator), sides: make(list[Side], c_allocator),
        side_facts: make(list[Fact], c_allocator), drops: make(list[Drop], c_allocator),
        drop_text: make(list[uint8], c_allocator), diffs: make(list[DiffBound], c_allocator),
        drop_at: make(map[int64]int64, c_allocator), diff_at: make(map[int64]int64, c_allocator),
    }
    mut i := start
    for i < len(out) {
        mut f := fact_in(out[:], i)
        f = mut c.carry_fact(am, mut k, f)?
        if f.either >= am.eithers {
            e := c.either_at(f.either)
            nid := am.eithers +% len(k.eithers)
            first := am.sides +% len(k.sides)
            mut j int64 = 0
            for j < e.count {
                side := c.side_at(e.first +% j)
                j +%= 1
                sstart := am.side_facts +% len(k.side_facts)
                mut q int64 = 0
                for q < side.count {
                    sf := fact_in(c.fx.side_facts[:], side.start +% q)
                    q +%= 1
                    nsf := mut c.carry_fact(am, mut k, sf)?
                    append(mut k.side_facts, nsf)?
                }
                append(mut k.sides, Side{start: sstart, count: side.count})?
            }
            append(mut k.eithers, Either{first: first, count: e.count})?
            f.either = nid
        }
        set_fact(mut out, i, f)
        i +%= 1
    }
    for len(c.fx.eithers) > am.eithers {
        pop(mut c.fx.eithers)
    }
    for len(c.fx.sides) > am.sides {
        pop(mut c.fx.sides)
    }
    for len(c.fx.side_facts) > am.side_facts {
        pop(mut c.fx.side_facts)
    }
    for len(c.fx.drops) > am.drops {
        pop(mut c.fx.drops)
    }
    for len(c.fx.drop_text) > am.drop_text {
        pop(mut c.fx.drop_text)
    }
    for len(c.fx.diffs) > am.diffs {
        pop(mut c.fx.diffs)
    }
    for len(c.fx.keeps) > am.keeps {
        pop(mut c.fx.keeps)
    }
    append(mut c.fx.eithers, k.eithers[:]...)?
    append(mut c.fx.sides, k.sides[:]...)?
    append(mut c.fx.side_facts, k.side_facts[:]...)?
    append(mut c.fx.drops, k.drops[:]...)?
    append(mut c.fx.drop_text, k.drop_text[:]...)?
    append(mut c.fx.diffs, k.diffs[:]...)?
    return noerror
}

// carry_fact returns f with the drop and the difference bound it names,
// when made since am, carried into k and renamed to where they will be.
// A fact of a side carries no sides of its own.
func (mut c Checker) carry_fact(am ArenaMark, mut k Kept, f Fact) (Fact, error) {
    mut g := f
    if g.drop >= am.drops {
        nd, seen := k.drop_at[g.drop]
        if seen {
            g.drop = nd
        } else {
            mut d := c.drop_at(g.drop)
            ts := am.drop_text +% len(k.drop_text)
            mut t int64 = 0
            for t < d.text_len {
                append(mut k.drop_text, byte_at(c.fx.drop_text[:], d.text_start +% t))?
                t +%= 1
            }
            d.text_start = ts
            n := am.drops +% len(k.drops)
            append(mut k.drops, d)?
            put(mut k.drop_at, g.drop, n)?
            g.drop = n
        }
    }
    if g.diff >= am.diffs {
        nd, seen := k.diff_at[g.diff]
        if seen {
            g.diff = nd
        } else {
            n := am.diffs +% len(k.diffs)
            append(mut k.diffs, c.diff_at(g.diff))?
            put(mut k.diff_at, g.diff, n)?
            g.diff = n
        }
    }
    return g, noerror
}
