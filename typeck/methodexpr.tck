package typeck

import ast from "tack/ast"
import fmt from "std/fmt"
import types from "tack/types"

// Method expressions, Go's methodexpr.go: a method named through its
// type, Pair.first, is the method as a function value, whose first
// parameter is its receiver; what Go reports of a name selected through
// a type that names no method is reported here.

// type_operand reports whether x names a type rather than a value, Go's
// ast.TypeOperand: a name bound to a type's declaration or a type
// parameter, or a basic type's name, which binds to nothing.
func type_operand(trees []ast.File, none []uint8, x Key) bool {
    nm, ok := ident_at(trees, x)
    if !ok {
        return false
    }
    if nm.def.kind == ast.def_type || nm.def.kind == ast.def_type_param {
        return true
    }
    if !nm.def.is_none() || len(text_at(trees, none, x.unit, nm.pkg)) > 0 {
        return false
    }
    _, basic := types.lookup(text_at(trees, none, x.unit, nm.name))
    return basic
}

// method_expr checks the method expression s at k used as a value, Go's
// methodExpr: the method it names (see named_method) is a function
// value of its signature's type, receiver first, recorded on the
// selector; a method whose signature no function type can say is
// reported, and anything else named_method reports gives invalid.
func (mut c Checker) method_expr(k Key, s ast.Selector) (types.Type, error) {
    fn := mut c.named_method(k, s, false)?
    if is_no_key(fn) {
        return types.invalid, noerror
    }
    mut why := msg()
    bad := mut c.not_value(fn, mut why)?
    if bad {
        mut m := msg()
        fmt.appendf(mut m, "cannot use ")?
        mut c.display_name(fn, mut m)?
        fmt.appendf(mut m, " as a value: %s", why[:])?
        mut c.errorf(span_at(c.prog.trees, k), own m)?
        return types.invalid, noerror
    }
    typ := mut c.signature_value(fn)?
    if typ == types.invalid {
        return types.invalid, noerror
    }
    put(mut c.call_method, k, fn)?
    mut c.set_node_type(k, typ)?
    return typ, noerror
}
