package typeck

import conv from "std/conv"
import fmt from "std/fmt"
import types from "tack/types"
import unicode from "std/unicode"
import utf8 from "std/utf8"

// Format checks, Go's printf.go: std/fmt's printf, eprintf and appendf
// take a format and ...any, and when the format is a string the checker
// knows, every verb in it is checked against the value it takes, read
// byte by byte as printf's C reads it. std/testing's T.errorf and
// T.fatalf take a testing.Site first, which the port declines.

// check_printf checks the call k to fn, when fn is one of std/fmt's
// format functions and its format is a string the checker knows, Go's
// checkPrintfFrom: the arguments hold shift more before the format than
// the function's parameters say, 1 for a method expression's call.
func (mut c Checker) check_printf(k Key, fn Key, shift int64) error {
    cl := call_of(c.prog.trees, k)
    f := func_of(c.prog.trees, fn)
    mut name := msg()
    append(mut name, text_at(c.prog.trees, c.none, fn.unit, f.name)...)?
    owner, has_owner := c.unit_pkg[fn.unit]
    if !has_owner {
        return noerror
    }
    if f.method {
        if (bytes_equal(name, []uint8("errorf")) || bytes_equal(name, []uint8("fatalf"))) && pkg_path_is(c.prog.packages, owner, []uint8("std/testing")) {
            return not_ported
        }
        return noerror
    }
    mut at int64 = 0
    if bytes_equal(name, []uint8("appendf")) {
        at = 1
    } else if !bytes_equal(name, []uint8("printf")) && !bytes_equal(name, []uint8("eprintf")) {
        return noerror
    }
    if !pkg_path_is(c.prog.packages, owner, []uint8("std/fmt")) {
        return noerror
    }
    at +%= shift
    n := count_items(c.prog.trees, k.unit, cl.args)
    if n <= at {
        return noerror
    }
    farg := item_at(c.prog.trees, k.unit, cl.args, at)
    format, known := mut c.known_string(farg)?
    if !known {
        return noerror
    }
    mut fbytes := msg()
    append(mut fbytes, c.store.str_bytes(format)...)?
    counted := !cl.spread
    mut value_types := make(list[types.Type], c_allocator)
    if counted {
        mut i := at +% 1
        for i < n {
            append(mut value_types, mut c.type_of(item_at(c.prog.trees, k.unit, cl.args, i)))?
            i +%= 1
        }
    }
    mut verbs := make(list[VerbAt], c_allocator)
    lone := format_verbs(fbytes, mut verbs)?
    for value, v := range verbs {
        mut typ := types.invalid
        if counted {
            t, has := value_types[value]
            if has {
                typ = t
            }
        }
        mut verb := msg()
        mut j := v.start
        for j < v.end {
            append(mut verb, byte_at(fbytes, j))?
            j +%= 1
        }
        known_verb := verb_known(verb)
        if !known_verb {
            mut m := msg()
            fmt.appendf(mut m, "unknown %s verb ", name[:])?
            show_verb(verb, mut m)?
            mut c.errorf(span_at(c.prog.trees, farg), own m)?
            continue
        }
        if typ == types.invalid || typ == types.any_type || mut c.verb_takes(verb, typ) {
            continue
        }
        tn := mut c.type_name(typ)?
        mut m := msg()
        fmt.appendf(mut m, "%s verb %%%s does not take %s", name[:], verb[:], tn[:])?
        vk := item_at(c.prog.trees, k.unit, cl.args, at +% 1 +% value)
        mut c.errorf(span_at(c.prog.trees, vk), own m)?
    }
    if lone {
        mut m := msg()
        fmt.appendf(mut m, "%s format ends in a lone %%", name[:])?
        mut c.errorf(span_at(c.prog.trees, farg), own m)?
    }
    nv := len(verbs)
    if counted && nv != len(value_types) {
        mut m := msg()
        mut vw := "verbs"
        if nv == 1 {
            vw = "verb"
        }
        mut aw := "arguments"
        if len(value_types) == 1 {
            aw = "argument"
        }
        fmt.appendf(mut m, "%s format has %d %s but %d %s", name[:], nv, vw, len(value_types), aw)?
        if len(value_types) > nv {
            first := item_at(c.prog.trees, k.unit, cl.args, at +% 1 +% nv)
            mut sp := span_at(c.prog.trees, first)
            sp.end = span_at(c.prog.trees, item_at(c.prog.trees, k.unit, cl.args, n -% 1)).end
            mut c.errorf(sp, own m)?
        } else {
            mut c.errorf(span_at(c.prog.trees, farg), own m)?
        }
    }
    return noerror
}

// VerbAt is one verb of a format, without its %: where its bytes start
// and end in the format.
type VerbAt struct {
    start int64
    end int64
}

// format_verbs appends to out the verbs of format, in order, %% being
// none, Go's formatVerbs, and reports whether a lone % ends it.
func format_verbs(format []uint8, mut out list[VerbAt]) (bool, error) {
    mut i int64 = 0
    for i < len(format) {
        b := byte_at(format, i)
        if b != '%' {
            i +%= 1
            continue
        }
        i +%= 1
        if i == len(format) {
            return true, noerror
        }
        first := byte_at(format, i)
        n := verb_len(first, len(format) -% i)
        if !(n == 1 && first == '%') {
            append(mut out, VerbAt{start: i, end: i +% n})?
        }
        i +%= n
    }
    return false, noerror
}

// verb_len returns the length of the verb starting with the byte b, with
// n bytes left in the format, Go's verbLen: the length of the UTF-8
// sequence b starts, at most n.
func verb_len(b uint8, n int64) int64 {
    mut l int64 = 1
    if b >= 248 {
    } else if b >= 240 {
        l = 4
    } else if b >= 224 {
        l = 3
    } else if b >= 192 {
        l = 2
    }
    if l > n {
        return n
    }
    return l
}

// verb_known reports whether verb is one printf knows, Go's verbTakes'
// second result.
func verb_known(verb []uint8) bool {
    if len(verb) != 1 {
        return false
    }
    b := byte_at(verb, 0)
    return b == 'd' || b == 'x' || b == 's' || b == 't' || b == 'c' || b == 'e' || b == 'f' || b == 'g' || b == 'v'
}

// verb_takes reports whether the printf verb, one verb_known knows, takes
// a value of type typ, Go's verbTakes.
func (mut c Checker) verb_takes(verb []uint8, typ types.Type) bool {
    b := byte_at(verb, 0)
    bytes := c.table.is_view(typ) && c.table.elem_of(typ) == types.uint8_type
    if b == 'd' || b == 'x' {
        return types.is_integer(typ)
    }
    if b == 's' {
        return typ == types.string_type || bytes
    }
    if b == 't' {
        return typ == types.bool_type
    }
    if b == 'c' {
        return typ == types.uint8_type
    }
    if b == 'e' || b == 'f' || b == 'g' {
        return types.is_float(typ)
    }
    return c.table.in_any_of(typ) || bytes
}

// show_verb appends how a message shows verb, with its %, Go's showVerb:
// as written when it is valid UTF-8 of graphic characters, and quoted as
// Go quotes a string otherwise.
func show_verb(verb []uint8, mut out list[uint8]) error {
    mut with := msg()
    append(mut with, '%')?
    append(mut with, verb...)?
    if !utf8.valid(verb) {
        return conv.append_quote(mut out, with[:])
    }
    mut i int64 = 0
    for i >= 0 && i < len(verb) {
        r, size := utf8.decode(verb[i:])
        if !unicode.is_graphic(r) || unicode.is_space(r) {
            return conv.append_quote(mut out, with[:])
        }
        i +%= size
    }
    append(mut out, with[:]...)?
    return noerror
}
