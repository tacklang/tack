package typeck

import ast from "tack/ast"
import diag from "tack/diag"
import fmt from "std/fmt"
import source from "tack/source"
import text from "std/text"
import types from "tack/types"

// The bodies: Go's checkFunc and checkBody, and the statements they
// check (check.go, defer.go, invalid.go). The port checks a body as Go's
// pipeline does, statement by statement in source order, but without
// the facts Go keeps beside it: those decide only proofs, which later
// stages port, and every construct that needs one is declined,
// not_ported, before it could make a difference. So a body that checks
// is one in which Go's facts report nothing, and what the port reports
// is all Go reports. The moves and the escapes Go checks after a body
// with nothing reported the port checks too (see mover.tck and
// escape.tck).
//
// What is declined, and the stage that owns it: a read of a variable an
// error or an ok holds, a plain pop or remove, an element, a division
// and a slice not of a constant string, all of which need the facts in
// force (S3); integer arithmetic, an increment, a decrement, an integer
// compound assignment and a conversion of a value not known (S4); a loop
// that writes a variable declared before it, an ensures clause and
// unreachable (S5); two indexes of mut arguments whose overlap only
// facts decide, and a swap, whose indexes need proofs (S3); and a
// type parameter, a function value, a closure, a scope parameter of a
// function type, a fields loop and a switch on a type parameter (S7).
//
// A chain of else ifs, which nests an if in the else of the one before
// for every link, is checked in a loop, as is a statement list; only
// the nesting the source writes, up to the parser's limit, recurses.

// BodyState is what the check of one function's body tracks, Go's
// loops, deferred, deferLoops, inRejectedDefer and clauses: how many
// loops and defers are around the statement being checked, how many
// loops were around the innermost defer, whether a defer inside a defer
// was reported, and the switch cases whose bodies are being checked.
type BodyState struct {
    fn Key
    loops int64
    deferred int64
    defer_loops int64
    in_rejected_defer bool
    clauses list[ClauseAt]
}

// ClauseAt is a switch case whose body is being checked, Go's clauseAt:
// the clause, whether its switch is on a union, on_union, or a type
// switch, on_type, and how many defers were around it.
type ClauseAt struct {
    cl Key
    on_union bool
    on_type bool
    deferred int64
}

// check_bodies checks every function's body, in declaration order, Go's
// loop over decls calling checkFunc (check.go:604), each in the package
// it is declared in.
func (mut c Checker) check_bodies() error {
    for i := range count_decls(c.prog) {
        d := decl_at(c.prog, i)
        switch kind_at(c.prog.trees, d) {
        case func_decl:
            old := mut c.enter(d)
            e := mut c.check_func(d)
            c.pkg = old
            if e.code != 0 {
                return e
            }
        default:
        }
    }
    return noerror
}

// check_func checks the function d once every signature is known, Go's
// checkFunc: an extern func's C side, or any other's body, and a body
// with bad statements as check_damaged_body says. A body that had
// nothing else reported then has its moves checked (see check_moves),
// and, when they report nothing either, its escapes (see
// check_escapes).
func (mut c Checker) check_func(d Key) error {
    fn := func_of(c.prog.trees, d)
    if fn.is_extern && fn.method && c.prior > 0 {
        // The resolver reported it: a method is never extern.
        return noerror
    }
    if fn.is_extern {
        return mut c.check_extern(d)
    }
    first := first_bad_stmt(c.prog.trees, d.unit, fn.body)?
    if !is_no_key(first) {
        return mut c.check_damaged_body(d, first)
    }
    before := len(c.diags)
    mut c.check_body(d)?
    if len(c.diags) != before {
        return noerror
    }
    mut c.check_moves(d)?
    if len(c.diags) != before {
        return noerror
    }
    return mut c.check_escapes(d)
}

// first_bad_stmt returns the first bad statement of body, in the tree
// unit, at any depth, in Go's ast.BadStmts order, the walk's, or no key
// when it has none, or out of memory.
func first_bad_stmt(trees []ast.File, unit int64, body ast.Nodes) (Key, error) {
    mut stack := make(list[id[ast.Node]], c_allocator)
    mut kids := make(list[id[ast.Node]], c_allocator)
    mut i := count_items(trees, unit, body) -% 1
    for i >= 0 {
        append(mut stack, item_at(trees, unit, body, i).node)?
        i -%= 1
    }
    for len(stack) > 0 {
        top, ok := pop(mut stack)
        if !ok {
            break
        }
        k := Key{unit: unit, node: top}
        switch kind_at(trees, k) {
        case bad_stmt:
            return k, noerror
        default:
        }
        clear_nodes(mut kids)
        children_of(trees, unit, top, mut kids)?
        mut j := len(kids) -% 1
        for j >= 0 {
            kid, has := kids[j]
            if has {
                append(mut stack, kid)?
            }
            j -%= 1
        }
    }
    return no_key(), noerror
}

// check_damaged_body checks the body of d, which holds bad statements,
// the first of them first, Go's checkDamagedBody: it is checked as any
// body is, and what is reported in d at or after first, errors and
// warnings alike, is dropped, as are the size checks made there; the bad
// statement is reported as a syntax error when no earlier stage
// reported an error.
func (mut c Checker) check_damaged_body(d Key, first Key) error {
    before := len(c.diags)
    warned := len(c.warnings)
    mut c.check_body(d)?
    fsp := span_at(c.prog.trees, d)
    bad := span_at(c.prog.trees, first)
    keep_before(mut c.diags, before, fsp, bad)?
    keep_before(mut c.warnings, warned, fsp, bad)?
    mut c.forget_sizes_after(fsp, bad)?
    return mut c.report_bad(bad)
}

// after_bad reports whether sp starts in the function spanning fsp at or
// after bad, its first bad statement, Go's afterBad.
func after_bad(sp source.Span, fsp source.Span, bad source.Span) bool {
    return sp.file == bad.file && sp.start >= bad.start && sp.start < fsp.end
}

// keep_before drops from diags, from the index start on, every one that
// starts in the function spanning fsp at or after bad, Go's keptBefore.
func keep_before(mut diags list[diag.Diagnostic], start int64, fsp source.Span, bad source.Span) error {
    mut kept := make(list[diag.Diagnostic], c_allocator)
    for i := range len(diags) {
        if i < start || !after_bad(diags[i].span, fsp, bad) {
            append(mut kept, replace(mut diags[i], make(diag.Diagnostic, c_allocator)))?
        }
    }
    old := replace(mut diags, kept)
    drop(own old)
    return noerror
}

// forget_sizes_after forgets the size checks made in the function
// spanning fsp at or after bad, Go's forgetSizesAfter, so a type too
// large written there is reported at its next use.
func (mut c Checker) forget_sizes_after(fsp source.Span, bad source.Span) error {
    mut gone := make(list[int64], c_allocator)
    for n, sp := range c.size_checked {
        if after_bad(sp, fsp, bad) {
            append(mut gone, n)?
        }
    }
    for _, n := range gone {
        delete(mut c.size_checked, n)
    }
    return noerror
}

// report_bad reports a bad node, at sp, as a syntax error when no
// earlier stage reported an error, Go's reportBad.
func (mut c Checker) report_bad(sp source.Span) error {
    if c.prior == 0 {
        mut m := msg()
        fmt.appendf(mut m, "syntax error: this code could not be parsed")?
        mut c.errorf(sp, own m)?
    }
    return noerror
}

// check_bad_decls reports every bad declaration of the program as a
// syntax error when no earlier stage reported an error, Go's
// checkBadDecls.
func (mut c Checker) check_bad_decls() error {
    for i := range count_decls(c.prog) {
        d := decl_at(c.prog, i)
        switch kind_at(c.prog.trees, d) {
        case bad_decl:
            mut c.report_bad(span_at(c.prog.trees, d))?
        default:
        }
    }
    return noerror
}

// check_body checks the body of d, Go's checkBody: a first pass when a
// binding ties together the results of a method call (see
// discarded_pass), then what its bindings of errors tie together (see
// collect_holds), each statement, the variables nothing read, and then
// that it ends in a return when it declares a result. A body Go probes
// for its loops' bounds the port declines before it starts (see
// body_declined).
func (mut c Checker) check_body(d Key) error {
    fn := func_of(c.prog.trees, d)
    declined := mut c.body_declined(d, fn)?
    if declined {
        return not_ported
    }
    mut c.link_fallthroughs(d.unit, fn.body)?
    mut c.declare_regions(d.unit, fn.body)?
    outer := replace(mut c.body, BodyState{
        fn: d,
        loops: 0,
        deferred: 0,
        defer_loops: 0,
        in_rejected_defer: false,
        clauses: make(list[ClauseAt], c_allocator),
    })
    was := c.in_body
    c.in_body = true
    c.body_owns = mut c.holds_own_arg(d.unit, fn.body)?
    mut e := noerror
    binds := mut c.has_method_binding(d.unit, fn.body)?
    if binds {
        e = mut c.discarded_pass(d.unit, fn.body)
    }
    if e.code == 0 {
        e = mut c.collect_holds(d.unit, fn.body)
    }
    if e.code == 0 {
        e = mut c.check_stmts(d.unit, fn.body)
    }
    if e.code == 0 {
        e = mut c.report_unread(d.unit, fn.body)
    }
    c.in_body = was
    done := replace(mut c.body, outer)
    drop(own done)
    if e.code != 0 {
        return e
    }
    if count_items(c.prog.trees, d.unit, fn.results) == 0 {
        return noerror
    }
    terminates := mut c.block_terminates(d.unit, fn.body)?
    bad := first_bad_stmt(c.prog.trees, d.unit, fn.body)?
    if terminates || !is_no_key(bad) || fn.no_body && c.prior > 0 {
        return noerror
    }
    mut m := msg()
    mut c.display_name(d, mut m)?
    append(mut m, []uint8(" must end in a return")...)?
    return mut c.errorf(fn.name_span, own m)
}

// has_method_binding reports whether body, in the tree unit, binds the
// results of a method call or of a call of a method expression, at any
// depth, Go's hasMethodBinding: which method either calls is known only
// once its receiver or its type is checked.
func (mut c Checker) has_method_binding(unit int64, body ast.Nodes) (bool, error) {
    mut stack := make(list[id[ast.Node]], c_allocator)
    mut kids := make(list[id[ast.Node]], c_allocator)
    for i := range count_items(c.prog.trees, unit, body) {
        append(mut stack, item_at(c.prog.trees, unit, body, i).node)?
    }
    for len(stack) > 0 {
        top, ok := pop(mut stack)
        if !ok {
            break
        }
        k := Key{unit: unit, node: top}
        mut value := no_key()
        switch kind_at(c.prog.trees, k) {
        case multi_var(m):
            value = sub(k, m.value)
        case multi_assign(m):
            value = sub(k, m.value)
        default:
        }
        switch kind_at(c.prog.trees, value) {
        case call(cl):
            if !is_no_key(mut c.receiver_of(value)) || is_value_call(c.prog.trees, value) || mut c.is_method_expr(sub(value, cl.fn)) {
                return true, noerror
            }
        default:
        }
        clear_nodes(mut kids)
        children_of(c.prog.trees, unit, top, mut kids)?
        for _, kid := range kids {
            append(mut stack, kid)?
        }
    }
    return false, noerror
}

// holds_own_arg reports whether body, in the tree unit, holds an own
// argument at any depth, whose calls check_own_exclusive checks.
func (mut c Checker) holds_own_arg(unit int64, body ast.Nodes) (bool, error) {
    mut stack := make(list[id[ast.Node]], c_allocator)
    mut kids := make(list[id[ast.Node]], c_allocator)
    for i := range count_items(c.prog.trees, unit, body) {
        append(mut stack, item_at(c.prog.trees, unit, body, i).node)?
    }
    for len(stack) > 0 {
        top, ok := pop(mut stack)
        if !ok {
            break
        }
        k := Key{unit: unit, node: top}
        switch kind_at(c.prog.trees, k) {
        case own_arg:
            return true, noerror
        default:
        }
        clear_nodes(mut kids)
        children_of(c.prog.trees, unit, top, mut kids)?
        for _, kid := range kids {
            append(mut stack, kid)?
        }
    }
    return false, noerror
}

// discarded_pass checks body, in the tree unit, once before the check
// for good, with what it reports dropped and with records of its own,
// put back as they were after it, Go's discardedPass (see findCallees):
// what it leaves is each method call's method, which collect_holds then
// reads, and what the check for good records again.
func (mut c Checker) discarded_pass(unit int64, body ast.Nodes) error {
    before := len(c.diags)
    warned := len(c.warnings)
    own_r := replace(mut c.own_reported, make(map[source.Span]bool, c_allocator))
    sizes := replace(mut c.size_checked, make(map[int64]source.Span, c_allocator))
    locals := replace(mut c.known_locals, make(map[Key]KnownLocal, c_allocator))
    bins := replace(mut c.known_binaries, make(map[Key]KnownBinary, c_allocator))
    hs := replace(mut c.holders, make(map[Key]HolderAt, c_allocator))
    mut e := mut c.collect_holds(unit, body)
    if e.code == 0 {
        e = mut c.check_block(unit, body)
    }
    old_r := replace(mut c.own_reported, own_r)
    drop(own old_r)
    old_s := replace(mut c.size_checked, sizes)
    drop(own old_s)
    old_l := replace(mut c.known_locals, locals)
    drop(own old_l)
    old_b := replace(mut c.known_binaries, bins)
    drop(own old_b)
    old_h := replace(mut c.holders, hs)
    drop(own old_h)
    for len(c.diags) > before {
        d, ok := pop(mut c.diags)
        if ok {
            drop(own d)
        }
    }
    for len(c.warnings) > warned {
        w, ok := pop(mut c.warnings)
        if ok {
            drop(own w)
        }
    }
    return e
}

// body_declined reports whether the port declines the body of d, fn,
// before checking it: a function with type parameters or an ensures
// clause, one whose signature has
// a function type or a type parameter (see supported_type), which are
// later stages', or whose body Go probes for its
// loops' bounds, a loop that writes a variable declared before it (see
// firstPasses).
func (mut c Checker) body_declined(d Key, fn ast.Func) (bool, error) {
    if count_items(c.prog.trees, d.unit, fn.type_params) > 0 || !ast.is_none(fn.contract) {
        return true, noerror
    }
    for i := range count_items(c.prog.trees, d.unit, fn.params) {
        p := item_at(c.prog.trees, d.unit, fn.params, i)
        ok := mut c.supported_type(decl_type_of(c.decl_types, p))?
        if !ok {
            return true, noerror
        }
    }
    n, _ := results_count(c.result_count, d)
    for i := range n {
        rt := result_of(c.results, d, i)
        ok := mut c.supported_type(rt)?
        if !ok {
            return true, noerror
        }
    }
    writes := mut c.loop_writes_outer(d.unit, fn.body)?
    return writes, noerror
}

// loop_writes_outer reports whether a loop in body, in the tree unit,
// assigns, increments or decrements a name declared before it, a
// parameter or a variable, Go's hasCounterLoop: Go probes such a body
// first, which is S5's.
func (mut c Checker) loop_writes_outer(unit int64, body ast.Nodes) (bool, error) {
    // loops holds the spans of the loops around the node being looked
    // at, innermost last.
    mut loops := make(list[source.Span], c_allocator)
    mut stack := make(list[id[ast.Node]], c_allocator)
    mut kids := make(list[id[ast.Node]], c_allocator)
    mut targets := make(list[Key], c_allocator)
    mut i := count_items(c.prog.trees, unit, body) -% 1
    for i >= 0 {
        append(mut stack, item_at(c.prog.trees, unit, body, i).node)?
        i -%= 1
    }
    for len(stack) > 0 {
        top, ok := pop(mut stack)
        if !ok {
            return true, noerror
        }
        k := Key{unit: unit, node: top}
        sp := span_at(c.prog.trees, k)
        for len(loops) > 0 {
            last, has := loops[len(loops) -% 1]
            if !has || sp.start < last.end {
                break
            }
            pop(mut loops)
        }
        clear_keys(mut targets)
        switch kind_at(c.prog.trees, k) {
        case for_stmt, for_range, func_lit:
            append(mut loops, sp)?
        case assign(a):
            append(mut targets, sub(k, a.target))?
        case inc_dec(s):
            append(mut targets, sub(k, s.target))?
        case multi_assign(m):
            for j := range count_items(c.prog.trees, unit, m.targets) {
                append(mut targets, item_at(c.prog.trees, unit, m.targets, j))?
            }
        default:
        }
        for _, target := range targets {
            if len(loops) == 0 {
                break
            }
            nm, is_id := ident_at(c.prog.trees, target)
            last, has_last := loops[len(loops) -% 1]
            if is_id && has_last && declared_before(c.prog.trees, nm.def, last.start) {
                return true, noerror
            }
        }
        clear_nodes(mut kids)
        children_of(c.prog.trees, unit, top, mut kids)?
        mut j := len(kids) -% 1
        for j >= 0 {
            kid, has := kids[j]
            if has {
                append(mut stack, kid)?
            }
            j -%= 1
        }
    }
    return false, noerror
}

// declared_before reports whether def is a parameter, or a variable
// declared before pos, Go's declaredBefore.
func declared_before(trees []ast.File, def ast.Def, pos int64) bool {
    if def.kind == ast.def_param {
        return true
    }
    if def.kind == ast.def_var {
        return span_at(trees, key_of_def(def)).start < pos
    }
    return false
}

// link_fallthroughs records, for every switch in body, in the tree unit,
// each fallthrough that is the last statement of a case other than the
// last, with the case written after it, Go's Fallthrough.Next, which the
// parser links (see linkFallthroughs).
func (mut c Checker) link_fallthroughs(unit int64, body ast.Nodes) error {
    mut stack := make(list[id[ast.Node]], c_allocator)
    mut kids := make(list[id[ast.Node]], c_allocator)
    for i := range count_items(c.prog.trees, unit, body) {
        append(mut stack, item_at(c.prog.trees, unit, body, i).node)?
    }
    for len(stack) > 0 {
        top, ok := pop(mut stack)
        if !ok {
            return noerror
        }
        k := Key{unit: unit, node: top}
        switch kind_at(c.prog.trees, k) {
        case switch_stmt(s):
            n := count_items(c.prog.trees, unit, s.cases)
            for i := range n -% 1 {
                cl := item_at(c.prog.trees, unit, s.cases, i)
                f := last_stmt(c.prog.trees, cl)
                switch kind_at(c.prog.trees, f) {
                case fallthrough_stmt:
                    put(mut c.fall_next, f, item_at(c.prog.trees, unit, s.cases, i +% 1))?
                default:
                }
            }
        default:
        }
        clear_nodes(mut kids)
        children_of(c.prog.trees, unit, top, mut kids)?
        for _, kid := range kids {
            append(mut stack, kid)?
        }
    }
    return noerror
}

// last_stmt returns the last statement of the body of the case clause
// cl, or no key when it has none or cl is no clause.
func last_stmt(trees []ast.File, cl Key) Key {
    switch kind_at(trees, cl) {
    case case_clause(c):
        n := count_items(trees, cl.unit, c.body)
        if n == 0 {
            return no_key()
        }
        return item_at(trees, cl.unit, c.body, n -% 1)
    default:
        return no_key()
    }
}

// check_block checks the statements of a block, Go's checkBlock: each
// in turn, the facts they give one another left to the stages that
// port them.
func (mut c Checker) check_block(unit int64, body ast.Nodes) error {
    return mut c.check_stmts(unit, body)
}

// check_stmts checks each statement of body, in the tree unit, in
// order, Go's checkStmts.
func (mut c Checker) check_stmts(unit int64, body ast.Nodes) error {
    for i := range count_items(c.prog.trees, unit, body) {
        mut c.check_stmt(item_at(c.prog.trees, unit, body, i))?
    }
    return noerror
}

// check_stmt checks the statement k and everything nested in it, Go's
// checkStmt and checkStmtAt.
func (mut c Checker) check_stmt(k Key) error {
    switch kind_at(c.prog.trees, k) {
    case return_stmt(s):
        return mut c.check_return(k, s)
    case if_stmt(s):
        return mut c.check_if(k, s)
    case for_stmt(s):
        return mut c.check_for(k, s)
    case for_range(s):
        return mut c.check_for_range(k, s)
    case switch_stmt(s):
        return mut c.check_switch(k, s)
    case defer_stmt(s):
        return mut c.check_defer(k, s)
    case region_stmt(r):
        return mut c.check_block(k.unit, r.body)
    case unreachable_stmt:
        return not_ported
    case break_stmt:
        return mut c.check_in_loop(span_at(c.prog.trees, k), "break")
    case continue_stmt:
        return mut c.check_in_loop(span_at(c.prog.trees, k), "continue")
    case fallthrough_stmt:
        return mut c.check_fallthrough(k)
    case bad_stmt:
        return noerror
    default:
        return mut c.check_simple_stmt(k)
    }
}

// check_if checks an if, its condition and then its branches, Go's case
// of *ast.If in checkStmtAt; an else that is one if, an else if, is
// checked as the next link of a loop rather than a frame deeper.
func (mut c Checker) check_if(k Key, s ast.If) error {
    mut cur := k
    mut st := s
    for {
        mut c.check_cond(sub(cur, st.cond))?
        mut c.check_block(cur.unit, st.then)?
        if count_items(c.prog.trees, cur.unit, st.else_body) == 1 {
            next := item_at(c.prog.trees, cur.unit, st.else_body, 0)
            switch kind_at(c.prog.trees, next) {
            case if_stmt(es):
                cur = next
                st = es
                continue
            default:
            }
        }
        return mut c.check_block(cur.unit, st.else_body)
    }
    return noerror
}

// check_cond checks the condition of an if or a loop, which must be a
// bool, Go's checkCond.
func (mut c Checker) check_cond(cond Key) error {
    t := mut c.expr(cond)?
    got := mut c.value_of(cond, t)?
    if got != types.invalid && got != types.bool_type {
        n := mut c.type_name(got)?
        mut m := msg()
        fmt.appendf(mut m, "condition must be a bool, got %s", n[:])?
        mut c.errorf(span_at(c.prog.trees, cond), own m)?
    }
    return noerror
}

// check_in_loop reports a break or continue, keyword, at sp, that no
// loop encloses, and one in deferred code whose loop is outside it, Go's
// checkInLoop. No fields loop is checked by the port, so none encloses
// it.
func (mut c Checker) check_in_loop(sp source.Span, keyword string) error {
    if c.body.loops == 0 {
        mut m := msg()
        fmt.appendf(mut m, "%s is not in a loop", keyword)?
        return mut c.errorf(sp, own m)
    }
    if c.body.deferred > 0 && c.body.loops == c.body.defer_loops {
        mut m := msg()
        fmt.appendf(mut m, "cannot %s out of a defer", keyword)?
        return mut c.errorf(sp, own m)
    }
    return noerror
}

// check_defer checks what the defer k defers, as a block of its own,
// Go's checkDefer: a defer inside a defer is reported at its keyword,
// the outermost such one only, and its block still checked.
func (mut c Checker) check_defer(k Key, d ast.Defer) error {
    outer_rejected := c.body.in_rejected_defer
    if c.body.deferred > 0 && !c.body.in_rejected_defer {
        mut kw := span_at(c.prog.trees, k)
        kw.end = kw.start +% 5
        mut m := msg()
        fmt.appendf(mut m, "cannot defer inside a defer")?
        mut c.errorf(kw, own m)?
        c.body.in_rejected_defer = true
    }
    outer_loops := c.body.defer_loops
    c.body.deferred +%= 1
    c.body.defer_loops = c.body.loops
    e := mut c.check_block(k.unit, d.body)
    c.body.deferred -%= 1
    c.body.defer_loops = outer_loops
    c.body.in_rejected_defer = outer_rejected
    return e
}

// check_fallthrough checks the fallthrough k, Go's checkFallthrough: it
// must be the last statement of the body of a case of an expression
// switch that is not the switch's last case, outside any defer inside
// that case.
func (mut c Checker) check_fallthrough(k Key) error {
    sp := span_at(c.prog.trees, k)
    mut m := msg()
    in, ok := c.body.clauses[len(c.body.clauses) -% 1]
    if !ok {
        fmt.appendf(mut m, "fallthrough is not in a switch")?
        return mut c.errorf(sp, own m)
    }
    last := last_stmt(c.prog.trees, in.cl)
    _, linked := c.fall_next[k]
    if c.body.deferred > in.deferred {
        fmt.appendf(mut m, "cannot fall through out of a defer")?
    } else if in.on_type {
        fmt.appendf(mut m, "cannot fall through in a type switch")?
    } else if in.on_union {
        fmt.appendf(mut m, "cannot fall through in a switch on a union")?
    } else if last != k {
        fmt.appendf(mut m, "fallthrough must be the last statement of a case")?
    } else if !linked {
        fmt.appendf(mut m, "cannot fall through from the last case of a switch")?
    } else {
        return noerror
    }
    return mut c.errorf(sp, own m)
}

// check_return checks the return k of the function being checked, Go's
// checkReturn: its values against the function's results, or, in
// deferred code, which nothing may leave, an error of its own, its
// values then checked only for what is inside them.
func (mut c Checker) check_return(k Key, s ast.Return) error {
    if c.body.deferred == 0 {
        return mut c.check_results(k, s)
    }
    mut m := msg()
    fmt.appendf(mut m, "cannot return from a defer")?
    mut c.errorf(span_at(c.prog.trees, k), own m)?
    for i := range count_items(c.prog.trees, k.unit, s.values) {
        mut c.discard(item_at(c.prog.trees, k.unit, s.values, i))?
    }
    return noerror
}

// values_span returns the span from the start of the first of values,
// in the tree unit, to the end of the last, Go's spanOf; values must not
// be empty.
func values_span(trees []ast.File, unit int64, values ast.Nodes) source.Span {
    n := count_items(trees, unit, values)
    mut sp := span_at(trees, item_at(trees, unit, values, 0))
    sp.end = span_at(trees, item_at(trees, unit, values, n -% 1)).end
    return sp
}

// check_results checks that the return k carries one value for each
// result the function declares, each usable as that result's type, Go's
// checkResults; a wrong count is one error, and then no value is
// compared with a result. The values a return passes on beside the
// error that holds them may be read unchecked (see note_pass_on).
func (mut c Checker) check_results(k Key, s ast.Return) error {
    fnk := c.body.fn
    fn := func_of(c.prog.trees, fnk)
    got := count_items(c.prog.trees, k.unit, s.values)
    want := count_items(c.prog.trees, fnk.unit, fn.results)
    if got == want {
        mut c.note_pass_on(k, s, fnk)?
        for i := range got {
            v := item_at(c.prog.trees, k.unit, s.values, i)
            rt := result_of(c.results, fnk, i)
            if c.table.is_view(rt) {
                mut c.return_view(v, rt, fnk)?
                continue
            }
            t := mut c.expr(v)?
            mut ctx := msg()
            append(mut ctx, []uint8("in return from ")...)?
            mut c.display_name(fnk, mut ctx)?
            mut c.use(v, t, rt, ctx)?
        }
        old := replace(mut c.passed_on, make(map[Key]Key, c_allocator))
        drop(own old)
        return noerror
    }
    for i := range got {
        mut c.discard(item_at(c.prog.trees, k.unit, s.values, i))?
    }
    mut name := msg()
    mut c.display_name(fnk, mut name)?
    mut m := msg()
    if want == 0 {
        fmt.appendf(mut m, "%s declares no result, so it cannot return a value", name[:])?
        return mut c.errorf(values_span(c.prog.trees, k.unit, s.values), own m)
    }
    if got == 0 && want == 1 {
        n := mut c.type_name(result_of(c.results, fnk, 0))?
        fmt.appendf(mut m, "%s must return a value of type %s", name[:], n[:])?
        return mut c.errorf(span_at(c.prog.trees, k), own m)
    }
    if got < want {
        fmt.appendf(mut m, "not enough return values: %s returns %d, got %d", name[:], want, got)?
        return mut c.errorf(span_at(c.prog.trees, k), own m)
    }
    fmt.appendf(mut m, "too many return values: %s returns %d, got %d", name[:], want, got)?
    return mut c.errorf(values_span(c.prog.trees, k.unit, s.values), own m)
}

// check_for checks a loop's clauses, in source order, then its body,
// inside which break and continue are allowed, Go's checkFor. A loop
// whose init declares a mutable variable is declined: it may count, and
// its counting is a later stage's; the overflow a post statement needs
// proved is declined where it is met.
func (mut c Checker) check_for(k Key, s ast.For) error {
    if !ast.is_none(s.init) {
        switch kind_at(c.prog.trees, sub(k, s.init)) {
        case var_decl(v):
            if v.mutable {
                return not_ported
            }
        default:
        }
        mut c.check_simple_stmt(sub(k, s.init))?
    }
    if !ast.is_none(s.cond) {
        mut c.check_cond(sub(k, s.cond))?
    }
    if !ast.is_none(s.post) {
        mut c.check_simple_stmt(sub(k, s.post))?
    }
    c.body.loops +%= 1
    e := mut c.check_block(k.unit, s.body)
    c.body.loops -%= 1
    return e
}

// check_for_range checks a range loop, Go's checkForRange: what it
// ranges over, the types it gives its variables (see range_types), and
// its body, inside which break and continue are allowed. A variable
// that refers in place into what it ranges over, a map's owned key or
// an owned element, is recorded with it (see range_bindings). A fields
// loop is S7's, and declined.
func (mut c Checker) check_for_range(k Key, s ast.ForRange) error {
    x := sub(k, s.x)
    switch kind_at(c.prog.trees, x) {
    case fields_of:
        return not_ported
    default:
    }
    mut c.allow_view_call(x)
    t := mut c.expr(x)?
    got := mut c.value_of(x, t)?
    mut index := types.invalid
    mut elem := types.invalid
    has_elem := !ast.is_none(s.elem)
    if got == types.invalid {
    } else if types.is_integer(got) {
        if has_elem {
            mut sp := span_at(c.prog.trees, sub(k, s.var_node))
            sp.end = span_at(c.prog.trees, x).end
            n := mut c.type_name(got)?
            mut m := msg()
            fmt.appendf(mut m, "assignment mismatch: 2 variables but range over %s gives 1 value", n[:])?
            mut c.errorf(sp, own m)?
        }
        index = got
    } else if c.table.is_array(got) || c.table.is_view(got) || c.table.is_list(got) {
        index = types.int64_type
        elem = c.table.elem_of(got)
    } else if c.table.is_map(got) {
        index = c.table.key_of(got)
        elem = c.table.elem_of(got)
    } else if c.table.is_arena(got) {
        index = mut c.table.id_of(c.table.elem_of(got))?
        elem = c.table.elem_of(got)
    } else if c.table.is_pool(got) {
        index = mut c.table.handle_of(c.table.elem_of(got))?
        elem = c.table.elem_of(got)
    } else if got == types.string_type {
        index = types.int64_type
        elem = types.uint8_type
    } else {
        n := mut c.type_name(got)?
        mut m := msg()
        fmt.appendf(mut m, "cannot range over %s", n[:])?
        mut c.errorf(span_at(c.prog.trees, x), own m)?
    }
    if !ast.is_none(s.var_node) {
        mut place := range_never
        if c.table.is_map(got) {
            place = range_key
        }
        mut c.bind_range_var(sub(k, s.var_node), index, x, place)?
    }
    if has_elem {
        ek := sub(k, s.elem)
        ok := mut c.supported_type(elem)?
        if !ok {
            return not_ported
        }
        mut c.bind_range_var(ek, elem, x, range_elem)?
        mut c.any_local(ek, var_of(c.prog.trees, ek))?
    }
    c.body.loops +%= 1
    e := mut c.check_block(k.unit, s.body)
    c.body.loops -%= 1
    return e
}

// How a range loop's variable may refer into what it ranges over in
// place, when its type is owned: as its element, as a map's key, or
// never, an index of anything else.
var range_elem uint8 = 0
var range_key uint8 = 1
var range_never uint8 = 2

// bind_range_var gives v, a range loop's variable over x, its type typ
// and records it as a range loop's binding, and, when typ is owned and
// place allows it (see range_elem), as one that refers into x in place
// (see range_bindings). check_for_range calls it for both its
// variables, so that what it holds stays out of the frame every
// statement nests through (see the stack discipline in doc.tck).
func (mut c Checker) bind_range_var(v Key, typ types.Type, x Key, place uint8) error {
    mut c.set_decl_type(v, typ)?
    put(mut c.bindings, v, bind_range)?
    if place == range_never {
        return noerror
    }
    owned := c.table.owned(typ)?
    if !owned {
        return noerror
    }
    put(mut c.range_bindings, v, x)?
    if place == range_key {
        put(mut c.range_keys, v, true)?
    }
    return noerror
}

// allow_view_call marks e, when it is a call or an element, as written
// where a view it returns may be, Go's allowViewCall.
func (mut c Checker) allow_view_call(e Key) {
    switch kind_at(c.prog.trees, e) {
    case call:
        c.view_call = e
    case index:
        c.view_span = e
    default:
    }
}

// check_simple_stmt checks a statement that holds no other statement,
// Go's checkSimpleStmt: an expression, a declaration, an assignment; an
// increment, a decrement and a binding of several names the port
// declines but where Go reports the binding at once (see
// check_multi).
func (mut c Checker) check_simple_stmt(k Key) error {
    switch kind_at(c.prog.trees, k) {
    case expr_stmt(s):
        return mut c.check_expr_stmt(sub(k, s.x))
    case var_decl(v):
        return mut c.check_local_var(k, v)
    case assign(a):
        return mut c.check_assign(k, a)
    case multi_var(m):
        return mut c.check_multi(k, sub(k, m.value), m.vars, false)
    case multi_assign(m):
        return mut c.check_multi(k, sub(k, m.value), m.targets, true)
    default:
        return not_ported
    }
}

// check_expr_stmt checks the expression x written as a statement, Go's
// case of *ast.ExprStmt: a ? is checked as one; one that only gives a
// value, a union built, a conversion or len, is checked and its value
// reported as not used; any other is checked as a call statement, whose
// error cannot be dropped.
func (mut c Checker) check_expr_stmt(x Key) error {
    switch kind_at(c.prog.trees, x) {
    case question:
        mut results := make(list[types.Type], c_allocator)
        mut c.check_question(x, mut results)?
        return noerror
    default:
    }
    if mut c.only_value(x) {
        before := len(c.diags)
        t := mut c.expr(x)?
        if t == types.invalid || len(c.diags) != before {
            return noerror
        }
        sp := span_at(c.prog.trees, x)
        src := mut c.source_text(sp)?
        mut m := msg()
        fmt.appendf(mut m, "%s is not used", src[:])?
        return mut c.unusedf(sp, own m)
    }
    outer := c.dropped_call
    switch kind_at(c.prog.trees, x) {
    case call:
        c.dropped_call = x
    default:
        c.dropped_call = no_key()
    }
    e := mut c.discard(x)
    c.dropped_call = outer
    if e.code != 0 {
        return e
    }
    return mut c.dropped_error(x)
}

// only_value reports whether e, written as a statement, does nothing but
// give a value, Go's onlyValue: a union built, a conversion, or a call
// of len.
func (mut c Checker) only_value(e Key) bool {
    _, _, built := construction(c.prog.trees, c.none, e)
    if built {
        return true
    }
    switch kind_at(c.prog.trees, e) {
    case call(cl):
        return cl.conv != types.invalid || is_len_call(c.prog.trees, c.none, e)
    default:
        return false
    }
}

// check_multi checks a binding of several names, the targets of an
// assignment when assign says so and the variables of a declaration
// otherwise, of value, Go's checkMultiVar and checkMultiAssign: the
// values value gives (see multi_results), each name's type or target,
// and what dropping or tying its results says.
func (mut c Checker) check_multi(k Key, value Key, names ast.Nodes, assign bool) error {
    want := count_items(c.prog.trees, k.unit, names)
    mut first := msg()
    mut second := msg()
    if want == 2 {
        a := item_at(c.prog.trees, k.unit, names, 0)
        b := item_at(c.prog.trees, k.unit, names, 1)
        if assign {
            ta := mut c.source_text(span_at(c.prog.trees, a))?
            append(mut first, ta[:]...)?
            tb := mut c.source_text(span_at(c.prog.trees, b))?
            append(mut second, tb[:]...)?
        } else {
            append(mut first, name_of(c.prog.trees, c.none, a)...)?
            append(mut second, name_of(c.prog.trees, c.none, b)...)?
        }
    }
    mut results := make(list[types.Type], c_allocator)
    ok := mut c.multi_results(value, want, span_at(c.prog.trees, k), mut results)?
    mut blank := make(list[bool], c_allocator)
    mut spans := make(list[source.Span], c_allocator)
    if !assign {
        if !ok {
            return noerror
        }
        for i := range want {
            v := item_at(c.prog.trees, k.unit, names, i)
            t := type_at(results, i)
            sup := mut c.supported_type(t)?
            if !sup {
                return not_ported
            }
            mut c.set_decl_type(v, t)?
            mut c.any_local(v, var_of(c.prog.trees, v))?
            append(mut blank, bytes_equal(name_of(c.prog.trees, c.none, v), []uint8("_")))?
            append(mut spans, name_span_of(c.prog.trees, v))?
        }
        mut c.check_error_binding(value, blank, spans)?
        mut c.check_ok_dropped(value, blank, spans)?
        mut c.nothing_bound(value, blank, span_at(c.prog.trees, k))?
        return mut c.note_holder(item_at(c.prog.trees, k.unit, names, want -% 1), value, want)
    }
    // seen holds what each name assigned so far is bound to, Go's map of
    // Decls, in which every name bound to nothing is one key.
    mut seen := make(map[ast.Def]bool, c_allocator)
    for i := range want {
        target := item_at(c.prog.trees, k.unit, names, i)
        mut got := types.invalid
        if ok {
            got = type_at(results, i)
        }
        mut c.check_multi_target(target, value, got, mut seen)?
    }
    if !ok {
        return noerror
    }
    for i := range want {
        t := item_at(c.prog.trees, k.unit, names, i)
        append(mut blank, is_blank(c.prog.trees, c.none, t))?
        append(mut spans, span_at(c.prog.trees, t))?
    }
    mut c.check_error_binding(value, blank, spans)?
    mut c.check_ok_dropped(value, blank, spans)?
    mut c.nothing_bound(value, blank, span_at(c.prog.trees, k))?
    mut c.note_target_holder(item_at(c.prog.trees, k.unit, names, want -% 1), value, want)?
    switch kind_at(c.prog.trees, k) {
    case multi_assign(m):
        mut c.check_error_targets(k, m)?
    default:
    }
    for i := range want {
        t := item_at(c.prog.trees, k.unit, names, i)
        if !is_blank(c.prog.trees, c.none, t) {
            mut c.check_error_assign(k, t)?
        }
    }
    return noerror
}

// check_multi_target checks one target of an assignment of several
// values to value, which gives got in the target's position, invalid when
// the value is wrong, Go's checkMultiTarget: seen holds the variables
// already named, each of which may be named only once.
func (mut c Checker) check_multi_target(target Key, value Key, got types.Type, mut seen map[ast.Def]bool) error {
    if is_blank(c.prog.trees, c.none, target) {
        return noerror
    }
    nm, is_id := ident_at(c.prog.trees, target)
    if is_id {
        _, twice := seen[nm.def]
        if twice {
            mut t := msg()
            fmt.appendf(mut t, "%s is assigned more than once", text_at(c.prog.trees, c.none, target.unit, nm.name)[:])?
            return mut c.errorf(span_at(c.prog.trees, target), own t)
        }
        put(mut seen, nm.def, true)?
    }
    c.assign_target = target
    c.assign_value = value
    typ, ok, ae := mut c.assignable(target)
    c.assign_target = no_key()
    c.assign_value = no_key()
    if ae.code != 0 {
        return ae
    }
    if !ok || typ == types.invalid || got == types.invalid || types.widens(got, typ) {
        return noerror
    }
    a := mut c.type_name(got)?
    b := mut c.type_name(typ)?
    mut tn := msg()
    mut c.target_name(target, mut tn)?
    mut m := msg()
    fmt.appendf(mut m, "cannot use %s as %s in assignment to %s", a[:], b[:], tn[:])?
    return mut c.errorf(span_at(c.prog.trees, target), own m)
}

// multi_results checks value, bound to want names, Go's multiResults, and
// appends the type of each value it gives to out, reporting whether it
// gives exactly want: a call, a ? after one, a type assertion, an index
// or a checked pop or remove. A division, a slice, arithmetic and a
// conversion, whose checked forms need proofs, are declined; any other
// value is one, reported as such.
func (mut c Checker) multi_results(value Key, want int64, sp source.Span, mut out list[types.Type]) (bool, error) {
    switch kind_at(c.prog.trees, value) {
    case question:
        ok := mut c.question_results(value, want, sp, mut out)?
        return ok, noerror
    case index(ix):
        ok := mut c.index_results(value, ix, want, sp, mut out)?
        return ok, noerror
    case binary, unary, slice:
        return false, not_ported
    case type_assert(a):
        ok := mut c.assert_results(value, a, want, sp, mut out)?
        return ok, noerror
    case call(cl):
        if mut c.is_take(value) {
            ok := mut c.take_results(value, want, sp, mut out)?
            return ok, noerror
        }
        if cl.conv != types.invalid {
            return false, not_ported
        }
        switch kind_at(c.prog.trees, sub(value, cl.fn)) {
        case view_type:
            mut c.view_conversion_elsewhere(value)?
            return false, noerror
        case ref_type(rt):
            mut c.ref_conversion(value, rt)?
            return false, noerror
        default:
        }
        ok := mut c.call_results(value, want, sp, mut out)?
        return ok, noerror
    default:
    }
    has := mut c.has_fallible(value)?
    if has {
        return false, not_ported
    }
    mut c.expr(value)?
    mut m := msg()
    fmt.appendf(mut m, "assignment mismatch: %d variables but 1 value", want)?
    mut c.errorf(sp, own m)?
    return false, noerror
}

// call_results checks the call k bound to want names covering sp, Go's
// callResults: its callee must declare exactly that many results. A
// generic builtin gives its one value, and any other builtin none.
func (mut c Checker) call_results(k Key, want int64, sp source.Span, mut out list[types.Type]) (bool, error) {
    mut results := make(list[types.Type], c_allocator)
    gt, generic := mut c.generic_call(k)?
    if generic {
        if gt == types.invalid {
            return false, noerror
        }
        append(mut results, gt)?
        if mut c.gives_with_error(k) {
            // add, add_all or insert, which give two, Go's
            // Call.ResultTypes.
            append(mut results, types.error_type)?
        }
    } else {
        mut c.check_call(k)?
    }
    mut name := msg()
    named := mut c.callee_name(k, mut name)?
    if !named {
        return false, noerror
    }
    if is_value_call(c.prog.trees, k) {
        return false, noerror
    }
    fn := mut c.callee_of(k)
    if !is_no_key(fn) {
        clear_types(mut results)
        for i := range mut c.callee_result_count(fn) {
            append(mut results, result_of(c.results, fn, i))?
        }
    }
    got := len(results)
    mut m := msg()
    if got == 0 {
        fmt.appendf(mut m, "assignment mismatch: %d variables but %s returns no value", want, name[:])?
        mut c.errorf(sp, own m)?
        return false, noerror
    }
    if got != want {
        mut word := "values"
        if got == 1 {
            word = "value"
        }
        fmt.appendf(mut m, "assignment mismatch: %d variables but %s returns %d %s", want, name[:], got, word)?
        mut c.errorf(sp, own m)?
        return false, noerror
    }
    for _, t := range results {
        append(mut out, t)?
    }
    return true, noerror
}

// has_fallible reports whether value holds, outside any call, a
// division, a remainder, an index, a slice or a type assertion, Go's
// fallible finding one, which makes a binding of two names the checked
// form misused, a later stage's.
func (mut c Checker) has_fallible(value Key) (bool, error) {
    mut stack := make(list[id[ast.Node]], c_allocator)
    mut kids := make(list[id[ast.Node]], c_allocator)
    append(mut stack, value.node)?
    for len(stack) > 0 {
        top, ok := pop(mut stack)
        if !ok {
            return true, noerror
        }
        k := Key{unit: value.unit, node: top}
        switch kind_at(c.prog.trees, k) {
        case call:
            continue
        case index, slice, type_assert:
            return true, noerror
        case binary(b):
            if b.op == ast.op_div || b.op == ast.op_rem {
                return true, noerror
            }
        default:
        }
        clear_nodes(mut kids)
        children_of(c.prog.trees, value.unit, top, mut kids)?
        for _, kid := range kids {
            append(mut stack, kid)?
        }
    }
    return false, noerror
}

// check_local_var checks a variable declared in a body, Go's checkVar
// for a local: its declared type if it has one, otherwise its value's,
// an untyped constant being an int64, never a view and never a mutable
// any. A value must be usable as the declared type, and only a mutable
// variable whose type has a zero value may leave out its value. A
// function type or a type parameter is S7's, and declined.
func (mut c Checker) check_local_var(k Key, v ast.Var) error {
    mut declared := types.invalid
    if !ast.is_none(v.type_expr) {
        declared = mut c.declared_type(sub(k, v.type_expr))?
        ok := mut c.supported_type(declared)?
        if !ok {
            return not_ported
        }
    }
    mut name := msg()
    append(mut name, text_at(c.prog.trees, c.none, k.unit, v.name)...)?
    if ast.is_none(v.value) {
        if !v.mutable {
            mut m := msg()
            fmt.appendf(mut m, "immutable variable %s needs a value", name[:])?
            mut c.errorf(v.name_span, own m)?
        } else if declared != types.invalid {
            has_zero := c.table.has_zero(declared)?
            if !has_zero {
                n := mut c.type_name(declared)?
                mut m := msg()
                fmt.appendf(mut m, "%s needs a value: %s has no zero value", name[:], n[:])?
                mut c.errorf(v.name_span, own m)?
                declared = types.invalid
            }
        }
        return mut c.set_decl_type(k, declared)
    }
    value := sub(k, v.value)
    got := mut c.expr(value)?
    mut c.note_holder(k, value, 1)?
    if ast.is_none(v.type_expr) {
        typ := mut c.value_of(value, got)?
        ok := mut c.supported_type(typ)?
        if !ok {
            return not_ported
        }
        mut c.set_decl_type(k, typ)?
        reported := mut c.any_local(k, v)?
        if reported {
            return noerror
        }
        if c.table.is_view(typ) {
            n := mut c.type_name(typ)?
            mut m := msg()
            fmt.appendf(mut m, "cannot declare %s as %s; a view can only be the type of a parameter or of a result", name[:], n[:])?
            mut c.errorf(v.name_span, own m)?
            return mut c.set_decl_type(k, types.invalid)
        }
        return mut c.note_known_local(k, v)
    }
    mut ctx := msg()
    fmt.appendf(mut ctx, "in declaration of %s", name[:])?
    mut c.use(value, got, declared, ctx)?
    mut c.set_decl_type(k, declared)?
    return mut c.note_known_local(k, v)
}

// note_known_local records the value of the local k, v, when it is an
// immutable variable whose value is known, Go's knownVar, which works it
// out the first time it is asked: its value depends only on its own
// initializer and the locals before it, each recorded already, so
// working it out here gives what Go would there.
func (mut c Checker) note_known_local(k Key, v ast.Var) error {
    if v.mutable || ast.is_none(v.value) {
        return noerror
    }
    value, known := mut c.known_value(sub(k, v.value))?
    put(mut c.known_locals, k, KnownLocal{value: value, ok: known})?
    return noerror
}

// check_assign checks an assignment, Go's checkAssign: its value, then
// its target, which must be one an assignment can write, of a type the
// value is usable as; a compound assignment's target must be a number
// the operator updates (see check_compound). An error variable that
// holds others may be assigned only with them (see check_error_assign).
func (mut c Checker) check_assign(k Key, a ast.Assign) error {
    value := sub(k, a.value)
    target := sub(k, a.target)
    got := mut c.expr(value)?
    if a.op != ast.op_invalid {
        mut c.read_held(target)?
        mut c.check_compound(k, a, got)?
        return mut c.check_error_assign(k, target)
    }
    c.assign_target = target
    c.assign_value = value
    typ, ok, ae := mut c.assignable(target)
    c.assign_target = no_key()
    c.assign_value = no_key()
    if ae.code != 0 {
        return ae
    }
    if ok {
        mut ctx := msg()
        append(mut ctx, []uint8("in assignment to ")...)?
        mut c.target_name(target, mut ctx)?
        mut c.use(value, got, typ, ctx)?
    }
    mut c.note_target_holder(target, value, 1)?
    return mut c.check_error_assign(k, target)
}

// check_compound checks a compound assignment whose value has type got,
// Go's checkCompound: its target must be a number the operator updates.
// One on an integer is declined, since it needs its overflow or its
// divisor proved, later stages' work; one on a float, of + - * or /,
// needs its value usable as the float's type.
func (mut c Checker) check_compound(k Key, a ast.Assign, got types.Type) error {
    target := sub(k, a.target)
    typ, ok := mut c.assignable(target)?
    if !ok || typ == types.invalid {
        return noerror
    }
    float_op := a.op == ast.op_add || a.op == ast.op_sub || a.op == ast.op_mul || a.op == ast.op_div
    if types.is_integer(typ) {
        return not_ported
    }
    mut op := msg()
    fmt.appendf(mut op, "%s=", op_name(a.op))?
    if !float_op || !types.is_float(typ) {
        n := mut c.type_name(typ)?
        mut m := msg()
        fmt.appendf(mut m, "operator %s is not defined on %s", op[:], n[:])?
        return mut c.errorf(span_at(c.prog.trees, target), own m)
    }
    mut ctx := msg()
    fmt.appendf(mut ctx, "in %s", op[:])?
    mut c.use(sub(k, a.value), got, typ, ctx)?
    return noerror
}

// assignable checks that target can be assigned, Go's assignable: a
// mutable variable or a mut parameter, or a field of one; a view, or any
// part of one, is read-only; an element is declined, since its index
// needs proving, a later stage's work. It returns the type target holds
// and whether it can be assigned.
func (mut c Checker) assignable(target Key) (types.Type, bool, error) {
    root, is_view := mut c.view_root(target)
    if is_view {
        t := mut c.source_text(span_at(c.prog.trees, target))?
        mut what := msg()
        fmt.appendf(mut what, "assign to %s", t[:])?
        mut c.read_only(span_at(c.prog.trees, target), what, root)?
        return types.invalid, false, noerror
    }
    switch kind_at(c.prog.trees, target) {
    case ident(nm):
        if nm.def.kind == ast.def_param {
            d := key_of_def(nm.def)
            p := param_of(c.prog.trees, d)
            typ := decl_type_of(c.decl_types, d)
            if p.is_mut {
                return typ, typ != types.invalid, noerror
            }
            mut m := msg()
            fmt.appendf(mut m, "cannot assign to parameter %s", text_at(c.prog.trees, c.none, target.unit, nm.name)[:])?
            mut c.errorf(span_at(c.prog.trees, target), own m)?
            return types.invalid, false, noerror
        }
        if nm.def.kind == ast.def_var {
            d := key_of_def(nm.def)
            if !var_of(c.prog.trees, d).mutable {
                mut m := msg()
                fmt.appendf(mut m, "cannot assign to immutable variable ")?
                qualified(c.prog.trees, c.none, target.unit, nm, mut m)?
                mut c.errorf(span_at(c.prog.trees, target), own m)?
                return types.invalid, false, noerror
            }
            typ := decl_type_of(c.decl_types, d)
            ok := mut c.supported_type(typ)?
            if !ok {
                return types.invalid, false, not_ported
            }
            return typ, true, noerror
        }
        return types.invalid, false, noerror
    case selector:
        typ, ok := mut c.place_target(target)?
        return typ, ok, noerror
    case index:
        typ, ok := mut c.place_target(target)?
        return typ, ok, noerror
    case slice:
        t := mut c.source_text(span_at(c.prog.trees, target))?
        mut m := msg()
        fmt.appendf(mut m, "cannot assign to %s: a slice is not a place", t[:])?
        mut c.errorf(span_at(c.prog.trees, target), own m)?
        return types.invalid, false, noerror
    default:
        if c.prior == 0 {
            mut m := msg()
            fmt.appendf(mut m, "cannot assign to this expression")?
            mut c.errorf(span_at(c.prog.trees, target), own m)?
        }
        return types.invalid, false, noerror
    }
}

// place_target checks k, a field or an element being assigned, Go's
// fieldTarget and elementTarget and their recursion through
// containerTarget: what it is a part of must be a mutable variable or a
// mut parameter, or itself a field or an element of one, no string,
// whose bytes are never assigned, and no slice, which is not a place.
// The chain of fields and elements down to the variable is walked in
// loops, as Go's recursion checks it: what each element is in, from the
// outermost, then the variable, then each field and element, the
// innermost first, each element's index checked as no part of the
// target. It returns the type of k. A field of a fields loop is S7's.
func (mut c Checker) place_target(k Key) (types.Type, bool, error) {
    mut chain := make(list[Key], c_allocator)
    mut cur := k
    for {
        switch kind_at(c.prog.trees, cur) {
        case selector(cs):
            if !ast.is_none(cs.field) {
                return types.invalid, false, not_ported
            }
            append(mut chain, cur)?
            cur = sub(cur, cs.x)
            continue
        case index(ix):
            append(mut chain, cur)?
            x := sub(cur, ix.x)
            switch kind_at(c.prog.trees, x) {
            case ident:
                if mut c.type_of(x) == types.string_type {
                    mut c.string_target(cur, ix)?
                    mut c.target_failed(chain, len(chain) -% 1)?
                    return types.invalid, false, noerror
                }
            case index, selector:
            case slice:
                t := mut c.source_text(span_at(c.prog.trees, cur))?
                mut m := msg()
                fmt.appendf(mut m, "cannot assign to %s: a slice is not a place", t[:])?
                mut c.errorf(span_at(c.prog.trees, cur), own m)?
                mut c.target_failed(chain, len(chain) -% 1)?
                return types.invalid, false, noerror
            default:
                if c.prior == 0 {
                    mut m := msg()
                    fmt.appendf(mut m, "cannot assign to this expression")?
                    mut c.errorf(span_at(c.prog.trees, x), own m)?
                }
                mut c.target_failed(chain, len(chain) -% 1)?
                return types.invalid, false, noerror
            }
            cur = x
            continue
        default:
        }
        break
    }
    mut what := "field"
    switch kind_at(c.prog.trees, key_in(chain, len(chain) -% 1)) {
    case index:
        what = "element"
    default:
    }
    mut base, ok := mut c.container_target(cur, what)?
    if !ok {
        mut c.target_failed(chain, len(chain))?
        return types.invalid, false, noerror
    }
    mut i := len(chain) -% 1
    for i >= 0 {
        sk := key_in(chain, i)
        switch kind_at(c.prog.trees, sk) {
        case selector(s):
            typ := mut c.field(sk, s, base)?
            mut c.set_node_type(sk, typ)?
            if typ == types.invalid {
                mut c.target_failed(chain, i)?
                return types.invalid, false, noerror
            }
            base = typ
        case index(ix):
            if base == types.string_type {
                mut c.string_target(sk, ix)?
                mut c.target_failed(chain, i)?
                return types.invalid, false, noerror
            }
            typ := mut c.element_write(sk, ix, base)?
            mut c.set_node_type(sk, typ)?
            if typ == types.invalid {
                mut c.target_failed(chain, i)?
                return types.invalid, false, noerror
            }
            base = typ
        default:
        }
        i -%= 1
    }
    return base, true, noerror
}

// target_failed checks, for the links of chain above the one at i,
// whose check failed, the index of each element, as Go's elementTarget
// does when what holds the element was reported.
func (mut c Checker) target_failed(chain []Key, i int64) error {
    mut j := i -% 1
    for j >= 0 {
        sk := key_in(chain, j)
        j -%= 1
        switch kind_at(c.prog.trees, sk) {
        case index(ix):
            mut c.expr(sub(sk, ix.index))?
        default:
        }
    }
    return noerror
}

// string_target reports an assignment to a byte of a string, k, ix,
// after checking the index for errors of its own, Go's stringTarget.
func (mut c Checker) string_target(k Key, ix ast.Index) error {
    mut c.expr(sub(k, ix.index))?
    mut m := msg()
    fmt.appendf(mut m, "cannot assign to an element of a string; strings are immutable")?
    return mut c.errorf(span_at(c.prog.trees, k), own m)
}

// container_target checks x, the variable a field or an element, what,
// being assigned is in, Go's containerTarget: a mutable variable or a
// mut parameter. It returns x's type, and false when anything was
// reported or x's type is unknown.
func (mut c Checker) container_target(x Key, what string) (types.Type, bool, error) {
    switch kind_at(c.prog.trees, x) {
    case ident(nm):
        if nm.def.kind == ast.def_param {
            d := key_of_def(nm.def)
            typ := decl_type_of(c.decl_types, d)
            if param_of(c.prog.trees, d).is_mut {
                return typ, typ != types.invalid, noerror
            }
            mut m := msg()
            fmt.appendf(mut m, "cannot assign to %s of parameter %s", what, text_at(c.prog.trees, c.none, x.unit, nm.name)[:])?
            mut c.errorf(span_at(c.prog.trees, x), own m)?
            return types.invalid, false, noerror
        }
        if nm.def.kind == ast.def_var {
            d := key_of_def(nm.def)
            typ := decl_type_of(c.decl_types, d)
            if var_of(c.prog.trees, d).mutable {
                return typ, typ != types.invalid, noerror
            }
            mut m := msg()
            fmt.appendf(mut m, "cannot assign to %s of immutable variable ", what)?
            qualified(c.prog.trees, c.none, x.unit, nm, mut m)?
            mut c.errorf(span_at(c.prog.trees, x), own m)?
            return types.invalid, false, noerror
        }
        return types.invalid, false, noerror
    default:
        if c.prior == 0 {
            mut m := msg()
            fmt.appendf(mut m, "cannot assign to this expression")?
            mut c.errorf(span_at(c.prog.trees, x), own m)?
        }
        return types.invalid, false, noerror
    }
}

// target_name appends how a message names an assignment target, Go's
// targetName: the variable, a field of it, or an element of it.
func (mut c Checker) target_name(target Key, mut out list[uint8]) error {
    root := root_ident(c.prog.trees, target)
    switch kind_at(c.prog.trees, target) {
    case selector(s):
        fmt.appendf(mut out, "field %s", text_at(c.prog.trees, c.none, target.unit, s.name)[:])?
        if !is_no_key(root) {
            nm, _ := ident_at(c.prog.trees, root)
            fmt.appendf(mut out, " of %s", text_at(c.prog.trees, c.none, root.unit, nm.name)[:])?
        }
        return noerror
    case ident(nm):
        append(mut out, text_at(c.prog.trees, c.none, target.unit, nm.name)...)?
        return noerror
    default:
    }
    if is_no_key(root) {
        append(mut out, []uint8("an element")...)?
        return noerror
    }
    nm, _ := ident_at(c.prog.trees, root)
    fmt.appendf(mut out, "an element of %s", text_at(c.prog.trees, c.none, root.unit, nm.name)[:])?
    return noerror
}

// root_ident returns the name a place is rooted at, Go's ast.Root: the
// name itself, or the name under a chain of fields and elements, or no
// key for any other place.
func root_ident(trees []ast.File, e Key) Key {
    mut k := e
    for {
        switch kind_at(trees, k) {
        case ident:
            return k
        case selector(s):
            k = sub(k, s.x)
        case index(ix):
            k = sub(k, ix.x)
        default:
            return no_key()
        }
    }
    return no_key()
}

// children_of appends to out the nodes the node n of the tree unit
// holds, in the order Go's walk visits them (see ast.children), or
// nothing for a unit trees does not have.
func children_of(trees []ast.File, unit int64, n id[ast.Node], mut out list[id[ast.Node]]) error {
    if unit < 0 || unit >= len(trees) {
        return noerror
    }
    return ast.children(trees[unit], n, mut out)
}

// clear_nodes empties l, keeping what it holds allocated.
func clear_nodes(mut l list[id[ast.Node]]) {
    for len(l) > 0 {
        pop(mut l)
    }
}

// unusedf reports a warning at sp saying msg, taken over, code that is
// never used, Go's unusedf; while a suspended global is checked again,
// what it reported before is not reported again.
func (mut c Checker) unusedf(sp source.Span, own msg list[uint8]) error {
    if c.suppressing {
        return noerror
    }
    m := text.from_bytes(msg, c_allocator)?
    mut d := diag.new_error(own m, sp, c_allocator)
    d.severity = diag.warning
    d.unused = true
    append(mut c.warnings, d)?
    return noerror
}
