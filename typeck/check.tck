package typeck

import ast from "tack/ast"
import constant from "tack/constant"
import diag from "tack/diag"
import fmt from "std/fmt"
import source from "tack/source"
import text from "std/text"
import types from "tack/types"

// Key names a node of the program, Go's pointer to it as a map's key: a
// tree, by its unit, and a node of it.
pub type Key struct {
    pub unit int64
    pub node id[ast.Node]
}

// RKey names one result type of a function or an interface method, Go's
// ResultTypes[i]: the declaration's key and the result's place.
type RKey struct {
    unit int64
    node id[ast.Node]
    i int64
}

// The states of something checked when first needed, Go's progress: not
// looked at yet, being checked further up, or done.
var st_none uint8 = 0
var st_checking uint8 = 1
var st_checked uint8 = 2

// not_ported is the error a check returns for what the port does not do
// yet, which the driver reports as not implemented, exit status 3.
pub var not_ported = error{code: 3, msg: "not implemented in the port"}

// suspend is the error that unwinds the checks of globals nested in each
// other past the depth they may nest to on the stack, so the outermost
// loop checks the global wanted first (see ensure_global).
var suspend = error{code: 4, msg: "internal error: a global's check was suspended"}

// max_nested_globals is how many globals' checks may nest on the stack,
// one needing the next, before the innermost is suspended, and
// max_nested_depth how deeply the expressions and types being checked
// may nest, summed over them, before it is.
var max_nested_globals int64 = 8
var max_nested_depth int64 = 64

// PendingElem is an element type whose copyability, or a key type whose
// ==, is judged once every struct's fields are known, Go's pendingElem.
type PendingElem struct {
    holder string
    at source.Span
    elem types.Type
}

// SizeSite is a type whose size is to be checked and where it is made,
// Go's sizeSite.
type SizeSite struct {
    span source.Span
    typ types.Type
}

// Pending is a global whose check was suspended: the global, the name in
// its initializer or type where it needed one not checked yet, from
// which its check goes on once that one is, and whether it has one.
type Pending struct {
    v Key
    resume Key
}

// Lost is a method name a bad declaration of the package pkg may have
// declared, Go's lostMethods.
type Lost struct {
    pkg int64
    name text.Text
}

// Checker type-checks a program, Go's typeck.Checker: so far its
// declaration phase, everything Go's Check does before it checks the
// first function body (check.go:604), whose results --port-types dumps.
//
// Go's checker records what it finds on the tree's nodes, a Type field
// here and a Const there; the port's tree is in arenas the checker
// reads, so what it finds is kept beside the tree, in maps keyed by the
// node: decl_types for a declaration's type, Go's TypeDecl.Type,
// Var.Type, Param.Type and TypeParam.Type, results for Func.ResultTypes
// and IfaceMethod.ResultTypes, node_types for an expression's, and
// consts for a constant's value, Go's Var.Const and the Const of a
// Binary, a Unary or a Call.
pub type Checker struct {
    prog ast.Program
    files source.Set
    table types.Table
    pub tests bool
    // dumping says check runs for the --port-types dump (see
    // check_types), which shows what Go adds to the tree.
    dumping bool

    diags list[diag.Diagnostic]
    // warnings holds the warnings, Go's c.warnings, reported after the
    // errors whatever order they were found in.
    warnings list[diag.Diagnostic]
    // assumed holds the kinds of judgment the port answered as holding
    // without proving them, each once: none since the declaration phase
    // declines every judgment it cannot make (see expr.tck), but the
    // dump keeps the list for the stages to come.
    assumed list[text.Text]

    // unit_pkg holds the package of each tree, by unit.
    unit_pkg list[int64]
    pkg int64
    prior int64

    decl_types map[Key]types.Type
    node_types map[Key]types.Type
    result_count map[Key]int64
    results map[RKey]types.Type
    consts map[Key]Const
    var_consts map[Key]Const
    store ConstStore

    // The type parameters: the interface each one's constraint names,
    // or none, whether it is constrained by Data, and whether the
    // checker made it for a parameter whose type is an interface (see
    // implicit_type_params).
    tp_iface map[Key]Key
    tp_data map[Key]bool
    tp_implicit map[Key]bool
    type_params map[int64]Key
    // stand_ins holds the stand-in for each interface method called on
    // a type parameter's values, Go's standIns, and stand_in_of the
    // interface method of each stand-in, Go's Func.Interface (see
    // type_param_method).
    stand_ins map[StandInKey]Key
    stand_in_of map[Key]Key

    // The function values (see funcvalue.tck): each function's value,
    // Go's Func.Value, the stand-in for a call through a value of each
    // function type, Go's dynamics, and the stand-in each such call
    // calls, Go's Call.Dynamic.
    func_values map[Key]types.Type
    dynamics map[int64]Key
    call_dynamic map[Key]Key

    // The fields loops (see data.tck): the type each fields(T) ranges
    // over the fields of and the type parameter v.[f] has in its body,
    // Go's FieldsOf.Type and Field, whether its body reads f.name, Go's
    // Names, the loop each loop's variable ranges over, Go's fieldLoops,
    // and the locals named in a body lowered once for each field or
    // case, Go's Var.Unrolled.
    fo_types map[Key]types.Type
    // The closures (see closure.tck): the parameters of closures, Go's
    // closureParams, and the captures of each closure, Go's
    // FuncLit.Captures, their records in caps.
    closure_params map[Key]bool
    caps list[CapRec]
    lit_caps map[Key]CapRange
    // What checking each closure's body around the point set apart,
    // innermost last (see enter_closure).
    cs_body list[BodyState]
    cs_rel list[RelIdx]
    cs_proven list[list[ProofOnly]]
    cs_chain list[list[Fact]]
    cs_appended list[list[AppendRec]]
    cs_passed list[map[Key]Key]
    cs_views list[map[Key]bool]
    cs_marks list[ClosureMarks]
    // The switches on a type parameter (see paramswitch.tck): the
    // narrowings in force, Go's narrowed, those narrow_push saved, with
    // where each push's start and how many were in force before it, the
    // kinds the cases around leave a type parameter, Go's paramKinds,
    // what each name was narrowed to, Go's Ident.Narrowed, how many
    // defaults that never run are around, Go's inCoveredDefault, and how
    // each case's values match, Go's CaseClause.TypeCases; and what the
    // check of each switch on a type parameter being checked keeps
    // between its cases, innermost last (see check_param_switch).
    ps_frames list[ParamSwitchFrame]
    ps_taken list[map[int64]Key]
    ps_seen list[map[text.Text]Key]
    ps_names list[list[uint8]]
    narrowed list[Narrowing]
    narrow_saved list[Narrowing]
    narrow_marks list[int64]
    narrow_counts list[int64]
    param_kinds list[ParamKinds]
    narrowed_names map[Key]types.Type
    in_covered_default int64
    tc_recs list[TypeCaseRec]
    tc_of map[Key]TcRange
    fo_fields map[Key]types.Type
    fo_names map[Key]bool
    field_loops map[Key]Key
    unrolled map[Key]bool

    // The inferences (see infer.tck): the one in force, Go's
    // inference, -1 for none, the number the next one takes, the callee
    // of each, the type argument each found for each type parameter and
    // which the call wrote; and what each call to a generic function
    // recorded, Go's Call.TypeArgs, ParamTypes and ResultTypes, with
    // their counts.
    inf int64
    inf_next int64
    inf_fn map[int64]Key
    inf_args map[IKey]types.Type
    inf_written map[IKey]bool
    call_targs map[RKey]types.Type
    call_targ_count map[Key]int64
    call_ptypes map[RKey]types.Type
    call_pcount map[Key]int64
    call_rtypes map[RKey]types.Type
    call_rcount map[Key]int64

    // The instances (see instance.tck), Go's Program.Instances, in the
    // order found, the type arguments of all of them, a number for each
    // generic function the instances' keys name it by, and whether they
    // were recorded, Go's record, which a search stopped by an error
    // never reaches.
    instances list[Instance]
    inst_args list[types.Type]
    inst_fns map[Key]int64
    // bounds holds the bindings the instances' bodies are walked with
    // (see BoundRec), inst_unrolled counts the fields loop bodies walked,
    // Go's unrolled, and unrolled_recs the fields each fields loop lists
    // for each type, Go's FieldsOf.Unrolled, their positions in
    // unrolled_fields.
    bounds list[BoundRec]
    instances_recorded bool
    inst_unrolled int64
    unrolled_recs list[UnrolledRec]
    unrolled_fields list[int64]

    globals map[Key]bool
    global_state map[Key]uint8
    global_before map[Key]int64
    init_stack list[Key]

    structs map[int64]Key
    unions map[int64]Key
    struct_order list[types.Type]
    struct_state map[int64]uint8
    union_state map[int64]uint8
    struct_pkg map[int64]int64

    pending_elems list[PendingElem]
    pending_keys list[PendingElem]
    pending_sizes list[SizeSite]
    size_checked map[int64]source.Span
    sizes_known bool

    site_params map[Key]types.Type

    lost list[Lost]
    lost_all map[int64]bool

    in_fields bool
    in_union bool

    // known_binaries remembers knownArithmetic's answers, Go's
    // knownBinaries.
    known_binaries map[Key]KnownBinary

    // The globals' checks: how many nest on the stack now, how deeply
    // the expressions and types being checked nest, the globals waiting
    // for another to be checked first (see check_globals), and, while
    // one of them is checked again from the start, the name its check
    // goes on from, the diagnostics before which were reported already.
    nested_globals int64
    depth int64
    unwound list[Pending]
    want Key
    suppressing bool
    suppress_until Key

    // global_shapes keeps what each global's initializer is (see
    // global_shape).
    global_shapes map[Key]uint8

    // spines holds the spines whose check was suspended, by their top
    // node (see expr).
    spines map[Key]SpineState

    // contracts holds each function's contract, Go's contracts, its facts
    // in contract_facts and their difference bounds' conditions in
    // contract_conds (see ensures.tck); defers each function's defers,
    // Go's defers, in defer_list.
    contracts map[Key]CRun
    contract_facts list[ClauseFact]
    contract_conds list[NoWrap]
    defers map[Key]DRun
    defer_list list[Key]

    // none is empty, the view a lookup of a name of no tree gives.
    none list[uint8]

    // The bodies (see body.tck): the state of the body being checked,
    // whether one is, each fallthrough that enters the next case with
    // that case, Go's Fallthrough.Next, the immutable locals' known
    // values, Go's knownVars, the switches on a union that name every
    // case, Go's Exhaustive, the names and calls a switch on a union
    // took as patterns, whose binding and conversion Go then clears.
    body BodyState
    in_body bool
    fall_next map[Key]Key
    known_locals map[Key]KnownLocal
    exhaustive map[Key]bool
    pattern_cleared map[Key]bool
    conv_cleared map[Key]bool

    // The calls (see call.tck): the method each method call and each
    // call of a method expression calls, Go's Call.Method; the type a
    // conversion to a view records, Go's Conv of one; the bindings no
    // declaration can make mut, Go's bindings; the call, slice or element
    // written where a view may be, Go's viewCall, viewSlice and viewSpan;
    // the assertion and the pop or remove bound with ok, Go's
    // checkedAssert and checkedTake; the call written as a statement,
    // Go's droppedCall; and the names reported alongside an own argument,
    // Go's ownReported.
    call_method map[Key]Key
    view_convs map[Key]types.Type
    bindings map[Key]uint8
    view_call Key
    view_slice Key
    view_span Key
    checked_assert Key
    checked_take Key
    checked_index Key

    // The assignment whose target is being checked, Go's assigning: its
    // target and its value, or no key.
    assign_target Key
    assign_value Key
    dropped_call Key
    own_reported map[source.Span]bool
    // site_args holds the testing.Site arguments Go puts among each
    // call's arguments, by the call and their order, and site_count how
    // many each call has (see pass_site).
    site_args map[RKey]SiteArg
    site_count map[Key]int64
    // recv_given is a method call's receiver that the walk of a spine
    // has checked already, as recv_type (see expr and receiver_type).
    recv_given Key
    recv_type types.Type

    // The errors (see errors.tck): the ties the bindings of the body
    // being checked make, in order, the ok variables among the holders
    // with the call that bound each, which variables are held and which
    // hold, what each unread variable holds, Go's holders, and the
    // values the return being checked passes on beside their error, Go's
    // passedOn.
    ties list[HoldTie]
    oks map[Key]Key
    held_any map[Key]bool
    holder_any map[Key]bool
    holders map[Key]HolderAt
    passed_on map[Key]Key

    // The ?s (see question.tck): how many values each gives, and their
    // types, Go's Question.Results.
    question_counts map[Key]int64
    question_types map[RKey]types.Type

    // The moves (see mover.tck): what the mover tracks while it follows
    // a body; the clause variables a switch on a union bound, each with
    // what its switch matches, Go's unionBindings, and the switch on a
    // union whose patterns are being checked, union_tag; the element and
    // key variables of range loops that refer into what they range over
    // in place, each with it, Go's rangeBindings, the keys among them,
    // Go's rangeKeys; and the names the mover moved, Go's Ident.Move.
    mv MoverState
    union_bound map[Key]Key
    union_tag Key
    range_bindings map[Key]Key
    range_keys map[Key]bool
    moves map[Key]bool

    // The regions (see scopealloc.tck): each region's allocator with
    // its region, Go's regions, and the name of a scope allocator being
    // checked where one may be, Go's scopeUse.
    regions map[Key]Key
    scope_use Key

    // esc is what the escape walk tracks (see escape.tck).
    esc EscState

    // body_owns says whether the body being checked holds an own
    // argument, whose call checks check_own_exclusive.
    body_owns bool

    // How far check got: decls_done once the declaration phase is,
    // with how many types the table and how many errors the checker had
    // then, and bodies_done once everything is.
    decls_done bool
    decl_type_count int64
    decl_error_count int64
    bodies_done bool

    // The facts of the body being checked (see fact.tck), and whether a
    // block leaves, remembered for each statement asked about while no
    // switch is found to name every case since (see leaves):
    // exhaust_gen counts the switches found to, and leave_gen is the
    // count leave_memo's answers were worked out at.
    fx FactState
    // The division whose value is being bound with ok, Go's
    // checkedDivision, which needs no proof, beside checked_index; and
    // whether the body being checked has a loop writing a variable
    // declared before it, which Go probes.
    checked_division Key
    probe_body bool
    // The probe (see invariant.tck): whether the body is being checked
    // as one, Go's probing; the loops it is judging writes for, Go's
    // invFrames, with what of each can run, inv_nodes, and the bounds
    // each may keep, inv_cands, the next one's id one past inv_next,
    // and the writes found to keep each, inv_kept; the bounds each loop
    // keeps, Go's invariants, in inv_facts; and the known values
    // mutable variables were last given, Go's starts.
    probing bool
    inv_frames list[InvFrame]
    inv_nodes list[Key]
    inv_cands list[InvCand]
    inv_next int64
    inv_kept map[InvKept]bool
    invariants map[Key]FRun
    inv_facts list[Fact]
    starts list[Start]
    cs_starts list[list[Start]]
    cs_frames list[list[InvFrame]]
    // appends holds the calls to append checked so far whose error
    // proves what they added, Go's appends (see appended.tck), and
    // writes_by_decl each declaration's writes anywhere in the body of
    // the function being checked, Go's writesByDecl, their records in
    // func_write_list and the loops holding them in fw_loops; body_unit
    // and body_nodes are that body, Go's body.
    appends list[AppendRec]
    writes_by_decl map[Key]WRun
    func_write_list list[FuncWrite]
    fw_loops list[source.Span]
    body_unit int64
    body_nodes ast.Nodes
    leave_memo map[LeaveKey]bool
    leave_gen int64
    exhaust_gen int64
    // term_memo remembers whether each if, switch and loop asked about
    // terminates, while term_gen is exhaust_gen (see terminates).
    term_memo map[Key]bool
    term_gen int64
    // dead counts the blocks around the statement being checked that a
    // statement before it left or terminated, Go's dead: code there
    // never runs, so an unreachable there is proven, and a contract
    // proves anything there.
    dead int64

    // The arithmetic (see overflow.tck): the operation a checked form
    // binds, Go's checkedArith, which needs no proof; the slice being
    // bound with ok, Go's checkedSlice; the slices of a spine written
    // where a view may be, marked as the spine is walked down, as Go's
    // viewSlice marks each before its check; what checking each operation
    // found, Go's arithMemo, under the facts of generation fact_gen in the
    // statement stmt_gen counts, Go's factGen and stmtGen; the operations
    // of a loop's post not proven where it is written, kept for
    // recheck_post while deferring says so, Go's deferredOverflow; and
    // whether a query counts each variable's type's bounds, Go's
    // typedRelations.
    checked_arith Key
    checked_slice Key
    slice_views map[Key]bool
    arith_memo map[Key]ArithMemo
    fact_gen int64
    stmt_gen int64
    deferring bool
    deferred list[OverflowCheck]
    typed_relations bool
    // extents holds what extent_of found of each slice in a body.
    extents map[Key]ExtentMemo
    // tag_writes holds, for each switch, where its values first may
    // assign a variable, and tag_pos each case's place in the order its
    // switch tries them (see tag_write_of).
    tag_writes map[Key]int64
    tag_pos map[Key]int64
}

// KnownLocal is the value of an immutable local, Go's knownResult:
// the value, and whether it is known.
type KnownLocal struct {
    value constant.Int
    ok bool
}

// KnownBinary is what known_arithmetic found about a binary, Go's
// knownBinary: its value, whether it is known, and the binary's type
// then.
type KnownBinary struct {
    value constant.Int
    ok bool
    typ types.Type
}

// new_checker returns a Checker for prog, which must have been resolved,
// with the source files its spans point into, both taken over and given
// back by check, Go's New.
pub func new_checker(own prog ast.Program, own files source.Set) (Checker, error) {
    t := types.new_table(c_allocator)?
    fx := new_fact_state()?
    mut c := Checker{
        prog: prog,
        files: files,
        table: t,
        tests: false,
        dumping: false,
        diags: make(list[diag.Diagnostic], c_allocator),
        warnings: make(list[diag.Diagnostic], c_allocator),
        assumed: make(list[text.Text], c_allocator),
        unit_pkg: make(list[int64], c_allocator),
        pkg: -1,
        prior: 0,
        decl_types: make(map[Key]types.Type, c_allocator),
        node_types: make(map[Key]types.Type, c_allocator),
        result_count: make(map[Key]int64, c_allocator),
        results: make(map[RKey]types.Type, c_allocator),
        consts: make(map[Key]Const, c_allocator),
        var_consts: make(map[Key]Const, c_allocator),
        store: new_store(c_allocator),
        tp_iface: make(map[Key]Key, c_allocator),
        tp_data: make(map[Key]bool, c_allocator),
        tp_implicit: make(map[Key]bool, c_allocator),
        type_params: make(map[int64]Key, c_allocator),
        stand_ins: make(map[StandInKey]Key, c_allocator),
        stand_in_of: make(map[Key]Key, c_allocator),
        func_values: make(map[Key]types.Type, c_allocator),
        dynamics: make(map[int64]Key, c_allocator),
        call_dynamic: make(map[Key]Key, c_allocator),
        fo_types: make(map[Key]types.Type, c_allocator),
        closure_params: make(map[Key]bool, c_allocator),
        caps: make(list[CapRec], c_allocator),
        lit_caps: make(map[Key]CapRange, c_allocator),
        cs_body: make(list[BodyState], c_allocator),
        cs_rel: make(list[RelIdx], c_allocator),
        cs_proven: make(list[list[ProofOnly]], c_allocator),
        cs_chain: make(list[list[Fact]], c_allocator),
        cs_appended: make(list[list[AppendRec]], c_allocator),
        cs_passed: make(list[map[Key]Key], c_allocator),
        cs_views: make(list[map[Key]bool], c_allocator),
        cs_marks: make(list[ClosureMarks], c_allocator),
        narrowed: make(list[Narrowing], c_allocator),
        narrow_saved: make(list[Narrowing], c_allocator),
        narrow_marks: make(list[int64], c_allocator),
        narrow_counts: make(list[int64], c_allocator),
        param_kinds: make(list[ParamKinds], c_allocator),
        ps_frames: make(list[ParamSwitchFrame], c_allocator),
        ps_taken: make(list[map[int64]Key], c_allocator),
        ps_seen: make(list[map[text.Text]Key], c_allocator),
        ps_names: make(list[list[uint8]], c_allocator),
        narrowed_names: make(map[Key]types.Type, c_allocator),
        in_covered_default: 0,
        tc_recs: make(list[TypeCaseRec], c_allocator),
        tc_of: make(map[Key]TcRange, c_allocator),
        fo_fields: make(map[Key]types.Type, c_allocator),
        fo_names: make(map[Key]bool, c_allocator),
        field_loops: make(map[Key]Key, c_allocator),
        unrolled: make(map[Key]bool, c_allocator),
        inf: -1,
        inf_next: 0,
        inf_fn: make(map[int64]Key, c_allocator),
        inf_args: make(map[IKey]types.Type, c_allocator),
        inf_written: make(map[IKey]bool, c_allocator),
        call_targs: make(map[RKey]types.Type, c_allocator),
        call_targ_count: make(map[Key]int64, c_allocator),
        call_ptypes: make(map[RKey]types.Type, c_allocator),
        call_pcount: make(map[Key]int64, c_allocator),
        call_rtypes: make(map[RKey]types.Type, c_allocator),
        call_rcount: make(map[Key]int64, c_allocator),
        instances: make(list[Instance], c_allocator),
        inst_args: make(list[types.Type], c_allocator),
        inst_fns: make(map[Key]int64, c_allocator),
        bounds: make(list[BoundRec], c_allocator),
        instances_recorded: false,
        inst_unrolled: 0,
        unrolled_recs: make(list[UnrolledRec], c_allocator),
        unrolled_fields: make(list[int64], c_allocator),
        globals: make(map[Key]bool, c_allocator),
        global_state: make(map[Key]uint8, c_allocator),
        global_before: make(map[Key]int64, c_allocator),
        init_stack: make(list[Key], c_allocator),
        structs: make(map[int64]Key, c_allocator),
        unions: make(map[int64]Key, c_allocator),
        struct_order: make(list[types.Type], c_allocator),
        struct_state: make(map[int64]uint8, c_allocator),
        union_state: make(map[int64]uint8, c_allocator),
        struct_pkg: make(map[int64]int64, c_allocator),
        pending_elems: make(list[PendingElem], c_allocator),
        pending_keys: make(list[PendingElem], c_allocator),
        pending_sizes: make(list[SizeSite], c_allocator),
        size_checked: make(map[int64]source.Span, c_allocator),
        sizes_known: false,
        site_params: make(map[Key]types.Type, c_allocator),
        lost: make(list[Lost], c_allocator),
        lost_all: make(map[int64]bool, c_allocator),
        in_fields: false,
        in_union: false,
        known_binaries: make(map[Key]KnownBinary, c_allocator),
        nested_globals: 0,
        depth: 0,
        unwound: make(list[Pending], c_allocator),
        want: no_key(),
        suppressing: false,
        suppress_until: no_key(),
        none: make(list[uint8], c_allocator),
        spines: make(map[Key]SpineState, c_allocator),
        global_shapes: make(map[Key]uint8, c_allocator),
        contracts: make(map[Key]CRun, c_allocator),
        contract_facts: make(list[ClauseFact], c_allocator),
        contract_conds: make(list[NoWrap], c_allocator),
        defers: make(map[Key]DRun, c_allocator),
        defer_list: make(list[Key], c_allocator),
        body: BodyState{fn: no_key(), loops: 0, deferred: 0, defer_loops: 0, field_loop: 0, in_rejected_defer: false, clauses: make(list[ClauseAt], c_allocator)},
        in_body: false,
        fall_next: make(map[Key]Key, c_allocator),
        known_locals: make(map[Key]KnownLocal, c_allocator),
        exhaustive: make(map[Key]bool, c_allocator),
        pattern_cleared: make(map[Key]bool, c_allocator),
        conv_cleared: make(map[Key]bool, c_allocator),
        call_method: make(map[Key]Key, c_allocator),
        view_convs: make(map[Key]types.Type, c_allocator),
        bindings: make(map[Key]uint8, c_allocator),
        view_call: no_key(),
        view_slice: no_key(),
        view_span: no_key(),
        checked_assert: no_key(),
        checked_take: no_key(),
        checked_index: no_key(),
        assign_target: no_key(),
        assign_value: no_key(),
        dropped_call: no_key(),
        own_reported: make(map[source.Span]bool, c_allocator),
        site_args: make(map[RKey]SiteArg, c_allocator),
        site_count: make(map[Key]int64, c_allocator),
        recv_given: no_key(),
        recv_type: types.invalid,
        ties: make(list[HoldTie], c_allocator),
        oks: make(map[Key]Key, c_allocator),
        held_any: make(map[Key]bool, c_allocator),
        holder_any: make(map[Key]bool, c_allocator),
        holders: make(map[Key]HolderAt, c_allocator),
        passed_on: make(map[Key]Key, c_allocator),
        question_counts: make(map[Key]int64, c_allocator),
        question_types: make(map[RKey]types.Type, c_allocator),
        mv: new_mover_state(),
        union_bound: make(map[Key]Key, c_allocator),
        union_tag: no_key(),
        range_bindings: make(map[Key]Key, c_allocator),
        range_keys: make(map[Key]bool, c_allocator),
        moves: make(map[Key]bool, c_allocator),
        regions: make(map[Key]Key, c_allocator),
        scope_use: no_key(),
        esc: new_esc_state(no_key()),
        body_owns: false,
        decls_done: false,
        decl_type_count: 0,
        decl_error_count: 0,
        bodies_done: false,
        fx: fx,
        checked_division: no_key(),
        probe_body: false,
        probing: false,
        inv_frames: make(list[InvFrame], c_allocator),
        inv_nodes: make(list[Key], c_allocator),
        inv_cands: make(list[InvCand], c_allocator),
        inv_next: 0,
        inv_kept: make(map[InvKept]bool, c_allocator),
        invariants: make(map[Key]FRun, c_allocator),
        inv_facts: make(list[Fact], c_allocator),
        starts: make(list[Start], c_allocator),
        cs_starts: make(list[list[Start]], c_allocator),
        cs_frames: make(list[list[InvFrame]], c_allocator),
        appends: make(list[AppendRec], c_allocator),
        writes_by_decl: make(map[Key]WRun, c_allocator),
        func_write_list: make(list[FuncWrite], c_allocator),
        fw_loops: make(list[source.Span], c_allocator),
        body_unit: 0,
        body_nodes: empty_nodes(),
        leave_memo: make(map[LeaveKey]bool, c_allocator),
        leave_gen: 0,
        exhaust_gen: 0,
        term_memo: make(map[Key]bool, c_allocator),
        term_gen: 0,
        dead: 0,
        checked_arith: no_key(),
        checked_slice: no_key(),
        slice_views: make(map[Key]bool, c_allocator),
        arith_memo: make(map[Key]ArithMemo, c_allocator),
        fact_gen: 0,
        stmt_gen: 0,
        deferring: false,
        deferred: make(list[OverflowCheck], c_allocator),
        typed_relations: false,
        extents: make(map[Key]ExtentMemo, c_allocator),
        tag_writes: make(map[Key]int64, c_allocator),
        tag_pos: make(map[Key]int64, c_allocator),
    }
    for k, pkg := range c.prog.packages {
        mut c.table.add_owner_name(pkg.name.bytes())?
        mut j int64 = 0
        for j < pkg.count {
            append(mut c.unit_pkg, k)?
            j +%= 1
        }
    }
    return c, noerror
}

// append_pkg appends to out the name, for what 0, the import path, for
// 1, or the module, for 2, of the package p of packages, or nothing for
// a p it does not have.
func append_pkg(packages []ast.Package, p int64, what uint8, mut out list[uint8]) error {
    if p < 0 || p >= len(packages) {
        return noerror
    }
    if what == 0 {
        append(mut out, packages[p].name.bytes()...)?
    } else if what == 1 {
        append(mut out, packages[p].path.bytes()...)?
    } else {
        append(mut out, packages[p].module.bytes()...)?
    }
    return noerror
}

// pkg_path_is reports whether the package p of packages has the import
// path s.
func pkg_path_is(packages []ast.Package, p int64, s []uint8) bool {
    if p < 0 || p >= len(packages) {
        return false
    }
    return packages[p].path.equal(s)
}

// state_at returns how far the check of k has got, in states, st_none
// for one not looked at yet.
func state_at(states map[Key]uint8, k Key) uint8 {
    st, ok := states[k]
    if !ok {
        return st_none
    }
    return st
}

// state_n returns how far the check of the type numbered n has got, in
// states, st_none for one not looked at yet.
func state_n(states map[int64]uint8, n int64) uint8 {
    st, ok := states[n]
    if !ok {
        return st_none
    }
    return st
}

// no_key returns the Key of no node.
func no_key() Key {
    mut z id[ast.Node]
    return Key{unit: -1, node: z}
}

// is_no_key reports whether k names no node.
func is_no_key(k Key) bool {
    return k.unit < 0
}

// key_of_def returns the Key of the declaration d names.
func key_of_def(d ast.Def) Key {
    return Key{unit: d.unit, node: d.node}
}

// check runs Go's Check on the program, in its order (check.go:557-618):
// the declaration phase, every struct and union type declared, their
// fields and cases resolved and the globals checked, std/testing's shapes
// checked, the interfaces' methods resolved, every function's signature,
// and then the exposure of every declaration, the C names of the extern
// funcs and the tests; then every function's body (see body.tck), the
// bad declarations, the instances of generic functions (see
// instance.tck) and the declarations nothing uses. It returns
// not_ported for anything the port does not check yet, or out of memory.
pub func (mut c Checker) check() error {
    c.prior = c.prog.errors
    mut c.find_lost_methods()?
    mut c.declare_structs()?
    mut c.check_globals()?
    mut c.check_site_shape()?
    mut c.check_testing_t()?
    mut c.resolve_interfaces()?
    for i := range count_decls(c.prog) {
        d := decl_at(c.prog, i)
        switch kind_at(c.prog.trees, d) {
        case func_decl(fid):
            old := mut c.enter(d)
            mut c.implicit_type_params(d, fid)?
            mut c.resolve_type_params(d)?
            mut c.resolve_param_types(d)?
            mut c.check_site_params(d)?
            mut c.resolve_result_types(d)?
            mut c.check_contract(d)?
            c.pkg = old
        default:
        }
    }
    mut c.check_exposure()?
    mut c.check_cnames()?
    mut c.check_tests()?
    c.decls_done = true
    c.decl_type_count = c.table.count()
    c.decl_error_count = len(c.diags)
    mut c.check_bodies()?
    mut c.check_bad_decls()?
    mut c.instantiate()?
    mut c.check_unused_decls()?
    c.prog.errors +%= len(c.diags)
    c.bodies_done = true
    return noerror
}

// check_types runs check for --port-types: when only the bodies are
// declined, what the declaration phase found is kept, and the dump says
// so with its phase (see write_dump); a decline before then is
// not_ported, as is any from check.
pub func (mut c Checker) check_types() error {
    c.dumping = true
    e := mut c.check()
    if e.code == not_ported.code && c.decls_done {
        return noerror
    }
    return e
}

// take_diags gives back what check reported, Go's append(c.diags,
// c.warnings...): its errors in the order it found them, then its
// warnings in theirs, or out of memory.
pub func (mut c Checker) take_diags() (list[diag.Diagnostic], error) {
    mut out := replace(mut c.diags, make(list[diag.Diagnostic], c_allocator))
    // The warnings are moved out from the end, last first, and then
    // moved again from the end of what that gives, first first, each a
    // step: taking each from the front would move every one after it.
    mut reversed := make(list[diag.Diagnostic], c_allocator)
    for len(c.warnings) > 0 {
        w, ok := pop(mut c.warnings)
        if ok {
            append(mut reversed, w)?
        }
    }
    for len(reversed) > 0 {
        w, ok := pop(mut reversed)
        if ok {
            append(mut out, w)?
        }
    }
    return out, noerror
}

// take_program gives back the program and the files check took over.
pub func (mut c Checker) take_program() (ast.Program, source.Set) {
    p := replace(mut c.prog, ast.new_program(c_allocator))
    f := replace(mut c.files, source.new_set(c_allocator))
    return p, f
}

// enter makes the package of decl the one being checked, and returns the
// one it replaced, for the caller to put back, Go's enter.
func (mut c Checker) enter(decl Key) int64 {
    old := c.pkg
    p, ok := c.unit_pkg[decl.unit]
    if ok {
        c.pkg = p
    }
    return old
}

// count_decls returns how many declarations prog has, Go's len of
// prog.Decls().
func count_decls(prog ast.Program) int64 {
    mut n int64 = 0
    for _, t := range prog.trees {
        n +%= len(t.decls)
    }
    return n
}

// decl_at returns the i'th of prog's declarations, in Go's prog.Decls()
// order: the trees' in the program's order, each tree's in source order.
// The trees are in package order already, so this is it.
func decl_at(prog ast.Program, i int64) Key {
    mut rest := i
    for u, t := range prog.trees {
        if rest < len(t.decls) {
            n, ok := t.decls[rest]
            if ok {
                return Key{unit: u, node: n}
            }
            return no_key()
        }
        rest -%= len(t.decls)
    }
    return no_key()
}

// kind_at returns what the node k is, a copy, or none for a k naming no
// node.
func kind_at(trees []ast.File, k Key) ast.Kind {
    if k.unit < 0 || k.unit >= len(trees) {
        return ast.Kind.none
    }
    return trees[k.unit].nodes[k.node].k
}

// span_at returns the span of the node k.
func span_at(trees []ast.File, k Key) source.Span {
    if k.unit < 0 || k.unit >= len(trees) {
        return ast.unset_span()
    }
    return trees[k.unit].nodes[k.node].span
}

// text_at returns the bytes s names in the tree unit, or none, an empty
// view, for a unit trees does not have.
func text_at(trees []ast.File, none []uint8, unit int64, s span[uint8]) []uint8 {
    if unit < 0 || unit >= len(trees) {
        return none
    }
    return trees[unit].bytes[s]
}

// count_items returns how many nodes l holds in the tree unit.
func count_items(trees []ast.File, unit int64, l ast.Nodes) int64 {
    if unit < 0 || unit >= len(trees) {
        return 0
    }
    return len(trees[unit].lists[l.items])
}

// item_at returns the i'th node of l in the tree unit, as a Key, or no
// key.
func item_at(trees []ast.File, unit int64, l ast.Nodes, i int64) Key {
    if unit < 0 || unit >= len(trees) {
        return no_key()
    }
    n, ok := trees[unit].lists[l.items][i]
    if !ok {
        return no_key()
    }
    return Key{unit: unit, node: n}
}

// func_of returns the Func the func_decl node k holds, a copy.
func func_of(trees []ast.File, k Key) ast.Func {
    switch kind_at(trees, k) {
    case func_decl(fid):
        if k.unit >= 0 && k.unit < len(trees) {
            return trees[k.unit].funcs[fid]
        }
    default:
    }
    mut z ast.Func
    return z
}

// param_of returns the Param the param_decl node k holds, a copy.
func param_of(trees []ast.File, k Key) ast.Param {
    switch kind_at(trees, k) {
    case param_decl(pid):
        if k.unit >= 0 && k.unit < len(trees) {
            return trees[k.unit].params[pid]
        }
    default:
    }
    mut z ast.Param
    return z
}

// sub returns the Key of the node n of the tree k names.
func sub(k Key, n id[ast.Node]) Key {
    return Key{unit: k.unit, node: n}
}

// is_none_key reports whether k names the sentinel, Go's nil.
func is_none_key(k Key) bool {
    return k.unit < 0 || ast.is_none(k.node)
}

// name_of returns the name a declaration k has: a Func's, a Param's, a
// Var's, a TypeDecl's or a TypeParam's.
func name_of(trees []ast.File, none []uint8, k Key) []uint8 {
    if k.unit < 0 || k.unit >= len(trees) {
        return none
    }
    return ast.decl_name(trees[k.unit], k.node)
}

// name_span_of returns the span of the name of the declaration k.
func name_span_of(trees []ast.File, k Key) source.Span {
    if k.unit < 0 || k.unit >= len(trees) {
        return ast.unset_span()
    }
    return ast.decl_name_span(trees[k.unit], k.node)
}

// errorf reports an error at sp saying msg, taken over, Go's errorf;
// while a suspended global is checked again up to where it was
// suspended, what it reported then is not reported again.
func (mut c Checker) errorf(sp source.Span, own msg list[uint8]) error {
    if c.suppressing {
        return noerror
    }
    m := text.from_bytes(msg, c_allocator)?
    d := diag.new_error(own m, sp, c_allocator)
    append(mut c.diags, d)?
    return noerror
}

// report reports an error at sp saying format with args as fmt.appendf
// writes them, as errorf does. The message is built here, out of the
// caller's frame: a check that recurses into what it checks, an operand,
// an argument or an element, keeps its frame small by reporting through
// this, which matters for a body nested as deeply as the parser allows
// (see the stack discipline in doc.tck).
func (mut c Checker) report(sp source.Span, format string, args ...any) error {
    mut m := msg()
    fmt.appendf(mut m, format, args...)?
    return mut c.errorf(sp, own m)
}

// note_last adds to the last diagnostic a note at sp saying msg, taken
// over, unless the diagnostic was not reported (see errorf).
func (mut c Checker) note_last(sp source.Span, own msg list[uint8]) error {
    if c.suppressing {
        return noerror
    }
    m := text.from_bytes(msg, c_allocator)?
    i := len(c.diags) -% 1
    add_note(mut c.diags, i, diag.Related{message: m, marker: text.new(c_allocator), span: sp, severity: diag.note})?
    return noerror
}

// add_note adds rel, taken over, to diags[i].
func add_note(mut diags list[diag.Diagnostic], i int64, own rel diag.Related) error {
    if i >= 0 && i < len(diags) {
        append(mut diags[i].related, rel)?
    }
    return noerror
}

// msg returns an empty message to write into.
func msg() list[uint8] {
    return make(list[uint8], c_allocator)
}

// type_name returns typ's name as a diagnostic about the package being
// checked writes it, Go's typeName: a struct or union type of another
// package qualified by that package's name.
func (mut c Checker) type_name(typ types.Type) (list[uint8], error) {
    n := c.table.name_in(typ, c.pkg)?
    return n, noerror
}

// text returns the source sp covers, which notes quote, Go's text.
func (mut c Checker) source_text(sp source.Span) (list[uint8], error) {
    mut out := msg()
    for _, f := range c.files.lookup(sp.file) {
        if sp.start >= 0 && sp.start <= sp.end && sp.end <= len(f.data) {
            append(mut out, f.data[sp.start:sp.end]...)?
        }
    }
    return out, noerror
}

// decl_type_of returns the type recorded in decl_types for the
// declaration k, invalid before.
func decl_type_of(decl_types map[Key]types.Type, k Key) types.Type {
    t, ok := decl_types[k]
    if !ok {
        return types.invalid
    }
    return t
}

// set_decl_type records typ as the declaration k's type.
func (mut c Checker) set_decl_type(k Key, typ types.Type) error {
    put(mut c.decl_types, k, typ)?
    return noerror
}

// node_type_of returns the type recorded in node_types on the
// expression k, Go's x.Type, invalid before.
func node_type_of(node_types map[Key]types.Type, k Key) types.Type {
    t, ok := node_types[k]
    if !ok {
        return types.invalid
    }
    return t
}

// set_node_type records typ on the expression k.
func (mut c Checker) set_node_type(k Key, typ types.Type) error {
    put(mut c.node_types, k, typ)?
    return noerror
}

// result_of returns the i'th of the result types recorded in results for
// the function or interface method k.
func result_of(results map[RKey]types.Type, k Key, i int64) types.Type {
    t, ok := results[RKey{unit: k.unit, node: k.node, i: i}]
    if !ok {
        return types.invalid
    }
    return t
}

// results_count returns how many result types are recorded in counts for
// k, and whether any were, Go's ResultTypes being made.
func results_count(counts map[Key]int64, k Key) (int64, bool) {
    n, ok := counts[k]
    return n, ok
}
