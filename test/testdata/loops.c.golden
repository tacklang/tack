}

static int64_t tack_main_nthPrime(int64_t p_n) {
    int64_t v_found = 0;
    int64_t v_candidate = 1;
    for (;;) {
        v_candidate = (v_candidate + 1);
        if (!tack_main_isPrime(v_candidate)) {
            continue;
