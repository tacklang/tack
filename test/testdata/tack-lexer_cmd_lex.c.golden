// print: write s to stdout exactly as given. An empty string is not
// written: a zeroed one holds a null pointer, which C does not let fwrite
// take even with nothing to write.
static void tack_builtin_print(tack_string s) {
    if (s.len > 0) {
        fwrite(s.ptr, 1, s.len, stdout);
    }
}

// exit: end the process, running no defers. C's exit takes an int, so the
// status is narrowed in the open; only its low bits reach the OS.
static void tack_builtin_exit(int64_t code) {
    exit((int)code);
}

static int64_t tack_div_int64(int64_t a, int64_t b) {
    return b == -1 ? (int64_t)(0 - (uint64_t)a) : (int64_t)(a / b);
}

static uint8_t tack_div_uint8(uint8_t a, uint8_t b) {
    return a / b;
}

static int64_t tack_rem_int64(int64_t a, int64_t b) {
    return b == -1 ? 0 : (int64_t)(a % b);
}

static uint8_t tack_rem_uint8(uint8_t a, uint8_t b) {
    return a % b;
}

