// Generated by the Tack compiler. Do not edit.

#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

typedef struct {
    const unsigned char *ptr;
    int64_t len;
} tack_string;

static const unsigned char tack_str0[2] = {10, 0};
static const unsigned char tack_str1[6] = {102, 105, 114, 115, 116, 0};
static const unsigned char tack_str2[6] = {110, 101, 118, 101, 114, 0};
static const unsigned char tack_str3[7] = {115, 101, 99, 111, 110, 100, 0};

// print: write s to stdout exactly as given. An empty string is not
// written: a zeroed one holds a null pointer, which C does not let fwrite
// take even with nothing to write.
static void tack_builtin_print(tack_string s) {
    if (s.len > 0) {
        fwrite(s.ptr, 1, s.len, stdout);
    }
}

// exit: end the process, running no defers. C's exit takes an int, so the
// status is narrowed in the open; only its low bits reach the OS.
static void tack_builtin_exit(int64_t code) {
    exit((int)code);
}

static int64_t tack_div_int64(int64_t a, int64_t b) {
    return b == -1 ? (int64_t)(0 - (uint64_t)a) : (int64_t)(a / b);
}

static bool tack_4_main5_check(tack_string p_name, bool p_ok);
static bool tack_4_main4_safe(int64_t p_n);
static void tack_4_main4_main(void);

static bool tack_4_main5_check(tack_string p_name, bool p_ok) {
    tack_builtin_print(p_name);
    tack_builtin_print((tack_string){tack_str0, 1});
    return p_ok;
}

static bool tack_4_main4_safe(int64_t p_n) {
    return ((p_n != 0) && (tack_div_int64(100, p_n) > 10));
}

static void tack_4_main4_main(void) {
    if (tack_4_main5_check((tack_string){tack_str1, 5}, false) && tack_4_main5_check((tack_string){tack_str2, 5}, true)) {
        tack_builtin_exit(1);
    }
    if (tack_4_main5_check((tack_string){tack_str3, 6}, true) || tack_4_main5_check((tack_string){tack_str2, 5}, true)) {
        if (!tack_4_main4_safe(0) && tack_4_main4_safe(5)) {
            tack_builtin_exit(13);
        }
    }
}

int main(void) {
    tack_4_main4_main();
    return 0;
}
