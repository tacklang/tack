    tack_4_main5_check((tack_4_main9_else_5fif(10, (-1)) == (-10)), (tack_string){tack_str45, TACK_C_STR_LEN(tack_str45)});
    tack_4_main5_check((tack_4_main9_else_5fif(v_min, (-1)) == v_min), (tack_string){tack_str46, TACK_C_STR_LEN(tack_str46)});
    tack_4_main5_check((tack_4_main9_else_5fif(10, 0) == 0), (tack_string){tack_str47, TACK_C_STR_LEN(tack_str47)});
    tack_4_main5_check((tack_4_main9_else_5fif(10, 5) == 2), (tack_string){tack_str48, TACK_C_STR_LEN(tack_str48)});
    tack_4_main5_check((tack_4_main9_else_5fif(v_min, v_min) == 1), (tack_string){tack_str49, TACK_C_STR_LEN(tack_str49)});
    tack_4_main5_check((tack_4_main14_proven_5fafter((-1)) == 1), (tack_string){tack_str50, TACK_C_STR_LEN(tack_str50)});
    tack_4_main5_check((tack_4_main14_proven_5fafter(0) == 0), (tack_string){tack_str51, TACK_C_STR_LEN(tack_str51)});
    tack_4_main5_check((tack_4_main14_proven_5fafter(5) == 2), (tack_string){tack_str52, TACK_C_STR_LEN(tack_str52)});
}

