// Generated by the Tack compiler. Do not edit.

#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>

typedef struct {
    const unsigned char *ptr;
    int64_t len;
} tack_string;

static const unsigned char tack_str0[6] = {115, 109, 97, 108, 108, 0};
static const unsigned char tack_str1[6] = {108, 97, 114, 103, 101, 0};
static const unsigned char tack_str2[2] = {10, 0};

// print: write s to stdout exactly as given. An empty string is not
// written: a zeroed one holds a null pointer, which C does not let fwrite
// take even with nothing to write.
static void tack_builtin_print(tack_string s) {
    if (s.len > 0) {
        fwrite(s.ptr, 1, s.len, stdout);
    }
}

static tack_string tack_4_main8_classify(int64_t p_n);
static void tack_4_main4_main(void);

static tack_string tack_4_main8_classify(int64_t p_n) {
    if (p_n < 10) {
        return (tack_string){tack_str0, 5};
    } else {
        return (tack_string){tack_str1, 5};
    }
}

static void tack_4_main4_main(void) {
    tack_builtin_print(tack_4_main8_classify(3));
    tack_builtin_print((tack_string){tack_str2, 1});
    tack_builtin_print(tack_4_main8_classify(30));
    tack_builtin_print((tack_string){tack_str2, 1});
}

int main(void) {
    tack_4_main4_main();
    return 0;
}
