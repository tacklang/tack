package main

import text from "std/text"

// has(m, k) reports whether the key k is in the map m. Tested as a guard,
// it proves k is there, and m[k] is then a place, as a proven l[i] is: it
// can be read in place, its fields read, passed to a function as it is or
// as mut, appended to, have a mut method called on it, be replaced, and
// be assigned, which frees the value it held. The proof ends at any write
// to m or to k that can reach the use.
//
// Every check that makes a map runs in a function of its own, and main
// asserts after it that c_allocator's count of live buffers is back to
// zero. Every check prints its name and "ok", or "FAIL".

// live returns how many buffers c_allocator holds, in C.
extern("has_live") func live() int64

// fail_after makes c_allocator grant the next n requests and refuse every
// one after them, or refuse none again for a negative n, in C.
extern("has_fail_after") func fail_after(n int64)

// check prints name and whether cond held.
func check(cond bool, name string) {
    print(name)
    if cond {
        print(" ok\n")
    } else {
        print(" FAIL\n")
    }
}

// count returns a list holding 0 through n-1.
func count(n int64) list[int64] {
    mut l := make(list[int64], c_allocator)
    for i := range n {
        err := append(mut l, i)
        if err.code != 0 {
            return l
        }
    }
    return l
}

// textOf returns a Text holding s's bytes, or an empty one on failure.
func textOf(s string) text.Text {
    t, err := text.from_bytes([]uint8(s), c_allocator)
    if err.code != 0 {
        return text.new(c_allocator)
    }
    return t
}

// total returns the sum of l's elements.
func total(l []int64) int64 {
    mut n := 0
    for _, x := range l {
        n += x
    }
    return n
}

// double doubles x where it is.
func double(mut x int64) {
    x = x * 2
}

// Bag holds a list and a tag.
type Bag struct {
    items list[int64]
    tag int64
}

// add appends x to b's items.
func (mut b Bag) add(x int64) error {
    return append(mut b.items, x)
}

// plain reads and writes int64 values under has: a read, a write, an
// update through mut, a missing key, an early exit, and constant keys.
func plain() {
    mut m := make(map[int64]int64, c_allocator)
    e1 := put(mut m, 1, 10)
    e2 := put(mut m, 2, 20)
    if e1.code != 0 || e2.code != 0 {
        return
    }
    k := 2
    mut got := 0
    if has(m, k) {
        got = m[k]
        m[k] = m[k] + 5
        double(mut m[k])
    }
    v, hasV := m[2]
    check(got == 20 && hasV && v == 50 && len(m) == 2, "read, assign and mut under has")
    missing := 9
    check(!has(m, missing) && has(m, 1), "has of a missing key and a present one")
    if has(m, 1) {
        m[1] = 11
    }
    w, hasW := m[1]
    check(hasW && w == 11, "a constant key")
    one := 1
    if !has(m, one) {
        return
    }
    m[one] += 1
    x, hasX := m[1]
    check(hasX && x == 12 && order(m) == 12, "an early exit, and the order kept")
}

// order returns m's keys in the order a range gives them, as one number,
// each key a digit.
func order(m map[int64]int64) int64 {
    mut n := 0
    for k := range m {
        n = n * 10 + k
    }
    return n
}

// owned updates list values keyed by Texts in place under has: appends,
// views, replaces, and assignments that free the value they replace.
func owned() {
    mut m := make(map[text.Text]list[int64], c_allocator)
    e1 := put(mut m, textOf("a"), count(2))
    e2 := put(mut m, textOf("b"), count(3))
    if e1.code != 0 || e2.code != 0 {
        return
    }
    a := textOf("a")
    b := textOf("b")
    if !has(m, a) || !has(m, b) {
        return
    }
    e3 := append(mut m[a], 7, 8)
    n := len(m[a])
    sum := total(m[a])
    old := replace(mut m[b], count(1))
    m[a] = count(4)
    c := textOf("c")
    check(e3.code == 0 && n == 4 && sum == 0 + 1 + 7 + 8 && len(old) == 3 && len(m[b]) == 1 &&
        len(m[a]) == 4 && at(m, a, 3) == 3 && at(m, a, 4) == -1 && at(m, c, 0) == -1 &&
        len(m) == 2, "list values in place")
}

// at returns element j of the list m holds by k, or -1 when there is
// none: the key and the index are each proven before the element is read.
func at(m map[text.Text]list[int64], k text.Text, j int64) int64 {
    if has(m, k) && 0 <= j && j < len(m[k]) {
        return m[k][j]
    }
    return -1
}

// bags calls a mut method on a struct value, and reads its fields, under
// has.
func bags() {
    mut m := make(map[string]Bag, c_allocator)
    e1 := put(mut m, "x", Bag{items: count(1), tag: 3})
    if e1.code != 0 {
        return
    }
    if has(m, "x") {
        e2 := mut m["x"].add(5)
        e3 := append(mut m["x"].items, 6)
        m["x"].tag = m["x"].tag + 1
        check(e2.code == 0 && e3.code == 0 && len(m["x"].items) == 3 && m["x"].tag == 4,
            "a mut method and fields")
    }
}

// nested writes a map held in a map under has, and reads it, each level
// proven on its own: a proof is about a map that is a variable, or a
// field of one declared without mut, so the inner map's keys are proven
// in a function that takes the outer one.
func nested() {
    mut outer := make(map[int64]map[string]int64, c_allocator)
    e1 := put(mut outer, 1, make(map[string]int64, c_allocator))
    if e1.code != 0 {
        return
    }
    if has(outer, 1) {
        e2 := put(mut outer[1], "a", 5)
        check(e2.code == 0 && len(outer[1]) == 1 && inner(outer, 1, "a") == 5 &&
            inner(outer, 1, "b") == -1 && inner(outer, 2, "a") == -1, "maps in maps")
    }
}

// inner returns the value under j in the map outer holds under i, or -1
// when there is none.
func inner(outer map[int64]map[string]int64, i int64, j string) int64 {
    if has(outer, i) && has(outer[i], j) {
        return outer[i][j]
    }
    return -1
}

// Index holds a map in a field.
type Index struct {
    byName map[string]int64
}

// Slot holds a map as a union's payload, or nothing.
type Slot union {
    table map[int64]list[int64]
    empty
}

// field returns the value under k in ix's map, or -1.
func field(ix Index, k string) int64 {
    if has(ix.byName, k) {
        return ix.byName[k]
    }
    return -1
}

// payload returns the length of the list under k in the map slot holds,
// or -1.
func payload(slot Slot, k int64) int64 {
    switch slot {
    case table(t):
        if has(t, k) {
            return len(t[k])
        }
    case empty:
    }
    return -1
}

// places proves keys in maps held in a struct's field, a union's payload
// and a range loop's value.
func places() {
    mut ix := Index{byName: make(map[string]int64, c_allocator)}
    e1 := put(mut ix.byName, "a", 4)
    mut table := make(map[int64]list[int64], c_allocator)
    e2 := put(mut table, 3, count(3))
    slot := Slot.table(table)
    mut outer := make(map[int64]map[int64]int64, c_allocator)
    mut in := make(map[int64]int64, c_allocator)
    e3 := put(mut in, 7, 70)
    e4 := put(mut outer, 1, in)
    mut sum := 0
    for _, im := range outer {
        if has(im, 7) {
            sum += im[7]
        }
    }
    check(e1.code == 0 && e2.code == 0 && e3.code == 0 && e4.code == 0 && field(ix, "a") == 4 &&
        field(ix, "b") == -1 && payload(slot, 3) == 3 && payload(slot, 4) == -1 && sum == 70,
        "a field, a payload and a range's value")
}

// again proves a key once more after a put ends the proof, inside a loop
// whose every pass proves it before it is used.
func again() {
    mut m := make(map[int64]int64, c_allocator)
    mut sum := 0
    for i := range 10 {
        err := put(mut m, i % 3, i)
        if err.code != 0 {
            return
        }
        k := i % 3
        if has(m, k) {
            sum += m[k]
        }
    }
    check(sum == 45 && len(m) == 3, "a proof in every pass of a loop")
}

// failing appends to a list value under has with every allocation from
// the n'th on refused, and reports whether each append either succeeded
// or left the list as it was.
func failing(n int64) bool {
    mut m := make(map[text.Text]list[int64], c_allocator)
    e := put(mut m, textOf("k"), make(list[int64], c_allocator))
    k := textOf("k")
    fail_after(n)
    mut ok := e.code == 0 || len(m) == 0
    if has(m, k) {
        for i := range 40 {
            before := len(m[k])
            err := append(mut m[k], i)
            ok = ok && (err.code == 0 && len(m[k]) == before + 1 || err.code == 1 && len(m[k]) == before)
        }
        m[k] = count(3)
        ok = ok && len(m[k]) <= 3
    }
    fail_after(-1)
    return ok
}

func main() {
    plain()
    check(live() == 0, "nothing left after plain values")
    owned()
    check(live() == 0, "nothing left after owned values")
    bags()
    check(live() == 0, "nothing left after struct values")
    nested()
    check(live() == 0, "nothing left after nested maps")
    again()
    check(live() == 0, "nothing left after a loop")
    places()
    check(live() == 0, "nothing left after places")
    mut all := true
    for n := range 60 {
        all = all && failing(n)
        all = all && live() == 0
    }
    check(all, "an append under has that cannot grow changes nothing")
}
