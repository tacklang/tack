// go_bases_and_bit_sizes is Go's parseBitSizeTests and parseBaseTests, on "0", and which error comes first: an empty input is a syntax error before the base or bit size is looked at, and the base comes before the bit size.
func go_bases_and_bit_sizes() {
    start := fails
    ints("0", 0, -1, 0, 9)
    uints("0", 0, -1, 0, 9)
    ints("0", 0, 0, 0, 0)
    uints("0", 0, 0, 0, 0)
    ints("0", 0, 64, 0, 0)
    uints("0", 0, 64, 0, 0)
    ints("0", 0, 65, 0, 9)
    uints("0", 0, 65, 0, 9)
    ints("0", 0, -9223372036854775808, 0, 9)
    uints("0", 0, -9223372036854775808, 0, 9)
    ints("0", 0, 9223372036854775807, 0, 9)
    uints("0", 0, 9223372036854775807, 0, 9)
    ints("0", -1, 0, 0, 8)
    uints("0", -1, 0, 0, 8)
    ints("0", 0, 0, 0, 0)
    uints("0", 0, 0, 0, 0)
    ints("0", 1, 0, 0, 8)
    uints("0", 1, 0, 0, 8)
    ints("0", 2, 0, 0, 0)
    uints("0", 2, 0, 0, 0)
    ints("0", 36, 0, 0, 0)
    uints("0", 36, 0, 0, 0)
    ints("0", 37, 0, 0, 8)
    uints("0", 37, 0, 0, 8)
    ints("0", -9223372036854775808, 0, 0, 8)
    uints("0", -9223372036854775808, 0, 0, 8)
    ints("0", 9223372036854775807, 0, 0, 8)
    uints("0", 9223372036854775807, 0, 0, 8)
    ints("", 1, 0, 0, 6)
    uints("", 1, 0, 0, 6)
    ints("", 37, 65, 0, 6)
    uints("", 37, 65, 0, 6)
    ints("-", 1, 0, 0, 6)
    uints("-", 1, 0, 0, 8)
    ints("+", 0, 65, 0, 6)
    uints("+", 0, 65, 0, 9)
    ints("x", 1, 65, 0, 8)
    uints("x", 1, 65, 0, 8)
    ints("1", 37, -1, 0, 8)
    uints("1", 37, -1, 0, 8)
    ints("z", 1, 0, 0, 8)
    uints("z", 1, 0, 0, 8)
    check(fails == start, "go bases and bit sizes")
}

