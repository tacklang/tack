package main

import conv from "std/conv"
import fmt from "std/fmt"
import text from "std/text"

// std/conv parses integers as Go's strconv.ParseInt and ParseUint do:
// base 0 takes the base from a prefix, 0x, 0o, 0b or a leading 0, and
// underscores between digits; bases 2 to 36 take digits alone; bit
// sizes 1 to 64 bound the value, 0 meaning 64; a sign is parse_int's
// alone. Bad syntax is error{code: 6, msg: "invalid syntax"}, a value
// out of range error{code: 7, msg: "value out of range"}, and a base or
// bit size Go refuses code 8, "invalid base", or 9, "invalid bit size".
//
// The tables below are Go's own atoi tests, ported, and cases of ours;
// each case's expected value and error were written from what Go's
// strconv gives, and codegen/c/conv_test.go checks every row against strconv
// again. A failed case prints what it got; each table prints ok when
// all its cases held. The value beside an error cannot be read before
// the error is checked, so a case that fails checks the error alone.

// syntax, out_of_range, bad_base and bad_bit_size are the errors
// std/conv gives, written out so a case compares the whole error, its
// message too.
var syntax = error{code: 6, msg: "invalid syntax"}
var out_of_range = error{code: 7, msg: "value out of range"}
var bad_base = error{code: 8, msg: "invalid base"}
var bad_bit_size = error{code: 9, msg: "invalid bit size"}

// fails counts the cases that did not hold.
mut fails int64 = 0

// check prints name and whether cond held.
func check(cond bool, name string) {
    print(name)
    if cond {
        print(" ok\n")
    } else {
        print(" FAIL\n")
    }
}

// error_of returns the error std/conv gives for code, or noerror for 0.
func error_of(code int32) error {
    switch code {
    case 6:
        return syntax
    case 7:
        return out_of_range
    case 8:
        return bad_base
    case 9:
        return bad_bit_size
    }
    return noerror
}

// ints checks that conv.parse_int(s, base, bits) gives want and no error
// when code is 0, and otherwise the error code names, printing what it
// gave and counting a failure when it does not.
func ints(s string, base int64, bits int64, want int64, code int32) {
    v, e := conv.parse_int([]uint8(s), base, bits)
    if e != error_of(code) {
        fails++
        fmt.printf("parse_int(\"%s\", %d, %d) gave error %d %s, want %d\n", s, base, bits, e.code, e.msg, code)
        return
    }
    if e.code == 0 && v != want {
        fails++
        fmt.printf("parse_int(\"%s\", %d, %d) gave %d, want %d\n", s, base, bits, v, want)
    }
}

// uints checks that conv.parse_uint(s, base, bits) gives want and no
// error when code is 0, and otherwise the error code names, printing
// what it gave and counting a failure when it does not.
func uints(s string, base int64, bits int64, want uint64, code int32) {
    v, e := conv.parse_uint([]uint8(s), base, bits)
    if e != error_of(code) {
        fails++
        fmt.printf("parse_uint(\"%s\", %d, %d) gave error %d %s, want %d\n", s, base, bits, e.code, e.msg, code)
        return
    }
    if e.code == 0 && v != want {
        fails++
        fmt.printf("parse_uint(\"%s\", %d, %d) gave %d, want %d\n", s, base, bits, v, want)
    }
}

// sources parses bytes from each kind of []uint8 a program has: a
// string's, a std/text Text's, a list's, an array's and slices of them,
// and a view parameter's.
func sources() {
    t, e := text.from_bytes([]uint8("-0x7f"), c_allocator)
    if e.code != 0 {
        check(false, "from_bytes")
        return
    }
    v, e1 := conv.parse_int(t.bytes(), 0, 8)
    check(e1.code == 0 && v == -127, "a Text's bytes")
    mut l := make(list[uint8], c_allocator)
    e2 := append(mut l, '4', '2', 'x')
    if e2.code != 0 {
        check(false, "append")
        return
    }
    _, e3 := conv.parse_uint(l, 10, 0)
    check(e3 == syntax, "a list, its x a syntax error")
    u, e4 := conv.parse_uint(l[:2], 10, 0)
    check(e4.code == 0 && u == 42, "a slice of a list")
    a := [4]uint8{'1', '0', '0', '0'}
    w, e5 := conv.parse_int(a, 2, 5)
    check(e5.code == 0 && w == 8, "an array, 8 in 5 bits")
    _, e6 := conv.parse_int(a, 2, 4)
    check(e6 == out_of_range, "an array, 8 out of range in 4 bits")
    x, e7 := conv.parse_int(a[1:], 16, 0)
    check(e7.code == 0 && x == 0, "a slice of an array")
    check(twice(t.bytes()) == -254, "a view passed on")
}

// twice returns the value of b, parsed in base 0 as an int8, doubled, or
// 0 when it does not parse.
func twice(b []uint8) int64 {
    v, e := conv.parse_int(b, 0, 8)
    if e.code != 0 {
        return 0
    }
    return v * 2
}

// sums adds parsed values, checking each error first, as a program
// reading numbers would.
func sums() {
    words := [4]string{"10", "0x10", "0b10", "0o10"}
    mut sum := 0
    for _, w := range words {
        v, e := conv.parse_int([]uint8(w), 0, 0)
        if e.code != 0 {
            check(false, "sum")
            return
        }
        sum = sum + v
    }
    check(sum == 10 + 16 + 2 + 8, "a sum of parsed values")
    m, e := conv.parse_uint([]uint8("18446744073709551615"), 10, 64)
    if e.code != 0 {
        check(false, "max")
        return
    }
    check(m + 1 == 0, "the largest uint64 wraps when one is added")
}

// go_parse_uint64 is Go's parseUint64Tests: parse_uint in base 10, bit sizes 64 and 0.
func go_parse_uint64() {
    start := fails
    uints("", 10, 64, 0, 6)
    uints("0", 10, 64, 0, 0)
    uints("1", 10, 64, 1, 0)
    uints("12345", 10, 64, 12345, 0)
    uints("012345", 10, 64, 12345, 0)
    uints("12345x", 10, 64, 0, 6)
    uints("98765432100", 10, 64, 98765432100, 0)
    uints("18446744073709551615", 10, 64, 18446744073709551615, 0)
    uints("18446744073709551616", 10, 64, 0, 7)
    uints("18446744073709551620", 10, 64, 0, 7)
    uints("1_2_3_4_5", 10, 64, 0, 6)
    uints("_12345", 10, 64, 0, 6)
    uints("1__2345", 10, 64, 0, 6)
    uints("12345_", 10, 64, 0, 6)
    uints("-0", 10, 64, 0, 6)
    uints("-1", 10, 64, 0, 6)
    uints("+1", 10, 64, 0, 6)
    uints("", 10, 0, 0, 6)
    uints("0", 10, 0, 0, 0)
    uints("1", 10, 0, 1, 0)
    uints("12345", 10, 0, 12345, 0)
    uints("012345", 10, 0, 12345, 0)
    uints("12345x", 10, 0, 0, 6)
    uints("98765432100", 10, 0, 98765432100, 0)
    uints("18446744073709551615", 10, 0, 18446744073709551615, 0)
    uints("18446744073709551616", 10, 0, 0, 7)
    uints("18446744073709551620", 10, 0, 0, 7)
    uints("1_2_3_4_5", 10, 0, 0, 6)
    uints("_12345", 10, 0, 0, 6)
    uints("1__2345", 10, 0, 0, 6)
    uints("12345_", 10, 0, 0, 6)
    uints("-0", 10, 0, 0, 6)
    uints("-1", 10, 0, 0, 6)
    uints("+1", 10, 0, 0, 6)
    check(fails == start, "go parse uint64")
}

