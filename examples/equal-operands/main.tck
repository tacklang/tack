package main

// Equality of structs, arrays and unions, whose operands are values the
// comparison reads through their addresses, where an operand holds calls:
// a literal whose fields or elements are calls, on either side or both,
// a literal nested in one, a union built from one, and a switch case
// written as one. Every call adds its argument to trace, so each check also
// asserts the calls ran exactly once each, left to right, and a call that
// writes the other operand, a global or a mut argument, writes it after
// it was read, as the left operand is read first.

// trace records the calls made, one decimal digit each, in order.
mut trace int64

// f records x in trace and returns it.
func f(x int64) int64 {
    trace = trace *% 10 +% x
    return x
}

// moved is a pair calls write.
mut moved S

// bump records x, moves moved's a by 10 and returns x.
func bump(x int64) int64 {
    moved.a = moved.a +% 10
    return f(x)
}

// set records x, sets s's a to x plus 10 and returns x.
func set(mut s S, x int64) int64 {
    s.a = x +% 10
    return f(x)
}

// S is a pair of integers.
type S struct {
    a int64
    b int64
}

// Outer holds a pair and an integer, for a literal nested in a literal.
type Outer struct {
    s S
    c int64
}

// Shape is a union with a struct payload and one with none.
type Shape union {
    pair S
    none
}

// check exits with code when cond does not hold, or when the calls made
// since trace was last cleared are not want, and clears trace.
func check(cond bool, want int64, code int32) {
    if !cond || trace != want {
        exit(code)
    }
    trace = 0
}

// which returns the code of the case of switch p matches.
func which(p S) int64 {
    switch p {
    case S{a: f(1), b: f(2)}:
        return 1
    case S{a: f(3), b: f(4)}:
        return 2
    }
    return 0
}

// main runs every check and exits 23 when all of them hold.
func main() {
    p := S{a: 1, b: 2}
    check(p == (S{a: f(1), b: f(2)}), 12, 1)
    check(!(p == (S{a: f(2), b: f(1)})), 21, 2)
    check(p != (S{a: f(1), b: f(3)}), 13, 3)
    check((S{a: f(1), b: f(2)}) == p, 12, 4)
    check((S{a: f(1), b: f(2)}) == (S{a: f(1), b: f(2)}), 1212, 5)

    a := [3]int64{1, 2, 3}
    check(a == [3]int64{f(1), f(2), f(3)}, 123, 6)
    check(a != [3]int64{f(1), f(2), f(4)}, 124, 7)

    o := Outer{s: S{a: 1, b: 2}, c: 3}
    check(o == (Outer{s: S{a: f(1), b: f(2)}, c: f(3)}), 123, 8)

    u := Shape.pair(S{a: 1, b: 2})
    check(u == Shape.pair(S{a: f(1), b: f(2)}), 12, 9)
    check(u != Shape.pair(S{a: f(2), b: f(2)}), 22, 10)
    check(Shape.none != Shape.pair(S{a: f(1), b: f(2)}), 12, 11)

    rows := [2]S{S{a: 1, b: 2}, S{a: 3, b: 4}}
    check(rows[0] != rows[1], 0, 12)
    check(rows[1] == (S{a: f(3), b: f(4)}), 34, 13)
    grid := [2][3]int64{[3]int64{1, 2, 3}, [3]int64{4, 5, 6}}
    check(grid[0] == a, 0, 14)
    check(grid[1] == [3]int64{f(4), f(5), f(6)}, 456, 15)

    moved = S{a: 1, b: 2}
    check(moved == (S{a: bump(1), b: bump(2)}), 12, 19)
    check(moved.a == 21, 0, 20)
    mut m := S{a: 1, b: 2}
    check(m == (S{a: set(mut m, 1), b: set(mut m, 2)}), 12, 21)
    check(m.a == 12, 0, 22)

    check(which(p) == 1, 12, 16)
    check(which(S{a: 3, b: 4}) == 2, 1234, 17)
    check(which(S{a: 5, b: 6}) == 0, 1234, 18)
    exit(23)
}

// The wrapping operators in this file, +% -% *% and their compound
// forms, stand where nothing proves a value's bound but this program's
// own fixed data keeps it within its type, so none of them wraps; one
// that is meant to wrap says so where it is.
