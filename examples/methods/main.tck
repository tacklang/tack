package main

// Methods. A method is a function declared with a receiver, func (b
// Builder) len() int64, on a struct type of its own package, and called
// on a value of that type, b.len(). A mut receiver, func (mut b Builder)
// write(s string) error, is a mut parameter: the call writes mut before
// the place it changes, mut b.write(s), and the method changes the
// caller's value through it.
//
// Every check that makes a list runs in a function of its own, and main
// asserts after it that c_allocator's count of live buffers is back to
// zero, so a list a method made, grew or was handed is freed exactly
// once. The count is read through live, whose C, in live.c, reads std's
// hook.

import fmt from "std/fmt"
import strs from "methods/strs"

// live returns how many buffers c_allocator holds, in C.
extern("methods_live") func live() int64

// check prints name and whether cond held.
func check(cond bool, name string) {
    print(name)
    if cond {
        print(" ok\n")
    } else {
        print(" FAIL\n")
    }
}

// freed checks that nothing is live after a check, name saying which.
func freed(name string) {
    check(live() == 0, name)
}

// Builder collects bytes in a list it owns, and counts the lines written
// to it.
type Builder struct {
    buf   list[uint8]
    lines int64
}

// newBuilder returns an empty Builder.
func newBuilder() Builder {
    return Builder{buf: make(list[uint8], c_allocator), lines: 0}
}

// len returns how many bytes b holds: a method named like the builtin,
// whose body still calls the builtin.
func (b Builder) len() int64 {
    return len(b.buf)
}

// append appends c: a method named like the builtin, calling it.
func (mut b Builder) append(c uint8) error {
    return append(mut b.buf, c)
}

// write appends every byte of s, through append: a method calling a
// method on its own receiver, passed on as mut.
func (mut b Builder) write(s string) error {
    for _, c := range s {
        err := mut b.append(c)
        if err.code != 0 {
            return err
        }
    }
    return noerror
}

// writeAll writes each of parts in turn: a variadic method.
func (mut b Builder) writeAll(parts ...string) error {
    for _, p := range parts {
        err := mut b.write(p)
        if err.code != 0 {
            return err
        }
    }
    return noerror
}

// line writes s and a newline, and counts the line in a defer, which
// runs after the return's value is computed.
func (mut b Builder) line(s string) error {
    defer {
        b.lines++
    }
    err := mut b.write(s)
    if err.code != 0 {
        return err
    }
    return mut b.append('\n')
}

// at returns the byte at i and whether there is one: several results.
func (b Builder) at(i int64) (uint8, bool) {
    c, ok := b.buf[i]
    return c, ok
}

// last returns the last byte, or an error when b is empty: a result
// beside an error, which the caller must check.
func (b Builder) last() (uint8, error) {
    c, ok := b.buf[b.len() - 1]
    if !ok {
        return 0, error{code: 1, msg: "empty"}
    }
    return c, noerror
}

// count returns how many bytes from i on are c, recursively.
func (b Builder) count(c uint8, i int64) int64 {
    x, ok := b.buf[i]
    if !ok {
        return 0
    }
    rest := b.count(c, i + 1)
    if x == c {
        return rest + 1
    }
    return rest
}

// count returns how many bytes of s are c: a package-level function
// sharing a name with a method, which lives in its type's namespace.
func count(s string, c uint8) int64 {
    mut n int64 = 0
    for _, x := range s {
        if x == c {
            n++
        }
    }
    return n
}

// equals reports whether b holds exactly the bytes of s.
func (b Builder) equals(s string) bool {
    if b.len() != len(s) {
        return false
    }
    for i, c := range s {
        x, ok := b.buf[i]
        if !ok || x != c {
            return false
        }
    }
    return true
}

// allocated reports whether c_allocator holds any buffer: a method
// calling an extern func.
func (b Builder) allocated() bool {
    return live() > 0
}

// isInt reports whether v holds an int64: an any parameter.
func (b Builder) isInt(v any) bool {
    _, ok := v.(int64)
    return ok
}

// show writes format with args through fmt.printf, which a method passes
// its variadic on to as any function does.
func (b Builder) show(format string, args ...any) {
    fmt.printf(format, args...)
}

// Writer holds a Builder as a field, so a call can reach it through a
// chain, mut w.out.write(s).
type Writer struct {
    out  Builder
    name string
}

// Doc holds a Writer and an array of points, for longer chains.
type Doc struct {
    pages [2]Point
    w     Writer
}

// makePoint returns a Point, a value no variable holds.
func makePoint(x int64, y int64) Point {
    return Point{x: x, y: y}
}

// pointAt returns a point at n, for a receiver whose evaluation shows.
func pointAt(n int64) Point {
    return Point{x: n, y: 0}
}

// next returns n and then adds one to it, so its calls show the order
// arguments are evaluated in.
func next(mut n int64) int64 {
    old := n
    n++
    return old
}

// fill writes s to the caller's builder, a mut parameter passed on as a
// mut receiver.
func fill(mut b Builder, s string) error {
    return mut b.write(s)
}

// size reads the caller's builder through a mut parameter, as a plain
// receiver.
func size(mut b Builder) int64 {
    return b.len()
}

// total reads a Counter of another package through its pub method.
func total(c strs.Counter) int64 {
    return c.Value()
}

// builds checks plain and mut methods on a local, a builder's lifetime
// through them, and methods named like builtins.
func builds() {
    mut b := newBuilder()
    check(b.len() == 0, "empty builder")
    err := mut b.write("hello")
    if err.code != 0 {
        check(false, "write")
        return
    }
    check(b.len() == 5 && b.equals("hello"), "write through a mut receiver")
    errA := mut b.append('!')
    if errA.code != 0 {
        check(false, "append method")
        return
    }
    check(b.equals("hello!") && len(b.buf) == 6, "methods named len and append")
    c, ok := b.at(1)
    check(c == 'e' && ok, "several results")
    _, past := b.at(6)
    check(!past, "several results past the end")
    l, errL := b.last()
    if errL.code == 0 {
        check(l == '!', "result beside an error")
    }
    check(b.count('l', 0) == 2 && count("hello", 'l') == 2, "recursion, and a function of the same name")
    errAll := mut b.writeAll(" ", "wor", "ld")
    if errAll.code == 0 {
        check(b.equals("hello! world"), "variadic method")
    }
    errNone := mut b.writeAll()
    if errNone.code == 0 {
        check(b.len() == 12, "variadic method with no values")
    }
    parts := [2]string{"!", "?"}
    errSpread := mut b.writeAll(parts[:]...)
    if errSpread.code == 0 {
        check(b.equals("hello! world!?"), "spread into a variadic method")
    }
    check(b.isInt(5) && !b.isInt("five"), "any parameter")
    check(b.allocated(), "a method calling an extern func")
}

// lines checks a defer in a method, and a method returning another's
// error.
func lines() {
    mut b := newBuilder()
    err := mut b.line("one")
    if err.code != 0 {
        check(false, "line")
        return
    }
    err2 := mut b.line("two")
    if err2.code == 0 {
        check(b.lines == 2 && b.equals("one\ntwo\n"), "defer in a method")
    }
    e := newBuilder()
    _, errE := e.last()
    check(errE.code == 1 && errE.msg == "empty", "error from a method")
}

// chains checks calls on fields, elements and mut parameters.
func chains() {
    mut w := Writer{out: newBuilder(), name: "w"}
    err := mut w.out.write("field")
    if err.code == 0 {
        check(w.out.equals("field") && w.out.len() == 5, "mut receiver through a field")
    }
    mut d := Doc{pages: [2]Point{makePoint(1, 2), makePoint(3, 4)}, w: Writer{out: newBuilder(), name: "d"}}
    errD := mut d.w.out.line("deep")
    if errD.code == 0 {
        check(d.w.out.lines == 1 && d.w.out.equals("deep\n"), "deep chain")
    }
    mut d.pages[1].scale(10)
    check(d.pages[1] == makePoint(30, 40) && d.pages[0].norm() == 3, "array element in a field")
    errF := fill(mut d.w.out, "+")
    if errF.code == 0 {
        check(size(mut d.w.out) == 6, "mut parameter passed on as a receiver")
    }
}

// Point is a struct holding no list, copied freely.
type Point struct {
    x int64
    y int64
}

// norm returns |x| + |y|.
func (p Point) norm() int64 {
    mut n int64 = 0
    if p.x < 0 {
        n -= p.x
    } else {
        n += p.x
    }
    if p.y < 0 {
        n -= p.y
    } else {
        n += p.y
    }
    return n
}

// scale multiplies p in place.
func (mut p Point) scale(k int64) {
    p.x *= k
    p.y *= k
}

// flip exchanges x and y, passing two fields of its receiver as mut.
func (mut p Point) flip() {
    swap(mut p.x, mut p.y)
}

// swap exchanges two integers.
func swap(mut a int64, mut b int64) {
    t := a
    a = b
    b = t
}

// digits returns x, a and b as a number with one digit each.
func (p Point) digits(a int64, b int64) int64 {
    return p.x * 100 + a * 10 + b
}

// peek sets q.x and returns what p.x was: a plain receiver is a copy.
func (p Point) peek(mut q Point) int64 {
    q.x = 100
    return p.x
}

// points checks plain values: temporaries, array elements and order.
func points() {
    check(makePoint(-3, 4).norm() == 7, "temporary receiver")
    check(Point{x: 1, y: 1}.norm() == 2, "literal receiver")
    mut ps := [3]Point{makePoint(1, 2), makePoint(3, 4), makePoint(5, 6)}
    for i := range ps {
        mut ps[i].scale(2)
    }
    mut ps[2].flip()
    check(ps[0] == makePoint(2, 4) && ps[2] == makePoint(12, 10), "array elements")
    check(ps[1].norm() == 14, "plain receiver of an element")
    mut k int64 = 1
    check(pointAt(k).digits(next(mut k), next(mut k)) == 112 && k == 3, "receiver first, then left to right")
    mut p := makePoint(7, 0)
    check(p.peek(mut p) == 7 && p.x == 100, "plain receiver copied before the call")
}

// packages checks methods of another package.
func packages() {
    mut c := strs.New(1)
    mut c.Add(2)
    mut c.Add(3)
    check(c.Value() == 6 && c.n == 6 && total(c) == 6, "pub methods of another package")
    check(c.Hits() == 2, "lib method in the module")
    check(strs.Peeked(9) == 9, "pub method of a private type")
    mut b := strs.NewBytes()
    err := mut b.Push('x')
    if err.code == 0 {
        x, ok := b.At(0)
        check(b.Len() == 1 && x == 'x' && ok, "a list of another package through its methods")
    }
}

func main() {
    check(live() == 0, "nothing live at the start")
    builds()
    freed("builds freed")
    lines()
    freed("lines freed")
    chains()
    freed("chains freed")
    points()
    packages()
    freed("packages freed")
    tallies()
    freed("tallies freed")
    mut b := newBuilder()
    b.show("%s %d", "forwarded", 42)
    check(b.len() == 0, "")
}
