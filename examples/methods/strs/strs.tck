package strs

// Package strs declares methods for the main package of examples/methods
// to call from another package: pub ones any package may call, a lib one
// only a package of this module may, and private ones only strs may.

// Counter counts what it is given: n is pub, hits is private.
pub type Counter struct {
    pub n int64
    hits  int64
}

// New returns a Counter holding n.
pub func New(n int64) Counter {
    return Counter{n: n, hits: 0}
}

// Add adds k to c, and counts the call through a private method.
pub func (mut c Counter) Add(k int64) {
    mut c.touch()
    c.n +%= k
}

// Value returns what c holds.
pub func (c Counter) Value() int64 {
    return c.n
}

// Hits returns how many times Add was called on c: lib, so only a package
// of module methods may call it.
lib func (c Counter) Hits() int64 {
    return c.hits
}

// touch counts one call of Add; private to strs.
func (mut c Counter) touch() {
    c.hits +%= 1
}

// Bytes owns a list of bytes, which another package grows only through
// its methods: data is private.
pub type Bytes struct {
    data list[uint8]
}

// NewBytes returns an empty Bytes.
pub func NewBytes() Bytes {
    return Bytes{data: make(list[uint8], c_allocator)}
}

// Push appends c, returning append's error.
pub func (mut b Bytes) Push(c uint8) error {
    return append(mut b.data, c)
}

// Len returns how many bytes b holds.
pub func (b Bytes) Len() int64 {
    return len(b.data)
}

// At returns the byte at i, and whether there is one.
pub func (b Bytes) At(i int64) (uint8, bool) {
    c, ok := b.data[i]
    return c, ok
}

// hidden is a private type: its pub method is capped at private, as a
// field of it would be, so it exposes nothing.
type hidden struct {
    v int64
}

// Peek returns h's value.
pub func (h hidden) Peek() int64 {
    return h.v
}

// Peeked returns what Peek gives for v, so hidden is used.
pub func Peeked(v int64) int64 {
    return hidden{v: v}.Peek()
}

// The wrapping operators in this file, +% -% *% and their compound
// forms, stand where nothing proves a value's bound but this program's
// own fixed data keeps it within its type, so none of them wraps; one
// that is meant to wrap says so where it is.
