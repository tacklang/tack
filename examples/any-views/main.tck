package main

import fmt from "std/fmt"
import text from "std/text"

// Views passed as any: a view of one of the twelve builtin types, []T,
// passes to an any parameter, and to printf's ...any, as it is. The any
// holds the view's type id and a pointer to the view, which points into
// the caller's elements, for the call only. A view parameter, a slice of
// a list, an array, a view or a string, a call returning a view and
// t.bytes() are each passed. printf writes a []uint8 for %s and %v as a
// string's bytes, and takes no other view; a type switch's case []T binds
// the view, under every rule a view parameter follows.

// check prints name and whether cond held.
func check(cond bool, name string) {
    print(name)
    if cond {
        print(" ok\n")
    } else {
        print(" FAIL\n")
    }
}

// mut grid is a mutable global array, which a call can change while a
// view of it is held, so a view of it passed as any is of a copy.
mut grid [3]uint8 = [3]uint8{'g', 'h', 'i'}

// show prints format with args, a format the compiler does not know, so
// each mistake in it is written into the output.
func show(format string, args ...any) {
    fmt.printf(format, args...)
}

// tail returns b past its first byte, a view result, or b itself when it
// is empty.
func tail(b []uint8) []uint8 {
    if len(b) == 0 {
        return b
    }
    return b[1:]
}

// passOn prints b, a view parameter, passed on as any.
func passOn(b []uint8) {
    fmt.printf("param %s|%v\n", b, b)
}

// depth passes a down n calls and prints it at the bottom.
func depth(n int64, a any) {
    if n == 0 {
        fmt.printf("bottom %s\n", a)
        return
    }
    depth(n - 1, a)
}

// describe names what a holds, binding each view case's v as that view:
// its length, a checked and a proven element, a range, a slice passed
// on and v passed on as any again.
func describe(a any) string {
    switch v := a.(type) {
    case []uint8:
        if len(v) == 0 {
            return "empty bytes"
        }
        first := v[0]
        mut n := 0
        for _, c := range v {
            if c == first {
                n++
            }
        }
        last, ok := v[len(v) - 1]
        if !ok {
            return "bytes FAIL"
        }
        fmt.printf("bytes %s, rest %s, first %c x%d, last %c\n", v, v[1:], first, n, last)
        fmt.write(v)
        print("\n")
        return "bytes"
    case []int64:
        mut sum := 0
        for _, x := range v {
            sum = sum + x
        }
        fmt.printf("int64s %d sum %d\n", len(v), sum)
        return "int64s"
    case []string:
        if len(v) > 0 {
            fmt.printf("strings %d first %s\n", len(v), v[0])
        }
        return "strings"
    case []bool, []int8:
        return "bools or int8s"
    case string:
        return "string"
    default:
        return "other"
    }
}

// changeThenShow sets the array x, then prints a, which was copied when
// the call began, so the change does not show in it.
func changeThenShow(mut x [3]uint8, a any) {
    x[0] = 'X'
    fmt.printf("copied %s\n", a)
}

// changeGridThenShow sets grid, then prints a, a view of a copy of it
// taken when the call began.
func changeGridThenShow(a any) {
    grid[0] = 'G'
    fmt.printf("global %s\n", a)
}

// first returns its view parameter whole, a view result.
func first(b []uint8) []uint8 {
    return b
}

// texts prints a std/text Text's bytes, a view result, as %s.
func texts() {
    name, err := text.from_bytes([]uint8("lookup"), c_allocator)
    if err.code != 0 {
        check(false, "from_bytes")
        return
    }
    fmt.printf("undefined: %s\n", name.bytes())
    fmt.printf("%v has %d bytes\n", name.bytes(), name.len())
    check(describe(name.bytes()) == "bytes", "a Text's bytes in a type switch")
}

// sources passes views from every source printf takes: a list, an array,
// slices of each, a slice of a string's bytes, view results and a view
// parameter.
func sources() {
    mut l := make(list[uint8], c_allocator)
    e := append(mut l, 'a', 'b', 'c', 'd')
    if e.code != 0 {
        check(false, "append")
        return
    }
    a := [3]uint8{'x', 'y', 'z'}
    fmt.printf("list %s array %s\n", l[:], a[:])
    fmt.printf("slices %s %s %v\n", l[1:3], a[2:], l[0:0])
    fmt.printf("results %s %s\n", tail(l), first(a))
    fmt.printf("nested %s\n", tail(tail(tail(l))))
    passOn(l)
    passOn(a)
    passOn(l[2:])
    depth(3, l[:2])
    s := "string bytes"
    passOn([]uint8(s))
    empty := make(list[uint8], c_allocator)
    fmt.printf("empty [%s] [%v]\n", empty[:], tail(empty))
    zeros := [2]uint8{0, 255}
    fmt.printf("raw %s\n", zeros[:])
}

// mixed passes views beside values of other types in one call.
func mixed() {
    mut nums := make(list[int64], c_allocator)
    e := append(mut nums, -9223372036854775808, 9223372036854775807, 1)
    if e.code != 0 {
        check(false, "append nums")
        return
    }
    words := [2]string{"alpha", "beta"}
    bools := [1]bool{true}
    b := [2]uint8{'o', 'k'}
    check(describe(b[:]) == "bytes", "a []uint8 case")
    check(describe(nums[:]) == "int64s", "a []int64 case")
    check(describe(words[:]) == "strings", "a []string case")
    check(describe(bools[:]) == "bools or int8s", "a case naming two views")
    check(describe(b[0:0]) == "empty bytes", "an empty view")
    check(describe("s") == "string", "a string beside view cases")
    check(describe(1) == "other", "an int64 in the default")
    show("%v %s %d\n", b[:], b[:], 7)
    show("%v\n", nums[:])
    show("%d %x %c %t\n", b[:], b[:], b[:], b[:])
    show("%s\n", words[:])
    show("extra\n", b[:], nums[:], 3)
    print("\n")
}

// copies checks a view passed as any is of the array as the call began,
// when the call changes the array: a mut argument beside it, or a
// mutable global.
func copies() {
    mut x := [3]uint8{'a', 'b', 'c'}
    changeThenShow(mut x, x[:])
    check(x[0] == 'X', "the mut argument was changed")
    changeGridThenShow(grid[:])
    check(grid[0] == 'G', "the global was changed")
}

func main() {
    texts()
    sources()
    mixed()
    copies()
}
