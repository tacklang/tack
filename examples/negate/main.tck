package main

var smallest = -9223372036854775808

func abs(n int64) int64 {
    if n < 0 {
        return -n
    }
    return n
}

func main() {
    if smallest + 9223372036854775807 != -1 {
        exit(1)
    }
    // Negating the smallest int64 wraps to itself, so its absolute value
    // is itself.
    if abs(smallest) != smallest {
        exit(2)
    }
    exit(abs(-20) + abs(3) - -(-4))
}
