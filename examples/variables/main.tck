package main

func square(n int64) int64 {
    r := n * n
    return r
}

func main() {
    greeting := "variables"
    print(greeting)
    print("\n")

    var base int64 = 3
    var step = 4
    mut total := square(base)
    total = total + square(step)

    mut label string
    if total == 25 {
        label = "five squared"
    } else {
        label = "something else"
    }
    print(label)
    print("\n")

    mut count int64
    count = count + 1
    done := count == 1
    if done {
        code, ok := int32(total)
        if !ok {
            exit(1)
        }
        exit(code)
    }
}
