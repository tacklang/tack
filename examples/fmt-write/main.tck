package main

import fmt from "std/fmt"

// Writing bytes with std/fmt's write: a list[uint8] built with append, an
// array, a slice of each, a string's bytes, an empty list, an empty array
// and an empty string, bytes 0x00 and 0xff, a view passed on through a
// Tack function and from a mut parameter, and writes interleaved with
// print and printf, which go through the same stdout, so the output is in
// call order. Last, a list of 1 MiB, whose bytes the test checks rather
// than a golden: byte i of it is i % 251.

// bytesOf appends every byte of s to l and reports whether all fit.
func bytesOf(mut l list[uint8], s string) bool {
    err := append(mut l, []uint8(s)...)
    return err.code == 0
}

// pass writes b, a view it was given, on through write.
func pass(b []uint8) {
    fmt.write(b)
}

// grow appends c to l, then writes the whole list, from a mut parameter.
func grow(mut l list[uint8], c uint8) {
    err := append(mut l, c)
    if err.code != 0 {
        print("append failed\n")
        return
    }
    fmt.write(l)
}

// big writes a list of n bytes, byte i being i % 251.
func big(n int64) {
    mut l := make(list[uint8], c_allocator)
    err := reserve(mut l, n)
    if err.code != 0 {
        print("reserve failed\n")
        return
    }
    for i := range n {
        v, ok := uint8(i % 251)
        if !ok {
            print("conversion failed\n")
            return
        }
        e := append(mut l, v)
        if e.code != 0 {
            print("append failed\n")
            return
        }
    }
    fmt.write(l)
}

func main() {
    mut l := make(list[uint8], c_allocator)
    if !bytesOf(mut l, "list") {
        print("append failed\n")
    }
    e := append(mut l, '\n')
    if e.code != 0 {
        print("append failed\n")
    }
    fmt.write(l)

    a := [6]uint8{'a', 'r', 'r', 'a', 'y', '\n'}
    fmt.write(a)
    fmt.write(a[1:3])
    fmt.write(a[5:])
    if len(l) >= 5 {
        fmt.write(l[1:3])
        fmt.write(l[4:])
    }
    fmt.write([]uint8("string bytes\n"))

    empty := make(list[uint8], c_allocator)
    fmt.write(empty)
    none := [0]uint8{}
    fmt.write(none)
    fmt.write([]uint8(""))
    fmt.write(a[2:2])
    if len(l) >= 5 {
        fmt.write(l[5:])
    }
    print("empties wrote nothing\n")

    raw := [6]uint8{0, 255, 0, 128, 255, '\n'}
    fmt.write(raw)
    fmt.write([]uint8("a\x00b\xffc\n"))

    pass(a)
    pass([]uint8("passed\n"))
    mut g := make(list[uint8], c_allocator)
    grow(mut g, 'x')
    grow(mut g, '\n')

    print("1 ")
    fmt.write([]uint8("2 "))
    fmt.printf("%d ", 3)
    fmt.write(a[5:])
    fmt.printf("%s", "4")
    fmt.write([]uint8(" 5"))
    print(" 6\n")

    big(1048576)
}
