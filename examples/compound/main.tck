package main

mut calls int

func sumTo(n int) int {
    calls += 1
    mut i = 0
    mut sum = 0
    for i < n {
        i += 1
        sum += i
    }
    return sum
}

func main() {
    mut x = sumTo(10)
    x -= 13
    x *= 2
    x /= 7
    x %= 100
    x += calls
    x++
    x++
    x--
    exit(x)
}
