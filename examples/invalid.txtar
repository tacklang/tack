    return true
}

// A false && is i < 0, or i >= 0 with ready() false, which gives no
// fact, so that side never contradicts i in [0, 4].
func f(n int64) int64 {
    i := n
    if i < 0 || i > 4 {
        return -1
    }
    if i >= 0 && ready() {
        return i
    } else {
        unreachable
