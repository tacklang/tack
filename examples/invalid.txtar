package main

// fixb makes d nonzero and reports whether it was zero.
func fixb(mut d int64) bool ensures d != 0 {
    was := d == 0
    if d == 0 {
        d = 1
    }
    if d == 0 {
        exit(2)
    }
    return was
}

func zero(mut d int64) bool {
    d = 0
    return true
}

