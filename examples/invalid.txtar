package main

// use takes a value.
func use(x int64) {
}

// A write after an early exit ends what it proved, as it would after a
// return: a divisor assigned, a key deleted, a list popped.
func f(mut d int64, mut m map[int64]int64, k int64, mut l list[int64]) {
    if d == 0 {
        exit(1)
    }
    d = 0
    use(10 / d)
    if !has(m, k) {
        exit(2)
    }
    delete(mut m, k)
    use(m[k])
    if len(l) == 0 {
        exit(3)
    }
    x := pop(mut l)
    y := pop(mut l)
    use(x +% y)
}

