    mut l := make(list[int64], c_allocator)
    err := append(mut l, 1)
    if err.code != 0 {
        return l, err
    }
    return l, noerror
}

func size(l list[int64]) int64 {
    return len(l)
}

// The list numbers()? gives is held by no variable, so it cannot be lent
// to a plain parameter, as a call's cannot.
func f() (int64, error) {
    return size(numbers()?), noerror
}

func main() {
    n, err := f()
    if err.code == 0 {
        if n > 0 {
            exit(1)
        }
    }
}
