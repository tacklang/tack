-- relation-loop-moves/main.tck --
package main

// A binary search whose loop does not restate its bounds: the body moves
// lo and hi, which ends what was known of them before the loop.
func find(a []int64, x int64) int64 {
    mut lo int64 = 0
    mut hi := len(a)
    for lo < hi {
        mid := lo +% (hi -% lo) / 2
        if a[mid] < x {
            lo = mid +% 1
        } else {
            hi = mid
        }
    }
    return lo
}

func main() {
}
