-- closure-captures-mut-int-arg/main.tck --
package main

// Assumption: a closure reads a capture by reference, not as a copy taken
// at the call, so a read capture of x beside mut x is the conflict of
// passing x twice even for a copyable x, unlike f(mut x, x), whose plain
// argument is a copy.

func set(mut n int64, scope f func() int64) {
    n = f()
}

func main() {
    mut x := 1
    set(mut x, func() int64 { return x }) // ERROR
    if x == 1 {
        print("x")
    }
}
