-- index-borrow-element-method/main.tck --
package main

func grow(mut l list[int64]) int64 {
    err := append(mut l, 1)
    if err.code != 0 {
        return 0
    }
    return 1
}

type Stack struct {
    items list[int64]
}

func (mut s Stack) push() int64 {
    return grow(mut s.items)
}

func main() {
