// Only a variable passed by name carries a fact: a field, an element
// and an expression do not.
func run(p P, a [2]int64, i int64) {
    nonzero(p.x)
    nonzero(a[0])
    nonzero(i + 0)
    use(10 / p.x + 10 / a[0] + 10 / i)
