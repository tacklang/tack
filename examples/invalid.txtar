-- fallthrough-continue-reaches-loop/main.tck --
package main

// The case assigning d leaves through the continue of the case it falls
// into, which goes back to the division at the top of the loop.
func f(n int64, c int64) int64 {
    mut d := n
    if d == 0 {
        return 0
    }
    mut r := 0
    for r < 100 {
        r = r +% 100 / d
        switch {
        case c == 1:
            d = 0
            fallthrough
        case c == 2:
            continue
        }
        return r
    }
    return r
}

func main() {
    code, fits := int32(f(5, 3))
    if fits { exit(code) }
}
