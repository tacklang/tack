-- assignment-mismatch-count/main.tck --
package main

func divmod(a int64, b int64) (int64, int64) {
    if b == 0 {
        return 0, 0
    }
    return a / b, a % b
}

func main() {
    q, r, s := divmod(7, 2)
    exit(q + r + s)
}
