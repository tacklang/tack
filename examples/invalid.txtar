-- method-expr-value-no-contract/main.tck --
package main

type Pair struct {
    a int64
    b int64
}

func (p Pair) within(i int64) ensures 0 <= i && i < 2 {
    if i < 0 || i >= 2 {
        exit(1)
    }
}

// A function type states no contract: called through a value, the
// method's ensures does not hold after the call, as it does after
// Pair.within(p, i) and p.within(i).
func pick(p Pair, i int64) int64 {
    f := Pair.within
    f(p, i)
    both := [2]int64{p.a, p.b}
    return both[i]
}

func main() {
    if pick(Pair{a: 1, b: 2}, 1) == 2 {
        print("two")
    }
}
