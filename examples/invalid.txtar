package main

// parse returns n, or error 1 when n is negative.
func parse(n int64) (int64, error) {
    if n < 0 {
        return 0, error{code: 1, msg: "negative"}
    }
    return n, noerror
}

// v + 1 reads v, so passing the sum on beside err is no pass-through.
func next(n int64) (int64, error) {
    v, err := parse(n)
    return v +% 1, err
}

