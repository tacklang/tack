-- error-pass-on-other-error/main.tck --
package main

// parse returns n, or error 1 when n is negative.
func parse(n int64) (int64, error) {
    if n < 0 {
        return 0, error{code: 1, msg: "negative"}
    }
    return n, noerror
}

// other is not the error that holds v.
func pick(n int64) (int64, error) {
    v, err := parse(n)
    _, other := parse(1)
    if other.code != 0 {
        return 0, other
    }
    if err.code > 5 {
        return 0, err
    }
    return v, other
}

func main() {
