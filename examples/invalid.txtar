package main

func grow(mut l list[int64]) int64 {
    err := append(mut l, 1)
    if err.code != 0 {
        return 0
    }
    return 1
}

func sum(v []int64) int64 {
    mut t int64 = 0
    for _, x := range v {
        t += x
    }
    return t
}

