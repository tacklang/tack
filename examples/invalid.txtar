package main

// A heap's child index: 2 * r + 1 is no node plus a known amount, and it
// can wrap besides.
func child(a []int64, r int64, end int64) int64 {
    if 0 <= r && r < end && end <= len(a) {
        c := 2 *% r +% 1
        if c < end {
            return a[c]
        }
    }
    return -1
}

