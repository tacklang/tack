-- error-pass-on-noerror/main.tck --
package main

// parse returns n, or error 1 when n is negative.
func parse(n int64) (int64, error) {
    if n < 0 {
        return 0, error{code: 1, msg: "negative"}
    }
    return n, noerror
}

// noerror is not the error that holds v, so the caller could read v
// without a check.
func launder(n int64) (int64, error) {
    v, err := parse(n)
    if err.code > 5 {
        return 0, err
    }
    return v, noerror
}

func main() {
}
