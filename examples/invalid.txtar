-- remove-guard-ends-at-remove/main.tck --
package main

func take(mut l list[int64], i int64) int64 {
    if 0 <= i && i < len(l) {
        x := remove(mut l, i)
        return x + remove(mut l, i)
    }
    return 0
}

func main() {
    mut l := make(list[int64], c_allocator)
    if take(mut l, 0) > 0 {
        print("y")
