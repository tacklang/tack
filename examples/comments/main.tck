// A comment before the package clause.
// Two lines of it.
package main // after the package clause

// limit is a package-level variable.
var limit int64 = 5 // after a package-level variable

mut calls int64 // a mutable one

// pair returns two values; the comment sits inside its result list.
func pair(a int64, // after a parameter
    b int64) (int64, // after the first result type
    int64) {
    // first thing in a body
    calls++ // after an increment
    return a, // after the first returned value
        b
}

func sum(xs [4]int64) int64 { // after an opening brace
    mut total := 0 // after a short declaration
    for _, x := range xs { // after a range header
        total += x // after a compound assignment
    } // after a closing brace
    return total // after a return
}

// main checks each statement form still works with comments around it.
// Each failed check exits with its own status; success exits 37.
func main() {
    // before the first statement

    x := 1 + // after a binary operator
        2 * // after another
        3
    if x != 7 { // after an if header
        exit(1) // after a call
    }

    a, b := pair( // after an opening parenthesis
        10, // after an argument
        20)
    if a + b != 30 || calls != 1 {
        exit(2)
    }

    xs := [4]int64{ // after an opening brace of a literal
        1, // one
        2,
        // between elements
        3,
        4, // four
    }
    if sum(xs) != 10 {
        exit(3)
    }

    mut n = 0 // after a mut declaration
    var m int64 = 3 // after a var declaration
    n = m // after an assignment
    for mut i := 0; i < limit; i++ { // after a three-clause header
        if i == 1 { // after a nested if
            continue // after continue
        } else if i == 4 { // after else if
            break // after break
        } else { // after else
            n++
        }
    }
    if n != 6 {
        exit(4)
    }

    mut loops = 0
    for { // after an infinite loop header
        loops++
        if loops == 3 &&
            // inside a condition that spans lines
            n == 6 {
            break
        }
    }
    for loops > 0 { // after a condition-only header
        loops--
    }
    if loops != 0 {
        exit(5)
    }

    exit(x + a + b - n + 6) // 7 + 10 + 20 - 6 + 6 = 37
}
// A comment at the end of the file, with no newline after it.