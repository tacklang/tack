06 |	    mut t.errorf("%d is not %s", "seven", 7)
   |	                                 ^~~~~~~
07 |	    return noerror

errorf-format/errorf_test.tck:6:43: error: errorf verb %s does not take int64
05 |	func test_format(mut t testing.T) error {
06 |	    mut t.errorf("%d is not %s", "seven", 7)
   |	                                          ^
07 |	    return noerror

