package main

type Point struct {
    x int64
    y int64
}

type Shape struct {
    pts  [2]Point
    grid [2][2]int64
}

// check prints name and whether cond held.
func check(cond bool, name string) {
    print(name)
    if cond {
        print(" ok\n")
    } else {
        print(" FAIL\n")
    }
}

// exchange swaps two integers.
func exchange(mut a int64, mut b int64) {
    t := a
    a = b
    b = t
}

// swapPoints exchanges two points.
func swapPoints(mut a Point, mut b Point) {
    t := a
    a = b
    b = t
}

// scaleBy multiplies p by q, field by field, reading q.x after p.x has
// changed: q is a copy, so it still holds what p held before the call.
func scaleBy(mut p Point, q Point) {
    p.x = p.x *% q.x
    p.y = p.y *% q.x
}

// addTo adds n to both of p's fields.
func addTo(mut p Point, n int64) {
    p.x +%= n
    p.y +%= n
}

// double doubles p.x and returns the new value.
func double(mut p Point) int64 {
    p.x *%= 2
    return p.x
}

// swapEnds swaps the elements at i and j, which the guard keeps in
// different halves of a, so they are known to differ.
func swapEnds(mut a [4]int64, i int64, j int64) {
    if 0 <= i && i < 2 && 2 <= j && j < 4 {
        exchange(mut a[i], mut a[j])
    }
}

// mirror swaps a point's fields, and passes the parameter's own parts on.
func mirror(mut p Point) {
    exchange(mut p.x, mut p.y)
}

func main() {
    mut p := Point{x: 1, y: 2}
    exchange(mut p.x, mut p.y)
    check(p.x == 2 && p.y == 1, "fields of one struct")

    mirror(mut p)
    check(p.x == 1 && p.y == 2, "fields of a mut parameter")

    mut a := [4]int64{1, 2, 3, 4}
    exchange(mut a[0], mut a[3])
    check(a == [4]int64{4, 2, 3, 1}, "elements at known indexes")

    swapEnds(mut a, 1, 2)
    check(a == [4]int64{4, 3, 2, 1}, "elements at indexes proven apart")

    mut s Shape
    s.pts[0] = Point{x: 5, y: 6}
    s.pts[1] = Point{x: 7, y: 8}
    exchange(mut s.pts[0].x, mut s.pts[1].y)
    check(s.pts[0].x == 8 && s.pts[1].y == 5, "nested paths")

    swapPoints(mut s.pts[0], mut s.pts[1])
    check(s.pts[0] == Point{x: 7, y: 5} && s.pts[1] == Point{x: 8, y: 6}, "elements of a field")

    s.grid[0][1] = 1
    s.grid[1][0] = 2
    exchange(mut s.grid[0][1], mut s.grid[1][0])
    check(s.grid[0][1] == 2 && s.grid[1][0] == 1, "two-level elements")

    for i := range s.pts {
        exchange(mut s.pts[i].x, mut s.pts[1].y)
    }
    check(s.pts[0] == Point{x: 6, y: 5} && s.pts[1] == Point{x: 7, y: 8}, "different fields of elements at unknown indexes")

    mut b := Point{x: 3, y: 4}
    scaleBy(mut b, b)
    check(b.x == 9 && b.y == 12, "overlapping plain argument copied")

    addTo(mut b, b.x)
    check(b.x == 18 && b.y == 21, "field of the mut place as a plain argument")

    mut c := Point{x: 1, y: 1}
    addTo(mut c, double(mut c))
    check(c.x == 4 && c.y == 3, "inner call changes the place first")

    mut d := Point{x: 1, y: 0}
    exchange(mut d.y, mut c.x)
    check(d.y == 4 && c.x == 0, "two variables")
}

// The wrapping operators in this file, +% -% *% and their compound
// forms, stand where nothing proves a value's bound but this program's
// own fixed data keeps it within its type, so none of them wraps; one
// that is meant to wrap says so where it is.
