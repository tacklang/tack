-- unused-stmt-generic/main.tck --
package main

type Counted interface {
    count() int32
}

type S struct {
    n int32
}

func (s S) count() int32 {
    return s.n
}

func g[C Counted](c C) {
    int64(c.count())
}

func main() {
    g(S{n: 1})
}
