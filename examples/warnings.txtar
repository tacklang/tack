Example programs the compiler accepts with warnings, one case per
program, in byte order of name.

Each case is a txtar file pair: <name>/main.tck holds the program and
<name>/expected the warnings the compiler gives it, with the program's
path printed as <name>/main.tck. An empty <name>/no-final-newline file
after the pair means the program's last line has no newline. The format
is invalid.txtar's, which internal/invalid documents; go test ./test -run
TestWarnings checks that every case compiles with exactly its warnings,
and -update rewrites the expected sections.

-- any-switch-unused-binding/main.tck --
package main

func f(a any) int64 {
    switch v := a.(type) {
    case int64:
        return 1
    default:
        return 0
    }
}

func main() {
}
-- any-switch-unused-binding/expected --

any-switch-unused-binding/main.tck:4:12: warning: declared and not used: v
03 |	func f(a any) int64 {
04 |	    switch v := a.(type) {
   |	           ^
05 |	    case int64:

-- func-value-hidden-unused/main.tck --
package main

func step(x int64) int64 {
    return x + 1
}

func run(fs [2]func(int64) int64) int64 {
    mut v := 0
    for _, step := range fs {
        v = step(v)
    }
    return v
}

func main() {
    if run([2]func(int64) int64{step, step}) == 2 {
        print("two")
    }
}
-- func-value-hidden-unused/expected --

func-value-hidden-unused/main.tck:9:12: warning: declared and not used: step
08 |	    mut v := 0
09 |	    for _, step := range fs {
   |	           ^~~~
10 |	        v = step(v)
func-value-hidden-unused/main.tck:10:13: note: this call calls the function step, not the variable; rename one of them
09 |	    for _, step := range fs {
10 |	        v = step(v)
   |	            ^~~~
11 |	    }

