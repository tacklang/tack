package main

// Slicing, x[i:j], x[:j], x[i:] and x[:]. A string slices to a string, its
// bytes from i up to j, which may be stored anywhere; an array or a view
// slices to a view, which is passed to a view parameter or to len. Every
// bound is proven, 0 <= i <= j <= len(x), or a string is sliced with the
// checked form, t, ok := s[i:j], which gives "" and false out of range.

type Token struct {
    text string
    kind int64
}

type Shelf struct {
    items [5]int64
    name  string
}

// greeting is a slice of a known string, computed at compile time.
var greeting = "hello"[1:4]

// greetingLen is the length of greeting, a known value.
var greetingLen = len(greeting)

// table is a mutable global array, which a callee could change during a
// call that views a slice of it, so the view is of a copy.
mut table [4]int64

// trace records the order calls run in, one digit per call.
mut trace int64

// check prints name and whether cond held.
func check(cond bool, name string) {
    print(name)
    if cond {
        print(" ok\n")
    } else {
        print(" FAIL\n")
    }
}

// sum adds every element of v.
func sum(v []int64) int64 {
    mut total int64 = 0
    for _, x := range v {
        total +%= x
    }
    return total
}

// first returns v[0], or -1 for an empty view.
func first(v []int64) int64 {
    x, ok := v[0]
    if !ok {
        return -1
    }
    return x
}

// count returns how many bytes of b are c.
func count(b []uint8, c uint8) int64 {
    mut n int64 = 0
    for _, x := range b {
        if x == c {
            n +%= 1
        }
    }
    return n
}

// word returns the second word of "hello, world", a slice returned as a
// result.
func word() string {
    s := "hello, world"
    return s[7:]
}

// tail returns s without its first byte, proven by the early exit on its
// length, or s itself when it is empty.
func tail(s string) string {
    if len(s) == 0 {
        return s
    }
    return s[1:]
}

// prefix returns s[:n] where the guard proves it, and "?" otherwise.
func prefix(s string, n int64) string {
    if 0 <= n && n <= len(s) {
        return s[:n]
    }
    return "?"
}

// between returns s[i:j] where the guard proves both bounds and their
// order, and "?" otherwise.
func between(s string, i int64, j int64) string {
    if 0 <= i && i <= j && j <= len(s) {
        return s[i:j]
    }
    return "?"
}

// checked slices s with the checked form.
func checked(s string, i int64, j int64) (string, bool) {
    t, ok := s[i:j]
    return t, ok
}

// checkedU slices s with uint64 bounds and the checked form.
func checkedU(s string, i uint64, j uint64) (string, bool) {
    t, ok := s[i:j]
    return t, ok
}

// checkedFrom slices s from i to its end with the checked form, assigned.
func checkedFrom(s string, i int8) (string, bool) {
    mut t string
    mut ok bool
    t, ok = s[i:]
    return t, ok
}

// checkedTo slices s from its start to j with the checked form.
func checkedTo(s string, j int64) (string, bool) {
    t, ok := s[:j]
    return t, ok
}

// prefixSums adds the sum of every proper prefix of v, v[:i] proven by the
// counting loop.
func prefixSums(v []int64) int64 {
    mut total int64 = 0
    for mut i := 0; i < len(v); i++ {
        total +%= sum(v[:i])
    }
    return total
}

// suffixSums adds the sum of every non-empty suffix of v, v[i:] proven by
// the range loop.
func suffixSums(v []int64) int64 {
    mut total int64 = 0
    for i := range v {
        total +%= sum(v[i:])
    }
    return total
}

// dropFirst sums v without its first element, a slice of a view passed
// on, proven by the early exit on its length.
func dropFirst(v []int64) int64 {
    if len(v) == 0 {
        return 0
    }
    return sum(v[1:])
}

// sizedPrefix sums the first n elements of v, an unsafe_size_t bound
// proven by the guard.
func sizedPrefix(v []int64, n unsafe_size_t) int64 {
    if n <= len(v) {
        return sum(v[:n])
    }
    return -1
}

// lenFrom returns the length of v[i:], or -1.
func lenFrom(v []int64, i int64) int64 {
    if 0 <= i && i <= len(v) {
        return len(v[i:])
    }
    return -1
}

// viaMut changes the caller's array through a, then views slices of it.
func viaMut(mut a [3]int64) int64 {
    a[0] = 7
    return sum(a[1:]) +% first(a[:1])
}

// writeThenRead writes the caller's array through a, then reads v, which
// the caller passed a slice of the same array to: v is of a copy taken at
// the call.
func writeThenRead(mut a [3]int64, v []int64) int64 {
    a[1] = 100
    if len(v) < 2 {
        return -1
    }
    return first(v[1:])
}

// changeTable changes the global table, then reads v, which the caller
// passed a slice of table to: v is of a copy taken at the call.
func changeTable(v []int64) int64 {
    table[1] = 50
    return first(v)
}

// step appends d to trace and returns r.
func step(d int64, r int64) int64 {
    trace = trace *% 10 +% d
    return r
}

// named appends d to trace and returns "abcdef".
func named(d int64) string {
    trace = trace *% 10 +% d
    return "abcdef"
}

func main() {
    s := "hello, world"
    check(s[0:5] == "hello" && s[7:] == "world" && s[:5] == "hello", "string slices")
    check(s[:] == s && s[5:5] == "" && s[12:] == "" && s[:0] == "", "omitted and empty bounds")
    check(s[7:][1:3] == "or" && s[:5][1:][1:] == "llo", "slices of slices")

    t := Token{text: s[7:], kind: 2}
    parts := [2]string{s[:5], s[7:]}
    mut kept string
    kept = s[5:7]
    check(t.text == "world" && parts[0] == "hello" && parts[1] == "world" && kept == ", ",
        "stored in a field, an array and a variable")
    check(word() == "world" && tail("abc") == "bc" && tail("") == "", "results")

    e := "café!"
    check(len(e) == 6 && e[3:5] == "é" && e[:4] == "caf\xc3" && len(e[4:]) == 2,
        "bytes through a multi-byte character")

    mut z string
    mut zt Token
    check(z[:] == "" && z[0:0] == "" && zt.text[:] == "" && zt.text[0:0] == "", "zero strings")
    zs, zok := checked(zt.text, 0, 1)
    check(zs == "" && !zok, "zero string field checked")

    k := "abcdef"[1:4]
    mut buf [len(k)]int64
    buf[2] = 1
    check(k[2] == 'd' && len(buf) == 3 && len(k) == 3 && buf[2] == 1, "known slice of a known string")
    check(greeting == "ell" && greetingLen == 3, "globals")
    check(count([]uint8(s[7:]), 'o') == 1 && count([]uint8(s[:5]), 'l') == 2, "bytes of a slice")

    check(prefix(s, 5) == "hello" && prefix(s, 12) == s && prefix(s, 13) == "?" &&
        prefix(s, -1) == "?", "guard on the high bound")
    check(between(s, 7, 12) == "world" && between(s, 3, 2) == "?" && between(s, 0, 13) == "?" &&
        between(s, 4, 4) == "", "guard on both bounds")

    a, ok := checked("hello", 1, 3)
    check(a == "el" && ok, "checked in range")
    b, okB := checked("hello", 3, 1)
    c, okC := checked("hello", 2, 9)
    d, okD := checked("hello", -1, 2)
    check(b == "" && !okB && c == "" && !okC && d == "" && !okD, "checked out of range")
    u, okU := checkedU("hello", 0, 18446744073709551615)
    v, okV := checkedU("hello", 18446744073709551615, 2)
    w, okW := checkedU("hello", 2, 5)
    check(u == "" && !okU && v == "" && !okV && w == "llo" && okW, "checked uint64 bounds")
    f, okF := checkedFrom("hello", 3)
    g, okG := checkedFrom("hello", -2)
    h, okH := checkedTo("hello", 5)
    check(f == "lo" && okF && g == "" && !okG && h == "hello" && okH, "checked omitted bounds")

    nums := [5]int64{1, 2, 3, 4, 5}
    check(sum(nums[1:4]) == 9 && sum(nums[:]) == 15 && sum(nums[:0]) == 0 &&
        sum(nums[5:]) == 0, "array slices")
    check(first(nums[2:]) == 3 && first(nums[5:]) == -1 && len(nums[1:4]) == 3, "array slice ends")
    check(prefixSums(nums) == 20 && suffixSums(nums) == 55, "slices proven by loops")
    check(dropFirst(nums[1:]) == 12 && dropFirst(nums[:0]) == 0, "slice of a view passed on")
    check(sizedPrefix(nums, 2) == 3 && sizedPrefix(nums[3:], 3) == -1, "unsafe_size_t bound")
    check(lenFrom(nums[1:], 1) == 3 && lenFrom(nums, 6) == -1, "len of a view slice")

    mut shelf Shelf
    shelf.items[1] = 10
    shelf.items[2] = 20
    grid := [2][3]int64{{1, 2, 3}, {4, 5, 6}}
    check(sum(shelf.items[1:3]) == 30 && sum(grid[1][0:2]) == 9, "field and element arrays")

    mut m := [3]int64{1, 2, 3}
    check(viaMut(mut m) == 12 && m[0] == 7, "mut parameter's array")

    mut over := [3]int64{1, 2, 3}
    check(writeThenRead(mut over, over[0:2]) == 2 && over[1] == 100,
        "slice alongside mut of the same array")

    table = [4]int64{1, 2, 3, 4}
    check(changeTable(table[1:]) == 2 && table[1] == 50, "mutable global array")

    trace = 0
    x, okX := named(1)[step(2, 1):step(3, 4)]
    check(x == "bcd" && okX && trace == 123, "evaluation order")
}

// The wrapping operators in this file, +% -% *% and their compound
// forms, stand where nothing proves a value's bound but this program's
// own fixed data keeps it within its type, so none of them wraps; one
// that is meant to wrap says so where it is.
