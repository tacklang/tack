package main

// log records the order things run in, one decimal digit per step.
mut log int64

// mark appends the digit d to log.
func mark(d int64) {
    log = log * 10 + d
}

// expect exits with code unless log is want, then clears log.
func expect(want int64, code int64) {
    if log != want {
        exit(code)
    }
    log = 0
}

// clauses runs its body's defer at the end of every iteration, including
// one ended by continue or break, before the post statement: the defer
// reads i before i++ changes it.
func clauses() {
    for mut i := 1; i < 9; i++ {
        defer { mark(i) }
        if i == 2 {
            continue
        }
        if i == 3 {
            defer { mark(8) }
            break
        }
        mark(9)
    }
    mark(5)
}

// cases runs a case's defer when the case body ends, and a break in a case
// leaves the loop through the case's defers and the loop body's.
func cases() {
    for i := range 3 {
        defer { mark(1) }
        switch i {
        case 1:
            defer { mark(2) }
            break
        default:
            defer { mark(4) }
        }
        mark(3)
    }
}

// deep leaves three nested loops with one break, running only the defers
// of the innermost loop's body and the blocks inside it.
func deep() {
    for range 1 {
        defer { mark(1) }
        for range 1 {
            defer { mark(2) }
            for range 2 {
                defer { mark(3) }
                if true {
                    defer { mark(4) }
                    break
                }
            }
            mark(5)
        }
    }
}

// loopInDefer defers a block holding a loop that breaks and continues on
// its own.
func loopInDefer() {
    defer {
        for mut i := 1; ; i++ {
            if i == 2 {
                continue
            }
            if i == 5 {
                break
            }
            mark(i)
        }
    }
    mark(9)
}

// counted defers an increment and compound assignments that do not
// commute, so the result shows each iteration runs them last first: add i,
// add one, then multiply by ten.
func counted() int64 {
    mut n := 0
    for i := range 3 {
        defer { n *= 10 }
        defer { n++ }
        defer { n += i }
    }
    return n
}

// exits leaves a loop body holding a defer by a return on one call and by
// a break on another, running the body's defer either way, then the
// function's.
func exits(n int64) int64 {
    defer { mark(1) }
    for i := range 5 {
        defer { mark(2) }
        if i == n {
            return i
        }
        if i == 2 {
            break
        }
        mark(3)
    }
    mark(4)
    return 9
}

// skip continues out of a nested block with a defer of its own, inside a
// loop body with a defer. The next iterations run their whole body, and
// leave another nested block by falling off its end, not by continuing.
func skip() {
    for i := range 3 {
        defer { mark(1) }
        if i == 0 {
            defer { mark(2) }
            continue
        }
        if i >= 1 {
            defer { mark(5) }
        }
        mark(3)
    }
    mark(4)
}

// inner returns from an inner loop nested in an outer loop, both with body
// defers: the inner body's defer runs, then the outer body's, then the
// function's.
func inner(n int64) int64 {
    defer { mark(1) }
    for i := range 3 {
        defer { mark(2) }
        for j := range 3 {
            defer { mark(3) }
            if i * 3 + j == n {
                return i * 10 + j
            }
            mark(4)
        }
        mark(5)
    }
    return 99
}

// many runs one defer per iteration of a range loop over an array, with
// the element value the iteration sees.
func many() {
    for _, d := range [4]int64{4, 3, 2, 1} {
        defer { mark(d) }
        mark(0)
    }
}

func main() {
    clauses()
    expect(912835, 1)
    cases()
    expect(43121, 2)
    deep()
    expect(43521, 3)
    loopInDefer()
    expect(9134, 4)
    if counted() != 1230 {
        exit(5)
    }
    if exits(1) != 1 {
        exit(7)
    }
    expect(3221, 8)
    if exits(7) != 9 {
        exit(9)
    }
    expect(3232241, 10)
    skip()
    expect(215315314, 11)
    if inner(4) != 11 {
        exit(12)
    }
    expect(4343435243321, 13)
    many()
    expect(4030201, 6)
    exit(42)
}
