-- definition-in-another-package/tack.mod --
module calc
-- definition-in-another-package/main.tck --
package main

import util from "calc/util"

extern func add(a int64, b int64) int64

func main() {
    code, fits := int32(add(util.Two(), 40))
    if fits { exit(code) }
}
-- definition-in-another-package/util/util.tck --
package util

pub func Two() int64 {
    return 2
}
-- definition-in-another-package/util/util.c --
int64_t add(int64_t a, int64_t b) {
    return a + b;
}
-- definition-in-another-package/expected --

definition-in-another-package/main.tck:5:13: error: extern func add has no C definition in package main
04 |	
05 |	extern func add(a int64, b int64) int64
   |	            ^~~
06 |	

-- duplicate-definition/.target --
main.tck
-- duplicate-definition/main.tck --
package main

extern func add(a int64, b int64) int64

func main() {
    code, fits := int32(add(40, 2))
    if fits { exit(code) }
}
-- duplicate-definition/a.c --
int64_t add(int64_t a, int64_t b) {
    return a + b;
}
-- duplicate-definition/b.c --
int64_t add(int64_t a, int64_t b) {
    return b + a;
}
-- duplicate-definition/expected --
tack: two C files define add: duplicate-definition/a.c and duplicate-definition/b.c
-- duplicate-helper/.target --
main.tck
-- duplicate-helper/main.tck --
package main

extern func add(a int64, b int64) int64

func main() {
    code, fits := int32(add(40, 2))
    if fits { exit(code) }
}
-- duplicate-helper/a.c --
int counter = 0;

int64_t add(int64_t a, int64_t b) {
    return a + b;
}
-- duplicate-helper/b.c --
int counter = 1;
-- duplicate-helper/expected --
tack: two C files define counter: duplicate-helper/a.c and duplicate-helper/b.c
