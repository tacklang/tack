-- missing-definition/.target --
main.tck
-- missing-definition/main.tck --
package main

extern func add(a int64, b int64) int64

extern func flip(b bool) bool

extern func unused()

func main() {
    if flip(false) {
        code, fits := int32(add(40, 2))
        if fits { exit(code) }
    }
}
-- missing-definition/helpers.c --
bool flip(bool b) {
    return !b;
}

int64_t ad(int64_t a, int64_t b) {
    return a + b;
}
-- missing-definition/expected --

missing-definition/main.tck:7:13: warning: declared and not used: unused
06 |	
07 |	extern func unused()
   |	            ^~~~~~
08 |	


missing-definition/main.tck:3:13: error: extern func add has no C definition in package main
02 |	
03 |	extern func add(a int64, b int64) int64
   |	            ^~~
04 |	

missing-definition/main.tck:7:13: error: extern func unused has no C definition in package main
06 |	
07 |	extern func unused()
   |	            ^~~~~~
08 |	

-- missing-in-library/tack.mod --
module calc
-- missing-in-library/main.tck --
package main

import util from "calc/util"

func main() {
    code, fits := int32(util.Sum(40, 2))
    if fits { exit(code) }
}
-- missing-in-library/util/util.tck --
package util

extern func add(a int64, b int64) int64

pub func Sum(a int64, b int64) int64 {
    return add(a, b)
}
-- missing-in-library/expected --

missing-in-library/util/util.tck:3:13: error: extern func add has no C definition in package util
02 |	
03 |	extern func add(a int64, b int64) int64
   |	            ^~~
04 |	

-- mut-param-by-value/.target --
main.tck
-- mut-param-by-value/main.tck --
package main

extern func fill(mut n int64, v int64)

func main() {
    mut n int64 = 0
    fill(mut n, 42)
    code, fits := int32(n)
    if fits { exit(code) }
}
-- mut-param-by-value/helpers.c --
void fill(int64_t n, int64_t v) {
    n = v;
}
-- mut-param-by-value/expected --
tack: cannot compile mut-param-by-value/helpers.c: clang failed: exit status 1
