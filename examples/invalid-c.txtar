Invalid example programs with C files, one case per program, in byte
order of name.

A case named n is its files, each a txtar file n/<path>, its .c files
among them, followed by n/expected, what tack writes to stderr for it, with
each file's path printed as n/<path>. The case is built with clang from
the directory n, or from what an optional n/.target file names, relative
to n: main.tck for a single-file program. Every file must end with a
newline. When clang rejects a C file, its own report, which varies with
its version, is not pinned: n/expected holds what tack writes after it.
internal/invalid documents the format; go test ./tack -run TestInvalidC
builds every case, and -update rewrites the expected sections.

-- c-defines-main/.target --
main.tck
-- c-defines-main/main.tck --
package main

extern func add(a int64, b int64) int64

func main() {
    code, fits := int32(add(40, 2))
    if fits { exit(code) }
}
-- c-defines-main/helpers.c --
int64_t add(int64_t a, int64_t b) {
    return a + b;
}

int main(void) {
    return 0;
}
-- c-defines-main/expected --
tack: c-defines-main/helpers.c defines main; a Tack program's main is its Tack main, so no C file may define one
-- c-redefines-type/.target --
main.tck
-- c-redefines-type/main.tck --
package main

type Point struct {
    x int64
    y int64
}

extern func norm(p Point) int64

func main() {
    code, fits := int32(norm(Point{x: 40, y: 2}))
    if fits { exit(code) }
}
-- c-redefines-type/helpers.c --
typedef struct {
    int32_t x;
    int32_t y;
} Point;

int64_t norm(Point p) {
    return p.x + p.y;
}
-- c-redefines-type/expected --
tack: cannot compile c-redefines-type/helpers.c: clang failed: exit status 1
