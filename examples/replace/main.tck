package main

// replace(mut place, new) moves a place's value out, as its result, and
// moves new into the place, in one step, so the place never holds no
// value. It takes a list out of a struct to work on it as a local, which
// nothing else can, and puts it back; it replaces an element of a list,
// owned or copyable, and a list inside a list of lists; and written as a
// statement it is an assignment that frees the old value. main checks
// c_allocator holds nothing after each group, so every value was freed
// exactly once.
//
// Every check prints its name and "ok", or "FAIL".

// live returns how many buffers c_allocator holds, in C.
extern("replace_live") func live() int64

// check prints name and whether cond held.
func check(cond bool, name string) {
    print(name)
    if cond {
        print(" ok\n")
    } else {
        print(" FAIL\n")
    }
}

// count returns a list holding 0 through n-1, or an empty one if an
// append fails.
func count(n int64) list[int64] {
    mut l := make(list[int64], c_allocator)
    for i := range n {
        err := append(mut l, i)
        if err.code != 0 {
            return make(list[int64], c_allocator)
        }
    }
    return l
}

// sum returns the sum of v's elements.
func sum(v []int64) int64 {
    mut s := 0
    for _, x := range v {
        s +%= x
    }
    return s
}

// Stack keeps a list of frames to reuse across calls.
type Stack struct {
    frames list[int64]
    depth int64
}

// grow takes s's frames out, appends n more to them as a local, and puts
// them back, returning how many it holds.
func (mut s Stack) grow(n int64) int64 {
    mut frames := replace(mut s.frames, make(list[int64], c_allocator))
    for i := range n {
        err := append(mut frames, i)
        if err.code != 0 {
            break
        }
    }
    s.depth = len(frames)
    empty := replace(mut s.frames, frames)
    return len(s.frames) +% len(empty)
}

// fieldOutAndBack checks a list taken out of a struct and put back.
func fieldOutAndBack() {
    mut s := Stack{frames: count(2), depth: 2}
    check(mut s.grow(3) == 5 && s.depth == 5 && sum(s.frames) == 1 + 3, "a field taken out and put back")
}

// ownedElement checks an owned element of a list of lists replaced.
func ownedElement() {
    mut ll := make(list[list[int64]], c_allocator)
    e1 := append(mut ll, count(3))
    e2 := append(mut ll, count(1))
    if e1.code != 0 || e2.code != 0 {
        return
    }
    if len(ll) < 2 {
        return
    }
    old := replace(mut ll[0], count(5))
    check(len(old) == 3 && len(ll[0]) == 5 && len(ll[1]) == 1, "an owned element replaced")
    replace(mut ll[1], count(4))
    check(len(ll[1]) == 4, "an owned element replaced as a statement")
}

// copyable checks copyable values: a local, a mut parameter's element
// and a value computed from the place's own old value.
func copyable() {
    mut x := 7
    old := replace(mut x, 9)
    check(old == 7 && x == 9, "a copyable local")
    old2 := replace(mut x, x *% 2)
    check(old2 == 9 && x == 18, "a value read from the old one")
    mut a := [3]int64{1, 2, 3}
    o := replace(mut a[2], 30)
    check(o == 3 && a[2] == 30, "an array element")
    mut l := count(3)
    if len(l) > 1 {
        o2 := replace(mut l[1], -1)
        check(o2 == 1 && l[1] == -1, "a list element")
    }
    replace(mut x, 0)
    check(x == 0, "a copyable statement")
}

// nested checks a list of lists replaced whole, and a list inside it.
func nested() {
    mut ll := make(list[list[int64]], c_allocator)
    e := append(mut ll, count(2))
    if e.code != 0 || len(ll) == 0 {
        return
    }
    inner := replace(mut ll[0], count(6))
    mut outer := replace(mut ll, make(list[list[int64]], c_allocator))
    check(len(inner) == 2 && len(outer) == 1 && len(ll) == 0, "a list of lists replaced")
    err := append(mut outer, inner)
    check(err.code == 0 && len(outer) == 2, "the old values moved on")
}

func main() {
    fieldOutAndBack()
    check(live() == 0, "nothing left after a field")
    ownedElement()
    check(live() == 0, "nothing left after owned elements")
    copyable()
    check(live() == 0, "nothing left after copyable values")
    nested()
    check(live() == 0, "nothing left after nested lists")
}

// The wrapping operators in this file, +% -% *% and their compound
// forms, stand where nothing proves a value's bound but this program's
// own fixed data keeps it within its type, so none of them wraps; one
// that is meant to wrap says so where it is.
