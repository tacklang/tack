package main

// Loops that never end. A loop whose body does nothing a program can
// observe still runs for as long as its condition holds, forever if it
// always does, at every optimization level, and the code after it never
// runs. Each case is a function the first argument names; main runs it,
// then prints that it came back and exits 1, which only a loop that ended
// lets it do. The test runs each case under a short timeout and requires
// it to be still running, having printed nothing, when the timeout fires.
// The case "ends" is the control: its loop ends, and it prints "ended"
// and exits 0.

import fmt from "std/fmt"
import os from "std/os"
import text from "std/text"

// limit is read by a loop's condition and never changes.
mut limit int64

// zero returns 0, so a loop's condition holds a call.
func zero() int64 {
    return 0
}

// clause never ends: n is set back below 4 on every pass.
func clause() {
    for mut n := 0; n < 4; n++ {
        n = -5
    }
}

// clauseContinue never ends: a continue runs the post statement, n++,
// before the condition, and n never reaches 4.
func clauseContinue() {
    for mut n := 0; n < 4; n++ {
        if n >= 0 {
            n = -5
            continue
        }
    }
}

// cond never ends: i stays 0.
func cond() {
    mut i := 0
    for i < 4 {
        i = i * 2
    }
}

// condCall never ends: its condition calls zero and its body is empty.
func condCall() {
    for zero() < 4 {
    }
}

// bare never ends: a loop with no condition and an empty body.
func bare() {
    for {
    }
}

// bareBreak never ends: its break is behind a condition that never holds.
func bareBreak(never bool) {
    for {
        if never {
            break
        }
    }
}

// rangeInt never ends: its first pass runs a loop that never ends.
func rangeInt() {
    for i := range 3 {
        mut j := i
        for j >= 0 {
            j = 0
        }
    }
}

// rangeArray never ends, as rangeInt does, ranging over an array.
func rangeArray() {
    a := [3]int64{1, 2, 3}
    for _, x := range a {
        mut j := x
        for j >= 0 {
            j = 1
        }
    }
}

// rangeString never ends, as rangeInt does, ranging over a string.
func rangeString() {
    for _, c := range "abc" {
        mut j := c
        for j > 0 {
            j = 'a'
        }
    }
}

// rangeView never ends, as rangeInt does, ranging over a view.
func rangeView(v []int64) {
    for _, x := range v {
        mut j := x
        for j >= 0 {
            j = 1
        }
    }
}

// rangeList never ends, as rangeInt does, ranging over a list.
func rangeList() {
    mut l := make(list[int64], c_allocator)
    err := append(mut l, 7)
    if err.code != 0 {
        exit(2)
    }
    for _, x := range l {
        mut j := x
        for j >= 0 {
            j = 1
        }
    }
}

// rangeMap never ends, as rangeInt does, ranging over a map.
func rangeMap() {
    mut m := make(map[int64]int64, c_allocator)
    err := put(mut m, 1, 7)
    if err.code != 0 {
        exit(2)
    }
    for k, v := range m {
        mut j := k + v
        for j >= 0 {
            j = 1
        }
    }
}

// nestedInner never ends: the inner loop of two never does.
func nestedInner() {
    for mut a := 0; a < 2; a++ {
        for mut b := 0; b < 2; b++ {
            b = -1
        }
    }
}

// nestedOuter never ends: the inner loop ends every time, and the outer
// one sets a back below 2.
func nestedOuter() {
    for mut a := 0; a < 2; a++ {
        mut c := 0
        for mut b := 0; b < 2; b++ {
            c += b
        }
        a = -1 - c
    }
}

// inDefer never ends: the loop runs in a defer, as the function returns.
func inDefer() {
    defer {
        for mut n := 0; n < 4; n++ {
            n = -5
        }
    }
}

// global never ends: its condition reads a global nothing changes.
func global() {
    for limit < 4 {
    }
}

// exitInside never ends: an exit in the body is behind a condition that
// never holds.
func exitInside(n int64) {
    mut i := n
    for i < 4 {
        if i > 10 {
            exit(3)
        }
        i = 0
    }
}

// exitBefore never ends: it may exit before its loop, which it then runs
// when it does not.
func exitBefore(n int64) {
    if n > 100 {
        exit(3)
    }
    clause()
}

// Sizer has a size.
type Sizer interface {
    size() int64
}

// Box is a Sizer of size n.
type Box struct {
    n int64
}

// size returns b's n.
func (b Box) size() int64 {
    return b.n
}

// generic never ends, in its instance for Box: n starts at s's size and
// is set back below 4 on every pass.
func generic[S Sizer](s S) {
    for mut n := s.size(); n < 4; n++ {
        n = -5
    }
}

// guarded spins when at is out of range for a, and only then reads a[at]
// by the checked form, which a spin assumed to end would let read out of
// range.
func guarded(a []int64, at int64) int64 {
    if at < 0 || at >= len(a) {
        clause()
    }
    v, ok := a[at]
    if !ok {
        return -1
    }
    return v
}

// ends is the control: its loop ends.
func ends() {
    mut i := 0
    for i < 4 {
        i++
    }
    print("ended\n")
    exit(0)
}

// run runs the case named name. far is an index out of range for any
// array here, computed from the arguments so that no build knows it.
func run(name text.Text, far int64) {
    a := [4]int64{1, 2, 3, 4}
    switch {
    case name.equal([]uint8("ends")):
        ends()
    case name.equal([]uint8("clause")):
        clause()
    case name.equal([]uint8("clause-continue")):
        clauseContinue()
    case name.equal([]uint8("cond")):
        cond()
    case name.equal([]uint8("cond-call")):
        condCall()
    case name.equal([]uint8("bare")):
        bare()
    case name.equal([]uint8("bare-break")):
        bareBreak(far < 0)
    case name.equal([]uint8("range-int")):
        rangeInt()
    case name.equal([]uint8("range-array")):
        rangeArray()
    case name.equal([]uint8("range-string")):
        rangeString()
    case name.equal([]uint8("range-view")):
        rangeView(a)
    case name.equal([]uint8("range-list")):
        rangeList()
    case name.equal([]uint8("range-map")):
        rangeMap()
    case name.equal([]uint8("nested-inner")):
        nestedInner()
    case name.equal([]uint8("nested-outer")):
        nestedOuter()
    case name.equal([]uint8("defer")):
        inDefer()
    case name.equal([]uint8("global")):
        global()
    case name.equal([]uint8("exit-inside")):
        exitInside(far - far)
    case name.equal([]uint8("exit-before")):
        exitBefore(far - far)
    case name.equal([]uint8("generic")):
        generic(Box{n: 0})
    case name.equal([]uint8("guarded")):
        fmt.printf("%d\n", guarded(a, far))
    default:
        print("no such case\n")
        exit(2)
    }
}

func main() {
    args, err := os.args(c_allocator)
    if err.code != 0 || len(args) != 2 {
        print("one case name, please\n")
        exit(2)
    }
    for i, arg := range args {
        if i == 1 {
            run(arg, 100000000 * len(args))
        }
    }
    print("the loop ended\n")
    exit(1)
}
