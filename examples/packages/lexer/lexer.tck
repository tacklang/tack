package lexer

import text from "calc/internal/text"

// First returns the first token of src.
func First(src string) Token {
    if len(src) > 0 && text.isDigit(src[0]) {
        return Token{kind: KindNumber, start: 0, end: 1}
    }
    return Token{kind: KindPlus, start: 0, end: 1}
}

// size shares its name with text.size.
func size() int64 {
    return 2
}

// Size reports size, so main can tell the two apart.
func Size() int64 {
    return size() + text.size()
}
