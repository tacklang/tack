package geom

import text from "calc/internal/text"
import lexer from "calc/lexer"

// Point and Box nest one struct in another; Box also holds a struct of
// another package.
type Point struct {
    x int64
    y int64
}

type Box struct {
    min Point
    max Point
    tok lexer.Token
}

// Origin is a struct global, read from main through two qualifiers.
var Origin = Point{x: 0, y: 0}

// Limit is computed from another package's global.
var Limit int64 = lexer.KindPlus * 10

// Area takes and returns types of its own package and another's.
func Area(b Box) int64 {
    q, r := text.divmod(b.max.x - b.min.x, 1)
    return q * (b.max.y - b.min.y) + r
}

// Tokens returns an array of another package's struct type.
func Tokens() [2]lexer.Token {
    return [2]lexer.Token{lexer.First("7"), lexer.First("+")}
}

// size shares its name with lexer.size and text.size.
func size() int64 {
    return 4
}

// Size reports size.
func Size() int64 {
    return size()
}
