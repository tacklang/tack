package main

// Read-only views, []T. A view is a parameter, here: an array of any
// length passes to it as it is, and a string's bytes through []uint8(s).
// Inside, a view has len, indexing with a proof or the checked form,
// range, and being passed on to another view parameter. A view may also
// be a result, which examples/view-results shows.

type Point struct {
    x int64
    y int64
}

type Shape struct {
    pts  [3]Point
    grid [2][3]int64
    name string
}

// table is a mutable global array, which a callee could change during a
// call that views it, so the view is of a copy.
mut table [3]int64

// label is a mutable global string, whose bytes a view may read even if
// the global is assigned during the call.
mut label string

// check prints name and whether cond held.
func check(cond bool, name string) {
    print(name)
    if cond {
        print(" ok\n")
    } else {
        print(" FAIL\n")
    }
}

// sum adds every element of v, counting with a three-clause loop, whose
// condition and start prove v[i].
func sum(v []int64) int64 {
    mut total int64 = 0
    for mut i int64 = 0; i < len(v); i++ {
        total += v[i]
    }
    return total
}

// sumRange adds every element of v with a range loop over its elements.
func sumRange(v []int64) int64 {
    mut total int64 = 0
    for _, x := range v {
        total += x
    }
    return total
}

// sumByIndex adds every element of v with a range loop over its indexes,
// which proves v[i].
func sumByIndex(v []int64) int64 {
    mut total int64 = 0
    for i := range v {
        total += v[i]
    }
    return total
}

// countRange counts the iterations of a range loop with no variables.
func countRange(v []int64) int64 {
    mut n int64 = 0
    for range v {
        n++
    }
    return n
}

// passOn passes its view on to another view parameter.
func passOn(v []int64) int64 {
    return sum(v)
}

// count returns how many bytes of b are c.
func count(b []uint8, c uint8) int64 {
    mut n int64 = 0
    for i, x := range b {
        if x == c && b[i] == c {
            n++
        }
    }
    return n
}

// at returns v[i], or -1 when i is out of range, through the checked form.
func at(v []int64, i int64) int64 {
    x, ok := v[i]
    if !ok {
        return -1
    }
    return x
}

// firstTwo returns v[0] + v[1], proven by the guard on len(v), which holds
// for the rest of the function since a view never changes.
func firstTwo(v []int64) int64 {
    if len(v) < 2 {
        return -1
    }
    return v[0] + v[1]
}

// guarded returns v[i] when the guard proves it, and -1 otherwise.
func guarded(v []int64, i int64) int64 {
    if 0 <= i && i < len(v) {
        return v[i]
    }
    return -1
}

// sumXs adds the x of every point of a view of structs.
func sumXs(v []Point) int64 {
    mut total int64 = 0
    for i := range v {
        total += v[i].x
    }
    return total
}

// gridSum adds every element of a view of arrays, passing each row on as
// a view of its own: an element of a view, and a range loop's element.
func gridSum(rows [][3]int64) int64 {
    mut total int64 = 0
    for i := range rows {
        total += sum(rows[i])
    }
    for _, row := range rows {
        total += sumRange(row)
    }
    return total / 2
}

// lastOf returns the last element of v, or 0 for an empty view.
func lastOf(v []int64) int64 {
    n := len(v)
    if n == 0 {
        return 0
    }
    x, ok := v[n - 1]
    if !ok {
        return 0
    }
    return x
}

// viaMut views the caller's array through a mut parameter after changing
// it.
func viaMut(mut a [3]int64) int64 {
    a[1] = 7
    return sum(a)
}

// writeThenRead writes the caller's array through a, then reads v, which
// the caller passed the same array to: v is a copy taken at the call.
// It returns -1 when v is empty.
func writeThenRead(mut a [3]int64, v []int64) int64 {
    a[0] = 100
    x, ok := v[0]
    if !ok {
        return -1
    }
    return x
}

// setFirst sets a[0] to x and returns 0.
func setFirst(mut a [3]int64, x int64) int64 {
    a[0] = x
    return 0
}

// firstPlus returns v[0] + n, or n when v is empty.
func firstPlus(v []int64, n int64) int64 {
    x, ok := v[0]
    if !ok {
        return n
    }
    return x + n
}

// changeTable changes the global table, then reads v, which the caller
// passed table to: v is a copy taken at the call. It returns -1 when v
// is empty.
func changeTable(v []int64) int64 {
    table[0] = 50
    x, ok := v[0]
    if !ok {
        return -1
    }
    return x
}

// relabel assigns the global label, then counts c in b, which the caller
// passed label's bytes to: the bytes a string holds never change.
func relabel(b []uint8, c uint8) int64 {
    label = "zzzz"
    return count(b, c)
}

// bools counts the true elements of a view of bools.
func bools(v []bool) int64 {
    mut n int64 = 0
    for _, b := range v {
        if b {
            n++
        }
    }
    return n
}

// joined returns the total length of a view of strings.
func joined(v []string) int64 {
    mut n int64 = 0
    for _, s := range v {
        n += len(s)
    }
    return n
}

// sizes adds a view of unsafe_size_t, converted to int64, or returns -1
// when one is past the largest int64.
func sizes(v []unsafe_size_t) int64 {
    mut n int64 = 0
    for _, s := range v {
        k, ok := int64(s)
        if !ok {
            return -1
        }
        n += k
    }
    return n
}

func main() {
    three := [3]int64{1, 2, 3}
    five := [5]int64{10, 20, 30, 40, 50}
    check(sum(three) == 6 && sum(five) == 150, "arrays of two lengths")
    check(sumRange(five) == 150 && sumByIndex(five) == 150, "range loops")
    check(countRange(five) == 5 && countRange(three) == 3, "range without variables")

    empty := [0]int64{}
    check(sum(empty) == 0 && sumRange(empty) == 0 && at(empty, 0) == -1, "zero length")
    check(lastOf(empty) == 0 && lastOf(five) == 50, "last element")

    check(passOn(five) == 150, "passed on")
    check(at(three, 2) == 3 && at(three, 3) == -1 && at(three, -1) == -1, "checked index")
    check(firstTwo(three) == 3 && firstTwo(empty) == -1, "guard on len")
    check(guarded(five, 4) == 50 && guarded(five, 5) == -1, "guarded index")

    mut s Shape
    s.pts[0] = Point{x: 1, y: 9}
    s.pts[1] = Point{x: 2, y: 9}
    s.pts[2] = Point{x: 3, y: 9}
    s.grid[1] = [3]int64{4, 5, 6}
    check(sumXs(s.pts) == 6, "field of structs")
    check(sum(s.grid[1]) == 15 && sum(s.grid[0]) == 0, "element of a field")
    check(gridSum(s.grid) == 15, "view of arrays")

    word := "banana"
    check(count([]uint8(word), 'a') == 3, "string variable")
    check(count([]uint8("abracadabra"), 'a') == 5, "string literal")
    check(count([]uint8(""), 'a') == 0, "empty string")
    check(count([]uint8(s.name), 'a') == 0, "zero string field")

    mut m := [3]int64{1, 2, 3}
    check(viaMut(mut m) == 11 && m[1] == 7, "mut parameter's array")

    mut a := [3]int64{1, 2, 3}
    got := writeThenRead(mut a, a)
    check(got == 1 && a[0] == 100, "view alongside mut of the same array")

    mut b := [3]int64{1, 2, 3}
    check(firstPlus(b, setFirst(mut b, 9)) == 1 && b[0] == 9, "view before a later mut")
    check(firstPlus(b, 0) == 9, "view after the change")

    table = [3]int64{5, 6, 7}
    check(changeTable(table) == 5 && table[0] == 50, "mutable global array")

    label = "aaa"
    check(relabel([]uint8(label), 'a') == 3 && label == "zzzz", "mutable global string")

    flags := [4]bool{true, false, true, true}
    check(bools(flags) == 3, "view of bools")
    words := [2]string{"ab", "cde"}
    check(joined(words) == 5, "view of strings")
    ns := [2]unsafe_size_t{4, 5}
    check(sizes(ns) == 9, "view of unsafe_size_t")
}
