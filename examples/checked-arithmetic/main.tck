package main

// Checked integer arithmetic. Plain + - *, unary -, ++ -- += -= and *= on
// integers compile only where the compiler proves they cannot overflow,
// for every width, signed and unsigned, an unsigned value going below 0
// included. Elsewhere v, ok := a + b (or -, *, or -x) computes the result
// only when it fits: ok reports whether it did, and v is the result, or
// 0. Floats are unaffected, and << is a bit operation, left as it was.
// Each check prints its name and "ok", or "FAIL".
//
// The helpers take parameters so that no operand is a known value: a
// known overflow is a compile error, not a run-time failure.

// check prints name and whether cond held.
func check(cond bool, name string) {
    print(name)
    if cond {
        print(" ok\n")
    } else {
        print(" FAIL\n")
    }
}

// add_i8, sub_i8, mul_i8 and neg_i8 are the checked int8 operations.
func add_i8(a int8, b int8) (int8, bool) {
    v, ok := a + b
    return v, ok
}

func sub_i8(a int8, b int8) (int8, bool) {
    v, ok := a - b
    return v, ok
}

func mul_i8(a int8, b int8) (int8, bool) {
    v, ok := a * b
    return v, ok
}

func neg_i8(a int8) (int8, bool) {
    v, ok := -a
    return v, ok
}

// add_u8, sub_u8 and mul_u8 are the checked uint8 operations.
func add_u8(a uint8, b uint8) (uint8, bool) {
    v, ok := a + b
    return v, ok
}

func sub_u8(a uint8, b uint8) (uint8, bool) {
    v, ok := a - b
    return v, ok
}

func mul_u8(a uint8, b uint8) (uint8, bool) {
    v, ok := a * b
    return v, ok
}

