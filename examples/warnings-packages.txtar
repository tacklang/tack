-- unused-private-in-library/tack.mod --
module calc
-- unused-private-in-library/geo/geo.tck --
package geo

pub type Rect struct {
    pub w int64
    pub h int64
}

pub func Area(r Rect) int64 {
    return r.w * r.h
}

func spare(r Rect) int64 {
    return r.w + r.h
}

type hidden struct {
    x int64
}
-- unused-private-in-library/main.tck --
package main

import geo from "calc/geo"

func main() {
    if geo.Area(geo.Rect{w: 2, h: 3}) == 6 {
        print("ok\n")
    }
}
