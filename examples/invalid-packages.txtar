-- error-imported/tack.mod --
module errs
-- error-imported/num/num.tck --
package num

pub func Parse(s string) (int64, error) {
    if len(s) == 0 {
        return 0, error{code: 1, msg: "empty"}
    }
    return 1, noerror
}
-- error-imported/main.tck --
package main

import num from "errs/num"

func main() {
    num.Parse("1")
    v, err := num.Parse("2")
    print(err.msg)
    if v > 0 {
        print("parsed\n")
    }
}
-- error-imported/expected --
stage: typeck
---

