dup-global-across-files/b.tck:3:6: note: previous declaration of limit
02 |	
03 |	type limit struct {
   |	     ^~~~~
04 |	    n int64

-- dup-param-across-files/a.tck --
package main

var size int64 = 1

func main() {
    exit(grow(size))
}
-- dup-param-across-files/b.tck --
