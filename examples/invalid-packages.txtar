-- method-lib-other-module/.std/util/util.tck --
package util

pub type Pair struct {
    pub a int64
}

lib type Box struct {
    pub n int64
}

// Sum is lib: only std's packages may call it.
lib func (p Pair) Sum() int64 {
    return p.a
}

// A is pub.
pub func (p Pair) A() int64 {
    return p.a
}

// Get is pub, capped at lib by its type.
pub func (b Box) Get() int64 {
    return b.n
}
