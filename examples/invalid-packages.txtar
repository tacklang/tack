-- generic-foreign-private-method/tack.mod --
module calc
-- generic-foreign-private-method/sink/sink.tck --
package sink

pub type Sink interface {
    mut put(word string) error
    count() int64
}

pub func Feed[S Sink](mut s S, word string) error {
    return mut s.put(word)
}

pub type Tally struct {
    n int64
}

pub func NewTally() Tally {
    return Tally{n: 0}
}

func (mut t Tally) put(word string) error {
    t.n++
    return noerror
}

func (t Tally) count() int64 {
    return t.n
}
-- generic-foreign-private-method/main.tck --
package main

import sink from "calc/sink"

type Counted interface {
    count() int64
}

func countOf[C Counted](c C) int64 {
    return c.count()
}

func main() {
    t := sink.NewTally()
    if countOf(t) > 0 {
        exit(1)
    }
}
-- generic-foreign-private-method/expected --
stage: typeck
---

