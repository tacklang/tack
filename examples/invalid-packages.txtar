-- method-visibility/tack.mod --
module calc
-- method-visibility/lexer/lexer.tck --
package lexer

pub type Token struct {
    pub kind int64
}

lib type Half struct {
    pub n int64
}

// Kind is pub.
pub func (t Token) Kind() int64 {
    return t.kind
}

// Mid is lib, usable in module calc.
lib func (t Token) Mid() int64 {
    return t.kind
}

// hidden is private.
func (t Token) hidden() int64 {
    return t.kind
}

// Get is pub on a lib type, so lib in effect.
pub func (h Half) Get() int64 {
    return h.n
}

pub func Make() Token {
    return Token{kind: 1}
}
-- method-visibility/main.tck --
package main

import lexer from "calc/lexer"

func use(n int64) {
}

func main() {
    t := lexer.Make()
    use(t.Kind() + t.Mid())
    use(t.hidden())
    h := lexer.Half{n: 2}
    use(h.Get())
    use(t.nope())
    k := t.Kind
    use(k)
}
-- method-visibility/expected --
stage: typeck
---

