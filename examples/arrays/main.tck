package main

var primes = [5]int64{2, 3, 5, 7, 11}

func sum3(v [3]int64) int64 {
    return v[0] + v[1] + v[2]
}

func origin() [2]int64 {
    return [2]int64{0, 0}
}

func main() {
    mut a := [3]int64{1, 2, 3}
    b := a
    a[0] = 10
    if b[0] != 1 || a != [...]int64{10, 2, 3} {
        exit(1)
    }

    mut grid [2][2]bool
    grid[1][1] = true
    if grid != [2][2]bool{{false, false}, {false, true}} {
        exit(2)
    }

    o := origin()
    if o[0] != 0 || o[1] != 0 {
        exit(3)
    }

    word := "tack"
    code, ok := int32(sum3(b) + len(primes) + len(word) + len("abc") + primes[4])
    if !ok {
        exit(4)
    }
    exit(code)
}
