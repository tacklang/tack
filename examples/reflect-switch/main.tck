package main

import fmt from "std/fmt"
import text from "std/text"

// Switches on a type parameter: in each instance, switch T { ... } runs
// the one case T's type argument matches, the first in source order, and
// in a case naming one type every value of type T is a value of that
// type, a parameter, a local or a mut place alike. list[E] and
// map[text.Text]V name the element and value types E and V, type
// parameters of their own constrained by Data, and struct matches any
// struct, text.Text among them unless a case before it takes it. Each
// check prints its name and "ok", or "FAIL"; every check that allocates
// runs in a function of its own, and main asserts after it that
// c_allocator's count of live buffers is back to zero.

// live returns how many buffers c_allocator holds, in C.
extern("go_live") func live() int64

// fail_after makes c_allocator grant the next n requests and refuse every
// one after them, or refuse none again for a negative n, in C.
extern("go_fail_after") func fail_after(n int64)

// check prints name and whether cond held.
func check(cond bool, name string) {
    print(name)
    if cond {
        print(" ok\n")
    } else {
        print(" FAIL\n")
    }
}

// Point is a struct of two integers.
type Point struct {
    x int64
    y int64
}

// Item holds a field of every kind of Data: a Text, a struct, a list, a
// map, a float, a bool, a byte and a list of lists.
type Item struct {
    name  text.Text
    at    Point
    tags  list[int64]
    sizes map[text.Text]int64
    ratio float64
    ok    bool
    small uint8
    grid  list[list[int32]]
}

// emit appends s to out.
func emit(mut out list[uint8], s []uint8) error {
    return append(mut out, s...)
}

// show appends v to out as Go's %+v writes it: a struct's fields as
// {name:value ...}, a list as [a b c], a map as map[k:v ...], in the
// order its keys were put, and a Text as its bytes. It covers every kind
// of Data, so it has no default, and every case returns, so nothing
// follows the switch.
func show[T Data](v T, mut out list[uint8]) error {
    switch T {
    case bool:
        if v {
            return emit(mut out, []uint8("true"))
        }
        return emit(mut out, []uint8("false"))
    case int8:
        return fmt.appendf(mut out, "%d", v)
    case int16:
        return fmt.appendf(mut out, "%d", v)
    case int32:
        return fmt.appendf(mut out, "%d", v)
    case int64:
        return fmt.appendf(mut out, "%d", v)
    case uint8:
        return fmt.appendf(mut out, "%d", v)
    case uint16:
        return fmt.appendf(mut out, "%d", v)
    case uint32:
        return fmt.appendf(mut out, "%d", v)
    case uint64:
        return fmt.appendf(mut out, "%d", v)
    case unsafe_size_t:
        return fmt.appendf(mut out, "%d", v)
    case unsafe_uintptr_t:
        return fmt.appendf(mut out, "%d", v)
    case float32:
        return fmt.appendf(mut out, "%g", v)
    case float64:
        return fmt.appendf(mut out, "%g", v)
    case text.Text:
        return emit(mut out, v.bytes())
    case list[E]:
        emit(mut out, []uint8("["))?
        for i, e := range v {
            if i > 0 {
                emit(mut out, []uint8(" "))?
            }
            show(e, mut out)?
        }
        return emit(mut out, []uint8("]"))
    case map[text.Text]V:
        emit(mut out, []uint8("map["))?
        mut first := true
        for k, x := range v {
            if !first {
                emit(mut out, []uint8(" "))?
            }
            first = false
            emit(mut out, k.bytes())?
            emit(mut out, []uint8(":"))?
            show(x, mut out)?
        }
        return emit(mut out, []uint8("]"))
    case struct:
        emit(mut out, []uint8("{"))?
        for f := range fields(T) {
            if f.index > 0 {
                emit(mut out, []uint8(" "))?
            }
            emit(mut out, []uint8(f.name))?
            emit(mut out, []uint8(":"))?
            show(v.[f], mut out)?
        }
        return emit(mut out, []uint8("}"))
    }
}

// equal reports whether a and b hold the same value: == for a bool, an
// integer or a float, the same bytes for a Text, and the same elements,
// values or fields, at any depth, for a list, a map or a struct.
func equal[T Data](a T, b T) bool {
    switch T {
    case bool:
        return a == b
    case int8:
        return a == b
    case int16:
        return a == b
    case int32:
        return a == b
    case int64:
        return a == b
    case uint8:
        return a == b
    case uint16:
        return a == b
    case uint32:
        return a == b
    case uint64:
        return a == b
    case unsafe_size_t:
        return a == b
    case unsafe_uintptr_t:
        return a == b
    case float32:
        return a == b
    case float64:
        return a == b
    case text.Text:
        return a.equal(b.bytes())
    case list[E]:
        if len(a) != len(b) {
            return false
        }
        for i, x := range a {
            if i >= len(b) || !equal(x, b[i]) {
                return false
            }
        }
        return true
    case map[text.Text]V:
        if len(a) != len(b) {
            return false
        }
        for k, x := range a {
            if !has(b, k) || !equal(x, b[k]) {
                return false
            }
        }
        return true
    case struct:
        for f := range fields(T) {
            if !equal(a.[f], b.[f]) {
                return false
            }
        }
        return true
    }
}

// count_ints returns how many integers v holds, at any depth: one case
// names every integer type, and the default takes the bool and the
// floats.
func count_ints[T Data](v T) int64 {
    switch T {
    case int8, int16, int32, int64, uint8, uint16, uint32, uint64, unsafe_size_t, unsafe_uintptr_t:
        return 1
    case text.Text:
        return 0
    case list[E]:
        mut n := 0
        for _, e := range v {
            n +%= count_ints(e)
        }
        return n
    case map[text.Text]V:
        mut n := 0
        for _, x := range v {
            n +%= count_ints(x)
        }
        return n
    case struct:
        mut n := 0
        for f := range fields(T) {
            n +%= count_ints(v.[f])
        }
        return n
    default:
        return 0
    }
}

// bump adds one to v, through a mut parameter, when it is an int64 from 0
// to 99, which proves the addition cannot overflow; appends "!" to a
// Text; bumps each element of a list; and leaves anything else as it is.
func bump[T Data](mut v T) error {
    switch T {
    case int64:
        if v >= 0 && v < 100 {
            v = v + 1
        }
    case text.Text:
        return mut v.append([]uint8("!"))
    case list[E]:
        mut i := 0
        for i >= 0 && i < len(v) {
            bump(mut v[i])?
            i +%= 1
        }
    default:
    }
    return noerror
}

// doubled returns twice v, computed in a local of type T, when v is an
// int64 between -1000 and 1000, and a converted int32 widened to an
// int64, and -1 for anything else.
func doubled[T Data](v T) int64 {
    switch T {
    case int64:
        mut w T = v
        if w > -1000 && w < 1000 {
            w = w * 2
            return w
        }
        return 0
    case int32:
        return int64(v) +% int64(v)
    default:
        return -1
    }
}

// run calls f.
func run(scope f func()) {
    f()
}

// captured returns, through a closure that captures v and n, one more
// than an int64 v, or a list's length, and 0 for anything else.
func captured[T Data](v T) int64 {
    mut n := 0
    switch T {
    case int64:
        run(func() {
            n = v +% 1
        })
    case list[E]:
        run(func() {
            n = len(v)
        })
    default:
    }
    return n
}

// deferred returns v plus 11 for an int64, whose case defers an addition
// of one that runs when the case ends, before the return, and 0 for
// anything else.
func deferred[T Data](v T) int64 {
    mut n := 0
    switch T {
    case int64:
        defer {
            n +%= 1
        }
        n = v +% 10
    default:
    }
    return n
}

// first_byte returns the first byte of v when it is a list of bytes, or a
// list of lists of them at any depth, through a switch on the element
// type nested in the case of the list, and -1 otherwise, or when there is
// none.
func first_byte[T Data](v T) int64 {
    switch T {
    case list[E]:
        switch E {
        case uint8:
            if len(v) > 0 {
                return int64(v[0])
            }
            return -1
        default:
            if len(v) > 0 {
                return first_byte(v[0])
            }
            return -1
        }
    default:
        return -1
    }
}

// same reports whether out holds exactly the bytes of s.
func same(out list[uint8], s string) bool {
    if len(out) != len(s) {
        return false
    }
    for i, c := range out {
        if i >= len(s) || c != s[i] {
            return false
        }
    }
    return true
}

// shows reports whether show writes v as want.
func shows[T Data](v T, want string) bool {
    mut out := make(list[uint8], c_allocator)
    err := show(v, mut out)
    return err.code == 0 && same(out, want)
}

// key returns a Text holding s.
func key(s string) (text.Text, error) {
    mut t := text.new(c_allocator)
    mut t.append([]uint8(s))?
    return t, noerror
}

// item returns an Item holding something of every kind, its last row of
// the grid empty.
func item() (Item, error) {
    name := key("box")?
    mut tags := make(list[int64], c_allocator)
    append(mut tags, 1, 2, 3)?
    mut sizes := make(map[text.Text]int64, c_allocator)
    put(mut sizes, key("a")?, 1)?
    put(mut sizes, key("b")?, 2)?
    mut grid := make(list[list[int32]], c_allocator)
    mut row := make(list[int32], c_allocator)
    append(mut row, 1, 2)?
    append(mut grid, row)?
    append(mut grid, make(list[int32], c_allocator))?
    return Item{
        name:  name,
        at:    Point{x: 1, y: -2},
        tags:  tags,
        sizes: sizes,
        ratio: 0.5,
        ok:    true,
        small: 9,
        grid:  grid,
    }, noerror
}

// itemText is how show writes item's Item.
var itemText = "{name:box at:{x:1 y:-2} tags:[1 2 3] sizes:map[a:1 b:2] ratio:0.5 ok:true small:9 grid:[[1 2] []]}"

// basics checks show and equal on every type that is not a struct, a
// list or a map.
func basics() {
    check(shows(true, "true") && shows(false, "false"), "show bool")
    check(shows(int8(-128), "-128") && shows(int16(300), "300") && shows(int32(-7), "-7") &&
        shows(-9223372036854775807 - 1, "-9223372036854775808"), "show signed")
    check(shows(uint8(255), "255") && shows(uint16(65535), "65535") &&
        shows(uint32(4294967295), "4294967295") &&
        shows(uint64(18446744073709551615), "18446744073709551615"), "show unsigned")
    check(shows(unsafe_size_t(42), "42") && shows(unsafe_uintptr_t(0), "0"), "show target width")
    check(shows(0.5, "0.5") && shows(float32(1.5), "1.5") && shows(1000000.0, "1e+06"), "show float")
    check(equal(true, true) && !equal(true, false) && equal(int8(3), int8(3)) &&
        !equal(uint64(1), uint64(2)) && equal(1.5, 1.5) && !equal(float32(1), float32(2)),
        "equal basic")
}

// texts checks show and equal on Texts, which a case before struct takes.
func texts() {
    a, aerr := key("hi")
    b, berr := key("hi")
    c, cerr := key("ho")
    check(aerr.code == 0 && berr.code == 0 && cerr.code == 0 && shows(a, "hi") &&
        equal(a, b) && !equal(a, c) && count_ints(a) == 0, "text")
}

// composites checks show, equal and count_ints on lists, maps and
// structs, nested in one another.
func composites() {
    mut l := make(list[int64], c_allocator)
    lerr := append(mut l, 1, 2, 3)
    e := make(list[int64], c_allocator)
    check(lerr.code == 0 && shows(l, "[1 2 3]") && shows(e, "[]") && count_ints(l) == 3,
        "list")
    p := Point{x: 3, y: 4}
    check(shows(p, "{x:3 y:4}") && equal(p, Point{x: 3, y: 4}) && !equal(p, Point{x: 3, y: 5}) &&
        count_ints(p) == 2, "struct")
    it, err := item()
    same_it, serr := item()
    mut other, oerr := item()
    mut longer, gerr := item()
    if err.code != 0 || serr.code != 0 || oerr.code != 0 || gerr.code != 0 {
        check(false, "item")
        return
    }
    check(shows(it, itemText) && equal(it, same_it) && count_ints(it) == 10, "item")
    other.at.y = 7
    check(!equal(it, other), "item differs in a nested struct")
    more := append(mut longer.tags, 4)
    check(more.code == 0 && !equal(it, longer), "item differs in a length")
    check(lists_differ(), "item differs deep in a list")
}

// lists_differ reports whether equal tells apart two lists of lists of
// the same lengths that differ in one element of their last list.
func lists_differ() bool {
    mut a := make(list[list[int32]], c_allocator)
    mut b := make(list[list[int32]], c_allocator)
    mut ra := make(list[int32], c_allocator)
    mut rb := make(list[int32], c_allocator)
    e1 := append(mut ra, 1, 2)
    e2 := append(mut rb, 1, 3)
    e3 := append(mut a, ra)
    e4 := append(mut b, rb)
    return e1.code == 0 && e2.code == 0 && e3.code == 0 && e4.code == 0 && !equal(a, b) &&
        equal(a, a) && shows(b, "[[1 3]]")
}

// maps checks show and equal on maps: same keys, a value that differs,
// and a key that differs.
func maps() {
    mut a := make(map[text.Text]int64, c_allocator)
    mut b := make(map[text.Text]int64, c_allocator)
    mut c := make(map[text.Text]int64, c_allocator)
    ok := put_pair(mut a, "x", 1) && put_pair(mut a, "y", 2) &&
        put_pair(mut b, "x", 1) && put_pair(mut b, "y", 2) &&
        put_pair(mut c, "x", 1) && put_pair(mut c, "z", 2)
    check(ok && shows(a, "map[x:1 y:2]") && equal(a, b) && !equal(a, c), "map")
    if ok {
        mut k, kerr := key("y")
        mut perr := noerror
        if kerr.code == 0 {
            perr = put(mut b, k, 3)
        }
        check(kerr.code == 0 && perr.code == 0 && !equal(a, b), "map value differs")
    }
}

// put_pair puts n under a Text holding s in m, and reports whether it
// could.
func put_pair(mut m map[text.Text]int64, s string, n int64) bool {
    k, err := key(s)
    if err.code != 0 {
        return false
    }
    return put(mut m, k, n).code == 0
}

// narrowing checks that each case narrows T: a mut parameter assigned
// with a proven addition, a Text appended to, a list's elements in place,
// a local of type T, a closure and a defer.
func narrowing() {
    mut n := 5
    mut big := 100
    berr := bump(mut n)
    bigerr := bump(mut big)
    mut flag := true
    flagerr := bump(mut flag)
    check(berr.code == 0 && n == 6 && bigerr.code == 0 && big == 100 && flagerr.code == 0 &&
        flag, "bump scalar")
    mut t, terr := key("go")
    if terr.code == 0 {
        e := bump(mut t)
        check(e.code == 0 && t.equal([]uint8("go!")), "bump text")
    } else {
        check(false, "bump text")
    }
    mut l := make(list[int64], c_allocator)
    lerr := append(mut l, 1, 99, 100)
    if lerr.code == 0 {
        e := bump(mut l)
        check(e.code == 0 && len(l) == 3 && shows(l, "[2 100 100]"), "bump list")
    } else {
        check(false, "bump list")
    }
    check(doubled(21) == 42 && doubled(5000) == 0 && doubled(int32(-4)) == -8 &&
        doubled(true) == -1, "local of type T")
    mut c := make(list[int64], c_allocator)
    cerr := append(mut c, 7, 8)
    check(cerr.code == 0 && captured(41) == 42 && captured(c) == 2 && captured(1.5) == 0,
        "closure")
    check(deferred(3) == 14 && deferred(false) == 0, "defer")
}

// nested checks a switch on a list's element type nested in the case of
// the list, and the default of that switch passing an element on.
func nested() {
    mut b := make(list[uint8], c_allocator)
    berr := append(mut b, 'q', 'r')
    mut bb := make(list[list[uint8]], c_allocator)
    mut inner := make(list[uint8], c_allocator)
    ierr := append(mut inner, 'z')
    bberr := append(mut bb, inner)
    i := make(list[int64], c_allocator)
    check(berr.code == 0 && ierr.code == 0 && bberr.code == 0 && first_byte(b) == 'q' &&
        first_byte(bb) == 'z' && first_byte(i) == -1 && first_byte(7) == -1, "nested switch")
}

// failing makes show fail at every allocation in turn, and checks each
// failure is passed on, and that nothing leaks however far it got.
func failing() {
    mut failures := 0
    mut done := false
    for k := range 60 {
        if !done {
            it, err := item()
            if err.code == 0 {
                mut out := make(list[uint8], c_allocator)
                fail_after(k)
                serr := show(it, mut out)
                fail_after(-1)
                if serr.code == 0 {
                    done = same(out, itemText)
                } else if serr.code == 1 {
                    failures +%= 1
                }
            }
        }
    }
    check(done && failures > 0, "show under failure")
}

func main() {
    basics()
    texts()
    check(live() == 0, "texts freed")
    composites()
    check(live() == 0, "composites freed")
    maps()
    check(live() == 0, "maps freed")
    narrowing()
    check(live() == 0, "narrowing freed")
    nested()
    check(live() == 0, "nested freed")
    failing()
    check(live() == 0, "failing freed")
}
