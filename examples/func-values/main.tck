package main

import bytes from "std/bytes"
import path from "std/path"
import text from "std/text"

// A function's name used as a value is a value of its type, func(A, B) R,
// which can be passed, returned, stored in a variable, a struct, an
// array, a list, a map or a union, and called through a name, f(x), with
// the same rules for its arguments as a call by name: mut arguments,
// views, moves and the order they are evaluated in. A function value has
// no zero value, no ==, and does not cross to C.
//
// Every check that allocates runs in a function of its own, and main
// asserts after it that c_allocator's count of live buffers is back to
// zero. Every check prints its name and "ok", or "FAIL".

// live returns how many buffers c_allocator holds, in C.
extern("fv_live") func live() int64

// fail_after makes c_allocator grant the next n requests and refuse every
// one after them, or refuse none again for a negative n, in C.
extern("fv_fail_after") func fail_after(n int64)

// check prints name and whether cond held.
func check(cond bool, name string) {
    print(name)
    if cond {
        print(" ok\n")
    } else {
        print(" FAIL\n")
    }
}

// double returns twice x.
func double(x int64) int64 {
    return x * 2
}

// square returns x times x.
func square(x int64) int64 {
    return x * x
}

// add returns a plus b.
func add(a int64, b int64) int64 {
    return a + b
}

// sub returns a minus b.
func sub(a int64, b int64) int64 {
    return a - b
}

// apply calls f on x.
func apply(f func(int64) int64, x int64) int64 {
    return f(x)
}

// twice calls f on x, then on what that gives.
func twice(f func(int64) int64, x int64) int64 {
    return f(f(x))
}

// pick returns the operation named by op: add for "+", sub for anything
// else.
func pick(op string) func(int64, int64) int64 {
    if op == "+" {
        return add
    }
    return sub
}

// passing passes functions to functions and calls them through locals,
// a mutable one reassigned among them, and through what pick returns.
func passing() {
    f := double
    mut g := square
    a := apply(f, 5)
    b := apply(g, 5)
    g = double
    c := g(7)
    d := twice(square, 3)
    plus := pick("+")
    minus := pick("-")
    check(a == 10 && b == 25 && c == 14 && d == 81, "passed, called and reassigned")
    check(plus(7, 2) == 9 && minus(7, 2) == 5, "returned functions")
}

// bump adds by to n where it is.
func bump(mut n int64, by int64) {
    n = n + by
}

// grow appends x to l, and returns the error append gives.
func grow(mut l list[int64], x int64) error {
    return append(mut l, x)
}

// count returns a list holding 0 through n-1, or as many as fit.
func count(n int64) list[int64] {
    mut l := make(list[int64], c_allocator)
    for i := range n {
        err := append(mut l, i)
        if err.code != 0 {
            return l
        }
    }
    return l
}

// total returns the sum of v's elements.
func total(v []int64) int64 {
    mut n := 0
    for _, x := range v {
        n += x
    }
    return n
}

// consume borrows l, and returns its length.
func consume(l list[int64]) int64 {
    return len(l)
}

// muts calls through function values with mut arguments, views, and
// owned arguments and results, which move in and out as they do by name.
func muts() {
    inc := bump
    mut n := 1
    inc(mut n, 2)
    inc(mut n, 3)
    push := grow
    mut l := count(3)
    e := push(mut l, 9)
    sum := total
    make3 := count
    eat := consume
    m := make3(4)
    five := make3(5)
    eaten := eat(five)
    whole := sum(l)
    mut tail := 0
    if len(l) == 4 {
        tail = sum(l[2:])
    }
    check(n == 6 && e.code == 0 && len(l) == 4 && whole == 0 + 1 + 2 + 9 && tail == 11,
        "mut arguments and views")
    check(len(m) == 4 && eaten == 5, "owned arguments and results")
}

// Op is a named operation.
type Op struct {
    name string
    run func(int64, int64) int64
}

// Machine holds a list of steps and a mutable operation.
type Machine struct {
    steps list[func(int64) int64]
    last func(int64, int64) int64
}

// run applies every step of m to x in order.
func (m Machine) run(x int64) int64 {
    mut v := x
    for _, f := range m.steps {
        v = f(v)
    }
    return v
}

// stored keeps function values in a struct, an array, a list, a map and a
// struct holding a list of them, and calls them from there through
// locals.
func stored() {
    op := Op{name: "add", run: add}
    run := op.run
    ops := [2]Op{op, Op{name: "sub", run: sub}}
    fs := [3]func(int64) int64{double, square, double}
    mut acc := 1
    for _, f := range fs {
        acc = f(acc)
    }
    second := ops[1].run
    mut steps := make(list[func(int64) int64], c_allocator)
    e1 := append(mut steps, square, double)
    mut byName := make(map[string]func(int64, int64) int64, c_allocator)
    e2 := put(mut byName, "+", add)
    e3 := put(mut byName, "-", sub)
    mut got := 0
    if has(byName, "-") {
        minus := byName["-"]
        got = minus(10, 4)
    }
    mut m := Machine{steps: steps, last: add}
    m.last = sub
    last := m.last
    check(run(2, 3) == 5 && second(2, 3) == -1 && acc == 8, "a struct and an array")
    check(e1.code == 0 && e2.code == 0 && e3.code == 0 && got == 6 && len(byName) == 2,
        "a list and a map")
    check(m.run(3) == 18 && last(9, 4) == 5, "a struct holding a list of them")
}

// Node holds a function that takes a Node, which it is called with.
type Node struct {
    n int64
    visit func(Node) int64
}

// depth returns n's own number plus one.
func depth(n Node) int64 {
    return n.n + 1
}

// visits calls a function held by a struct on that struct, and through a
// mut parameter of the struct's type, which it then changes.
func visits() {
    mut n := Node{n: 4, visit: depth}
    v := n.visit
    first := v(n)
    reset(mut n)
    w := n.visit
    check(first == 5 && w(n) == 0, "a struct holding a function of itself")
}

// none returns 0, whatever n holds.
func none(n Node) int64 {
    return n.n - n.n
}

// reset gives n a function that returns 0.
func reset(mut n Node) {
    n.visit = none
}

// Handler holds a function, or none.
type Handler union {
    call func(int64) int64
    none
}

// handle runs h on x, or gives x back when h holds none.
func handle(h Handler, x int64) int64 {
    switch h {
    case call(f):
        return f(x)
    case none:
    }
    return x
}

// unions keeps function values in a union's payload.
func unions() {
    check(handle(Handler.call(square), 4) == 16 && handle(Handler.none, 4) == 4,
        "a union's payload")
}

// Area is anything with an area.
type Area interface {
    area() int64
}

// Rect is a rectangle that knows how to scale its area.
type Rect struct {
    w int64
    h int64
    scale func(int64) int64
}

// area returns r's area, scaled.
func (r Rect) area() int64 {
    s := r.scale
    return s(r.w * r.h)
}

// measure returns a's area passed through f.
func measure[A Area](a A, f func(int64) int64) int64 {
    return f(a.area())
}

// generics passes a function value to a generic function, and a struct
// holding one as its type argument.
func generics() {
    r := Rect{w: 2, h: 3, scale: double}
    check(measure(r, square) == 144, "a generic function and a struct holding one")
}

// log records the order deferred calls ran in, one digit per call.
mut log int64

// mark appends the digit d to log.
func mark(d int64) {
    log = log * 10 + d
}

// deferring calls function values from deferred code, which reads the
// variable when it runs.
func deferring() {
    mut f := mark
    defer {
        f(1)
    }
    defer {
        g := mark
        g(2)
    }
    f = mark
}

// step returns how many steps it takes to count n down to 0, calling
// itself through a function value.
func step(n int64) int64 {
    return down(n, step)
}

// down counts one step and leaves the rest to next.
func down(n int64, next func(int64) int64) int64 {
    if n <= 0 {
        return 0
    }
    return 1 + next(n - 1)
}

// divmod returns a divided by b and the remainder, or 0 and 0 for a b of
// 0.
func divmod(a int64, b int64) (int64, int64) {
    if b == 0 {
        return 0, 0
    }
    q, _ := a / b
    r, _ := a % b
    return q, r
}

// parse returns the digit s holds, or an error when it holds anything
// else.
func parse(s string) (int64, error) {
    if len(s) == 1 && s[0] >= '0' && s[0] <= '9' {
        return int64(s[0] - '0'), noerror
    }
    return 0, error{code: 1, msg: "not a digit"}
}

// results calls functions of several results through values, an error
// among them, and functions of other packages.
func results() {
    dm := divmod
    q, r := dm(17, 5)
    p := parse
    v, err := p("7")
    mut ok := false
    if err.code == 0 {
        ok = v == 7
    }
    _, bad := p("x")
    eq := bytes.equal
    same := eq([]uint8("ab"), []uint8("ab")) && !eq([]uint8("ab"), []uint8("b"))
    check(q == 3 && r == 2 && ok && bad.code == 1 && same, "several results and another package")
}

// joined joins two paths through std/path's join, a function of another
// package that allocates and returns an owned Text and an error.
func joined() {
    join := path.join
    t, err := join([]uint8("a"), []uint8("b"), c_allocator)
    if err.code != 0 {
        check(false, "another package's owned result")
        return
    }
    check(t.equal([]uint8("a/b")), "another package's owned result")
}

// failing appends functions to a list with every allocation from the
// n'th on refused, and reports whether each append either succeeded or
// left the list as it was, and every function in it still runs.
func failing(n int64) bool {
    mut l := make(list[func(int64) int64], c_allocator)
    fail_after(n)
    mut ok := true
    for i := range 20 {
        before := len(l)
        mut err := append(mut l, double)
        if i % 2 == 0 {
            err = append(mut l, square)
        }
        ok = ok && (err.code == 0 || len(l) >= before)
    }
    fail_after(-1)
    for _, f := range l {
        ok = ok && f(3) >= 6
    }
    return ok
}

// texts calls a function value that takes and returns owned Texts.
func texts() {
    mk := text.from_bytes
    t, err := mk([]uint8("hi"), c_allocator)
    check(err.code == 0 && t.len() == 2, "a function value returning an owned struct")
}

func main() {
    passing()
    muts()
    check(live() == 0, "nothing left after passing and calling")
    stored()
    check(live() == 0, "nothing left after storing")
    unions()
    visits()
    generics()
    log = 0
    deferring()
    check(log == 21, "deferred calls")
    check(step(5) == 5, "a function calling itself through a value")
    results()
    joined()
    texts()
    check(live() == 0, "nothing left after several results")
    mut all := true
    for n := range 30 {
        all = all && failing(n)
        all = all && live() == 0
    }
    check(all, "appending functions that cannot grow changes nothing")
}
