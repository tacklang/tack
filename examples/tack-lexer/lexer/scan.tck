package lexer

// Lex lexes src into l, replacing whatever l held. It goes on past an
// error, so every error is recorded, and stops early only when toks is
// full, setting overflow. The tokens end with an EOF token.
pub func Lex(mut l Lexer, src string) {
    l.src = src
    l.pos = 0
    l.n = 0
    l.overflow = false
    l.nerr = 0
    l.dropped = 0
    for l.pos < len(l.src) && !l.overflow {
        c := byteAt(l.src, l.pos)
        next := byteAt(l.src, l.pos +% 1)
        switch {
        case c == ' ' || c == '\t':
            l.pos +%= 1
        case newlineAt(l.src, l.pos) > 0:
            newlines(mut l)
        case isIdentStart(c):
            ident(mut l)
        case c == '"':
            quoted(mut l)
        case c == '`':
            raw(mut l)
        case c == '\'':
            char(mut l)
        case isDigit(c) || c == '.' && isDigit(next):
            number(mut l)
        case c == '/' && next == '/':
            comment(mut l)
        case c == '/' && next == '*':
            blockComment(mut l)
        case operator(mut l):
            // operator added the token and moved past it.
        default:
            fail(mut l, l.pos, l.pos +% 1, "invalid character")
            l.pos +%= 1
        }
    }
    addSemi(mut l, l.pos)
    add(mut l, KindEOF, 0, l.pos, l.pos, false)
}

// newlines skips a run of line ends and inserts a semicolon at the first
// one if the token before it can end a statement.
func newlines(mut l Lexer) {
    first := l.pos
    for mut n := newlineAt(l.src, l.pos); n > 0; n = newlineAt(l.src, l.pos) {
        l.pos +%= n
    }
    addSemi(mut l, first)
}

// ident lexes an identifier, or a keyword when keywords has its text.
func ident(mut l Lexer) {
    start := l.pos
    for l.pos < len(l.src) && (isIdentStart(byteAt(l.src, l.pos)) || isDigit(byteAt(l.src, l.pos))) {
        l.pos +%= 1
    }
    k := keyword(l.src, start, l.pos)
    w, isKeyword := keywords[k]
    if isKeyword {
        add(mut l, KindKeyword, k, start, l.pos, w.ends)
        return
    }
    add(mut l, KindIdent, 0, start, l.pos, true)
}

// keyword returns the index in keywords of the keyword src[start:end]
// spells, or -1 if it spells none. It is a linear search: there is no map,
// and no substring to look one up by.
func keyword(src string, start int64, end int64) int64 {
    for i, w := range keywords {
        if spanIs(src, start, end, w.text) {
            return i
        }
    }
    return -1
}

// number lexes an integer literal: decimal, or hexadecimal, binary or
// octal after a 0x, 0b or 0o prefix in either case, with _ between
// digits; or a decimal float literal, with a fraction point, 1.5, .5 or
// 1., an exponent, 1e9 or 1.5e-3, or both, and _ only between digits,
// whose exponent must have a digit. A prefixed literal takes every letter, digit and _ after its
// prefix. A prefix with no digit, a digit its base lacks, a _ that
// separates no digits, and a decimal literal of more than one digit
// starting with 0 are reported.
func number(mut l Lexer) {
    start := l.pos
    base := prefixBase(l.src, l.pos)
    if base != 0 {
        l.pos +%= 2
        for l.pos < len(l.src) && (isIdentStart(byteAt(l.src, l.pos)) || isDigit(byteAt(l.src, l.pos))) {
            l.pos +%= 1
        }
        mut digits := 0
        mut bad := -1
        for mut i := start +% 2; i < l.pos; i +%= 1 {
            c := byteAt(l.src, i)
            if c != '_' {
                digits +%= 1
                if bad < 0 && digitValue(c) >= base {
                    bad = i
                }
            }
        }
        if digits == 0 {
            fail(mut l, start, l.pos, "integer literal has no digits")
        } else if bad >= 0 {
            fail(mut l, bad, bad +% 1, "invalid digit in integer literal")
        } else if !separated(l.src, start, l.pos, start +% 2) {
            fail(mut l, start, l.pos, "_ must separate successive digits")
        }
        add(mut l, KindInt, 0, start, l.pos, true)
        return
    }
    mut isFloat := false
    for l.pos < len(l.src) && (isDigit(byteAt(l.src, l.pos)) || byteAt(l.src, l.pos) == '_' ||
        byteAt(l.src, l.pos) == '.' && !isFloat) {
        if byteAt(l.src, l.pos) == '.' {
            isFloat = true
        }
        l.pos +%= 1
    }
    mut expDigits := true
    if byteAt(l.src, l.pos) == 'e' || byteAt(l.src, l.pos) == 'E' {
        isFloat = true
        expDigits = false
        l.pos +%= 1
        if byteAt(l.src, l.pos) == '+' || byteAt(l.src, l.pos) == '-' {
            l.pos +%= 1
        }
        for l.pos < len(l.src) && (isDigit(byteAt(l.src, l.pos)) || byteAt(l.src, l.pos) == '_') {
            if isDigit(byteAt(l.src, l.pos)) {
                expDigits = true
            }
            l.pos +%= 1
        }
    }
    if !expDigits {
        fail(mut l, start, l.pos, "exponent has no digits")
    } else if isFloat {
        if !floatSeparated(l.src, start, l.pos) {
            fail(mut l, start, l.pos, "_ must separate successive digits")
        }
    } else if !separated(l.src, start, l.pos, start) {
        fail(mut l, start, l.pos, "_ must separate successive digits")
    } else if l.pos -% start > 1 && byteAt(l.src, start) == '0' {
        fail(mut l, start, l.pos, "integer literal has a leading zero")
    }
    if isFloat {
        add(mut l, KindFloat, 0, start, l.pos, true)
    } else {
        add(mut l, KindInt, 0, start, l.pos, true)
    }
}

// floatSeparated reports whether every _ in src[start:end], a float
// literal, stands between two digits.
func floatSeparated(src string, start int64, end int64) bool {
    for mut i := start; i < end; i++ {
        if byteAt(src, i) == '_' && (i == start || !isDigit(byteAt(src, i -% 1)) || i + 1 == end ||
            !isDigit(byteAt(src, i + 1))) {
            return false
        }
    }
    return true
}

// prefixBase returns the base of the integer literal at pos in src when
// it starts with a prefix, 0x, 0b or 0o in either case, and 0 otherwise.
func prefixBase(src string, pos int64) int64 {
    if byteAt(src, pos) != '0' {
        return 0
    }
    switch byteAt(src, pos +% 1) {
    case 'x', 'X':
        return 16
    case 'b', 'B':
        return 2
    case 'o', 'O':
        return 8
    }
    return 0
}

// digitValue returns the value of c as a digit of a base up to 16, or 16
// when it is none.
func digitValue(c uint8) int64 {
    if isDigit(c) {
        return c -% '0'
    }
    if c >= 'a' && c <= 'f' {
        return c - 'a' + 10
    }
    if c >= 'A' && c <= 'F' {
        return c - 'A' + 10
    }
    return 16
}

// separated reports whether every _ in src[start:end], an integer literal
// whose digits start at first, stands between two digits, or, right after a
// prefix, before one.
func separated(src string, start int64, end int64, first int64) bool {
    for mut i := first; i < end; i++ {
        if byteAt(src, i) != '_' {
            continue
        }
        before := i > first && byteAt(src, i -% 1) != '_' || i == first && first == start +% 2
        after := i + 1 < end && byteAt(src, i + 1) != '_'
        if !before || !after {
            return false
        }
    }
    return true
}

// operator lexes the longest operator the source starts with at the
// position, and reports false, consuming nothing, if none does.
func operator(mut l Lexer) bool {
    for i, op := range operators {
        if hasPrefixAt(l.src, l.pos, op.text) {
            add(mut l, KindOp, i, l.pos, l.pos +% len(op.text), op.ends)
            l.pos +%= len(op.text)
            return true
        }
    }
    return false
}

// comment lexes a line comment, or a run of them on consecutive lines,
// however each is indented, as one token that ends before the last line's
// end. A semicolon goes before it if the token before can end a
// statement; the line end after it inserts none, since a comment cannot
// end a statement.
func comment(mut l Lexer) {
    start := l.pos
    l.pos +%= 2
    for l.pos < len(l.src) {
        n := newlineAt(l.src, l.pos)
        if n == 0 {
            l.pos +%= 1
            continue
        }
        mut next := l.pos +% n
        for byteAt(l.src, next) == ' ' || byteAt(l.src, next) == '\t' {
            next +%= 1
        }
        if !hasPrefixAt(l.src, next, "//") {
            break
        }
        l.pos = next +% 2
    }
    addSemi(mut l, start)
    add(mut l, KindComment, 0, start, l.pos, false)
}

// blockComment lexes a block comment, from "/*" to the "*/" that closes
// it, as one token. Block comments nest: each "/*" inside needs its own
// "*/". One that spans a line end acts as one, so a semicolon goes before
// it if the token before can end a statement; one on a single line acts
// as a space. One never closed runs to the end of the source and is an
// error.
func blockComment(mut l Lexer) {
    start := l.pos
    l.pos +%= 2
    mut depth := 1
    mut lines := false
    for l.pos < len(l.src) && depth > 0 {
        n := newlineAt(l.src, l.pos)
        switch {
        case hasPrefixAt(l.src, l.pos, "/*"):
            depth +%= 1
            l.pos +%= 2
        case hasPrefixAt(l.src, l.pos, "*/"):
            depth -%= 1
            l.pos +%= 2
        case n > 0:
            lines = true
            l.pos +%= n
        default:
            l.pos +%= 1
        }
    }
    if lines {
        addSemi(mut l, start)
    }
    add(mut l, KindComment, 0, start, l.pos, false)
    if depth > 0 {
        fail(mut l, start, l.pos, "block comment not terminated")
    }
}

// The wrapping operators in this file, +% -% *% and their compound
// forms, stand where nothing proves a value's bound but this program's
// own fixed data keeps it within its type, so none of them wraps; one
// that is meant to wrap says so where it is.
