package main

// Expressions nested deeper than C compilers parse, generated by
// deepProgram in codegen/c/deep_test.go: each check prints its name and
// ok when the value computed is the one Tack defines, wrapping included.

type Pair struct {
    a int64
    b int64
}

func check(cond bool, name string) {
    print(name)
    if cond {
        print(" ok\n")
    } else {
        print(" FAIL\n")
    }
}

func inc(v int64) int64 {
    return v + 1
}

func sub(a int64, b int64) int64 {
    return a - b
}

func tick(mut c int64) int64 {
    c += 1
    return c
}

func add_int8(x int8) int8 {
    return x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x
}

func minus_int8(x int8) int8 {
    return x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x
}

func times_int8(x int8) int8 {
    return x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x
}

func add_int16(x int16) int16 {
    return x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x
}

func minus_int16(x int16) int16 {
    return x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x
}

func times_int16(x int16) int16 {
    return x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x
}

