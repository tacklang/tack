}

func minus_int32(x int32) int32 {
    return x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x
}

func times_int32(x int32) int32 {
    return x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x
}

func add_int64(x int64) int64 {
    return x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x
}

func minus_int64(x int64) int64 {
    return x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x
}

func times_int64(x int64) int64 {
    return x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x
}

func right_int64(x int64) int64 {
    return x + (x + (x + (x + (x + (x + (x + (x + (x + (x + (x + (x + (x + (x + (x + (x + (x + (x + (x + (x)))))))))))))))))))
}

func add_uint8(x uint8) uint8 {
    return x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x
}

func minus_uint8(x uint8) uint8 {
    return x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x
}

func times_uint8(x uint8) uint8 {
    return x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x
}

func add_uint16(x uint16) uint16 {
    return x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x
}

func minus_uint16(x uint16) uint16 {
    return x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x
}

func times_uint16(x uint16) uint16 {
    return x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x
}

func add_uint32(x uint32) uint32 {
    return x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x
}

func minus_uint32(x uint32) uint32 {
    return x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x
}

func times_uint32(x uint32) uint32 {
    return x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x
}

func add_uint64(x uint64) uint64 {
    return x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x
}

func minus_uint64(x uint64) uint64 {
    return x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x
}

func times_uint64(x uint64) uint64 {
    return x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x * x
}

func right_uint64(x uint64) uint64 {
    return x + (x + (x + (x + (x + (x + (x + (x + (x + (x + (x + (x + (x + (x + (x + (x + (x + (x + (x + (x)))))))))))))))))))
}

func mixed(x int64) int64 {
    return (((((((((((((((((((((((((((((((((((((((x + 7) * 3) - 11) / 2) % 1000003) + 7) * 3) - 11) / 2) % 1000003) + 7) * 3) - 11) / 2) % 1000003) + 7) * 3) - 11) / 2) % 1000003) + 7) * 3) - 11) / 2) % 1000003) + 7) * 3) - 11) / 2) % 1000003) + 7) * 3) - 11) / 2) % 1000003) + 7) * 3) - 11) / 2)
}

func mixed_right(x int64) int64 {
    return x * (x - (x + (x * (x - (x + (x * (x - (x + (x * (x - (x + (x * (x - (x + (x * (x - (x + (x * (x)))))))))))))))))))
}

func calls(x int64) int64 {
    return inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(inc(x))))))))))))))))))))))))))))))))))))
}

func calls_right(x int64) int64 {
    return sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, sub(x, 0))))))))))))))))))))))))))))))))))))
}

func negated(x int64) int64 {
    return -(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(-(x))))))))))))))))))))))))))))))))))))
}

func order_left() int64 {
    mut c int64 = 0
    return c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c)
}

func order_right() int64 {
    mut c int64 = 0
    return c + (tick(mut c) + (c + (tick(mut c) + (c + (tick(mut c) + (c + (tick(mut c) + (c + (tick(mut c) + (c + (tick(mut c) + (c + (tick(mut c) + (c + (tick(mut c) + (c + (tick(mut c) + (c + (tick(mut c) + (c + (tick(mut c) + (c + (tick(mut c) + (c + (tick(mut c) + (c + (tick(mut c) + (c + (tick(mut c) + (c + (tick(mut c) + (c + (tick(mut c) + (c + (tick(mut c) + (c + (tick(mut c) + (c + (tick(mut c))))))))))))))))))))))))))))))))))))))))
}

func guarded(run bool) int64 {
    mut c int64 = 0
    if run && c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) + c + tick(mut c) > 0 {
        return c
    }
    return c
}

func ands(x int64) int64 {
    mut c int64 = 0
    if x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && tick(mut c) > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 && x > 0 {
        return c + 10
    }
    return c
}

func ors(x int64) int64 {
    mut c int64 = 0
    if x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || tick(mut c) < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 || x < 0 {
        return c + 10
    }
    return c
}

func looped(x int64) int64 {
    mut i int64 = 0
    for x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + i < 64 {
        i += 1
    }
    return i
}

func ticked(x int64) int64 {
    mut c int64 = 0
    mut n int64 = 0
    for tick(mut c) + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x < 65 {
        n += 1
    }
    return n * 100 + c
}

func deferred(x int64) int64 {
    defer {
        check(x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x == 60, "a deep defer")
    }
    return x
}

func two(x int64) (int64, int64) {
    return x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x, x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x - x
}

func paired(x int64) Pair {
    return Pair{a: x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x, b: x * x * x}
}

func indexed(x uint8) int64 {
    mut a [256]int64
    for i := range a {
        a[i] = i * 2
    }
    a[x] = a[x] + a[x] + a[x] + a[x] + a[x] + a[x] + a[x] + a[x] + a[x] + a[x] + a[x] + a[x] + a[x] + a[x] + a[x] + a[x] + a[x] + a[x] + a[x] + a[x]
    return a[x]
}

func checked(x int64) (int64, bool) {
    a := [4]int64{10, 20, 30, 40}
    v, ok := a[x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x - 58]
    return v, ok
}

func both(x int64) bool {
    a, b := two(x)
    return a == 60 && b == -54
}

func in_range() bool {
    v, ok := checked(3)
    return ok && v == 30
}

func out_of_range() bool {
    v, ok := checked(4)
    return !ok && v == 0
}

func main() {
    check(add_int8(100) == -48, "20 terms of + in int8")
    check(minus_int8(100) == -8, "20 terms of - in int8")
    check(times_int8(3) == -111, "20 terms of * in int8")
    check(add_int16(100) == 2000, "20 terms of + in int16")
    check(minus_int16(100) == -1800, "20 terms of - in int16")
    check(times_int16(3) == 7057, "20 terms of * in int16")
    check(add_int32(100) == 2000, "20 terms of + in int32")
    check(minus_int32(100) == -1800, "20 terms of - in int32")
    check(times_int32(3) == -808182895, "20 terms of * in int32")
    check(add_int64(100) == 2000, "20 terms of + in int64")
    check(minus_int64(100) == -1800, "20 terms of - in int64")
    check(times_int64(3) == 3486784401, "20 terms of * in int64")
    check(right_int64(3) == 60, "20 right-nested terms of + in int64")
    check(add_uint8(100) == 208, "20 terms of + in uint8")
    check(minus_uint8(100) == 248, "20 terms of - in uint8")
    check(times_uint8(3) == 145, "20 terms of * in uint8")
    check(add_uint16(100) == 2000, "20 terms of + in uint16")
    check(minus_uint16(100) == 63736, "20 terms of - in uint16")
    check(times_uint16(3) == 7057, "20 terms of * in uint16")
    check(add_uint32(100) == 2000, "20 terms of + in uint32")
    check(minus_uint32(100) == 4294965496, "20 terms of - in uint32")
    check(times_uint32(3) == 3486784401, "20 terms of * in uint32")
    check(add_uint64(100) == 2000, "20 terms of + in uint64")
    check(minus_uint64(100) == 18446744073709549816, "20 terms of - in uint64")
    check(times_uint64(3) == 3486784401, "20 terms of * in uint64")
    check(right_uint64(3) == 60, "20 right-nested terms of + in uint64")
    check(mixed(5) == 356, "40 mixed operators")
    check(mixed_right(2) == 256, "20 right-nested mixed operators")
    check(calls(1) == 37, "36 nested calls")
    check(calls_right(4) == 0, "36 calls nested in the second argument")
    check(negated(9) == 9, "36 nested minuses")
    check(order_left() == 400, "40 terms run left to right")
    check(order_right() == 400, "40 right-nested terms run left to right")
    check(guarded(false) == 0, "a deep right side of && does not run")
    check(guarded(true) == 20, "a deep right side of && runs")
    check(ands(1) == 11, "36 terms of && hold")
    check(ands(-1) == 0, "36 terms of && stop at the first")
    check(ors(1) == 1, "36 terms of || fail")
    check(ors(-1) == 10, "36 terms of || stop at the first")
    check(looped(3) == 4, "a deep loop condition")
    check(ticked(3) == 405, "a deep loop condition with a call, tested five times")
    check(deferred(3) == 3, "a deep defer's function returns")
    check(both(3), "two deep results")
    check(paired(3).a == 60 && paired(3).b == 27, "a deep struct literal field")
    check(indexed(3) == 120, "a deep chain of elements, assigned to one")
    check(in_range(), "a deep checked index in range")
    check(out_of_range(), "a deep checked index out of range")
}
