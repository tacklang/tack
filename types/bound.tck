pub func (mut b Bound) field_count(typ Type) (int64, error) {
    r := mut b.t.bound_field_count(typ)?
    return r, noerror
}

// param is Go's FuncParams(typ)[i] under the binding in force, and
// whether there is one.
pub func (mut b Bound) param(typ Type, i int64) (FuncParam, bool, error) {
    p, ok := mut b.t.bound_param(typ, i)?
    return p, ok, noerror
}

// result is Go's FuncResults(typ)[i] under the binding in force, invalid
// for none.
pub func (mut b Bound) result(typ Type, i int64) (Type, error) {
    r := mut b.t.bound_result(typ, i)?
    return r, noerror
}

// case_at is Go's Cases(typ)[i] under the binding in force, and whether
// there is one; case_name gives its name.
pub func (mut b Bound) case_at(typ Type, i int64) (Case, bool, error) {
    c, ok := mut b.t.bound_case(typ, i)?
    return c, ok, noerror
}

// case_name appends to out the name of c, a case case_at gave.
pub func (mut b Bound) case_name(c Case, mut out list[uint8]) error {
    append(mut out, b.t.text(c.name.start, c.name.end)...)?
    return noerror
}

// find_case is Go's Case under the binding in force.
pub func (mut b Bound) find_case(typ Type, name []uint8) (Case, int64, bool, error) {
    c, at, ok := mut b.t.bound_find_case(typ, name)?
    return c, at, ok, noerror
}

// field_type is Go's Fields(typ)[i].Type under the binding in force, and
// whether there is one.
pub func (mut b Bound) field_type(typ Type, i int64) (Type, bool, error) {
    f, ok := mut b.t.bound_field_type(typ, i)?
    return f, ok, noerror
}

// field_name appends Go's Fields(typ)[i].Name under the binding in force.
pub func (mut b Bound) field_name(typ Type, i int64, mut out list[uint8]) error {
    return mut b.t.bound_field_name(typ, i, mut out)
}

// find_field is Go's Field under the binding in force.
pub func (mut b Bound) find_field(typ Type, name []uint8) (Type, int64, bool, error) {
    f, at, ok := mut b.t.bound_find_field(typ, name)?
    return f, at, ok, noerror
}

// kind_name is Table.kind_name of what typ stands for under the binding
// in force: the dump's name of its kind, Go's typeKind there.
pub func (mut b Bound) kind_name(typ Type) (string, error) {
    r := mut b.t.bound(typ)?
    return b.t.kind_name(r), noerror
}

// owner is the package the struct or union type typ stands for under
// the binding in force is declared in, an index among the program's
// packages, or -1 for none, which Go's backend reads from the
// declaration it maps each struct to (see bound_owner).
pub func (mut b Bound) owner(typ Type) (int64, error) {
    r := mut b.t.bound_owner(typ)?
    return r, noerror
}

// count is Go's Count: how many types the Table has added.
pub func (mut b Bound) count() int64 {
    return b.t.count()
}

// errors is Go's Table.Errors: the errors of the compilation.
pub func (mut b Bound) errors() int64 {
    return b.t.errors
}

// array_of is Go's Array: the type, added if the Table does not have it.
pub func (mut b Bound) array_of(elem Type, n int64) (Type, error) {
    r := mut b.t.array_of(elem, n)?
    return r, noerror
}

// view_of is Go's View: the type, added if the Table does not have it.
pub func (mut b Bound) view_of(elem Type) (Type, error) {
    r := mut b.t.view_of(elem)?
    return r, noerror
}

