// map_of is Go's Map: the type, added if the Table does not have it.
pub func (mut b Bound) map_of(key Type, value Type) (Type, error) {
    r := mut b.t.map_of(key, value)?
    return r, noerror
}

// func_of is Go's Func: the type, added if the Table does not have it.
pub func (mut b Bound) func_of(params []FuncParam, results []Type) (Type, error) {
    r := mut b.t.func_of(params, results)?
    return r, noerror
}
