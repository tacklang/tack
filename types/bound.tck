package types

import text from "std/text"

// Bound is the type table as code generation reads it: a Table it holds
// and hides, whose every query it answers under the binding in force,
// as Go's Table answers every query (see query.tck), and whose bindings
// it makes (see bind.tck). The Table's own queries, which answer about
// the type they are given as the type checker asks them, are not
// reachable through a Bound: its one field is private to this package,
// and it gives out no Table, so a backend handed a Bound, as typeck's
// Typed hands one, can ask no query that skips the binding. With
// nothing bound, each answers as the Table's own does and adds nothing.
//
// Its methods are Go's Table's, by the port's names: bind, bind_more,
// restore, unbind, binding and bound; the queries, is_func to
// is_struct, key_of, elem_of, len_of, owned, has_zero, the holds_
// queries, size, name, name_with and has_type_param, Go's HasTypeParam;
// a function type's parameters and results, a union's cases and a
// struct's fields a part at a time, param_count and param, result_count
// and result, case_count, case_at and case_name, find_case,
// field_count, field_type, field_name and find_field; kind_name, the
// dump's name of a type's kind; owner, the package that declares a
// struct or a union, which Go's backend reads from its declaration; the constructors, array_of to func_of,
// which bind nothing, as Go's do not; and count and errors.
pub type Bound struct {
    t Table
}

// bound_table returns a Bound of t, taken over.
pub func bound_table(own t Table) Bound {
    return Bound{t: t}
}

// bind is Table.bind, Go's Bind: args, taken over, binds each type
// parameter it holds a key of to its value, or unbindable.
pub func (mut b Bound) bind(own args map[Type]Type) error {
    return mut b.t.bind(own args)
}

// unbind is Go's Unbind.
pub func (mut b Bound) unbind() {
    mut b.t.unbind()
}

// bind_more is Go's BindMore: what restore puts back, or unbindable.
pub func (mut b Bound) bind_more(args map[Type]Type) (Saved, error) {
    s := mut b.t.bind_more(args)?
    return s, noerror
}

// restore puts back the binding bind_more replaced, s, taken over.
pub func (mut b Bound) restore(own s Saved) {
    mut b.t.restore(own s)
}

// binding is Go's Binding: a copy of the binding in force, and whether
// one is.
pub func (mut b Bound) binding() (map[Type]Type, bool, error) {
    m, on := b.t.binding()?
    return m, on, noerror
}

// bound is Go's Bound: what typ stands for under the binding in force.
pub func (mut b Bound) bound(typ Type) (Type, error) {
    r := mut b.t.bound(typ)?
    return r, noerror
}

// has_type_param is Go's HasTypeParam under the binding in force.
pub func (mut b Bound) has_type_param(typ Type) (bool, error) {
    r := mut b.t.bound_has_type_param(typ)?
    return r, noerror
}

// name_with is Go's NameWith under the binding in force, with the
// qualifier Table.name_with describes.
pub func (mut b Bound) name_with(typ Type, pkg int64, prefixes []text.Text, every bool, mut out list[uint8]) error {
    return mut b.t.name_with(typ, pkg, prefixes, every, mut out)
}

// name is Go's Name under the binding in force.
pub func (mut b Bound) name(typ Type) (list[uint8], error) {
    r := mut b.t.bound_name(typ)?
    return r, noerror
}

