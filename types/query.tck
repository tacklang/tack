    r := mut t.size(b)?
    return r, noerror
}

// bound_name is name under the binding in force, Go's Name: name_with
// qualifying no type.
func (mut t Table) bound_name(typ Type) (list[uint8], error) {
    mut out := make(list[uint8], c_allocator)
    none := make(list[text.Text], c_allocator)
    mut t.name_with(typ, -1, none[:], false, mut out)?
    return out, noerror
}

// The queries that give a view of the Table's lists, Go's FuncParams,
// FuncResults, Cases and Fields, are asked here a part at a time, since
// a method that may add a type, and so may fail, cannot give a view:
// how many there are, and each by its place, each binding typ first.

// bound_param_count is len(func_params) under the binding in force, Go's
// len(FuncParams).
func (mut t Table) bound_param_count(typ Type) (int64, error) {
    b := mut t.bound(typ)?
    return len(t.func_params(b)), noerror
}

// bound_param is func_params(typ)[i] under the binding in force, Go's
// FuncParams(typ)[i], and whether there is one.
func (mut t Table) bound_param(typ Type, i int64) (FuncParam, bool, error) {
    b := mut t.bound(typ)?
    p, ok := t.func_params(b)[i]
    return p, ok, noerror
}

// bound_result_count is len(func_results) under the binding in force,
// Go's len(FuncResults).
func (mut t Table) bound_result_count(typ Type) (int64, error) {
    b := mut t.bound(typ)?
    return len(t.func_results(b)), noerror
}

// bound_result is func_results(typ)[i] under the binding in force, Go's
// FuncResults(typ)[i], invalid for none.
func (mut t Table) bound_result(typ Type, i int64) (Type, error) {
    b := mut t.bound(typ)?
    r, ok := t.func_results(b)[i]
    if !ok {
        return invalid, noerror
    }
    return r, noerror
}

// bound_case_count is len(cases) under the binding in force, Go's
// len(Cases).
func (mut t Table) bound_case_count(typ Type) (int64, error) {
    b := mut t.bound(typ)?
    return len(t.cases(b)), noerror
}

// bound_case is cases(typ)[i] under the binding in force, Go's
// Cases(typ)[i], and whether there is one.
func (mut t Table) bound_case(typ Type, i int64) (Case, bool, error) {
    b := mut t.bound(typ)?
    c, ok := t.cases(b)[i]
    return c, ok, noerror
}

// bound_find_case is find_case under the binding in force, Go's Case.
func (mut t Table) bound_find_case(typ Type, name []uint8) (Case, int64, bool, error) {
    b := mut t.bound(typ)?
    c, at, ok := t.find_case(b, name)
    return c, at, ok, noerror
}

// bound_field_count is field_count under the binding in force, Go's
// len(Fields).
func (mut t Table) bound_field_count(typ Type) (int64, error) {
    b := mut t.fields_type(typ)?
    return t.field_count(b), noerror
}

// bound_field_type is field_type under the binding in force, Go's
// Fields(typ)[i].Type, and whether there is one.
func (mut t Table) bound_field_type(typ Type, i int64) (Type, bool, error) {
    b := mut t.fields_type(typ)?
    f, ok := t.field_type(b, i)
    return f, ok, noerror
}

// bound_field_name appends to out the name of field_type's field,
// Go's Fields(typ)[i].Name.
func (mut t Table) bound_field_name(typ Type, i int64, mut out list[uint8]) error {
    b := mut t.fields_type(typ)?
    append(mut out, t.field_name(b, i)...)?
    return noerror
}

// bound_find_field is find_field under the binding in force, Go's Field.
func (mut t Table) bound_find_field(typ Type, name []uint8) (Type, int64, bool, error) {
    b := mut t.fields_type(typ)?
    f, at, ok := t.find_field(b, name)
    return f, at, ok, noerror
}

// fields_type returns the type whose fields Go's Fields gives for typ
// under the binding in force: error for error itself, what typ stands
// for when that is a struct the Table added, and invalid, which has
// none, for anything else, a type standing for error among them.
func (mut t Table) fields_type(typ Type) (Type, error) {
    if typ == error_type {
        return typ, noerror
    }
    b := mut t.bound(typ)?
    if b == error_type || !t.is_struct(b) {
        return invalid, noerror
    }
    return b, noerror
}
