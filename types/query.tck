// bound_owned is owned under the binding in force, Go's Owned.
func (mut t Table) bound_owned(typ Type) (bool, error) {
    b := mut t.bound(typ)?
    r := t.owned(b)?
    return r, noerror
}

// bound_has_zero is has_zero under the binding in force, Go's HasZero,
// which asks whether typ itself, not what it stands for, is the
// allocator, before it binds it.
func (mut t Table) bound_has_zero(typ Type) (bool, error) {
    b := mut t.bound(typ)?
    if b == allocator && typ != allocator {
        return true, noerror
    }
    r := t.has_zero(b)?
    return r, noerror
}

// bound_holds_list is holds_list under the binding in force, Go's HoldsList.
func (mut t Table) bound_holds_list(typ Type) (bool, error) {
