-- type-switch-defers-run-under-sanitizers/main.tck --
package main

mut seen int64

func note(n int64) {
    seen = seen *% 10 +% n
}

func f(a any, xs ...any) int64 {
    defer {
        switch v := a.(type) {
        case int64:
            note(v)
        }
    }
    for _, x := range xs {
        switch v := x.(type) {
        case int64:
            defer {
                note(v)
            }
            if v == 3 {
                return v
            }
            continue
        case string:
            defer {
                note(len(v))
            }
            break
        }
    }
    return 0
}

func main() {
    seen = 0
    r := f(7, 1, 2, 3, 4)
    if r != 3 || seen != 1237 {
        exit(1)
    }
    seen = 0
    r2 := f(5, 1, "ab", 9)
    if r2 != 0 || seen != 125 {
        exit(2)
    }
}
