package main

func kind(a any) int64 {
    switch v := a.(type) {
    case int8:
        if v == -128 {
            return 1
        }
    case int16:
        if v == 32767 {
            return 2
        }
    case int32:
        if v == -2147483648 {
            return 3
        }
    case int64:
        if v == 9223372036854775807 {
            return 4
        }
    case uint8:
        if v == 255 {
            return 5
        }
    case uint16:
        if v == 65535 {
            return 6
        }
    case uint32:
        if v == 4294967295 {
            return 7
        }
    case uint64:
        if v == 18446744073709551615 {
            return 8
        }
    case unsafe_size_t:
        if v == 4294967295 {
            return 9
        }
    case unsafe_uintptr_t:
        if v == 0 {
            return 10
        }
    case bool:
        if v {
            return 11
        }
    case string:
        if len(v) == 3 && v[2] == 'c' {
            return 12
        }
    default:
        return 13
    }
    return 0
}

func empty(xs ...any) int64 {
    e, ok := xs[len(xs)]
    if ok {
        return -1
    }
    n, isInt := e.(int64)
    s, isString := e.(string)
    if isInt || isString || n != 0 || len(s) != 0 {
        return -2
    }
    return kind(e)
}

func main() {
    var i8 int8 = -128
    var i16 int16 = 32767
    var i32 int32 = -2147483648
    var u8 uint8 = 255
    var u16 uint16 = 65535
    var u32 uint32 = 4294967295
    var u64 uint64 = 18446744073709551615
    var sz unsafe_size_t = 4294967295
    var up unsafe_uintptr_t = 0
    if kind(i8) != 1 || kind(i16) != 2 || kind(i32) != 3 || kind(9223372036854775807) != 4 {
        exit(1)
    }
    if kind(u8) != 5 || kind(u16) != 6 || kind(u32) != 7 || kind(u64) != 8 {
        exit(2)
    }
    if kind(sz) != 9 || kind(up) != 10 || kind(true) != 11 || kind("abc") != 12 {
        exit(3)
    }
    if kind(false) != 0 || kind("ab") != 0 || kind(int8(0)) != 0 {
        exit(4)
    }
    if empty() != 13 || empty(1, "s") != 13 {
        exit(5)
    }
}
