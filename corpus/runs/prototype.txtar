-- lexer-program/record --
replaces tack/main_test.go TestBuiltTackLexer/program
dir examples/tack-lexer
target cmd/lex
stdin "package main\n"
stdin "\n"
stdin "func main() {\n"
stdin "\tx := \"a\\tb\" // hi\n"
stdin "\ty := '\\n'\n"
stdin "\tif x <= 10 && y != 0 { x++ }\n"
stdin "}\n"
exit 33
stdout "keyword 0 7 \"package\"\n"
stdout "ident 8 12 \"main\"\n"
stdout "; 12 12 \"\"\n"
stdout "keyword 14 18 \"func\"\n"
stdout "ident 19 23 \"main\"\n"
stdout "( 23 24 \"(\"\n"
stdout ") 24 25 \")\"\n"
stdout "{ 26 27 \"{\"\n"
stdout "ident 29 30 \"x\"\n"
stdout ":= 31 33 \":=\"\n"
stdout "string 34 40 \"\\\"a\\\\tb\\\"\"\n"
stdout "comment 41 46 \"// hi\"\n"
stdout "; 46 46 \"\"\n"
stdout "ident 48 49 \"y\"\n"
stdout ":= 50 52 \":=\"\n"
stdout "char 53 57 \"'\\\\n'\"\n"
stdout "; 57 57 \"\"\n"
stdout "keyword 59 61 \"if\"\n"
stdout "ident 62 63 \"x\"\n"
stdout "<= 64 66 \"<=\"\n"
stdout "int 67 69 \"10\"\n"
stdout "&& 70 72 \"&&\"\n"
stdout "ident 73 74 \"y\"\n"
stdout "!= 75 77 \"!=\"\n"
stdout "int 78 79 \"0\"\n"
stdout "{ 80 81 \"{\"\n"
stdout "ident 82 83 \"x\"\n"
stdout "++ 83 85 \"++\"\n"
stdout "} 86 87 \"}\"\n"
stdout "; 87 87 \"\"\n"
stdout "} 88 89 \"}\"\n"
stdout "; 89 89 \"\"\n"
stdout "EOF 90 90 \"\"\n"
stderr ""
-- logical/record --
replaces tack/main_test.go TestBuiltLogicalShortCircuitsAndExits13
dir examples/logical
exit 13
stdout "first\n"
stdout "second\n"
stderr ""
-- os/record --
replaces tack/main_test.go TestBuiltOsPassesEveryCheck/0
replaces tack/main_test.go TestBuiltOsPassesEveryCheck/1
replaces tack/main_test.go TestBuiltOsPassesEveryCheck/2
replaces tack/main_test.go TestBuiltOsPassesEveryCheck/3
replaces tack/main_test.go TestBuiltOsPassesEveryCheck/s
replaces tack/main_test.go TestBuiltOsPassesEveryCheck/z
dir examples/os
opt 0 1 2 3 s z
arg "one"
arg ""
arg "two words"
env "TACK_OS_EXAMPLE=set by the test"
env "TACK_OS_EXAMPLE_EMPTY="
limit nofile 64
lacks stdout "FAIL"
stdout-file examples/os/output
exit 0
stderr ""
-- packages-calc/record --
replaces tack/main_test.go TestBuiltPackagesRunsBothMains/calc
dir examples/packages
target cmd/calc
exit 15
stdout "packages ok\n"
stderr ""
-- packages-calc-by-path/record --
replaces tack/main_test.go TestBuiltPackagesRunsBothMains/calc_by_path
dir examples/packages
target calc/cmd/calc
exit 15
stdout "packages ok\n"
stderr ""
-- packages-count/record --
replaces tack/main_test.go TestBuiltPackagesRunsBothMains/count
dir examples/packages
target cmd/count
exit 34
stdout ""
