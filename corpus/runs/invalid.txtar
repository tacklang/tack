-- probe-cflags-level/main.tck --
package main

extern("probe_opt") func optimized() int64

func main() {
    code, fits := int32(optimized())
    if fits { exit(code) }
}
-- probe-cflags-level/opt.c --
#include "tack.h"

int64_t probe_opt(void) {
#ifdef __OPTIMIZE__
    return 1;
#else
    return 0;
#endif
}
