-- probe-env-tmpdir/class --
env
-- probe-env-tmpdir/main.tck --
package main

import os from "std/os"

func main() {
    tmp, set, e := os.env([]uint8("TMPDIR"), c_allocator)
    if e.code != 0 || !set {
        exit(1)
    }
    if os.make_dir(tmp.bytes()).code != 0 {
    }
    mut p := make(list[uint8], c_allocator)
    if append(mut p, tmp.bytes()...).code != 0 {
        exit(3)
    }
    if append(mut p, []uint8("/left")...).code != 0 {
        exit(3)
    }
    if os.write_file(p[:], []uint8("x")).code != 0 {
        exit(4)
    }
}
-- probe-env-tmpdir/record --
selfcheck probe: the program leaves a file in its TMPDIR
env "TMPDIR=$TMP/../leak"
exit 0
stdout ""
stderr ""
-- probe-leak-asan-level/class --
cflags
-- probe-leak-asan-level/leak.c --
#include <stdlib.h>
#include "tack.h"

static void *keep;

void c_leak(void) {
    keep = malloc(64);
    keep = 0;
}
-- probe-leak-asan-level/main.tck --
package main

extern("c_leak") func leak()

func main() {
    leak()
}
-- probe-leak-asan-level/record --
selfcheck review: a C leak under ASan must fail this record
