-- reflect-fields-example-is-sanitizer-clean-1/record --
replaces codegen/c/fields_test.go TestReflectFieldsExampleIsSanitizerClean/-O2
strict-libs the test compiles its build's C with -std=c11 -Wall -Wextra -Werror -fstrict-flex-arrays=3 at its level and flags itself, which the driver's -w turns off; the runner compiles it so
dir examples/reflect-fields
target .
opt 2
cflags -fstrict-flex-arrays=3 -D_DEFAULT_SOURCE -ffinite-loops -mllvm -indvars-predicate-loops=true
