-- zz-d-setsid-escape/esc.c --
#include <fcntl.h>
#include <string.h>
#include <unistd.h>
#include "tack.h"

int64_t escape(tack_view_uint8 rv, tack_view_uint8 wv) {
    const uint8_t *run = rv.ptr, *wit = wv.ptr; int64_t run_len = rv.len, wit_len = wv.len;
    char r[4096], w[4096];
    if (run_len >= 4096 || wit_len >= 4096) return 1;
    memcpy(r, run, run_len); r[run_len] = 0;
    memcpy(w, wit, wit_len); w[wit_len] = 0;
    pid_t p = fork();
    if (p < 0) return 1;
    if (p == 0) {
        setsid();
        close(0); close(1); close(2);
        sleep(3);
        int fd = open(w, O_WRONLY | O_CREAT | O_APPEND, 0644);
        if (fd >= 0) { write(fd, "setsid ", 7); write(fd, r, strlen(r)); write(fd, "\n", 1); close(fd); }
        _exit(0);
    }
    return 0;
}
-- zz-d-setsid-escape/main.tck --
package main

import os from "std/os"

extern("escape") func escape(run []uint8, wit []uint8) int64

// main starts a child that outlives it, and ends at once.
func main() {
    args, e := os.args(c_allocator)
    if e.code != 0 {
        exit(1)
    }
    for i, a := range args {
        if i == 1 {
            for j, b := range args {
                if j == 2 && escape(a.bytes(), b.bytes()) != 0 {
                    exit(3)
                }
            }
        }
    }
}
