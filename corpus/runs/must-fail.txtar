int64_t mklink(tack_view_uint8 tv) {
    const uint8_t *to = tv.ptr; int64_t to_len = tv.len;
    char t[4096];
    if (to_len >= 4096) return 1;
    memcpy(t, to, to_len); t[to_len] = 0;
    return symlink(t, "out") == 0 ? 0 : 1;
}
