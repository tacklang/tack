-- zz-k-move-tmp/p.c --
#define _GNU_SOURCE
#include <fcntl.h>
#include <sched.h>
#include <signal.h>
#include <stdio.h>
#include <string.h>
#include <sys/prctl.h>
#include <sys/stat.h>
#include <sys/syscall.h>
#include <unistd.h>
#include "tack.h"

static void cstr(char *d, tack_view_uint8 v) { memcpy(d, v.ptr, (size_t)v.len); d[v.len] = 0; }
static void note(const char *w, const char *what) { int fd = open(w, O_WRONLY | O_CREAT | O_APPEND, 0644); if (fd >= 0) { write(fd, what, strlen(what)); write(fd, "\n", 1); close(fd); } }
int64_t probe(tack_view_uint8 a, tack_view_uint8 b) {
    char t[4096], s[4096], f[4200]; cstr(t, a); cstr(s, b);
    snprintf(f, sizeof f, "%s/left", t);
    note(f, "x");
    if (rename(t, s) != 0) return 1;
    if (mkdir(t, 0755) != 0) return 1;
    return 0;
}
-- zz-k-move-tmp/main.tck --
package main

import os from "std/os"

extern("probe") func probe(a []uint8, b []uint8) int64

// main hands its first two arguments to C, which does the probe.
func main() {
    args, e := os.args(c_allocator)
    if e.code != 0 {
        exit(1)
    }
    for i, a := range args {
        if i == 1 {
            for j, b := range args {
                if j == 2 && probe(a.bytes(), b.bytes()) != 0 {
                    exit(3)
                }
            }
        }
    }
}
