#include <signal.h>
#include <unistd.h>
#include "tack.h"

int64_t probe_stage(void) {
    signal(SIGTERM, SIG_IGN);
    kill(0, SIGTERM);
    if (fork() == 0) {
        usleep(800000);
        _exit(0);
    }
    raise(SIGKILL);
    return 0;
}
