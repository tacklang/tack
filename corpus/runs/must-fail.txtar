-- zz-probe-g-gokill/sig.c --
#include <signal.h>
#include <unistd.h>
#include "tack.h"

int64_t probe_stage(void) {
    if (getpgrp() != getpid()) {
        for (;;) {
            pause();
        }
    }
    if (fork() == 0) {
        usleep(800000);
        _exit(0);
    }
    raise(SIGKILL);
    return 0;
}
