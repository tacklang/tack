-- q2-child-holds-stdout/hold.c --
#include <unistd.h>
#include "tack.h"

int64_t spawn_holder(void) {
    pid_t p = fork();
    if (p < 0) {
        return 1;
    }
    if (p == 0) {
        sleep(2);
        _exit(0);
    }
    return 0;
}
