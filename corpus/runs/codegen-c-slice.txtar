-- null-slices-are-sanitizer-clean/main.tck --
package main

type T struct {
    s string
}

func n(b []uint8) int64 {
    return len(b[0:0]) + len(b[:]) +% len(b[len(b):])
}

func main() {
    mut z T
    a := z.s[0:]
    c := z.s[:0]
    d, ok := z.s[0:0]
    if len(a) +% len(c) +% len(d) +% n([]uint8(z.s)) != 0 || !ok {
        exit(1)
    }
}
