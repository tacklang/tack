package main

// Every extern func below is written in C, in lists.c. A list crosses to
// C only as a mut parameter, a pointer to the caller's tack_list_ struct,
// which C may read and grow through std's tack.h macros, TACK_LIST_LEN,
// TACK_LIST_AT, TACK_LIST_APPEND, TACK_LIST_APPEND_N and
// TACK_LIST_RESERVE, during the call; or as a view, whose elements C
// reads.

type Point struct {
    x int64
    y int64
}

// countUp appends 1 through n to l, in C, and returns false if an append
// failed.
extern("count_up") func countUp(mut l list[int64], n int64) bool

// doubleAll doubles every element of l in place, in C.
extern("double_all") func doubleAll(mut l list[int64])

// addPoint appends a point to l, in C.
extern("add_point") func addPoint(mut l list[Point], x int64, y int64) bool

// appendThree appends a, b and c to l, all or none, in C.
extern("append_three") func appendThree(mut l list[int64], a int64, b int64, c int64) bool

// appendView appends every element of v to l, all or none, in C.
extern("append_view") func appendView(mut l list[int64], v []int64) bool

// reserveRoom makes room in l for n more elements, in C.
extern("reserve_room") func reserveRoom(mut l list[int64], n int64) bool

// capOf returns how many elements l's buffer has room for, in C.
extern("list_cap") func capOf(mut l list[int64]) int64

// sumView adds the elements of v, in C.
extern("sum_view") func sumView(v []int64) int64

// live returns how many buffers c_allocator holds, in C.
extern("extern_lists_live") func live() int64

// failAfter makes c_allocator fail every allocation after the next n, or
// none again when n is negative, in C.
extern("extern_lists_fail_after") func failAfter(n int64)

// check prints name and whether cond held.
func check(cond bool, name string) {
    print(name)
    if cond {
        print(" ok\n")
    } else {
        print(" FAIL\n")
    }
}

// fromC lets C grow a list, then reads it back in Tack.
func fromC() {
    mut l := make(list[int64], c_allocator)
    check(countUp(mut l, 100) && len(l) == 100, "appended by C")
    mut good := true
    for i, x := range l {
        if x != i + 1 {
            good = false
        }
    }
    check(good, "C's elements read in Tack")
    doubleAll(mut l)
    check(sumView(l) == 2 * 5050, "doubled in C, viewed by C")
    if len(l) > 10 {
        check(sumView(l[:10]) == 2 * 55, "slice viewed by C")
    }
    err := append(mut l, 7)
    check(err.code == 0 && len(l) == 101, "appended in Tack after C")
}

// structsFromC lets C append structs.
func structsFromC() {
    mut pts := make(list[Point], c_allocator)
    check(addPoint(mut pts, 1, 2) && addPoint(mut pts, 3, 4), "structs appended by C")
    if len(pts) == 2 {
        check(pts[0].x == 1 && pts[1].y == 4, "structs read in Tack")
    }
}

// bulkFromC lets C reserve room and append several elements at once.
func bulkFromC() {
    mut l := make(list[int64], c_allocator)
    check(reserveRoom(mut l, 10) && len(l) == 0 && capOf(mut l) == 10, "reserved by C")
    a := [4]int64{4, 5, 6, 7}
    check(appendThree(mut l, 1, 2, 3) && appendView(mut l, a) && len(l) == 7, "bulk appended by C")
    mut good := capOf(mut l) == 10
    for i, x := range l {
        if x != i + 1 {
            good = false
        }
    }
    check(good, "C's bulk elements read in Tack, in reserved room")
    check(!reserveRoom(mut l, -1) && capOf(mut l) == 10, "negative reserve in C fails")
    failAfter(0)
    check(!appendView(mut l, a) && len(l) == 7 && capOf(mut l) == 10, "bulk append in C fails whole")
    check(!reserveRoom(mut l, 4) && capOf(mut l) == 10, "reserve in C fails")
    failAfter(-1)
    err := append(mut l, a...)
    check(err.code == 0 && len(l) == 11 && capOf(mut l) == 20, "spread in Tack after C")
}

// failing makes C's append fail.
func failing() {
    mut l := make(list[int64], c_allocator)
    failAfter(0)
    check(!countUp(mut l, 1) && len(l) == 0, "append in C fails")
    failAfter(-1)
}

func main() {
    fromC()
    check(live() == 0, "freed after C grew it")
    structsFromC()
    check(live() == 0, "structs freed")
    bulkFromC()
    check(live() == 0, "bulk freed")
    failing()
    check(live() == 0, "nothing after a failure")
}
