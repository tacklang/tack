package main

// Cases that leave, and what they prove after the switch. A switch is the
// chain of ifs it means, and a case whose body leaves is an early exit:
// the code after the switch is reached only when that case did not
// match, so it knows the case's values ruled out, whichever case it is in
// the order tried, as long as every case tried before it leaves too. The
// same holds for the links of an else-if chain whose then branches leave.
// Each check prints its name and "ok", or "FAIL".
//
// The helpers take parameters so that no operand is a known value.

// check prints name and whether cond held.
func check(cond bool, name string) {
    print(name)
    if cond {
        print(" ok\n")
    } else {
        print(" FAIL\n")
    }
}

// zero_then_minus_one divides after a switch whose first case leaves on 0
// and second on -1, so the divisor is neither.
func zero_then_minus_one(n int64, d int64) int64 {
    switch d {
    case 0:
        return 0
    case -1:
        return -%n
    }
    return n / d
}

// minus_one_then_zero is zero_then_minus_one with the cases the other way
// round: the second case gives d != 0.
func minus_one_then_zero(n int64, d int64) int64 {
    switch d {
    case -1:
        return -%n
    case 0:
        return 0
    }
    return n / d
}

// after_other is a case for 0 and -1 together, tried after a case for 7.
func after_other(n int64, d int64) int64 {
    switch d {
    case 7:
        return 100
    case 0, -1:
        return 200
    }
    return n / d
}

// first_combined is the case for 0 and -1 together, tried first.
func first_combined(n int64, d int64) int64 {
    switch d {
    case 0, -1:
        return 200
    case 7:
        return 100
    }
    return n / d
}

// min_dividend leaves on the smallest int8 dividend in its second case, so
// the dividend is not the smallest value and any divisor but 0 will do.
func min_dividend(n int8, d int8) int8 {
    switch n {
    case 0:
        return 0
    case -128:
        return 1
    }
    if d == 0 {
        return 2
    }
    return n / d
}

// with_default has a default that does not leave: the code after the
// switch is reached only through it, past both cases.
func with_default(n int64, d int64) int64 {
    mut r int64 = 0
    switch d {
    case 0:
        return 0
    case -1:
        return 1
    default:
        r = 3
    }
    return n / d +% r
}

// falls_out leaves on -1 by a fallthrough into the case for 0, which
// returns.
func falls_out(n int64, d int64) int64 {
    switch d {
    case -1:
        fallthrough
    case 0:
        return 0
    }
    return n / d
}

// tagless leaves in a switch with no tag, whose second case rules out -1.
func tagless(n int64, d int64) int64 {
    switch {
    case d == 0:
        return 0
    case d == -1:
        return 1
    }
    return n / d
}

// matched_middle reaches the code after the switch only through the case
// for 5, the cases before it and the default leaving, so d is 5 there.
func matched_middle(n int64, d int64) int64 {
    mut r int64 = 0
    switch d {
    case 0:
        return 0
    case 5:
        r = 1
    default:
        return 9
    }
    return n / d +% r
}

// in_loop leaves on -1 with a continue, so the rest of each pass knows d
// is not -1.
func in_loop(n int64, d int64) int64 {
    mut sum int64 = 0
    for mut i int64 = 0; i < 3; i++ {
        switch d {
        case 0:
            return 0
        case -1:
            continue
        }
        sum +%= n / d
    }
    return sum
}

// else_if divides after an else-if chain whose then branches leave on 0
// and on -1.
func else_if(n int64, d int64) int64 {
    if d == 0 {
        return 0
    } else if d == -1 {
        return -%n
    }
    return n / d
}

// proven_after has a switch with a default, and an unreachable after it
// on the value its second case ruled out.
func proven_after(d int64) int64 {
    mut r int64 = 0
    switch d {
    case 0:
        return 0
    case -1:
        return 1
    default:
        r = 2
    }
    if d == -1 {
        unreachable
    }
    return r
}

func main() {
    min := -9223372036854775807 - 1
    check(zero_then_minus_one(10, -1) == -10, "0, -1: d = -1")
    check(zero_then_minus_one(min, -1) == min, "0, -1: min, d = -1")
    check(zero_then_minus_one(10, 0) == 0, "0, -1: d = 0")
    check(zero_then_minus_one(10, 5) == 2, "0, -1: d = 5")
    check(zero_then_minus_one(10, min) == 0, "0, -1: d = min")
    check(zero_then_minus_one(min, min) == 1, "0, -1: min, d = min")
    check(minus_one_then_zero(10, -1) == -10, "-1, 0: d = -1")
    check(minus_one_then_zero(10, 0) == 0, "-1, 0: d = 0")
    check(minus_one_then_zero(-10, 5) == -2, "-1, 0: d = 5")
    check(minus_one_then_zero(min, min) == 1, "-1, 0: d = min")
    check(after_other(10, 7) == 100, "7; 0, -1: d = 7")
    check(after_other(10, 0) == 200, "7; 0, -1: d = 0")
    check(after_other(min, -1) == 200, "7; 0, -1: d = -1")
    check(after_other(10, 5) == 2, "7; 0, -1: d = 5")
    check(after_other(min, min) == 1, "7; 0, -1: d = min")
    check(first_combined(min, -1) == 200, "0, -1; 7: d = -1")
    check(first_combined(10, 0) == 200, "0, -1; 7: d = 0")
    check(first_combined(10, 5) == 2, "0, -1; 7: d = 5")
    check(min_dividend(-128, -1) == 1, "min dividend: -128 / -1")
    check(min_dividend(0, -1) == 0, "min dividend: 0 / -1")
    check(min_dividend(-127, -1) == 127, "min dividend: -127 / -1")
    check(min_dividend(5, 0) == 2, "min dividend: d = 0")
    check(min_dividend(127, -128) == 0, "min dividend: d = min")
    check(with_default(10, -1) == 1, "default: d = -1")
    check(with_default(10, 0) == 0, "default: d = 0")
    check(with_default(10, 5) == 5, "default: d = 5")
    check(with_default(min, min) == 4, "default: d = min")
    check(falls_out(10, -1) == 0, "fallthrough: d = -1")
    check(falls_out(10, 0) == 0, "fallthrough: d = 0")
    check(falls_out(10, 5) == 2, "fallthrough: d = 5")
    check(falls_out(min, min) == 1, "fallthrough: d = min")
    check(tagless(min, -1) == 1, "tagless: d = -1")
    check(tagless(10, 0) == 0, "tagless: d = 0")
    check(tagless(10, 5) == 2, "tagless: d = 5")
    check(tagless(10, min) == 0, "tagless: d = min")
    check(matched_middle(10, 5) == 3, "middle: d = 5")
    check(matched_middle(10, 0) == 0, "middle: d = 0")
    check(matched_middle(10, -1) == 9, "middle: d = -1")
    check(matched_middle(10, min) == 9, "middle: d = min")
    check(in_loop(10, -1) == 0, "loop: d = -1")
    check(in_loop(10, 0) == 0, "loop: d = 0")
    check(in_loop(10, 5) == 6, "loop: d = 5")
    check(in_loop(min, min) == 3, "loop: d = min")
    check(else_if(10, -1) == -10, "else if: d = -1")
    check(else_if(min, -1) == min, "else if: min, d = -1")
    check(else_if(10, 0) == 0, "else if: d = 0")
    check(else_if(10, 5) == 2, "else if: d = 5")
    check(else_if(min, min) == 1, "else if: d = min")
    check(proven_after(-1) == 1, "unreachable: d = -1")
    check(proven_after(0) == 0, "unreachable: d = 0")
    check(proven_after(5) == 2, "unreachable: d = 5")
}
