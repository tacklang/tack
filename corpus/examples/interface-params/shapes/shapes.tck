package shapes

// Shape has an area: an interface of another package, named as
// shapes.Shape where it is used.
pub type Shape interface {
    area() int64
}

// Square is a Shape with a side.
pub type Square struct {
    pub side int64
}

// area returns the square's area.
pub func (s Square) area() int64 {
    return s.side *% s.side
}

// The wrapping operators in this file, +% -% *% and their compound
// forms, stand where nothing proves a value's bound but this program's
// own fixed data keeps it within its type, so none of them wraps; one
// that is meant to wrap says so where it is.
