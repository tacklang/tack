package main

// divmod returns a divided by b and the remainder, or 0 and 0 for a b of
// 0. A b of -1 is written out, since the smallest int64 divided by -1
// overflows: the quotient wraps to -%a, as it did before that division
// needed a proof.
func divmod(a int64, b int64) (int64, int64) {
    if b == 0 {
        return 0, 0
    }
    if b == -1 {
        return -%a, 0
    }
    return a / b, a % b
}

func average(total int64, count int64) int64 {
    if count > 0 {
        return total / count
    }
    return 0
}

func main() {
    q, r := divmod(17, 5)
    mut zero int64 = 0
    v, ok := 10 / zero
    w, fine := 10 / q
    if ok || !fine || v != 0 {
        exit(1)
    }
    half := 7 / 2
    mut steps int64 = 100
    steps /= half
    code, fits := int32(q *% 10 +% r +% average(steps, 3) +% w)
    if !fits {
        exit(2)
    }
    exit(code)
}

// The wrapping operators in this file, +% -% *% and their compound
// forms, stand where nothing proves a value's bound but this program's
// own fixed data keeps it within its type, so none of them wraps; one
// that is meant to wrap says so where it is.
