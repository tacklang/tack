package pass

// Package pass is a library whose tests, in more_test.tck and
// pass_test.tck, all pass: tack test runs them, in the order of their
// files' names and then of the source, and exits 0. Its tests read
// private declarations, sum and parse, as tests in the package may.

// sum returns a plus b, wrapping.
func sum(a int64, b int64) int64 {
    return a +% b
}

// parse returns the digit c is, or error 2 when c is no digit.
func parse(c uint8) (int64, error) {
    if c < '0' || c > '9' {
        return 0, error{code: 2, msg: "not a digit"}
    }
    return int64(c - '0'), noerror
}

// Sum returns a plus b.
pub func Sum(a int64, b int64) int64 {
    return sum(a, b)
}

// Digit returns the digit c is, as parse does.
pub func Digit(c uint8) (int64, error) {
    n := parse(c)?
    return n, noerror
}

// test_value is no test, though its name starts with test_: this is no
// test file, so its signature is its own.
pub func test_value() int64 {
    return 42
}
